{
  "name": "threenative-engine-mcp",
  "version": "0.2.7",
  "license": "MIT",
  "description": "Offline MCP capability discovery for ThreeNative authoring agents.",
  "keywords": [
    "threenative",
    "mcp",
    "model-context-protocol",
    "three",
    "threejs",
    "agents",
    "capabilities"
  ],
  "homepage": "https://github.com/ThreeNativeHQ/threenative#readme",
  "bugs": {
    "url": "https://github.com/ThreeNativeHQ/threenative/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ThreeNativeHQ/threenative.git",
    "directory": "packages/engine-mcp"
  },
  "type": "module",
  "files": ["dist", "README.md"],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "threenative-engine-mcp": "./dist/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup --config tsup.config.ts && publint",
    "typecheck": "tsc --noEmit",
    "test": "publint --strict"
  },
  "devDependencies": {
    "publint": "0.3.22",
    "tsup": "8.5.1",
    "typescript": "catalog:",
    "@typescript/native": "catalog:"
  }
}
