{
  "name": "@threenative/playtest",
  "version": "0.3.6",
  "license": "MIT",
  "description": "Scenario-driven playtest harness for Three.js games. Runs on plain Three.js with zero ThreeNative dependencies.",
  "keywords": [
    "threenative",
    "three",
    "threejs",
    "testing",
    "playwright",
    "e2e",
    "gamedev"
  ],
  "homepage": "https://github.com/ThreeNativeHQ/threenative#readme",
  "bugs": {
    "url": "https://github.com/ThreeNativeHQ/threenative/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ThreeNativeHQ/threenative.git",
    "directory": "packages/playtest"
  },
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js"
    },
    "./three": {
      "types": "./dist/three/index.d.ts",
      "import": "./dist/three/index.js"
    },
    "./capture": {
      "types": "./dist/capture.d.ts",
      "import": "./dist/capture.js"
    },
    "./runner": {
      "types": "./dist/runner/index.d.ts",
      "import": "./dist/runner/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "threenative-playtest": "./dist/runner/cli.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "scripts": {
    "build": "pnpm --workspace-root exec tsx scripts/generate-assertion-validators.ts --check && tsup --config tsup.config.ts && publint",
    "typecheck": "tsc --noEmit",
    "test": "bash __tests__/orphan-cleanup.sh && publint --strict"
  },
  "dependencies": {
    "pngjs": "catalog:"
  },
  "peerDependencies": {
    "playwright": ">=1.60.0 <2",
    "three": ">=0.185.0 <0.186.0"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    },
    "three": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/pngjs": "catalog:",
    "@types/three": "0.185.3",
    "playwright": "1.62.1",
    "publint": "0.3.22",
    "three": "catalog:",
    "tsup": "8.5.1",
    "typescript": "catalog:",
    "@typescript/native": "catalog:"
  }
}
