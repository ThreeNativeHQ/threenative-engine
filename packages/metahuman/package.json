{
  "name": "@threenative/metahuman",
  "version": "0.1.3",
  "license": "MIT",
  "description": "MetaHuman head expression rig: checksum-verified OpenRigLogic WASM evaluator and the binding-metadata asset contract.",
  "keywords": [
    "threenative",
    "metahuman",
    "openriglogic",
    "riglogic",
    "facial",
    "expression",
    "three",
    "threejs"
  ],
  "homepage": "https://github.com/ThreeNativeHQ/threenative#readme",
  "bugs": {
    "url": "https://github.com/ThreeNativeHQ/threenative/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ThreeNativeHQ/threenative.git",
    "directory": "packages/metahuman"
  },
  "type": "module",
  "files": ["dist", "wasm", "README.md"],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "threenative-native": "./dist/native/index.js",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "./src/index.ts",
    "./src/native/index.ts",
    "./dist/index.js",
    "./dist/native/index.js"
  ],
  "scripts": {
    "build": "tsup --config tsup.config.ts && publint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --root ../.. metahuman/__tests__ && pnpm run build && publint --strict"
  },
  "peerDependencies": {
    "three": ">=0.185.0 <0.186.0"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@types/three": "0.185.3",
    "publint": "0.3.22",
    "three": "catalog:",
    "tsup": "8.5.1",
    "typescript": "catalog:",
    "@typescript/native": "catalog:"
  }
}
