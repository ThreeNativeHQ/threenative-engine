  "generated": {
    "needle-atlas.png": {
      "what": "A 2x2 RGBA atlas: three spruce branch cards (needles drawn as bundles of side shoots at several angles, lighter tips, dark twig) and one poppy petal, on a hard alpha edge",
      "generator": "examples/strata-terrain-preview/scripts/make-needle-atlas.mjs",
      "seed": 466468,
      "command": "node scripts/make-needle-atlas.mjs",
      "bytes": 321934,
      "dimensions": "1024x1024 (4 cells of 512x512)",
      "preprocessing": "none. Drawn from a seeded PRNG and deflated as PNG by the script itself: no image library, no upload, byte-identical on every run.",
      "sha256": "d2f1fd6eb3f87083a1c72a07add0c485f477b7b5e64e1d9db0108298c75eae50",
      "why": "A photograph of foliage does not give a card with the twig down the middle and needles fanning off both sides, which is what makes an alpha-cutout branch read as a branch from every angle."
    },
    "needle-surface.png": {
      "what": "The same four cells as relief: RG a tangent-space normal cooked from the albedo's own per-needle ridge field, B the ambient occlusion the canopy drops on itself",
      "generator": "examples/strata-terrain-preview/scripts/make-needle-atlas.mjs",
      "seed": 466468,
      "command": "node scripts/make-needle-atlas.mjs",
      "bytes": 1021932,
      "dimensions": "1024x1024 (4 cells of 512x512)",
      "preprocessing": "none. Cooked from the coverage and ridge the same run recorded while drawing the albedo, and deflated as PNG by the script itself: no image library, byte-identical on every run.",
      "sha256": "45d236f6b61f745753fd86b06b0c27d451ae118c9f0164ce44dda51f297ecbf5",
      "why": "An alpha-tested quad has no thickness, so a crown built from cards had exactly one flat normal per card and read as stacked flat quads. A normal per needle plus the spray's own occlusion is what makes a card a mass of needles rather than a silhouette."
    }
  },
  "prepared": {
    "why": "The starter's own art folder is the only place a prepared prop can live: it is what the terrain world's Vite publicDir serves and what ctx.assets loads by path, so the ground maps and the props come from one place with one credits file.",
    "generator": "examples/strata-terrain-preview/scripts/prep-trees.py",
    "command": "~/.local/bin/blender -b --factory-startup --python scripts/prep-trees.py -- --source <scratch>/<download> --out packages/terrain/starter-assets/<set> --species <name> --variant <node> --near <budget> --mid <budget>",
    "license": "CC0 1.0 Universal (public domain dedication), unchanged from the source assets",
    "rawDownloads": "never committed; the upstream .gltf and .bin stay in a scratch directory outside this repository",
    "preprocessing": [
      "split by material, then join to one solid part and one needle part per prop",
      "wood: collapse decimation, then a cylindrical unwrap so the game's own bark map can be sampled on it",
      "wood: loose branch shells dropped whole, biggest first, to reach the budget",
      "needles: whole alpha cards dropped, evenly over the crown's own volume, then the survivors enlarged about their own centres",
      "colours and extra UV sets stripped; cameras, lights and armatures removed",
      "exported with export_apply=True, and every count read back out of the written GLB's JSON chunk"
    ],
