    "leafy_grass": {
      "asset": "Leafy Grass",
      "author": "Charlotte Baglioni",
      "license": "CC0",
      "groundLayer": "grass",
      "metresPerTile": 2.6,
      "note": null
    },
    "forest_ground_04": {
      "asset": "Forest Ground 04",
      "author": "Rob Tuytel, Rico Cilliers",
      "license": "CC0",
      "groundLayer": "dirt",
      "metresPerTile": 3.4,
      "note": null
    },
    "cliff_side": {
      "asset": "Cliff Side",
      "author": "James Ray Cock, Jenelle van Heerden, Dario Barresi",
      "license": "CC0",
      "groundLayer": "rock",
      "metresPerTile": 9.0,
      "note": "The PRD shortlist names Sandstone Cracks for dry rock. Cliff Side is the same CC0 source's layered, sediment-banded rock face and is what the Temperate cliffs use; Sandstone Cracks stays unallocated for the Desert/Canyon starter."
    },
    "mossy_rock": {
      "asset": "Mossy Rock",
      "author": "Poly Haven / Dario Barresi",
      "license": "CC0",
      "groundLayer": "moss",
      "metresPerTile": 3.6,
      "note": "Substituted for the shortlist's Rock Moss Set 02: that set's 1K diffuse is an atlas of seven rocks over black unused cells with starburst edges, not a tileable ground map. Mossy Rock (CC0, Poly Haven) is tileable, mossy and stony."
    },
    "sand_01": {
      "asset": "Sand 01",
      "author": "Rob Tuytel",
      "license": "CC0",
      "groundLayer": "sand",
      "metresPerTile": 3.2,
      "note": "The 1K diffuse and GL normal map are seam-blended for tiling: each cross-fades its edges with a half-shifted copy. Diffuse left-right seam ratio 1.51 to 0.95; top-bottom 1.43 to 1.13. Only the edges changed; the source is Poly Haven, CC0."
    },
    "snow_02": {
      "asset": "Snow 02",
      "author": "Rob Tuytel",
      "license": "CC0",
      "groundLayer": "snow",
      "metresPerTile": 12.0,
      "note": null
    },
    "bark_brown_02": {
      "asset": "Bark Brown 02",
      "author": "Rob Tuytel",
      "license": "CC0",
      "groundLayer": null,
      "metresPerTile": 1.6,
      "note": "Spruce trunk bark. The shortlist names it for procedural tree bark; the Temperate starter uses it on the tapered spruce trunk, tiled 1.6 m up a 14 m trunk, and nowhere else."
    },
    "rock_boulder_dry": {
      "asset": "Rock Boulder Dry",
      "author": "Dimitrios Savva (Photography), Rico Cilliers (Processing)",
      "license": "CC0",
      "groundLayer": null,
      "metresPerTile": null,
      "note": "The dry grey granite-ish boulder set. Its 1K diffuse is tileable stone, not an atlas: the seam column differs from the last by 5.7 grey levels against an interior neighbour difference of 7.5, so it wraps as well as the map averages."
    },
    "lichen_rock": {
      "asset": "Lichen Rock",
      "author": "Rico Cilliers (All)",
      "license": "CC0",
      "groundLayer": null,
      "metresPerTile": null,
      "note": "The lichen-crusted weathered boulder set. Seam 11.5 against an interior 12.1: tileable. Distinct from the existing mossy_rock set, which is moss rather than lichen, so a boulder bed does not read as one surface twice."
    },
    "forest_leaves_02": {
      "asset": "Forest Leaves 02",
      "author": "Rob Tuytel (All)",
      "license": "CC0",
      "groundLayer": null,
      "metresPerTile": null,
      "note": "Leaf litter and forest floor for the ground under trees. Seam 19.7 against an interior 17.2: tileable. metresPerTile is deliberately null: the tiling is the terrain render layer's choice, not this folder's."
    },
    "river_small_rocks": {
      "asset": "River Small Rocks",
      "author": "Rob Tuytel (Photography, Processing), Rico Cilliers (Minor adjustment)",
      "license": "CC0",
      "groundLayer": null,
      "metresPerTile": null,
      "note": "The pebble set for river banks. Seam 12.6 against an interior 11.2: tileable. metresPerTile is deliberately null, as above."
    },
    "fern_02": {
      "asset": "Fern 02",
      "author": "Rob Tuytel, Rico Cilliers",
      "license": "CC0",
      "groundLayer": null,
      "metresPerTile": null,
      "note": "Alpha-cut card atlas only (diffuse, alpha, OpenGL normal at 512 px). The upstream plant meshes are not shipped: cut to the starter budget they kept one blade or frond of each plant, so the game builds its own cards on this atlas."
    },
    "grass_medium_02": {
      "asset": "Grass Medium 02",
      "author": "Rob Tuytel (photography), Rico Cilliers (modeling)",
      "license": "CC0",
      "groundLayer": null,
      "metresPerTile": null,
      "note": "Alpha-cut card atlas only (diffuse, alpha, OpenGL normal at 512 px). The upstream plant meshes are not shipped: cut to the starter budget they kept one blade or frond of each plant, so the game builds its own cards on this atlas."
    }
