{
  "name": "@threenative/terrain",
  "version": "0.1.10",
  "license": "MIT",
  "description": "Headless terrain authoring \u2014 noise, erosion, sculpting, roads, rivers, material splats and scatter \u2014 evaluated into ordinary typed arrays and indexed Three.js geometry.",
  "keywords": ["threenative", "terrain", "heightfield", "three", "threejs", "procedural", "webgpu"],
  "homepage": "https://github.com/ThreeNativeHQ/threenative#readme",
  "bugs": {
    "url": "https://github.com/ThreeNativeHQ/threenative/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ThreeNativeHQ/threenative-engine.git",
    "directory": "packages/terrain"
  },
  "type": "module",
  "files": [
    "dist",
    "starter/*/*.json",
    "starter/*/*.r16",
    "starter/*/*.mjs",
    "starter/*/*.ts",
    "starter/*/*.md",
    "starter-assets.json",
    "starter-credits.json",
    "README.md",
    "AGENTS.md",
    "docs/authoring/*.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "bin": "./dist/mcp/server.js",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./three": {
      "types": "./dist/three.d.ts",
      "import": "./dist/three.js"
    },
    "./export": {
      "types": "./dist/export.d.ts",
      "import": "./dist/export.js"
    },
    "./kit": {
      "types": "./dist/kit.d.ts",
      "import": "./dist/kit.js"
    },
    "./package.json": "./package.json",
    "./editor/server": {
      "types": "./dist/editor/server.d.ts",
      "import": "./dist/editor/server.js"
    },
    "./editor": {
      "types": "./dist/editor/index.d.ts",
      "import": "./dist/editor/index.js"
    },
    "./starter": {
      "types": "./dist/starter.d.ts",
      "import": "./dist/starter.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup --config tsup.config.ts && publint",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run build && vitest run --root ../.. terrain/__tests__ && publint --strict",
    "test:consumer": "pnpm run build && vitest run --root ../.. packages/terrain/__tests__/terrain-consumer.spec.ts",
    "test:map": "vitest run --root ../.. scripts/__tests__/terrain-architecture-census.spec.ts",
    "bake:forest": "pnpm run build && node starter/forest/bake.mjs --out ../../artifacts/terrain/forest",
    "bake:coastal": "pnpm run build && node starter/coastal/bake.mjs --out ../../artifacts/terrain/coastal",
    "bake:alpine": "pnpm run build && node starter/alpine/bake.mjs --out ../../artifacts/terrain/alpine",
    "bake:desert": "pnpm run build && node starter/desert/bake.mjs --out ../../artifacts/terrain/desert",
    "bake:tundra": "pnpm run build && node starter/tundra/bake.mjs --out ../../artifacts/terrain/tundra"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/three": "catalog:",
    "publint": "catalog:",
    "three": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "@typescript/native": "catalog:",
    "vite": "catalog:",
    "@threenative/core": "workspace:*",
    "@threenative/physics": "workspace:*",
    "@threenative/procedural-vegetation": "workspace:*"
  },
  "peerDependencies": {
    "@threenative/core": ">=0.3.14 <0.4.0",
    "@threenative/physics": ">=0.3.14 <0.4.0",
    "@threenative/procedural-vegetation": ">=0.1.0 <0.2.0",
    "three": ">=0.187.0 <0.188.0",
    "vite": ">=7.0.0 <9.0.0"
  },
  "peerDependenciesMeta": {
    "@threenative/core": { "optional": true },
    "@threenative/physics": { "optional": true },
    "@threenative/procedural-vegetation": { "optional": true },
    "vite": {
      "optional": true
    }
  }
}
