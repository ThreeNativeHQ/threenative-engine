{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threenative.dev/schemas/three-native-catalog.json",
  "title": "ThreeNative native-engine API catalog",
  "description": "The compatibility contract the native engine publishes: classes, constructors, inheritance, fields, methods, overloads, defaults, enum values, lifetime and mutability annotations, async behaviour, callback signatures and capability status for the Three.js surface measured by docs/architecture/native-engine-inventory.json. `supported` is the published native contract, not a claim that an implementation has shipped: the work packages implement it. `scripts/generate.ts` and src/catalog.ts enforce this schema with a hand-written validator over the keyword subset below.",
  "type": "object",
  "required": ["version", "reference", "abi", "entries"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "reference": {
      "type": "object",
      "required": ["three", "types", "patch"],
      "additionalProperties": false,
      "properties": {
        "three": { "type": "string", "minLength": 1 },
        "types": { "type": "string", "minLength": 1 },
        "patch": { "type": "string", "minLength": 1 }
      }
    },
    "abi": { "$ref": "#/$defs/abi" },
    "entries": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/entry" } }
  },
  "$defs": {
    "abi": {
      "description": "The four versions §8.2 keeps separate. A module built against different values is rejected before a game starts.",
      "type": "object",
      "required": ["engine", "compatibilityContract", "scene", "shaderPackage"],
      "additionalProperties": false,
      "properties": {
        "engine": { "type": "integer", "minimum": 1 },
        "compatibilityContract": { "type": "integer", "minimum": 1 },
        "scene": { "type": "integer", "minimum": 1 },
        "shaderPackage": { "type": "integer", "minimum": 1 }
      }
    },
    "status": {
      "description": "Capability status. Every entry carries one; a member inherits its entry's status unless it names its own.",
      "oneOf": [
        {
          "type": "object",
          "required": ["kind"],
          "additionalProperties": false,
          "properties": { "kind": { "const": "supported" } }
        },
        {
          "type": "object",
          "required": ["kind", "gaps"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "partial" },
            "gaps": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }
            }
          }
        },
        {
          "type": "object",
          "required": ["kind", "diagnostic"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "unsupported" },
            "diagnostic": { "type": "string", "pattern": "^TN_[A-Z0-9_]+$" }
          }
        }
      ]
    },
    "diagnostic": {
      "type": "string",
      "pattern": "^TN_[A-Z0-9_]+$"
    },
    "parameter": {
      "type": "object",
      "required": ["name", "type", "optional"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "optional": { "type": "boolean" },
        "default": { "type": "string" },
        "callback": {
          "description": "Set when the parameter is a function. Generation turns it into a callback-plus-context pair.",
          "type": "string",
          "minLength": 1
        },
        "rest": { "type": "boolean" }
      }
    },
    "overload": {
      "type": "object",
      "required": ["parameters", "returns"],
      "additionalProperties": false,
      "properties": {
        "parameters": { "type": "array", "items": { "$ref": "#/$defs/parameter" } },
        "returns": { "type": "string", "minLength": 1 }
      }
    },
    "field": {
      "type": "object",
      "required": ["name", "type", "mutable", "lifetime"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "mutable": { "type": "boolean" },
        "lifetime": {
          "description": "`owned` is a value the containing object holds; `reference` is another object it observes. Storage rules belong to N04.",
          "enum": ["owned", "reference"]
        },
        "accessor": { "type": "boolean" },
        "default": { "type": "string" },
        "note": { "type": "string" },
        "status": { "$ref": "#/$defs/status" }
      }
    },
    "method": {
      "type": "object",
      "required": ["name", "async", "overloads"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "async": { "type": "boolean" },
        "overloads": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/overload" }
        },
        "note": { "type": "string" },
        "status": { "$ref": "#/$defs/status" }
      }
    },
    "entry": {
      "oneOf": [
        { "$ref": "#/$defs/classEntry" },
        { "$ref": "#/$defs/typeEntry" },
        { "$ref": "#/$defs/enumEntry" },
        { "$ref": "#/$defs/constantEntry" },
        { "$ref": "#/$defs/functionEntry" }
      ]
    },
    "functionEntry": {
      "type": "object",
      "required": ["name", "kind", "source", "status"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Za-z_$][\\w$]*$" },
        "kind": { "const": "function" },
        "source": { "type": "string", "minLength": 1 },
        "status": { "$ref": "#/$defs/status" },
        "parameters": { "type": "array", "items": { "$ref": "#/$defs/parameter" } },
        "returns": { "type": "string", "minLength": 1 }
      }
    },
    "classEntry": {
      "type": "object",
      "required": ["name", "kind", "source", "status", "constructor", "fields", "methods"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Za-z_$][\\w$]*$" },
        "kind": { "const": "class" },
        "source": { "type": "string", "minLength": 1 },
        "extends": { "type": ["string", "null"] },
        "status": { "$ref": "#/$defs/status" },
        "constructor": { "type": "array", "items": { "$ref": "#/$defs/parameter" } },
        "fields": { "type": "array", "items": { "$ref": "#/$defs/field" } },
        "methods": { "type": "array", "items": { "$ref": "#/$defs/method" } }
      }
    },
    "typeEntry": {
      "type": "object",
      "required": ["name", "kind", "source", "status", "type"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Za-z_$][\\w$]*$" },
        "kind": { "const": "type" },
        "source": { "type": "string", "minLength": 1 },
        "status": { "$ref": "#/$defs/status" },
        "type": { "type": "string", "minLength": 1 }
      }
    },
    "enumEntry": {
      "type": "object",
      "required": ["name", "kind", "source", "status", "values"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Za-z_$][\\w$]*$" },
        "kind": { "const": "enum" },
        "source": { "type": "string", "minLength": 1 },
        "status": { "$ref": "#/$defs/status" },
        "values": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "value"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "value": { "type": ["string", "number"] }
            }
          }
        }
      }
    },
    "constantEntry": {
      "type": "object",
      "required": ["name", "kind", "source", "status", "type", "value"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Za-z_$][\\w$]*$" },
        "kind": { "const": "constant" },
        "source": { "type": "string", "minLength": 1 },
        "status": { "$ref": "#/$defs/status" },
        "type": { "enum": ["number", "string"] },
        "value": { "type": ["string", "number"] }
      }
    }
  }
}
