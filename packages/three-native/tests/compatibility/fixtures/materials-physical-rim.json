{
  "name": "materials-physical-rim",
  "adaptedFrom": "original \u2014 the materials-physical scene lit from behind the sphere (a rim light), so the half vector grazes: a dark MeshPhysicalMaterial with specularIntensity 0.2, where direct specular uses f90 = 1 (PhysicalLightingModel.direct) and specularF90 belongs to indirect light only",
  "tolerance": {
    "abs": 0
  },
  "render": {
    "scene": "scene",
    "camera": "camera",
    "width": 320,
    "height": 240,
    "toneMapping": "aces",
    "toneMappingExposure": 1,
    "outputColorSpace": "srgb"
  },
  "ops": [
    {
      "op": "new",
      "id": "scene",
      "class": "Scene",
      "args": []
    },
    {
      "op": "new",
      "id": "background",
      "class": "Color",
      "args": [0.05, 0.06, 0.08]
    },
    {
      "op": "set",
      "id": "scene",
      "path": "background",
      "value": {
        "ref": "background"
      }
    },
    {
      "op": "new",
      "id": "camera",
      "class": "PerspectiveCamera",
      "args": [60, 1.3333333333333333, 0.1, 100]
    },
    {
      "op": "set",
      "id": "camera",
      "path": "position.y",
      "value": 1.4
    },
    {
      "op": "set",
      "id": "camera",
      "path": "position.z",
      "value": 3.2
    },
    {
      "op": "call",
      "id": "camera",
      "method": "lookAt",
      "args": [0, 0, 0]
    },
    {
      "op": "new",
      "id": "light",
      "class": "DirectionalLight",
      "args": [16777215, 3]
    },
    {
      "op": "set",
      "id": "light",
      "path": "position.x",
      "value": 0
    },
    {
      "op": "set",
      "id": "light",
      "path": "position.y",
      "value": 1.5
    },
    {
      "op": "set",
      "id": "light",
      "path": "position.z",
      "value": -3
    },
    {
      "op": "new",
      "id": "sky",
      "class": "HemisphereLight",
      "args": [11189137, 2236962, 0.6]
    },
    {
      "op": "new",
      "id": "geometry",
      "class": "SphereGeometry",
      "args": [1, 32, 16]
    },
    {
      "op": "new",
      "id": "material",
      "class": "MeshPhysicalMaterial",
      "args": []
    },
    {
      "op": "set",
      "id": "material",
      "path": "color.r",
      "value": 0.05
    },
    {
      "op": "set",
      "id": "material",
      "path": "color.g",
      "value": 0.05
    },
    {
      "op": "set",
      "id": "material",
      "path": "color.b",
      "value": 0.05
    },
    {
      "op": "set",
      "id": "material",
      "path": "roughness",
      "value": 0.25
    },
    {
      "op": "set",
      "id": "material",
      "path": "metalness",
      "value": 0
    },
    {
      "op": "set",
      "id": "material",
      "path": "ior",
      "value": 1.5
    },
    {
      "op": "set",
      "id": "material",
      "path": "specularIntensity",
      "value": 0.2
    },
    {
      "op": "set",
      "id": "material",
      "path": "specularColor.r",
      "value": 1
    },
    {
      "op": "set",
      "id": "material",
      "path": "specularColor.g",
      "value": 1
    },
    {
      "op": "set",
      "id": "material",
      "path": "specularColor.b",
      "value": 1
    },
    {
      "op": "new",
      "id": "mesh",
      "class": "Mesh",
      "args": [
        {
          "ref": "geometry"
        },
        {
          "ref": "material"
        }
      ]
    },
    {
      "op": "call",
      "id": "scene",
      "method": "add",
      "args": [
        {
          "ref": "mesh"
        }
      ]
    },
    {
      "op": "call",
      "id": "scene",
      "method": "add",
      "args": [
        {
          "ref": "light"
        }
      ]
    },
    {
      "op": "call",
      "id": "scene",
      "method": "add",
      "args": [
        {
          "ref": "sky"
        }
      ]
    },
    {
      "op": "call",
      "id": "camera",
      "method": "updateProjectionMatrix",
      "args": []
    },
    {
      "op": "call",
      "id": "scene",
      "method": "updateMatrixWorld",
      "args": [true]
    }
  ],
  "observe": [
    {
      "id": "camera",
      "path": "projectionMatrix.elements",
      "kind": "numbers"
    },
    {
      "id": "camera",
      "path": "matrixWorld.elements",
      "kind": "numbers"
    },
    {
      "id": "light",
      "path": "matrixWorld.elements",
      "kind": "numbers"
    },
    {
      "id": "mesh",
      "path": "matrixWorld.elements",
      "kind": "numbers"
    },
    {
      "id": "geometry",
      "path": "parameters",
      "kind": "json"
    },
    {
      "id": "material",
      "path": "type",
      "kind": "string"
    },
    {
      "id": "scene",
      "kind": "pixels",
      "metric": {
        "maxPixelMismatchRatio": 0.01,
        "maxPerceptualDeltaE": 0.02
      }
    }
  ]
}
