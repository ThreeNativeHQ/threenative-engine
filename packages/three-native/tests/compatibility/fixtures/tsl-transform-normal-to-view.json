{
  "name": "tsl-transform-normal-to-view",
  "adaptedFrom": "original \u2014 r185's transformNormalToView(normalGeometry) as a colour: modelNormalMatrix (the inverse transpose of the model matrix) then the view matrix, on a rotated box and on a non-uniformly scaled one, where the inverse transpose is what keeps the normals perpendicular",
  "tolerance": {
    "abs": 0
  },
  "observe": [
    {
      "id": "camera",
      "path": "projectionMatrix.elements",
      "kind": "numbers"
    },
    {
      "id": "scene",
      "kind": "pixels",
      "metric": {
        "maxPixelMismatchRatio": 0.01,
        "maxPerceptualDeltaE": 0.02
      }
    }
  ],
  "render": {
    "scene": "scene",
    "camera": "camera",
    "width": 320,
    "height": 240,
    "toneMapping": "aces",
    "toneMappingExposure": 1,
    "outputColorSpace": "srgb",
    "shadowMap": false
  },
  "ops": [
    {
      "op": "new",
      "id": "scene",
      "class": "Scene",
      "args": []
    },
    {
      "op": "new",
      "id": "background",
      "class": "Color",
      "args": [0.05, 0.06, 0.08]
    },
    {
      "op": "set",
      "id": "scene",
      "path": "background",
      "value": {
        "ref": "background"
      }
    },
    {
      "op": "new",
      "id": "camera",
      "class": "PerspectiveCamera",
      "args": [50, 1.3333333333333333, 0.1, 100]
    },
    {
      "op": "set",
      "id": "camera",
      "path": "position.z",
      "value": 5
    },
    {
      "op": "new",
      "id": "boxGeometry",
      "class": "BoxGeometry",
      "args": [0.9, 0.9, 0.9]
    },
    {
      "op": "new",
      "id": "boxMaterial",
      "class": "MeshBasicNodeMaterial",
      "args": []
    },
    {
      "op": "new",
      "id": "box",
      "class": "Mesh",
      "args": [
        {
          "ref": "boxGeometry"
        },
        {
          "ref": "boxMaterial"
        }
      ]
    },
    {
      "op": "set",
      "id": "box",
      "path": "name",
      "value": "box"
    },
    {
      "op": "set",
      "id": "box",
      "path": "position.x",
      "value": -0.8
    },
    {
      "op": "set",
      "id": "box",
      "path": "rotation.x",
      "value": 0.6
    },
    {
      "op": "set",
      "id": "box",
      "path": "rotation.y",
      "value": 0.8
    },
    {
      "op": "call",
      "id": "scene",
      "method": "add",
      "args": [
        {
          "ref": "box"
        }
      ]
    },
    {
      "op": "new",
      "id": "stretchedMaterial",
      "class": "MeshBasicNodeMaterial",
      "args": []
    },
    {
      "op": "new",
      "id": "stretched",
      "class": "Mesh",
      "args": [
        {
          "ref": "boxGeometry"
        },
        {
          "ref": "stretchedMaterial"
        }
      ]
    },
    {
      "op": "set",
      "id": "stretched",
      "path": "name",
      "value": "stretched"
    },
    {
      "op": "set",
      "id": "stretched",
      "path": "position.x",
      "value": 0.9
    },
    {
      "op": "set",
      "id": "stretched",
      "path": "rotation.y",
      "value": -0.5
    },
    {
      "op": "set",
      "id": "stretched",
      "path": "rotation.z",
      "value": 0.4
    },
    {
      "op": "set",
      "id": "stretched",
      "path": "scale.x",
      "value": 1.6
    },
    {
      "op": "set",
      "id": "stretched",
      "path": "scale.y",
      "value": 0.6
    },
    {
      "op": "call",
      "id": "scene",
      "method": "add",
      "args": [
        {
          "ref": "stretched"
        }
      ]
    },
    {
      "op": "tsl",
      "id": "scene",
      "program": "tsl-transform-normal-to-view"
    },
    {
      "op": "call",
      "id": "camera",
      "method": "updateProjectionMatrix",
      "args": []
    },
    {
      "op": "call",
      "id": "scene",
      "method": "updateMatrixWorld",
      "args": [true]
    }
  ]
}
