{
  "name": "textures-data-half",
  "adaptedFrom": "original — the textures-data-float gradient as a HalfFloatType (RGBA16Float) DataTexture over binary16 bits, Linear filter and ClampToEdge, on a lit MeshStandardMaterial plane and a MeshBasicMaterial box",
  "tolerance": {
    "abs": 0
  },
  "render": {
    "scene": "scene",
    "camera": "camera",
    "width": 256,
    "height": 128,
    "toneMapping": "none",
    "toneMappingExposure": 1,
    "outputColorSpace": "srgb"
  },
  "ops": [
    {
      "op": "new",
      "id": "scene",
      "class": "Scene",
      "args": []
    },
    {
      "op": "new",
      "id": "background",
      "class": "Color",
      "args": [0.05, 0.06, 0.08]
    },
    {
      "op": "set",
      "id": "scene",
      "path": "background",
      "value": {
        "ref": "background"
      }
    },
    {
      "op": "new",
      "id": "camera",
      "class": "PerspectiveCamera",
      "args": [60, 2, 0.1, 100]
    },
    {
      "op": "set",
      "id": "camera",
      "path": "position.z",
      "value": 5
    },
    {
      "op": "call",
      "id": "camera",
      "method": "lookAt",
      "args": [0, 0, 0]
    },
    {
      "op": "new",
      "id": "light",
      "class": "DirectionalLight",
      "args": [16777215, 3]
    },
    {
      "op": "set",
      "id": "light",
      "path": "position.x",
      "value": 2
    },
    {
      "op": "set",
      "id": "light",
      "path": "position.y",
      "value": 3
    },
    {
      "op": "set",
      "id": "light",
      "path": "position.z",
      "value": 1
    },
    {
      "op": "new",
      "id": "sky",
      "class": "HemisphereLight",
      "args": [11189137, 2236962, 0.6]
    },
    {
      "op": "new",
      "id": "tex",
      "class": "DataTexture",
      "args": [
        {
          "array": [
            10854, 11878, 13926, 15360, 12902, 14336, 14746, 15360, 14541, 13517, 12902, 15360,
            15155, 14950, 11878, 15360
          ],
          "type": "Uint16Array"
        },
        4,
        1,
        1023,
        1016
      ]
    },
    {
      "op": "set",
      "id": "tex",
      "path": "wrapS",
      "value": 1001
    },
    {
      "op": "set",
      "id": "tex",
      "path": "wrapT",
      "value": 1001
    },
    {
      "op": "set",
      "id": "tex",
      "path": "magFilter",
      "value": 1006
    },
    {
      "op": "set",
      "id": "tex",
      "path": "minFilter",
      "value": 1006
    },
    {
      "op": "set",
      "id": "tex",
      "path": "needsUpdate",
      "value": true
    },
    {
      "op": "new",
      "id": "planeGeometry",
      "class": "PlaneGeometry",
      "args": [2.0, 1.6]
    },
    {
      "op": "new",
      "id": "planeMaterial",
      "class": "MeshStandardMaterial",
      "args": []
    },
    {
      "op": "set",
      "id": "planeMaterial",
      "path": "roughness",
      "value": 0.5
    },
    {
      "op": "set",
      "id": "planeMaterial",
      "path": "metalness",
      "value": 0
    },
    {
      "op": "set",
      "id": "planeMaterial",
      "path": "map",
      "value": {
        "ref": "tex"
      }
    },
    {
      "op": "new",
      "id": "plane",
      "class": "Mesh",
      "args": [
        {
          "ref": "planeGeometry"
        },
        {
          "ref": "planeMaterial"
        }
      ]
    },
    {
      "op": "set",
      "id": "plane",
      "path": "position.x",
      "value": -0.9
    },
    {
      "op": "call",
      "id": "scene",
      "method": "add",
      "args": [
        {
          "ref": "plane"
        }
      ]
    },
    {
      "op": "new",
      "id": "boxGeometry",
      "class": "BoxGeometry",
      "args": [0.9, 0.9, 0.9]
    },
    {
      "op": "new",
      "id": "boxMaterial",
      "class": "MeshBasicMaterial",
      "args": []
    },
    {
      "op": "set",
      "id": "boxMaterial",
      "path": "map",
      "value": {
        "ref": "tex"
      }
    },
    {
      "op": "new",
      "id": "box",
      "class": "Mesh",
      "args": [
        {
          "ref": "boxGeometry"
        },
        {
          "ref": "boxMaterial"
        }
      ]
    },
    {
      "op": "set",
      "id": "box",
      "path": "position.x",
      "value": 1.1
    },
    {
      "op": "call",
      "id": "scene",
      "method": "add",
      "args": [
        {
          "ref": "box"
        }
      ]
    },
    {
      "op": "call",
      "id": "scene",
      "method": "add",
      "args": [
        {
          "ref": "light"
        }
      ]
    },
    {
      "op": "call",
      "id": "scene",
      "method": "add",
      "args": [
        {
          "ref": "sky"
        }
      ]
    },
    {
      "op": "call",
      "id": "camera",
      "method": "updateProjectionMatrix",
      "args": []
    },
    {
      "op": "call",
      "id": "scene",
      "method": "updateMatrixWorld",
      "args": [true]
    }
  ],
  "observe": [
    {
      "id": "tex",
      "path": "colorSpace",
      "kind": "string"
    },
    {
      "id": "tex",
      "path": "wrapS",
      "kind": "number"
    },
    {
      "id": "tex",
      "path": "magFilter",
      "kind": "number"
    },
    {
      "id": "boxMaterial",
      "path": "type",
      "kind": "string"
    },
    {
      "id": "scene",
      "kind": "pixels",
      "metric": {
        "maxPixelMismatchRatio": 0.01,
        "maxPerceptualDeltaE": 0.02
      }
    }
  ]
}
