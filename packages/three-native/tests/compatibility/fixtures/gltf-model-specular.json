{
  "name": "gltf-model-specular",
  "adaptedFrom": "original — two UV spheres from one GLB: KHR_materials_ior (1000, Midway's value) and KHR_materials_specular with one RGBA PNG as both specularTexture (alpha) and specularColorTexture (sRGB rgb), beside a plain MeshStandardMaterial sphere, under a directional and a hemisphere light",
  "tolerance": {
    "abs": 0
  },
  "ops": [
    {
      "op": "new",
      "id": "scene",
      "class": "Scene",
      "args": []
    },
    {
      "op": "new",
      "id": "bg",
      "class": "Color",
      "args": [0.04, 0.04, 0.05]
    },
    {
      "op": "set",
      "id": "scene",
      "path": "background",
      "value": {
        "ref": "bg"
      }
    },
    {
      "op": "new",
      "id": "camera",
      "class": "PerspectiveCamera",
      "args": [40, 1.3333333333333333, 0.1, 100]
    },
    {
      "op": "set",
      "id": "camera",
      "path": "position.z",
      "value": 5.5
    },
    {
      "op": "new",
      "id": "sun",
      "class": "DirectionalLight",
      "args": [16777215, 3]
    },
    {
      "op": "set",
      "id": "sun",
      "path": "position.x",
      "value": 0.5
    },
    {
      "op": "set",
      "id": "sun",
      "path": "position.y",
      "value": 1
    },
    {
      "op": "set",
      "id": "sun",
      "path": "position.z",
      "value": 2
    },
    {
      "op": "new",
      "id": "sky",
      "class": "HemisphereLight",
      "args": [11189196, 3355443, 0.6]
    },
    {
      "op": "gltf",
      "id": "model",
      "file": "packages/three-native/tests/compatibility/fixtures/gltf-model-specular.glb"
    },
    {
      "op": "call",
      "id": "model",
      "method": "getObjectByName",
      "args": ["specular"],
      "result": "physical"
    },
    {
      "op": "set",
      "id": "model",
      "path": "rotation.y",
      "value": 0.9
    },
    {
      "op": "call",
      "id": "scene",
      "method": "add",
      "args": [
        {
          "ref": "model"
        }
      ]
    },
    {
      "op": "call",
      "id": "scene",
      "method": "add",
      "args": [
        {
          "ref": "sun"
        }
      ]
    },
    {
      "op": "call",
      "id": "scene",
      "method": "add",
      "args": [
        {
          "ref": "sky"
        }
      ]
    },
    {
      "op": "call",
      "id": "camera",
      "method": "updateProjectionMatrix",
      "args": []
    },
    {
      "op": "call",
      "id": "scene",
      "method": "updateMatrixWorld",
      "args": [true]
    }
  ],
  "observe": [
    {
      "id": "physical",
      "path": "name",
      "kind": "string"
    },
    {
      "id": "scene",
      "kind": "pixels",
      "metric": {
        "maxPixelMismatchRatio": 0.01,
        "maxPerceptualDeltaE": 0.02
      }
    }
  ],
  "render": {
    "scene": "scene",
    "camera": "camera",
    "width": 320,
    "height": 240,
    "toneMapping": "none",
    "toneMappingExposure": 1,
    "outputColorSpace": "srgb"
  }
}
