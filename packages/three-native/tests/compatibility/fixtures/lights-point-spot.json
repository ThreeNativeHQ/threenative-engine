{
  "name": "lights-point-spot",
  "adaptedFrom": "original \u2014 point and spot lights (distance cutoff, decay, cone and penumbra) beside a directional and a hemisphere light, on Standard, Lambert and Phong meshes",
  "tolerance": {
    "abs": 0
  },
  "ops": [
    {
      "op": "new",
      "id": "scene",
      "class": "Scene",
      "args": []
    },
    {
      "op": "new",
      "id": "background",
      "class": "Color",
      "args": [0.02, 0.02, 0.03]
    },
    {
      "op": "set",
      "id": "scene",
      "path": "background",
      "value": {
        "ref": "background"
      }
    },
    {
      "op": "new",
      "id": "camera",
      "class": "PerspectiveCamera",
      "args": [55, 1.3333333333333333, 0.1, 100]
    },
    {
      "op": "set",
      "id": "camera",
      "path": "position.x",
      "value": 0.6
    },
    {
      "op": "set",
      "id": "camera",
      "path": "position.y",
      "value": 2.6
    },
    {
      "op": "set",
      "id": "camera",
      "path": "position.z",
      "value": 5.2
    },
    {
      "op": "call",
      "id": "camera",
      "method": "lookAt",
      "args": [0, 0.3, 0]
    },
    {
      "op": "new",
      "id": "point",
      "class": "PointLight",
      "args": [16755302, 18, 0, 2]
    },
    {
      "op": "set",
      "id": "point",
      "path": "position.x",
      "value": -1.6
    },
    {
      "op": "set",
      "id": "point",
      "path": "position.y",
      "value": 1.4
    },
    {
      "op": "set",
      "id": "point",
      "path": "position.z",
      "value": 1.2
    },
    {
      "op": "new",
      "id": "spot",
      "class": "SpotLight",
      "args": [6728447, 45, 14, 0.42, 0.35, 2]
    },
    {
      "op": "set",
      "id": "spot",
      "path": "position.x",
      "value": 2.2
    },
    {
      "op": "set",
      "id": "spot",
      "path": "position.y",
      "value": 3.4
    },
    {
      "op": "set",
      "id": "spot",
      "path": "position.z",
      "value": 1.6
    },
    {
      "op": "new",
      "id": "fill",
      "class": "DirectionalLight",
      "args": [16777215, 0.4]
    },
    {
      "op": "set",
      "id": "fill",
      "path": "position.x",
      "value": -2
    },
    {
      "op": "set",
      "id": "fill",
      "path": "position.y",
      "value": 4
    },
    {
      "op": "set",
      "id": "fill",
      "path": "position.z",
      "value": -3
    },
    {
      "op": "new",
      "id": "sky",
      "class": "HemisphereLight",
      "args": [11189137, 2236962, 0.25]
    },
    {
      "op": "new",
      "id": "floorGeometry",
      "class": "PlaneGeometry",
      "args": [8, 8]
    },
    {
      "op": "new",
      "id": "floorMaterial",
      "class": "MeshLambertMaterial",
      "args": []
    },
    {
      "op": "set",
      "id": "floorMaterial",
      "path": "color.r",
      "value": 0.6
    },
    {
      "op": "set",
      "id": "floorMaterial",
      "path": "color.g",
      "value": 0.6
    },
    {
      "op": "set",
      "id": "floorMaterial",
      "path": "color.b",
      "value": 0.6
    },
    {
      "op": "new",
      "id": "floor",
      "class": "Mesh",
      "args": [
        {
          "ref": "floorGeometry"
        },
        {
          "ref": "floorMaterial"
        }
      ]
    },
    {
      "op": "set",
      "id": "floor",
      "path": "rotation.x",
      "value": -1.5707963267948966
    },
    {
      "op": "new",
      "id": "sphereGeometry",
      "class": "SphereGeometry",
      "args": [0.7, 32, 16]
    },
    {
      "op": "new",
      "id": "sphereMaterial",
      "class": "MeshStandardMaterial",
      "args": []
    },
    {
      "op": "set",
      "id": "sphereMaterial",
      "path": "roughness",
      "value": 0.4
    },
    {
      "op": "set",
      "id": "sphereMaterial",
      "path": "metalness",
      "value": 0.2
    },
    {
      "op": "new",
      "id": "sphere",
      "class": "Mesh",
      "args": [
        {
          "ref": "sphereGeometry"
        },
        {
          "ref": "sphereMaterial"
        }
      ]
    },
    {
      "op": "set",
      "id": "sphere",
      "path": "position.y",
      "value": 0.7
    },
    {
      "op": "set",
      "id": "sphere",
      "path": "position.x",
      "value": -0.4
    },
    {
      "op": "new",
      "id": "boxGeometry",
      "class": "BoxGeometry",
      "args": [0.8, 0.8, 0.8]
    },
    {
      "op": "new",
      "id": "boxMaterial",
      "class": "MeshPhongMaterial",
      "args": []
    },
    {
      "op": "set",
      "id": "boxMaterial",
      "path": "color.r",
      "value": 0.9
    },
    {
      "op": "set",
      "id": "boxMaterial",
      "path": "color.g",
      "value": 0.5
    },
    {
      "op": "set",
      "id": "boxMaterial",
      "path": "color.b",
      "value": 0.3
    },
    {
      "op": "set",
      "id": "boxMaterial",
      "path": "shininess",
      "value": 60
    },
    {
      "op": "new",
      "id": "box",
      "class": "Mesh",
      "args": [
        {
          "ref": "boxGeometry"
        },
        {
          "ref": "boxMaterial"
        }
      ]
    },
    {
      "op": "set",
      "id": "box",
      "path": "position.x",
      "value": 1.3
    },
    {
      "op": "set",
      "id": "box",
      "path": "position.y",
      "value": 0.4
    },
    {
      "op": "set",
      "id": "box",
      "path": "position.z",
      "value": 0.4
    },
    {
      "op": "set",
      "id": "box",
      "path": "rotation.y",
      "value": 0.6
    },
    {
      "op": "call",
      "id": "scene",
      "method": "add",
      "args": [
        {
          "ref": "floor"
        }
      ]
    },
    {
      "op": "call",
      "id": "scene",
      "method": "add",
      "args": [
        {
          "ref": "sphere"
        }
      ]
    },
    {
      "op": "call",
      "id": "scene",
      "method": "add",
      "args": [
        {
          "ref": "box"
        }
      ]
    },
    {
      "op": "call",
      "id": "scene",
      "method": "add",
      "args": [
        {
          "ref": "point"
        }
      ]
    },
    {
      "op": "call",
      "id": "scene",
      "method": "add",
      "args": [
        {
          "ref": "spot"
        }
      ]
    },
    {
      "op": "call",
      "id": "scene",
      "method": "add",
      "args": [
        {
          "ref": "fill"
        }
      ]
    },
    {
      "op": "call",
      "id": "scene",
      "method": "add",
      "args": [
        {
          "ref": "sky"
        }
      ]
    },
    {
      "op": "call",
      "id": "camera",
      "method": "updateProjectionMatrix",
      "args": []
    },
    {
      "op": "call",
      "id": "scene",
      "method": "updateMatrixWorld",
      "args": [true]
    }
  ],
  "observe": [
    {
      "id": "camera",
      "path": "projectionMatrix.elements",
      "kind": "numbers"
    },
    {
      "id": "point",
      "path": "matrixWorld.elements",
      "kind": "numbers"
    },
    {
      "id": "spot",
      "path": "matrixWorld.elements",
      "kind": "numbers"
    },
    {
      "id": "spot",
      "path": "angle",
      "kind": "number"
    },
    {
      "id": "scene",
      "kind": "pixels",
      "metric": {
        "maxPixelMismatchRatio": 0.01,
        "maxPerceptualDeltaE": 0.02
      }
    }
  ],
  "render": {
    "scene": "scene",
    "camera": "camera",
    "width": 320,
    "height": 240,
    "toneMapping": "aces",
    "toneMappingExposure": 1,
    "outputColorSpace": "srgb"
  }
}
