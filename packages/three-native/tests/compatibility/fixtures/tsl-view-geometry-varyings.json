{
  "name": "tsl-view-geometry-varyings",
  "adaptedFrom": "original \u2014 the fragment varyings three r185 builds for positionViewDirection (positionView.negate().toVarying()), normalWorldGeometry (normalViewGeometry back through the view matrix, i.e. modelNormalMatrix * normalLocal, as a varying) and depth (viewZToPerspectiveDepth(positionView.z)): a sphere coloured by the view direction, a rotated box and a non-uniformly scaled sphere (where only the inverse transpose keeps normals perpendicular) by their world geometry normals, a normal-mapped standard plane whose emissive is normalWorldGeometry (the map does not reach it), and a tilted plane shaded by depth",
  "tolerance": {
    "abs": 0
  },
  "observe": [
    {
      "id": "camera",
      "path": "projectionMatrix.elements",
      "kind": "numbers"
    },
    {
      "id": "scene",
      "kind": "pixels",
      "metric": {
        "maxPixelMismatchRatio": 0.01,
        "maxPerceptualDeltaE": 0.02
      }
    }
  ],
  "render": {
    "scene": "scene",
    "camera": "camera",
    "width": 320,
    "height": 240,
    "toneMapping": "aces",
    "toneMappingExposure": 1,
    "outputColorSpace": "srgb",
    "shadowMap": false
  },
  "ops": [
    {
      "op": "new",
      "id": "scene",
      "class": "Scene",
      "args": []
    },
    {
      "op": "new",
      "id": "background",
      "class": "Color",
      "args": [0.05, 0.06, 0.08]
    },
    {
      "op": "set",
      "id": "scene",
      "path": "background",
      "value": {
        "ref": "background"
      }
    },
    {
      "op": "new",
      "id": "camera",
      "class": "PerspectiveCamera",
      "args": [50, 1.3333333333333333, 0.1, 100]
    },
    {
      "op": "set",
      "id": "camera",
      "path": "position.z",
      "value": 5
    },
    {
      "op": "new",
      "id": "sphereGeometry",
      "class": "SphereGeometry",
      "args": [0.5, 24, 16]
    },
    {
      "op": "new",
      "id": "sphereMaterial",
      "class": "MeshBasicNodeMaterial",
      "args": []
    },
    {
      "op": "new",
      "id": "sphere",
      "class": "Mesh",
      "args": [
        {
          "ref": "sphereGeometry"
        },
        {
          "ref": "sphereMaterial"
        }
      ]
    },
    {
      "op": "set",
      "id": "sphere",
      "path": "name",
      "value": "sphere"
    },
    {
      "op": "set",
      "id": "sphere",
      "path": "position.x",
      "value": -1.1
    },
    {
      "op": "set",
      "id": "sphere",
      "path": "position.y",
      "value": 0.55
    },
    {
      "op": "call",
      "id": "scene",
      "method": "add",
      "args": [
        {
          "ref": "sphere"
        }
      ]
    },
    {
      "op": "new",
      "id": "boxGeometry",
      "class": "BoxGeometry",
      "args": [0.7, 0.7, 0.7]
    },
    {
      "op": "new",
      "id": "boxMaterial",
      "class": "MeshBasicNodeMaterial",
      "args": []
    },
    {
      "op": "new",
      "id": "box",
      "class": "Mesh",
      "args": [
        {
          "ref": "boxGeometry"
        },
        {
          "ref": "boxMaterial"
        }
      ]
    },
    {
      "op": "set",
      "id": "box",
      "path": "name",
      "value": "box"
    },
    {
      "op": "set",
      "id": "box",
      "path": "position.x",
      "value": 0
    },
    {
      "op": "set",
      "id": "box",
      "path": "position.y",
      "value": 0.55
    },
    {
      "op": "set",
      "id": "box",
      "path": "rotation.x",
      "value": 0.5
    },
    {
      "op": "set",
      "id": "box",
      "path": "rotation.y",
      "value": 0.7
    },
    {
      "op": "call",
      "id": "scene",
      "method": "add",
      "args": [
        {
          "ref": "box"
        }
      ]
    },
    {
      "op": "new",
      "id": "planeGeometry",
      "class": "PlaneGeometry",
      "args": [0.9, 0.9, 1, 1]
    },
    {
      "op": "new",
      "id": "mappedMaterial",
      "class": "MeshStandardNodeMaterial",
      "args": []
    },
    {
      "op": "set",
      "id": "mappedMaterial",
      "path": "color.r",
      "value": 0
    },
    {
      "op": "set",
      "id": "mappedMaterial",
      "path": "color.g",
      "value": 0
    },
    {
      "op": "set",
      "id": "mappedMaterial",
      "path": "color.b",
      "value": 0
    },
    {
      "op": "set",
      "id": "mappedMaterial",
      "path": "roughness",
      "value": 1
    },
    {
      "op": "set",
      "id": "mappedMaterial",
      "path": "metalness",
      "value": 0
    },
    {
      "op": "new",
      "id": "mapped",
      "class": "Mesh",
      "args": [
        {
          "ref": "planeGeometry"
        },
        {
          "ref": "mappedMaterial"
        }
      ]
    },
    {
      "op": "set",
      "id": "mapped",
      "path": "name",
      "value": "mapped"
    },
    {
      "op": "set",
      "id": "mapped",
      "path": "position.x",
      "value": 1.1
    },
    {
      "op": "set",
      "id": "mapped",
      "path": "position.y",
      "value": 0.55
    },
    {
      "op": "set",
      "id": "mapped",
      "path": "rotation.y",
      "value": 0.6
    },
    {
      "op": "call",
      "id": "scene",
      "method": "add",
      "args": [
        {
          "ref": "mapped"
        }
      ]
    },
    {
      "op": "new",
      "id": "depthGeometry",
      "class": "PlaneGeometry",
      "args": [3.2, 1.4, 1, 1]
    },
    {
      "op": "new",
      "id": "depthMaterial",
      "class": "MeshBasicNodeMaterial",
      "args": []
    },
    {
      "op": "new",
      "id": "depth",
      "class": "Mesh",
      "args": [
        {
          "ref": "depthGeometry"
        },
        {
          "ref": "depthMaterial"
        }
      ]
    },
    {
      "op": "set",
      "id": "depth",
      "path": "name",
      "value": "depth"
    },
    {
      "op": "set",
      "id": "depth",
      "path": "position.x",
      "value": 0
    },
    {
      "op": "set",
      "id": "depth",
      "path": "position.y",
      "value": -0.75
    },
    {
      "op": "set",
      "id": "depth",
      "path": "rotation.x",
      "value": -1.0
    },
    {
      "op": "call",
      "id": "scene",
      "method": "add",
      "args": [
        {
          "ref": "depth"
        }
      ]
    },
    {
      "op": "new",
      "id": "stretchedMaterial",
      "class": "MeshBasicNodeMaterial",
      "args": []
    },
    {
      "op": "new",
      "id": "stretched",
      "class": "Mesh",
      "args": [
        {
          "ref": "sphereGeometry"
        },
        {
          "ref": "stretchedMaterial"
        }
      ]
    },
    {
      "op": "set",
      "id": "stretched",
      "path": "name",
      "value": "stretched"
    },
    {
      "op": "set",
      "id": "stretched",
      "path": "position.x",
      "value": 1.25
    },
    {
      "op": "set",
      "id": "stretched",
      "path": "position.y",
      "value": -0.75
    },
    {
      "op": "set",
      "id": "stretched",
      "path": "rotation.y",
      "value": 0.7
    },
    {
      "op": "set",
      "id": "stretched",
      "path": "rotation.z",
      "value": 0.5
    },
    {
      "op": "set",
      "id": "stretched",
      "path": "scale.x",
      "value": 1.8
    },
    {
      "op": "set",
      "id": "stretched",
      "path": "scale.y",
      "value": 0.5
    },
    {
      "op": "call",
      "id": "scene",
      "method": "add",
      "args": [
        {
          "ref": "stretched"
        }
      ]
    },
    {
      "op": "tsl",
      "id": "scene",
      "program": "tsl-view-geometry-varyings"
    },
    {
      "op": "call",
      "id": "camera",
      "method": "updateProjectionMatrix",
      "args": []
    },
    {
      "op": "call",
      "id": "scene",
      "method": "updateMatrixWorld",
      "args": [true]
    }
  ]
}
