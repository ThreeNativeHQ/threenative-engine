{
  "name": "textures-data-3d",
  "adaptedFrom": "original \u2014 a 4x4x4 RGBA8 Data3DTexture (linear, wrapR RepeatWrapping) read by texture3D(volume, uvw) and texture3D(volume).sample(q) with W past 1 (three r185 Texture3DNode.js), as the rain template's clouds sample their noise volume",
  "tolerance": {
    "abs": 0
  },
  "ops": [
    {
      "op": "new",
      "id": "scene",
      "class": "Scene",
      "args": []
    },
    {
      "op": "new",
      "id": "background",
      "class": "Color",
      "args": [0.05, 0.06, 0.08]
    },
    {
      "op": "set",
      "id": "scene",
      "path": "background",
      "value": {
        "ref": "background"
      }
    },
    {
      "op": "new",
      "id": "camera",
      "class": "PerspectiveCamera",
      "args": [50, 1.3333333333333333, 0.1, 100]
    },
    {
      "op": "set",
      "id": "camera",
      "path": "position.z",
      "value": 5
    },
    {
      "op": "new",
      "id": "geometry",
      "class": "PlaneGeometry",
      "args": [3, 2, 1, 1]
    },
    {
      "op": "new",
      "id": "material",
      "class": "MeshBasicNodeMaterial",
      "args": []
    },
    {
      "op": "set",
      "id": "material",
      "path": "color.r",
      "value": 0.3
    },
    {
      "op": "set",
      "id": "material",
      "path": "color.g",
      "value": 0.6
    },
    {
      "op": "set",
      "id": "material",
      "path": "color.b",
      "value": 0.9
    },
    {
      "op": "tsl",
      "id": "material",
      "program": "texture-data-3d"
    },
    {
      "op": "new",
      "id": "mesh",
      "class": "Mesh",
      "args": [
        {
          "ref": "geometry"
        },
        {
          "ref": "material"
        }
      ]
    },
    {
      "op": "call",
      "id": "scene",
      "method": "add",
      "args": [
        {
          "ref": "mesh"
        }
      ]
    },
    {
      "op": "call",
      "id": "camera",
      "method": "updateProjectionMatrix",
      "args": []
    },
    {
      "op": "call",
      "id": "scene",
      "method": "updateMatrixWorld",
      "args": [true]
    }
  ],
  "observe": [
    {
      "id": "camera",
      "path": "projectionMatrix.elements",
      "kind": "numbers"
    },
    {
      "id": "scene",
      "kind": "pixels",
      "metric": {
        "maxPixelMismatchRatio": 0.01,
        "maxPerceptualDeltaE": 0.02
      }
    }
  ],
  "render": {
    "scene": "scene",
    "camera": "camera",
    "width": 320,
    "height": 240,
    "toneMapping": "aces",
    "toneMappingExposure": 1,
    "outputColorSpace": "srgb",
    "shadowMap": false
  }
}
