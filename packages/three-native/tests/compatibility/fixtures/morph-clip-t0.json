{
  "name": "morph-clip-t0",
  "adaptedFrom": "original \u2014 a glTF morph-influence clip (test-support/fixtures/morph-clip.glb, two targets, LINEAR weights) played by AnimationMixer and sampled at 0.4 s",
  "tolerance": {
    "abs": 0
  },
  "ops": [
    {
      "op": "new",
      "id": "scene",
      "class": "Scene",
      "args": []
    },
    {
      "op": "new",
      "id": "background",
      "class": "Color",
      "args": [0.05, 0.06, 0.08]
    },
    {
      "op": "set",
      "id": "scene",
      "path": "background",
      "value": {
        "ref": "background"
      }
    },
    {
      "op": "new",
      "id": "camera",
      "class": "PerspectiveCamera",
      "args": [40, 1.3333333333333333, 0.1, 100]
    },
    {
      "op": "set",
      "id": "camera",
      "path": "position.y",
      "value": 0.6
    },
    {
      "op": "set",
      "id": "camera",
      "path": "position.z",
      "value": 4
    },
    {
      "op": "call",
      "id": "camera",
      "method": "lookAt",
      "args": [0, 0, 0]
    },
    {
      "op": "new",
      "id": "sun",
      "class": "DirectionalLight",
      "args": [16777215, 2.5]
    },
    {
      "op": "set",
      "id": "sun",
      "path": "position.x",
      "value": 2
    },
    {
      "op": "set",
      "id": "sun",
      "path": "position.y",
      "value": 3
    },
    {
      "op": "set",
      "id": "sun",
      "path": "position.z",
      "value": 4
    },
    {
      "op": "new",
      "id": "sky",
      "class": "HemisphereLight",
      "args": [11189196, 3355443, 0.6]
    },
    {
      "op": "gltf",
      "id": "model",
      "file": "test-support/fixtures/morph-clip.glb",
      "clips": ["breathe"]
    },
    {
      "op": "new",
      "id": "mixer",
      "class": "AnimationMixer",
      "args": [
        {
          "ref": "model"
        }
      ]
    },
    {
      "op": "call",
      "id": "mixer",
      "method": "clipAction",
      "args": [
        {
          "ref": "breathe"
        }
      ],
      "result": "action"
    },
    {
      "op": "call",
      "id": "action",
      "method": "play",
      "args": []
    },
    {
      "op": "call",
      "id": "mixer",
      "method": "setTime",
      "args": [0.4]
    },
    {
      "op": "call",
      "id": "scene",
      "method": "add",
      "args": [
        {
          "ref": "model"
        }
      ]
    },
    {
      "op": "call",
      "id": "scene",
      "method": "add",
      "args": [
        {
          "ref": "sun"
        }
      ]
    },
    {
      "op": "call",
      "id": "scene",
      "method": "add",
      "args": [
        {
          "ref": "sky"
        }
      ]
    },
    {
      "op": "call",
      "id": "camera",
      "method": "updateProjectionMatrix",
      "args": []
    },
    {
      "op": "call",
      "id": "scene",
      "method": "updateMatrixWorld",
      "args": [true]
    }
  ],
  "observe": [
    {
      "id": "mixer",
      "path": "time",
      "kind": "number"
    },
    {
      "id": "breathe",
      "path": "duration",
      "kind": "number"
    },
    {
      "id": "scene",
      "kind": "pixels",
      "metric": {
        "maxPixelMismatchRatio": 0.01,
        "maxPerceptualDeltaE": 0.02
      }
    }
  ],
  "render": {
    "scene": "scene",
    "camera": "camera",
    "width": 320,
    "height": 240,
    "toneMapping": "aces",
    "toneMappingExposure": 1,
    "outputColorSpace": "srgb"
  }
}
