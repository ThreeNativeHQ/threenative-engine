{
  "name": "materials-standard-doubleside",
  "adaptedFrom": "original — an open-ended CylinderGeometry with a DoubleSide MeshStandardMaterial seen from above, so the far wall shows its inside: back faces lit with the normal turned to the viewer (three's negateOnBackSide), under the lit-render lights",
  "tolerance": {
    "abs": 0
  },
  "render": {
    "scene": "scene",
    "camera": "camera",
    "width": 320,
    "height": 240,
    "toneMapping": "aces",
    "toneMappingExposure": 1,
    "outputColorSpace": "srgb"
  },
  "ops": [
    {
      "op": "new",
      "id": "scene",
      "class": "Scene",
      "args": []
    },
    {
      "op": "new",
      "id": "background",
      "class": "Color",
      "args": [0.05, 0.06, 0.08]
    },
    {
      "op": "set",
      "id": "scene",
      "path": "background",
      "value": {
        "ref": "background"
      }
    },
    {
      "op": "new",
      "id": "camera",
      "class": "PerspectiveCamera",
      "args": [60, 1.3333333333333333, 0.1, 100]
    },
    {
      "op": "set",
      "id": "camera",
      "path": "position.y",
      "value": 1.4
    },
    {
      "op": "set",
      "id": "camera",
      "path": "position.z",
      "value": 3.2
    },
    {
      "op": "call",
      "id": "camera",
      "method": "lookAt",
      "args": [0, 0, 0]
    },
    {
      "op": "new",
      "id": "light",
      "class": "DirectionalLight",
      "args": [16777215, 3]
    },
    {
      "op": "set",
      "id": "light",
      "path": "position.x",
      "value": 2
    },
    {
      "op": "set",
      "id": "light",
      "path": "position.y",
      "value": 3
    },
    {
      "op": "set",
      "id": "light",
      "path": "position.z",
      "value": 1
    },
    {
      "op": "new",
      "id": "sky",
      "class": "HemisphereLight",
      "args": [11189137, 2236962, 0.6]
    },
    {
      "op": "new",
      "id": "geometry",
      "class": "CylinderGeometry",
      "args": [1, 1, 1.2, 32, 1, true]
    },
    {
      "op": "new",
      "id": "material",
      "class": "MeshStandardMaterial",
      "args": []
    },
    {
      "op": "set",
      "id": "material",
      "path": "color.r",
      "value": 0.8
    },
    {
      "op": "set",
      "id": "material",
      "path": "color.g",
      "value": 0.35
    },
    {
      "op": "set",
      "id": "material",
      "path": "color.b",
      "value": 0.2
    },
    {
      "op": "set",
      "id": "material",
      "path": "roughness",
      "value": 0.4
    },
    {
      "op": "set",
      "id": "material",
      "path": "metalness",
      "value": 0.1
    },
    {
      "op": "set",
      "id": "material",
      "path": "side",
      "value": 2
    },
    {
      "op": "new",
      "id": "mesh",
      "class": "Mesh",
      "args": [
        {
          "ref": "geometry"
        },
        {
          "ref": "material"
        }
      ]
    },
    {
      "op": "call",
      "id": "scene",
      "method": "add",
      "args": [
        {
          "ref": "mesh"
        }
      ]
    },
    {
      "op": "call",
      "id": "scene",
      "method": "add",
      "args": [
        {
          "ref": "light"
        }
      ]
    },
    {
      "op": "call",
      "id": "scene",
      "method": "add",
      "args": [
        {
          "ref": "sky"
        }
      ]
    },
    {
      "op": "call",
      "id": "camera",
      "method": "updateProjectionMatrix",
      "args": []
    },
    {
      "op": "call",
      "id": "scene",
      "method": "updateMatrixWorld",
      "args": [true]
    }
  ],
  "observe": [
    {
      "id": "camera",
      "path": "projectionMatrix.elements",
      "kind": "numbers"
    },
    {
      "id": "camera",
      "path": "matrixWorld.elements",
      "kind": "numbers"
    },
    {
      "id": "light",
      "path": "matrixWorld.elements",
      "kind": "numbers"
    },
    {
      "id": "mesh",
      "path": "matrixWorld.elements",
      "kind": "numbers"
    },
    {
      "id": "geometry",
      "path": "parameters",
      "kind": "json"
    },
    {
      "id": "material",
      "path": "type",
      "kind": "string"
    },
    {
      "id": "scene",
      "kind": "pixels",
      "metric": {
        "maxPixelMismatchRatio": 0.01,
        "maxPerceptualDeltaE": 0.02
      }
    }
  ]
}
