{
  "name": "material-normal-map",
  "adaptedFrom": "original \u2014 a MeshStandardMaterial with a tangent-space normalMap (an 8x8 data texture repeated 3x2, so the map's uv transform differs from the geometry's uv) and a non-uniform, y-flipped normalScale set as properties, lit by one directional light",
  "tolerance": {
    "abs": 0
  },
  "render": {
    "scene": "scene",
    "camera": "camera",
    "width": 300,
    "height": 200,
    "toneMapping": "none",
    "toneMappingExposure": 1,
    "outputColorSpace": "srgb"
  },
  "ops": [
    {
      "op": "new",
      "id": "scene",
      "class": "Scene",
      "args": []
    },
    {
      "op": "new",
      "id": "background",
      "class": "Color",
      "args": [0.05, 0.05, 0.08]
    },
    {
      "op": "set",
      "id": "scene",
      "path": "background",
      "value": {
        "ref": "background"
      }
    },
    {
      "op": "new",
      "id": "camera",
      "class": "PerspectiveCamera",
      "args": [45, 1.5, 0.1, 50]
    },
    {
      "op": "set",
      "id": "camera",
      "path": "position.z",
      "value": 3
    },
    {
      "op": "call",
      "id": "camera",
      "method": "updateMatrixWorld",
