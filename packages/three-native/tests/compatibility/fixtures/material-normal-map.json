    },
    {
      "op": "new",
      "id": "sun",
      "class": "DirectionalLight",
      "args": []
    },
    {
      "op": "set",
      "id": "sun",
      "path": "position.x",
      "value": 1.5
    },
    {
      "op": "set",
      "id": "sun",
      "path": "position.y",
      "value": 1
    },
    {
      "op": "set",
      "id": "sun",
      "path": "position.z",
      "value": 2
    },
    {
      "op": "set",
      "id": "sun",
      "path": "intensity",
      "value": 2.5
    },
    {
      "op": "call",
      "id": "scene",
      "method": "add",
      "args": [
        {
          "ref": "sun"
        }
      ]
    },
    {
