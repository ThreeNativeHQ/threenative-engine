{
  "name": "tsl-texture-object",
  "adaptedFrom": "original — TSL texture(textureObject, uv) on unnamed DataTextures, the way Midway's ocean and ripples read theirs: a positionNode displacing a tilted plane by texture(bumps, uv()).level(0).r and a colorNode of texture(ramp, uv()).rgb",
  "tolerance": {
    "abs": 0
  },
  "ops": [
    {
      "op": "new",
      "id": "scene",
      "class": "Scene",
      "args": []
    },
    {
      "op": "new",
      "id": "background",
      "class": "Color",
      "args": [0.05, 0.06, 0.08]
    },
    {
      "op": "set",
      "id": "scene",
      "path": "background",
      "value": {
        "ref": "background"
      }
    },
    {
      "op": "new",
      "id": "camera",
      "class": "PerspectiveCamera",
      "args": [50, 1.3333333333333333, 0.1, 100]
    },
    {
      "op": "set",
      "id": "camera",
      "path": "position.z",
      "value": 5
    },
    {
      "op": "new",
      "id": "geometry",
      "class": "PlaneGeometry",
      "args": [3, 2, 32, 16]
    },
    {
      "op": "new",
      "id": "material",
      "class": "MeshBasicNodeMaterial",
      "args": []
    },
    {
      "op": "tsl",
      "id": "material",
      "program": "tsl-texture-object"
    },
    {
      "op": "new",
      "id": "mesh",
      "class": "Mesh",
      "args": [
        {
          "ref": "geometry"
        },
        {
          "ref": "material"
        }
      ]
    },
    {
      "op": "set",
      "id": "mesh",
      "path": "rotation.x",
      "value": -0.9
    },
    {
      "op": "call",
      "id": "scene",
      "method": "add",
      "args": [
        {
          "ref": "mesh"
        }
      ]
    },
    {
      "op": "call",
      "id": "camera",
      "method": "updateProjectionMatrix",
      "args": []
    },
    {
      "op": "call",
      "id": "scene",
      "method": "updateMatrixWorld",
      "args": [true]
    }
  ],
  "observe": [
    {
      "id": "camera",
      "path": "projectionMatrix.elements",
      "kind": "numbers"
    },
    {
      "id": "scene",
      "kind": "pixels",
      "metric": {
        "maxPixelMismatchRatio": 0.01,
        "maxPerceptualDeltaE": 0.02
      }
    }
  ],
  "render": {
    "scene": "scene",
    "camera": "camera",
    "width": 320,
    "height": 240,
    "toneMapping": "aces",
    "toneMappingExposure": 1,
    "outputColorSpace": "srgb",
    "shadowMap": false
  }
}
