{
  "name": "tonemap-ramp-linear",
  "adaptedFrom": "original \u2014 an HDR ramp 0..8 in nine strips, tone mapped with LinearToneMapping: the curve as one row of pixels",
  "tolerance": {
    "abs": 0
  },
  "render": {
    "scene": "scene",
    "camera": "camera",
    "width": 288,
    "height": 64,
    "toneMapping": "linear",
    "toneMappingExposure": 1,
    "outputColorSpace": "srgb"
  },
  "ops": [
    {
      "op": "new",
      "id": "scene",
      "class": "Scene",
      "args": []
    },
    {
      "op": "new",
      "id": "black",
      "class": "Color",
      "args": [0, 0, 0]
    },
    {
      "op": "set",
      "id": "scene",
      "path": "background",
      "value": {
        "ref": "black"
      }
    },
    {
      "op": "new",
      "id": "camera",
      "class": "OrthographicCamera",
      "args": [-1, 1, 1, -1, 0.1, 10]
    },
    {
      "op": "set",
      "id": "camera",
      "path": "position.z",
      "value": 1
    },
    {
      "op": "new",
      "id": "quad",
      "class": "PlaneGeometry",
      "args": [0.2222222222222222, 2, 1, 1]
    },
    {
