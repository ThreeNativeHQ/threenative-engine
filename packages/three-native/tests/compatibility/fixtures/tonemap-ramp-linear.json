      "id": "tint0",
      "class": "MeshBasicMaterial",
      "args": []
    },
    {
      "op": "new",
      "id": "tone0",
      "class": "Color",
      "args": [0, 0, 0]
    },
    {
      "op": "set",
      "id": "tint0",
      "path": "color",
      "value": {
        "ref": "tone0"
      }
    },
    {
      "op": "new",
      "id": "strip0",
      "class": "Mesh",
      "args": [
        {
          "ref": "quad"
        },
        {
          "ref": "tint0"
        }
      ]
    },
    {
      "op": "set",
      "id": "strip0",
      "path": "position.x",
      "value": -0.8888888888888888
    },
    {
      "op": "call",
      "id": "scene",
      "method": "add",
      "args": [
        {
          "ref": "strip0"
        }
      ]
    },
    {
      "op": "new",
      "id": "tint1",
