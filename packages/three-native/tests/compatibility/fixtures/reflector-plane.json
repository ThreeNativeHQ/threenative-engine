{
  "name": "reflector-plane",
  "adaptedFrom": "original \u2014 reflector() (three r185 ReflectorNode.js): a floor that samples the scene mirrored in its plane, with a box and a sphere above it and a post through it that the oblique clip must cut",
  "tolerance": {
    "abs": 0
  },
  "ops": [
    {
      "op": "new",
      "id": "scene",
      "class": "Scene",
      "args": []
    },
    {
      "op": "new",
      "id": "background",
      "class": "Color",
      "args": [0.05, 0.06, 0.08]
    },
    {
      "op": "set",
      "id": "scene",
      "path": "background",
      "value": {
        "ref": "background"
      }
    },
    {
      "op": "new",
      "id": "camera",
      "class": "PerspectiveCamera",
      "args": [50, 1.3333333333333333, 0.1, 100]
    },
    {
      "op": "set",
      "id": "camera",
      "path": "position.y",
      "value": 2.2
    },
    {
      "op": "set",
      "id": "camera",
      "path": "position.z",
      "value": 6
    },
    {
      "op": "set",
      "id": "camera",
      "path": "rotation.x",
      "value": -0.3
    },
    {
      "op": "new",
      "id": "floorGeometry",
      "class": "PlaneGeometry",
      "args": [6, 6]
    },
    {
      "op": "new",
      "id": "floorMaterial",
      "class": "MeshBasicNodeMaterial",
      "args": []
    },
    {
      "op": "new",
      "id": "floor",
      "class": "Mesh",
      "args": [
        {
          "ref": "floorGeometry"
        },
        {
          "ref": "floorMaterial"
        }
      ]
    },
    {
      "op": "set",
      "id": "floor",
      "path": "name",
      "value": "mirror"
    },
    {
      "op": "set",
      "id": "floor",
      "path": "rotation.x",
      "value": -1.5707963267948966
    },
    {
      "op": "call",
      "id": "scene",
      "method": "add",
      "args": [
        {
          "ref": "floor"
        }
      ]
    },
    {
      "op": "new",
      "id": "boxGeometry",
      "class": "BoxGeometry",
      "args": [0.8, 0.8, 0.8]
    },
    {
      "op": "new",
      "id": "boxMaterial",
      "class": "MeshBasicMaterial",
      "args": []
    },
    {
      "op": "set",
      "id": "boxMaterial",
      "path": "color.r",
      "value": 0.9
    },
    {
      "op": "set",
      "id": "boxMaterial",
      "path": "color.g",
      "value": 0.2
    },
    {
      "op": "set",
      "id": "boxMaterial",
      "path": "color.b",
      "value": 0.1
    },
    {
      "op": "new",
      "id": "box",
      "class": "Mesh",
      "args": [
        {
          "ref": "boxGeometry"
        },
        {
          "ref": "boxMaterial"
        }
      ]
    },
    {
      "op": "set",
      "id": "box",
      "path": "position.x",
      "value": -0.9
    },
    {
      "op": "set",
      "id": "box",
      "path": "position.y",
      "value": 0.8
    },
    {
      "op": "set",
      "id": "box",
      "path": "rotation.y",
      "value": 0.6
    },
    {
      "op": "call",
      "id": "scene",
      "method": "add",
      "args": [
        {
          "ref": "box"
        }
      ]
    },
    {
      "op": "new",
      "id": "ballGeometry",
      "class": "SphereGeometry",
      "args": [0.5, 32, 16]
    },
    {
      "op": "new",
      "id": "ballMaterial",
      "class": "MeshBasicMaterial",
      "args": []
    },
    {
      "op": "set",
      "id": "ballMaterial",
      "path": "color.r",
      "value": 0.15
    },
    {
      "op": "set",
      "id": "ballMaterial",
      "path": "color.g",
      "value": 0.4
    },
    {
      "op": "set",
      "id": "ballMaterial",
      "path": "color.b",
      "value": 0.95
    },
    {
      "op": "new",
      "id": "ball",
      "class": "Mesh",
      "args": [
        {
          "ref": "ballGeometry"
        },
        {
          "ref": "ballMaterial"
        }
      ]
    },
    {
      "op": "set",
      "id": "ball",
      "path": "position.x",
      "value": 1.0
    },
    {
      "op": "set",
      "id": "ball",
      "path": "position.y",
      "value": 0.9
    },
    {
      "op": "set",
      "id": "ball",
      "path": "position.z",
      "value": -0.6
    },
    {
      "op": "call",
      "id": "scene",
      "method": "add",
      "args": [
        {
          "ref": "ball"
        }
      ]
    },
    {
      "op": "new",
      "id": "postGeometry",
      "class": "BoxGeometry",
      "args": [0.35, 1.6, 0.35]
    },
    {
      "op": "new",
      "id": "postMaterial",
      "class": "MeshBasicMaterial",
      "args": []
    },
    {
      "op": "set",
      "id": "postMaterial",
      "path": "color.r",
      "value": 0.2
    },
    {
      "op": "set",
      "id": "postMaterial",
      "path": "color.g",
      "value": 0.85
    },
    {
      "op": "set",
      "id": "postMaterial",
      "path": "color.b",
      "value": 0.3
    },
    {
      "op": "new",
      "id": "post",
      "class": "Mesh",
      "args": [
        {
          "ref": "postGeometry"
        },
        {
          "ref": "postMaterial"
        }
      ]
    },
    {
      "op": "set",
      "id": "post",
      "path": "position.z",
      "value": 1.2
    },
    {
      "op": "set",
      "id": "post",
      "path": "position.y",
      "value": -0.2
    },
    {
      "op": "call",
      "id": "scene",
      "method": "add",
      "args": [
        {
          "ref": "post"
        }
      ]
    },
    {
      "op": "call",
      "id": "camera",
      "method": "updateProjectionMatrix",
      "args": []
    },
    {
      "op": "call",
      "id": "scene",
      "method": "updateMatrixWorld",
      "args": [true]
    },
    {
      "op": "tsl",
      "id": "scene",
      "program": "reflector-plane"
    }
  ],
  "observe": [
    {
      "id": "camera",
      "path": "projectionMatrix.elements",
      "kind": "numbers"
    },
    {
      "id": "scene",
      "kind": "pixels",
      "metric": {
        "maxPixelMismatchRatio": 0.01,
        "maxPerceptualDeltaE": 0.02
      }
    }
  ],
  "render": {
    "scene": "scene",
    "camera": "camera",
    "width": 320,
    "height": 240,
    "toneMapping": "aces",
    "toneMappingExposure": 1,
    "outputColorSpace": "srgb",
    "shadowMap": false
  }
}
