{
  "name": "gltf-model-clearcoat",
  "adaptedFrom": "original \u2014 two rough dark dielectric spheres loaded by three's GLTFLoader and the native glTF loader with KHR_materials_clearcoat: one coated by factors only (clearcoat 1, clearcoatRoughness 0.05), one with clearcoatTexture and clearcoatRoughnessTexture over factors 0.9 and 1.0 (fully rough where the map does not sharpen it). Each becomes a MeshPhysicalMaterial whose coat highlight the plain base lacks",
  "tolerance": {
    "abs": 0
  },
  "ops": [
    {
      "op": "new",
      "id": "scene",
      "class": "Scene",
      "args": []
    },
    {
      "op": "new",
      "id": "background",
      "class": "Color",
      "args": [0.02, 0.02, 0.03]
    },
    {
      "op": "set",
      "id": "scene",
      "path": "background",
      "value": {
        "ref": "background"
      }
    },
    {
      "op": "new",
      "id": "camera",
      "class": "PerspectiveCamera",
      "args": [40, 1.3333333333333333, 0.1, 100]
    },
    {
      "op": "set",
      "id": "camera",
      "path": "position.y",
      "value": 0.6
    },
    {
      "op": "set",
      "id": "camera",
      "path": "position.z",
      "value": 5.5
    },
    {
      "op": "call",
      "id": "camera",
      "method": "lookAt",
      "args": [0, 0, 0]
    },
    {
      "op": "new",
      "id": "sun",
      "class": "DirectionalLight",
      "args": [16777215, 3]
    },
    {
      "op": "set",
      "id": "sun",
      "path": "position.x",
      "value": -1.5
    },
    {
      "op": "set",
      "id": "sun",
      "path": "position.y",
      "value": 2
    },
    {
      "op": "set",
      "id": "sun",
      "path": "position.z",
      "value": 4
    },
    {
      "op": "new",
      "id": "sky",
      "class": "HemisphereLight",
      "args": [11189196, 3355443, 0.4]
    },
    {
      "op": "gltf",
      "id": "model",
      "file": "packages/three-native/tests/compatibility/fixtures/gltf-model-clearcoat.glb"
    },
    {
      "op": "call",
      "id": "scene",
      "method": "add",
      "args": [
        {
          "ref": "model"
        }
      ]
    },
    {
      "op": "call",
      "id": "scene",
      "method": "add",
      "args": [
        {
          "ref": "sun"
        }
      ]
    },
    {
      "op": "call",
      "id": "scene",
      "method": "add",
      "args": [
        {
          "ref": "sky"
        }
      ]
    },
    {
      "op": "call",
      "id": "camera",
      "method": "updateProjectionMatrix",
      "args": []
    },
    {
      "op": "call",
      "id": "scene",
      "method": "updateMatrixWorld",
      "args": [true]
    }
  ],
  "observe": [
    {
      "id": "model",
      "path": "name",
      "kind": "string"
    },
    {
      "id": "scene",
      "kind": "pixels",
      "metric": {
        "maxPixelMismatchRatio": 0.01,
        "maxPerceptualDeltaE": 0.02
      }
    }
  ],
  "render": {
    "scene": "scene",
    "camera": "camera",
    "width": 320,
    "height": 240,
    "toneMapping": "aces",
    "toneMappingExposure": 1,
    "outputColorSpace": "srgb"
  }
}
