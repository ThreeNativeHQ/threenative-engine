{
  "name": "alias-method-returns-self",
  "adaptedFrom": "three@0.185.1 src/math/Vector3.js set()/normalize() and src/core/Object3D.js translateX()/add() mutate and return this — the handle a chaining call answers is the object itself, so repeated access through a retained result is one identity",
  "tolerance": {
    "abs": 0
  },
  "ops": [
    {
      "op": "new",
      "id": "v",
      "class": "Vector3",
      "args": [1, 2, 3]
    },
    {
      "op": "call",
      "id": "v",
      "method": "normalize",
      "args": [],
      "result": "n1"
    },
    {
      "op": "call",
      "id": "v",
      "method": "set",
      "args": [4, 5, 6],
      "result": "n2"
    },
    {
      "op": "set",
      "id": "v",
      "path": "x",
      "value": 9
    },
    {
      "op": "new",
      "id": "o",
      "class": "Object3D",
      "args": []
    },
    {
      "op": "call",
      "id": "o",
      "method": "translateX",
      "args": [2],
      "result": "r1"
    },
    {
      "op": "set",
      "id": "o",
      "path": "position.x",
      "value": 5
    },
    {
      "op": "call",
      "id": "o",
      "method": "rotateY",
      "args": [0.25],
      "result": "r2"
    }
  ],
  "observe": [
    {
      "id": "v",
      "path": "x",
      "kind": "number"
    },
    {
      "id": "n1",
      "path": "x",
      "kind": "number"
    },
    {
      "id": "n2",
      "path": "x",
      "kind": "number"
    },
    {
      "id": "n2",
      "path": "y",
      "kind": "number"
    },
    {
      "id": "o",
      "path": "position.x",
      "kind": "number"
    },
    {
      "id": "r1",
      "path": "position.x",
      "kind": "number"
    },
    {
      "id": "r2",
      "path": "position.x",
      "kind": "number"
    },
    {
      "id": "r2",
      "path": "quaternion.y",
      "kind": "number"
    }
  ]
}
