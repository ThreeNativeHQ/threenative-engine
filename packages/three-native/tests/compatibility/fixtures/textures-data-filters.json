  "observe": [
    {
      "id": "nearestTex",
      "path": "magFilter",
      "kind": "number"
    },
    {
      "id": "linearTex",
      "path": "magFilter",
      "kind": "number"
    },
    {
      "id": "mipTex",
      "path": "minFilter",
      "kind": "number"
    },
    {
      "id": "scene",
      "kind": "pixels",
      "metric": {
        "maxPixelMismatchRatio": 0.01,
        "maxPerceptualDeltaE": 0.02
      }
    }
  ]
}
