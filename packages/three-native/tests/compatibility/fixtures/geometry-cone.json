      "kind": "numbers"
    },
    {
      "id": "coarse",
      "path": "attributes.uv.array",
      "kind": "numbers"
    },
    {
      "id": "coarse",
      "path": "index.array",
      "kind": "numbers"
    },
    {
      "id": "coarse",
      "path": "groups",
      "kind": "json"
    },
    {
      "id": "coarse",
      "path": "parameters",
      "kind": "json"
    },
    {
      "id": "sweep",
      "path": "attributes.position.array",
      "kind": "numbers"
    },
    {
      "id": "sweep",
      "path": "attributes.normal.array",
      "kind": "numbers"
    },
    {
      "id": "sweep",
      "path": "attributes.uv.array",
      "kind": "numbers"
    },
    {
      "id": "sweep",
      "path": "index.array",
      "kind": "numbers"
    },
    {
      "id": "sweep",
      "path": "groups",
      "kind": "json"
    },
    {
      "id": "sweep",
      "path": "parameters",
      "kind": "json"
    },
    {
      "id": "open",
      "path": "attributes.position.array",
      "kind": "numbers"
    },
    {
