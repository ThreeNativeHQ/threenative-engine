{
  "name": "geometry-cone",
  "adaptedFrom": "three@0.185.1 src/geometries/ConeGeometry.js — coarse, partial-theta and open-ended cones",
  "tolerance": {
    "abs": 0
  },
  "ops": [
    {
      "op": "new",
      "id": "coarse",
      "class": "ConeGeometry",
      "args": [1, 2, 6, 1]
    },
    {
      "op": "new",
      "id": "sweep",
      "class": "ConeGeometry",
      "args": [2, 3, 5, 2, false, 0.5, 4]
    },
    {
      "op": "new",
      "id": "open",
      "class": "ConeGeometry",
      "args": [1.5, 2.5, 4, 1, true]
    }
  ],
  "observe": [
    {
      "id": "coarse",
      "path": "attributes.position.array",
