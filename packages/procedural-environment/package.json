{
  "name": "@threenative/procedural-environment",
  "version": "0.1.2",
  "license": "MIT",
  "description": "Optional, bake-first procedural nature GLBs for ThreeNative: trees and cover (Arbor), forest floor (forest-kit) and rocks, cliffs and mountains (Outcrop), found by biome.",
  "homepage": "https://github.com/ThreeNativeHQ/threenative#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ThreeNativeHQ/threenative-engine.git",
    "directory": "packages/procedural-environment"
  },
  "type": "module",
  "files": ["dist", "README.md", "LICENSES"],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup --config tsup.config.ts && publint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --root ../.. procedural-environment/__tests__ && publint --strict",
    "library": "tsup --config tsup.config.ts && vite --config library/vite.config.ts"
  },
  "dependencies": {
    "@napi-rs/canvas": "catalog:",
    "three": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "publint": "0.3.22",
    "tsup": "8.5.1",
    "typescript": "catalog:",
    "@types/three": "catalog:",
    "vite": "catalog:"
  }
}
