{
  "name": "threenative-blender-mcp",
  "version": "0.1.7",
  "license": "MIT",
  "description": "Drives an installed Blender headlessly so a downloaded .fbx becomes a GLB a ThreeNative game loads. Ships no Blender.",
  "keywords": ["threenative", "mcp", "model-context-protocol", "blender", "fbx", "gltf", "agents"],
  "homepage": "https://github.com/ThreeNativeHQ/threenative#readme",
  "bugs": {
    "url": "https://github.com/ThreeNativeHQ/threenative/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ThreeNativeHQ/threenative.git",
    "directory": "packages/blender-mcp"
  },
  "type": "module",
  "files": ["dist", "gpl", "README.md"],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./bridge": {
      "types": "./dist/bridge.d.ts",
      "import": "./dist/bridge.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "threenative-blender-mcp": "./dist/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup --config tsup.config.ts && publint",
    "typecheck": "tsc --noEmit",
    "test": "publint --strict"
  },
  "devDependencies": {
    "@gltf-transform/core": "catalog:",
    "publint": "0.3.22",
    "tsup": "8.5.1",
    "typescript": "catalog:",
    "@typescript/native": "catalog:"
  }
}
