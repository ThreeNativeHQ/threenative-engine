{
  "name": "@threenative/ui",
  "version": "0.3.5",
  "license": "MIT",
  "description": "React bindings for mounting a ThreeNative game and reading throttled state.",
  "keywords": ["threenative", "react", "tailwind", "hud", "three", "threejs", "gamedev"],
  "homepage": "https://github.com/ThreeNativeHQ/threenative#readme",
  "bugs": {
    "url": "https://github.com/ThreeNativeHQ/threenative/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ThreeNativeHQ/threenative.git",
    "directory": "packages/ui"
  },
  "type": "module",
  "files": ["dist", "README.md"],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "peerDependencies": {
    "@threenative/core": ">=0.3.5 <0.4.0",
    "react": ">=19.2.0 <20",
    "react-dom": ">=19.2.0 <20"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/react-test-renderer": "catalog:",
    "@threenative/core": "workspace:*",
    "publint": "0.3.22",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-test-renderer": "catalog:",
    "tsup": "8.5.1",
    "typescript": "catalog:",
    "@typescript/native": "catalog:"
  },
  "scripts": {
    "build": "tsup --config tsup.config.ts && publint",
    "typecheck": "tsc --noEmit",
    "test": "publint --strict"
  }
}
