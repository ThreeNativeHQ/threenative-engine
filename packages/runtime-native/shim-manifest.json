  "allowlist": [
    {
      "name": "EventTarget",
      "reason": "Worker mode (PRD-752) builds its page-side event surface from EventTarget only inside a browser DedicatedWorker; the native host never loads core/src/worker.ts."
    },
    {
      "name": "HTMLElement",
      "reason": "Framework uses HTMLElement only as a DOM-compatible TypeScript annotation; native mounting receives the host's compatibility object."
    },
    {
      "name": "MessageChannel",
      "reason": "Only the browser worker page (core/src/worker.ts, PRD-752) and the ui-bridge loopback behind the ?tnUiLoopback=1 URL flag open a MessageChannel; the native host has no URL search and no worker page."
    },
    {
      "name": "PerformanceObserver",
      "reason": "FrameBudget probes the browser-only Long Tasks API and reports it unavailable when native has no observer."
    },
    {
      "name": "ResizeObserver",
      "reason": "The renderer probes this optional browser API and falls back to the native window resize event when the host does not install it."
    },
    {
      "name": "queueMicrotask",
      "reason": "The worker audio proxy (core/src/worker-audio.ts, PRD-752) batches page messages with queueMicrotask inside a browser DedicatedWorker only; the native host plays audio directly."
    }
  ]
