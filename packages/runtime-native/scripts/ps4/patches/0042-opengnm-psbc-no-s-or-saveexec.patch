diff --color -ru a/src/amd/compiler/aco_lower_to_hw_instr.cpp b/src/amd/compiler/aco_lower_to_hw_instr.cpp
--- a/src/amd/compiler/aco_lower_to_hw_instr.cpp	2026-11-06 22:54:16.642117726 -0700
+++ b/src/amd/compiler/aco_lower_to_hw_instr.cpp	2026-11-06 23:04:13.991413326 -0700
@@ -3045,4 +3045,42 @@
    program->progress = CompilationProgress::after_lower_to_hw;
 }
 
+/* shadPS4 (v0.21.0 and main) translates s_and_saveexec_b64 and s_orn2_saveexec_b64 only, and aborts
+ * the pipeline on s_or_saveexec_b64 ("Unknown opcode S_OR_SAVEEXEC_B64"). psbc targets the PS4 alone,
+ * so each one becomes SALU ops shadPS4 translates, with the same results and the same SCC
+ * (exec != 0). It runs after lower_branches (which may delete an exec write nothing reads) and after
+ * disable_wqm (which emits one). */
+void
+lower_saveexec_for_shadps4(Program* program)
+{
+   for (Block& block : program->blocks) {
+      std::vector<aco_ptr<Instruction>> out;
+      out.reserve(block.instructions.size());
+      Builder bld(program, &out);
+      for (aco_ptr<Instruction>& instr : block.instructions) {
+         if (instr->opcode != aco_opcode::s_or_saveexec_b64) {
+            out.emplace_back(std::move(instr));
+            continue;
+         }
+         /* s_or_saveexec_b64 D, S0: D = exec; exec = S0 | exec; SCC = exec != 0. */
+         const PhysReg saved = instr->definitions[0].physReg();
+         const Definition scc_def = instr->definitions[1];
+         const Operand src = instr->operands[0];
+         if (src.isConstant() || src.physReg() != saved) {
+            assert(src.isConstant() || (src.physReg() + 1 != saved && saved + 1 != src.physReg()));
+            bld.sop1(aco_opcode::s_mov_b64, Definition(saved, s2), Operand(exec, s2));
+            bld.sop2(aco_opcode::s_or_b64, Definition(exec, s2), scc_def, src, Operand(exec, s2));
+         } else {
+            /* D is S0: swap D and exec with three xors, then or them into exec. */
+            const Operand d(saved, s2), e(exec, s2);
+            bld.sop2(aco_opcode::s_xor_b64, Definition(saved, s2), Definition(scc, s1), d, e);
+            bld.sop2(aco_opcode::s_xor_b64, Definition(exec, s2), Definition(scc, s1), e, d);
+            bld.sop2(aco_opcode::s_xor_b64, Definition(saved, s2), Definition(scc, s1), d, e);
+            bld.sop2(aco_opcode::s_or_b64, Definition(exec, s2), scc_def, e, d);
+         }
+      }
+      block.instructions = std::move(out);
+   }
+}
+
