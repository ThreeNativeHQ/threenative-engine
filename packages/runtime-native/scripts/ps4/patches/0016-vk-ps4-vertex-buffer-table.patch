+/* VkFormat -> the GNM data format the fetch shader's buffer_load_format_*
+ * reads this attribute with. */
+static GnmDataFormat vk_ps4_attribute_gnm_format(VkFormat format) {
+    switch (format) {
+    case VK_FORMAT_R32_SFLOAT:           return GNM_FMT_R32_FLOAT;
+    case VK_FORMAT_R32G32_SFLOAT:        return GNM_FMT_R32G32_FLOAT;
+    case VK_FORMAT_R32G32B32_SFLOAT:     return GNM_FMT_R32G32B32_FLOAT;
+    case VK_FORMAT_R32G32B32A32_SFLOAT:  return GNM_FMT_R32G32B32A32_FLOAT;
+    case VK_FORMAT_R16G16_SFLOAT:        return GNM_FMT_R16G16_FLOAT;
+    case VK_FORMAT_R16G16B16A16_SFLOAT:  return GNM_FMT_R16G16B16A16_FLOAT;
+    case VK_FORMAT_R8G8B8A8_UNORM:       return GNM_FMT_R8G8B8A8_UNORM;
+    case VK_FORMAT_R8G8B8A8_SRGB:        return GNM_FMT_R8G8B8A8_SRGB;
+    default: vk_ps4_log("vertex attribute format %d has no GNM mapping: reads as R32_FLOAT", (int)format); return GNM_FMT_R32_FLOAT;
+    }
+}
+
+/* The PTR_VERTEXBUFFERTABLE user data points at one V# per vertex input, in
+ * semantic order: sceGnmCreateFetchShader loads the V# for input i from
+ * dword offset i*4 of that table (opengnm src/shader.c, "s_load_dwordx4 ...,
+ * s[vbtableregister], semanticidx * 4"). So the table is indexed by attribute,
+ * each V# describing where that attribute's first element is, its binding's
+ * stride, its own data format and how many records follow. Building it per
+ * *binding* with a fixed GNM_FMT_R32_FLOAT (what CmdBindVertexBuffers used to
+ * do) described neither a vec3 colour at offset 8 nor its per-vertex stride,
+ * so the fetch shader read four R32 floats per attribute and the geometry
+ * arrived folded onto one point. */
+static void vk_ps4_build_vertex_buffer_table(VkPs4CommandBuffer *cmd) {
+    VkPs4Pipeline *pipe = cmd->current_pipeline;
+    const VkPipelineVertexInputStateCreateInfo *vi =
+        pipe ? &pipe->vertex_input_state : NULL;
+    uint32_t n = (vi && vi->pVertexAttributeDescriptions)
+                     ? vi->vertexAttributeDescriptionCount
+                     : 0;
+    /* The semantic table is ordered by location, not by the order the
+     * descriptions were declared in, so walk the attributes in location order.
+     * ponytail: selection sort over <=16 attributes; the GNM V# table the user
+     * data points at has VK_PS4_MAX_VERTEX_BINDINGS entries. */
+    bool used[VK_PS4_MAX_VERTEX_BINDINGS] = {false};
+
+    if (n > VK_PS4_MAX_VERTEX_BINDINGS) n = VK_PS4_MAX_VERTEX_BINDINGS;
+    memset(cmd->gnm_vertex_buffers, 0, sizeof(cmd->gnm_vertex_buffers));
+
+    for (uint32_t i = 0; i < n; i++) {
+        uint32_t pick = VK_PS4_MAX_VERTEX_BINDINGS;
+        for (uint32_t j = 0; j < n; j++) {
+            if (used[j]) continue;
+            if (pick == VK_PS4_MAX_VERTEX_BINDINGS ||
+                vi->pVertexAttributeDescriptions[j].location <
+                    vi->pVertexAttributeDescriptions[pick].location) {
+                pick = j;
+            }
+        }
+        if (pick == VK_PS4_MAX_VERTEX_BINDINGS) break;
+        used[pick] = true;
+
+        const VkVertexInputAttributeDescription *attrib =
+            &vi->pVertexAttributeDescriptions[pick];
+        uint32_t stride = 0;
+        if (vi->pVertexBindingDescriptions) {
+            for (uint32_t b = 0; b < vi->vertexBindingDescriptionCount; b++) {
+                if (vi->pVertexBindingDescriptions[b].binding == attrib->binding) {
+                    stride = vi->pVertexBindingDescriptions[b].stride;
+                    break;
+                }
+            }
+        }
+        if (attrib->binding >= VK_PS4_MAX_VERTEX_BINDINGS) continue;
+        VkPs4Buffer *vk_buf = (VkPs4Buffer *)cmd->vertex_buffers[attrib->binding].buffer;
+        if (!vk_buf || !vk_buf->memory || !vk_buf->memory->gnm_mem.mapped) continue;
+        if (attrib->offset > vk_buf->create_info.size) continue;
+
+        void *gpu_addr = (char *)vk_buf->memory->gnm_mem.mapped +
+                         vk_buf->memory_offset +
+                         cmd->vertex_buffers[attrib->binding].offset +
+                         attrib->offset;
+        const uint64_t remaining = vk_buf->create_info.size - attrib->offset;
+        const uint32_t num_records =
+            stride ? (uint32_t)(remaining / stride) : (uint32_t)remaining;
+
+        cmd->gnm_vertex_buffers[i] = sceGnmCreateVertexBuffer(
+            gpu_addr, vk_ps4_attribute_gnm_format(attrib->format), stride, num_records);
+    }
+}
+
+/* Emit the V# table pointer the fetch shader reads: it holds a pointer in its
+ * user SGPR pair (parsed by shadPS4 as ReadUdReg, i.e. dereferenced), so one
+ * SetPointerUserData covers every bound attribute. */
+static void vk_ps4_emit_vertex_buffer_table(VkPs4CommandBuffer *cmd) {
+    VkPs4Pipeline *pipe = cmd->current_pipeline;
+    if (!pipe || !pipe->has_vb_table_slot) return;
+    if (!cmd->vertex_binding_count && !pipe->vertex_input_state.vertexAttributeDescriptionCount)
+        return;
+    vk_ps4_build_vertex_buffer_table(cmd);
+    sceGnmDrawCmdSetPointerUserData(&cmd->gnm_cmd, GNM_STAGE_VS,
+                                    pipe->vertex_buffer_table_slot,
+                                    cmd->gnm_vertex_buffers);
+    cmd->vertex_buffers_dirty = false;
+}
