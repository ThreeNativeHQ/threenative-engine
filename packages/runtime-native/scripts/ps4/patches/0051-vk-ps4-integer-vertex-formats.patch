diff --git a/src/vk_ps4_command.c b/src/vk_ps4_command.c
--- a/src/vk_ps4_command.c
+++ b/src/vk_ps4_command.c
@@ -1761,7 +1761,15 @@
     case VK_FORMAT_R16G16B16A16_SFLOAT:  return GNM_FMT_R16G16B16A16_FLOAT;
     case VK_FORMAT_R8G8B8A8_UNORM:       return GNM_FMT_R8G8B8A8_UNORM;
     case VK_FORMAT_R8G8B8A8_SRGB:        return GNM_FMT_R8G8B8A8_SRGB;
-    default: vk_ps4_log("vertex attribute format %d has no GNM mapping: reads as R32_FLOAT", (int)format); return GNM_FMT_R32_FLOAT;
+    default: {
+        /* Integer attributes (skinIndex is Uint8x4 or Uint16x4: R8G8B8A8_UINT, R16G16B16A16_UINT) and the
+         * rest of the table come from the format table; read as R32_FLOAT they gave every vertex bone 0 and a
