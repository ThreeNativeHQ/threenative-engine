+/* Queue a flip of `index` behind every submitted command buffer.  A CPU sceVideoOutSubmitFlip shows the buffer
+ * at the next vblank even while the GPU still draws into it, so a frame showed with a black band over its top
+ * (PRD-784 gap sweep).  sceGnmSubmitAndFlipCommandBuffers flips when the GPU reaches this slice, and the CPU
+ * does not wait.  The slice ends in the 64-dword prepareFlip NOP the GNM driver patches into the flip. */
+int32_t vk_ps4_queue_submit_flip(VkPs4Device *dev, uint32_t vo_handle, uint32_t index, int64_t flip_arg) {
+    uint32_t *slot = vk_ps4_queue_next_epilogue(dev);
+    GnmCommandBuffer cmd = sceGnmCmdInit(slot, dev->gnm_epilogue_cmd_dwords * sizeof(uint32_t), NULL, NULL);
+    vk_ps4_queue_emit_retire(dev, &cmd, slot);
+    if ((uint32_t)(cmd.endptr - cmd.cmdptr) < 64) return -1;
+    memset(cmd.cmdptr, 0, 64 * sizeof(uint32_t));
+    cmd.cmdptr[0] = PKT3(PKT3_NOP, 62, 0); /* 0xc03e1000 */
+    cmd.cmdptr[1] = 0x68750777u;            /* prepareFlip */
+    cmd.cmdptr += 64;
+    uint32_t bytes = (uint32_t)(cmd.cmdptr - cmd.beginptr) * sizeof(uint32_t);
+    void *addr = slot;
+    int32_t result = sceGnmSubmitAndFlipCommandBuffers(1, &addr, &bytes, NULL, NULL, vo_handle, index,
+                                                       1 /* SCE_VIDEO_OUT_FLIP_MODE_VSYNC */, flip_arg);
+    if (result != 0) vk_ps4_queue_retired(dev)[(uint32_t)(slot - dev->gnm_epilogue_cmd) / dev->gnm_epilogue_cmd_dwords] =
+        dev->gnm_epilogue_ticket[(uint32_t)(slot - dev->gnm_epilogue_cmd) / dev->gnm_epilogue_cmd_dwords];
+    return result;
+}
+
