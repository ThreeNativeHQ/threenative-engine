vulkan-ps4: fence and semaphore labels come from a pooled slab, not one direct-memory block each

--- a/src/vk_ps4_sync.c
+++ b/src/vk_ps4_sync.c
@@ -15,6 +15,8 @@
 #include "vk_ps4_internal.h"
 
 #include <string.h>
+#include <pthread.h>
+#include <stdlib.h>
 #ifndef __ORBIS__
 #include <time.h>   /* clock_gettime, nanosleep — host only */
 #else
@@ -49,24 +51,59 @@
 #endif
 }
 
-/* Allocate a 4-byte GPU-visible label for fence/semaphore signaling.
- * Returns VK_SUCCESS and sets up mem->mapped as the label address. */
+/* GPU-visible labels for fence/semaphore signaling come from a shared pool:
+ * 64 KB Garlic blocks cut into 64-byte slots, handed out and returned through a
+ * free list.  One direct-memory block per label cost a GPU map and unmap for
+ * every sync object, and Dawn creates and destroys swapchain semaphores every
+ * frame: in shadPS4 each map/unmap re-syncs its GPU memory tracker (E5 made two
+ * of them per frame).  A label is only written by the GPU while its object is
+ * alive (Vulkan forbids destroying one in use), so a returned slot is idle.
+ * ponytail: blocks are never released; the pool peaks at the most labels live
+ * at once (1024 per block). */
+#define VK_PS4_LABEL_SLOT  64u
+#define VK_PS4_LABEL_BLOCK (64u * 1024u)
+static pthread_mutex_t g_label_lock = PTHREAD_MUTEX_INITIALIZER;
+static void **g_label_free;
+static uint32_t g_label_free_count;
+static uint32_t g_label_free_cap;
+
 static VkResult vk_ps4_sync_alloc_label(VkPs4Device *dev, GnmDirectMemory *mem) {
-    (void)dev; /* dev reserved for future per-device memory type selection */
-    const uint64_t alignment = 64 * 1024; /* 64KB Garlic alignment */
-    GnmError err = sceGnmDirectMemoryAllocate(
-        mem, 4, alignment,
-        GNM_DIRECT_MEMORY_TYPE_WC_GARLIC, GNM_PROT_CPU_GPU_RW
-    );
-    if (err != GNM_ERROR_OK) {
-        return VK_ERROR_OUT_OF_HOST_MEMORY;
+    (void)dev;
+    memset(mem, 0, sizeof(*mem));
+    pthread_mutex_lock(&g_label_lock);
+    if (g_label_free_count == 0) {
+        const uint32_t slots = VK_PS4_LABEL_BLOCK / VK_PS4_LABEL_SLOT;
+        if (g_label_free_cap < slots) {
+            void **grown = realloc(g_label_free, (size_t)(g_label_free_cap + slots) * sizeof(void *));
+            if (!grown) {
+                pthread_mutex_unlock(&g_label_lock);
+                return VK_ERROR_OUT_OF_HOST_MEMORY;
+            }
+            g_label_free = grown;
+            g_label_free_cap += slots;
+        }
+        GnmDirectMemory block;
+        if (sceGnmDirectMemoryAllocate(&block, VK_PS4_LABEL_BLOCK, VK_PS4_LABEL_BLOCK,
+                                       GNM_DIRECT_MEMORY_TYPE_WC_GARLIC,
+                                       GNM_PROT_CPU_GPU_RW) != GNM_ERROR_OK) {
+            pthread_mutex_unlock(&g_label_lock);
+            return VK_ERROR_OUT_OF_HOST_MEMORY;
+        }
+        for (uint32_t i = 0; i < slots; i++)
+            g_label_free[g_label_free_count++] = (uint8_t *)block.mapped + (size_t)i * VK_PS4_LABEL_SLOT;
     }
+    mem->mapped = g_label_free[--g_label_free_count];
+    pthread_mutex_unlock(&g_label_lock);
+    mem->size = VK_PS4_LABEL_SLOT;
     return VK_SUCCESS;
 }
 
 static void vk_ps4_sync_free_label(GnmDirectMemory *mem) {
-    if (mem->allocated) {
-        sceGnmDirectMemoryRelease(mem);
+    if (mem->mapped) {
+        pthread_mutex_lock(&g_label_lock);
+        /* cap >= every slot ever cut, so the push always fits */
+        g_label_free[g_label_free_count++] = mem->mapped;
+        pthread_mutex_unlock(&g_label_lock);
     }
     memset(mem, 0, sizeof(*mem));
 }
