+/* One consumed dynamic offset, keyed by the (set, binding, element) it belongs
+ * to: Vulkan consumes them set-major, binding ascending, one per dynamic
+ * descriptor, and both a VS/PS stage loop and the set composition read them. */
+struct vk_ps4_dyn_offset {
+    uint32_t set_idx;
+    uint32_t binding;
+    uint32_t array_elem;
+    uint32_t offset;
+};
+
+static uint32_t dyn_offset_for(const struct vk_ps4_dyn_offset *map, uint32_t count,
+                               uint32_t set_idx, uint32_t binding, uint32_t elem) {
+    for (uint32_t i = 0; i < count; i++) {
+        if (map[i].set_idx == set_idx && map[i].binding == binding &&
+            map[i].array_elem == elem)
+            return map[i].offset;
+    }
+    return 0;
+}
+
+/* Fill a set's descriptor memory: binding N's descriptors at
+ * N * VK_PS4_DESCRIPTOR_SET_STRIDE, array elements back to back, the layout
+ * psbc reports for the set. radv lowers every descriptor access to an SMEM read
+ * at set_base + binding offset, so the set's own GNM descriptors (16 bytes for a
+ * V#/S#, 32 for a T#, 48 for an image+sampler with the sampler at +32) copied
+ * there are exactly the bytes the shader loads -- the field layouts are the
+ * hardware ones on both sides. Dynamic offsets shift a buffer's base address in
+ * the copy, leaving the binding's own descriptor untouched. */
+static void compose_set_memory(VkPs4DescriptorSet *set, uint32_t set_index,
+                               const struct vk_ps4_dyn_offset *dyn, uint32_t dyn_count) {
+    if (!set || !set->memory) return;
+
+    memset(set->memory, 0, set->memory_size);
+
+    for (uint32_t bi = 0; bi < set->binding_count; bi++) {
+        VkPs4DescriptorBinding *b = &set->bindings[bi];
+        if (b->count == 0) continue;
+
+        uint8_t *slot = (uint8_t *)set->memory +
+                        (size_t)b->binding_number * VK_PS4_DESCRIPTOR_SET_STRIDE;
+
+        switch (b->type) {
+        case VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER:
+        case VK_DESCRIPTOR_TYPE_STORAGE_BUFFER:
+        case VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER_DYNAMIC:
+        case VK_DESCRIPTOR_TYPE_STORAGE_BUFFER_DYNAMIC:
+        case VK_DESCRIPTOR_TYPE_UNIFORM_TEXEL_BUFFER:
+        case VK_DESCRIPTOR_TYPE_STORAGE_TEXEL_BUFFER:
+            if (!b->buffers) break;
+            for (uint32_t e = 0; e < b->count; e++) {
+                GnmBuffer *dst = (GnmBuffer *)(slot + e * sizeof(GnmBuffer));
+                *dst = b->buffers[e];
+                const uint32_t off =
+                    dyn_offset_for(dyn, dyn_count, set_index, b->binding_number, e);
+                if (off) {
+                    char *base = (char *)sceGnmBufGetBaseAddress(dst);
+                    sceGnmBufSetBaseAddress(dst, base + off);
+                }
+            }
+            break;
+        case VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE:
+        case VK_DESCRIPTOR_TYPE_STORAGE_IMAGE:
+        case VK_DESCRIPTOR_TYPE_INPUT_ATTACHMENT:
+            if (b->textures)
+                memcpy(slot, b->textures, b->count * sizeof(GnmTexture));
+            break;
+        case VK_DESCRIPTOR_TYPE_SAMPLER:
+            if (b->samplers)
+                memcpy(slot, b->samplers, b->count * sizeof(GnmSampler));
+            break;
+        case VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER:
+            for (uint32_t e = 0; e < b->count; e++) {
+                uint8_t *elem = slot + e * (sizeof(GnmTexture) + sizeof(GnmSampler));
+                if (b->textures) memcpy(elem, &b->textures[e], sizeof(GnmTexture));
+                if (b->samplers)
+                    memcpy(elem + sizeof(GnmTexture), &b->samplers[e], sizeof(GnmSampler));
+            }
+            break;
+        default:
+            break;
+        }
+    }
+}
