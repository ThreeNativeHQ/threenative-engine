 	setcontextregister(cmd, R_028238_CB_TARGET_MASK, mask);
 }
 
+void sceGnmDrawCmdSetCbControl(
+    GnmCommandBuffer* cmd, uint32_t mode, uint32_t rop3
+) {
+	if (mode > 7 || rop3 > 0xFF) {
+		sceGnmWriteMsgf(
+		    GNM_MSGSEV_ERR,
+		    "SetCbControl: mode %u / rop3 0x%x is out of range",
+		    mode, rop3
+		);
+		return;
+	}
+
+	const uint32_t cmddwords = 2 + 1;
+	if (!cmdcanfit(cmd, cmddwords)) {
+		return;
+	}
+
+	setcontextregister(
+	    cmd, R_028808_CB_COLOR_CONTROL,
+	    S_028808_MODE(mode) | S_028808_ROP3(rop3)
+	);
+}
