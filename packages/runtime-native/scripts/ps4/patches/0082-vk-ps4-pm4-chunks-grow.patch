 #define VK_PS4_CMD_BUFFER_SIZE (256 * 1024)  /* 256KB default PM4 buffer */
+#define VK_PS4_CMD_CHUNK_DWORDS (1024 * 1024 / 4)  /* each chained chunk: 1 MB, under the 4 MB IB limit */
+
+/* GNM's grow callback (cmdcanfit): the default refused, and every packet after a full 256 KB buffer was
+ * dropped without a word. A frame of virtual-shadow pages filled it: the pages it dropped kept the atlas's
+ * zeroed depth, which reads as full shadow, and a page is not drawn again until it is invalidated, so most
+ * of the scene stayed black (PRD-784 P5-16). The buffer now closes and continues in a new chunk. */
+static bool vk_ps4_cmd_grow(GnmCommandBuffer *gc, uint32_t need, void *userdata) {
+    VkPs4CommandBuffer *cmd = (VkPs4CommandBuffer *)userdata;
+    const VkAllocationCallbacks *alloc = &cmd->device->allocator;
+    if (need > VK_PS4_CMD_CHUNK_DWORDS) {
+        vk_ps4_log("PM4: a %u-dword packet is larger than a chunk; dropped", need);
+        return false;
+    }
+    const uint32_t used = (uint32_t)(gc->cmdptr - gc->beginptr);
+    if (cmd->pm4_chunk_count == 0) cmd->pm4_head_used = used;
+    else cmd->pm4_chunk_used[cmd->pm4_chunk_count - 1] = used;
+    if (cmd->pm4_chunk_count == cmd->pm4_chunk_alloc) {
+        const uint32_t n = cmd->pm4_chunk_alloc + 1;
+        uint32_t **chunks = vk_ps4_alloc_zero(alloc, n * sizeof(*chunks), 16);
+        uint32_t *sizes = vk_ps4_alloc_zero(alloc, n * sizeof(*sizes), 16);
+        uint32_t *chunk = vk_ps4_alloc_zero(alloc, VK_PS4_CMD_CHUNK_DWORDS * sizeof(uint32_t), 256);
+        if (!chunks || !sizes || !chunk) {
+            vk_ps4_free(alloc, chunks); vk_ps4_free(alloc, sizes); vk_ps4_free(alloc, chunk);
+            vk_ps4_log("PM4: out of memory for a %u-byte chunk; packets dropped", VK_PS4_CMD_CHUNK_DWORDS * 4);
+            return false;
+        }
+        if (cmd->pm4_chunk_alloc) {
+            memcpy(chunks, cmd->pm4_chunks, cmd->pm4_chunk_alloc * sizeof(*chunks));
+            memcpy(sizes, cmd->pm4_chunk_used, cmd->pm4_chunk_alloc * sizeof(*sizes));
+            vk_ps4_free(alloc, cmd->pm4_chunks);
+            vk_ps4_free(alloc, cmd->pm4_chunk_used);
+        }
+        chunks[cmd->pm4_chunk_alloc] = chunk;
+        cmd->pm4_chunks = chunks;
+        cmd->pm4_chunk_used = sizes;
+        cmd->pm4_chunk_alloc = n;
+    }
+    uint32_t *next = cmd->pm4_chunks[cmd->pm4_chunk_count++];
+    gc->beginptr = gc->cmdptr = next;
+    gc->endptr = next + VK_PS4_CMD_CHUNK_DWORDS;
+    gc->sizedwords = VK_PS4_CMD_CHUNK_DWORDS;
+    return true;
+}
+static GnmCommandCallbackFunc vk_ps4_cmd_grow_fn = vk_ps4_cmd_grow;
+
+/* Room for n dwords, growing into a new chunk when the current one is full. */
+static bool vk_ps4_cmd_reserve(GnmCommandBuffer *gc, uint32_t n) {
+    if ((uint32_t)(gc->endptr - gc->cmdptr) >= n) return true;
+    return gc->callback.func && gc->callback.func(gc, n, gc->callback.userdata) &&
+           (uint32_t)(gc->endptr - gc->cmdptr) >= n;
+}
+
+/* Free the PM4 storage of a command buffer: the head buffer and every chunk. */
+static void vk_ps4_cmd_free_pm4(const VkAllocationCallbacks *alloc, VkPs4CommandBuffer *cmd) {
+    for (uint32_t i = 0; i < cmd->pm4_chunk_alloc; i++) vk_ps4_free(alloc, cmd->pm4_chunks[i]);
+    vk_ps4_free(alloc, cmd->pm4_chunks);
+    vk_ps4_free(alloc, cmd->pm4_chunk_used);
+    cmd->pm4_chunks = NULL; cmd->pm4_chunk_used = NULL;
+    cmd->pm4_chunk_alloc = cmd->pm4_chunk_count = 0;
+    vk_ps4_cmd_free_pm4(alloc, cmd);
+}
 
