+                                      const char *entrypoint,
                                       const VkAllocationCallbacks *alloc,
                                       void **out_binary, size_t *out_binary_size,
                                       GnmShaderMetadata *out_metadata) {
@@ -163,7 +164,12 @@
     /* Set up compile options (zero-init to avoid stack garbage) */
     PsbcCompileOptions opts = {0};
     opts.target = PSBC_TARGET_PS4_BASE;
-    opts.entrypoint = "main";
+    /* The entry point is the one the pipeline stage named, not a fixed "main": a SPIR-V module
+     * may name its entry point anything (Dawn renames every WebGPU entry point to
+     * "dawn_entry_point"), and libpsbc's SPIR-V reader searches this module for that exact name —
+     * a mismatch fails the whole pipeline with "Entry point not found for vertex shader \"main\"".
+     * A stage that names none keeps the Vulkan-valid default "main". */
+    opts.entrypoint = (entrypoint && entrypoint[0]) ? entrypoint : "main";
     opts.optimise = true;
 
     /* Determine stage */
