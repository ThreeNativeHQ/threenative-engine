+/* === MSAA resolve: the GCN colour-buffer ROP ===============================
+ * A multisampled colour target is resolved by the CB hardware, not by a
+ * shader copy. CB_COLOR_CONTROL.MODE = CB_RESOLVE turns the next draw into a
+ * resolve: ROP3 0xCC (copy) moves CB_COLOR0's samples into CB_COLOR1, and
+ * CB_TARGET_MASK names which RT slots take part. That is the register recipe
+ * RADV uses on GFX7 (radv_meta_resolve.c hw path), and the one shadPS4
+ * executes at draw time: vk_rasterizer.cpp FilterDraw runs
+ * `if (regs.color_control.mode == Resolve) Resolve();` before the draw, and
+ * Resolve() looks both images up as color_buffers[0] / color_buffers[1] with
+ * last_cb_extent[0] / [1], then copies the first into the second.
+ *
+ * Until this existed, pResolveAttachments was stored
+ * (vk_ps4_render_pass.c:102) and never acted on, so a Dawn pass that renders
+ * into a 4x target and names a 1x resolveTarget left the resolve target black
+ * and every later pass sampled black.
+ *
+ * The draw is only the trigger: shadPS4 filters it out before any pipeline or
+ * shader is built, so the clear PS the draw-based clear already uses serves
+ * here and its UBO is never read. Everything clobbered (RT slots, mask, blend,
+ * scissor, viewport, shaders, CB_COLOR_CONTROL) is restored by the caller with
+ * vk_ps4_bind_subpass_targets + vk_ps4_rebind_pipeline_state, which is the
+ * contract the draw-based clear already relies on. */
+static void vk_ps4_resolve_color_draw(VkPs4CommandBuffer *cmd,
+                                     VkPs4Image *src, VkPs4Image *dst) {
+    VkPs4Device *dev = cmd->device;
+    if (!dev || !src || !dst) return;
+
+    /* CB_COLOR0 = the multisampled source, CB_COLOR1 = the 1x destination,
+     * CB_TARGET_MASK = RT0|RT1 (4 bits per slot). */
+    sceGnmDrawCmdSetRenderTarget(&cmd->gnm_cmd, 0, &src->gnm_rt);
+    sceGnmDrawCmdSetRenderTarget(&cmd->gnm_cmd, 1, &dst->gnm_rt);
+    sceGnmDrawCmdSetRenderTargetMask(&cmd->gnm_cmd, 0x000000FFu);
+
+    sceGnmDrawCmdSetCbControl(&cmd->gnm_cmd, V_028808_CB_RESOLVE, V_028808_ROP3_COPY);
+    vk_ps4_emit_aa_config(cmd, (uint32_t)src->create_info.samples);
+
+    /* A resolve is a ROP, not a shaded draw: no depth, no blending. */
+    {
+        GnmDepthStencilControl ds_off;
+        memset(&ds_off, 0, sizeof(ds_off));
+        sceGnmDrawCmdSetDepthStencilControl(&cmd->gnm_cmd, &ds_off);
+    }
+    {
+        GnmBlendControl no_blend;
+        memset(&no_blend, 0, sizeof(no_blend));
+        sceGnmDrawCmdSetBlendControl(&cmd->gnm_cmd, 0, &no_blend);
+        sceGnmDrawCmdSetBlendControl(&cmd->gnm_cmd, 1, &no_blend);
+    }
+
+    /* Cover the destination: a fullscreen triangle through the same viewport
+     * mapping the draw-based clear uses. */
+    sceGnmDrawCmdSetScreenScissor(&cmd->gnm_cmd, 0, 0,
+        dst->create_info.extent.width, dst->create_info.extent.height);
+    {
+        GnmSetViewportInfo vp;
+        memset(&vp, 0, sizeof(vp));
+        vp.dmin = 0.0f;
+        vp.dmax = 1.0f;
+        vp.scale[0] = dst->create_info.extent.width * 0.5f;
+        vp.scale[1] = dst->create_info.extent.height * 0.5f;
+        vp.scale[2] = 0.5f;
+        vp.offset[0] = vp.scale[0];
+        vp.offset[1] = vp.scale[1];
+        vp.offset[2] = 0.5f;
+        sceGnmDrawCmdSetViewport(&cmd->gnm_cmd, 0, &vp);
+    }
+
+    sceGnmDrawCmdSetPsShader(&cmd->gnm_cmd, &dev->clear_ps_regs);
+    sceGnmDrawCmdSetEmbeddedVsShader(&cmd->gnm_cmd, GNM_EMBEDDED_VSH_FULLSCREEN, 0);
+    sceGnmDrawCmdSetPrimitiveType(&cmd->gnm_cmd, GNM_PT_TRILIST);
+    sceGnmDrawCmdSetNumInstances(&cmd->gnm_cmd, 1);
+    sceGnmDrawCmdDrawIndexAuto(&cmd->gnm_cmd, 3);
+
+    /* Back to ordinary colour writes before anything else runs. */
+    sceGnmDrawCmdSetCbControl(&cmd->gnm_cmd, V_028808_CB_NORMAL, V_028808_ROP3_COPY);
+}
