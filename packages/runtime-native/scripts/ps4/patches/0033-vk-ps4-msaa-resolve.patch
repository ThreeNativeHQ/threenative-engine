+/* Resolve every colour attachment of the current subpass that names a resolve
+ * target (`pResolveAttachments`, what Dawn's resolveTarget becomes) and is
+ * multisampled. Called while the subpass is still open, so its targets are the
+ * ones bound. shadPS4 resolves the whole surface the descriptors name, so the
+ * whole image is what moves; a sub-rect resolve would need a scissored path
+ * shadPS4 does not implement. */
+static void vk_ps4_resolve_subpass(VkPs4CommandBuffer *cmd) {
+    VkPs4RenderPass *rp = cmd->current_render_pass.pass;
+    VkPs4Framebuffer *fb = cmd->current_render_pass.framebuffer;
+    if (!rp || !fb) return;
+    uint32_t sub = cmd->current_render_pass.current_subpass;
+    if (sub >= rp->subpass_count) return;
+    const VkSubpassDescription *sp = &rp->subpasses[sub];
+    if (!sp->pColorAttachments || !sp->pResolveAttachments) return;
+
+    bool resolved = false;
+    for (uint32_t j = 0; j < sp->colorAttachmentCount; j++) {
+        uint32_t src_idx = sp->pColorAttachments[j].attachment;
+        uint32_t dst_idx = sp->pResolveAttachments[j].attachment;
+        if (src_idx == VK_ATTACHMENT_UNUSED || dst_idx == VK_ATTACHMENT_UNUSED) continue;
+        VkPs4ImageView *src_view = vk_ps4_get_attachment_view(cmd, src_idx);
+        VkPs4ImageView *dst_view = vk_ps4_get_attachment_view(cmd, dst_idx);
+        if (!src_view || !dst_view || !src_view->image || !dst_view->image) continue;
+        if (src_view->image->create_info.samples == VK_SAMPLE_COUNT_1_BIT) continue;
+        vk_ps4_resolve_color_draw(cmd, src_view->image, dst_view->image);
+        resolved = true;
+    }
+    if (!resolved) return;
+
+    /* The resolve left CB_COLOR0/1 pointing at the resolve pair. Re-binding the
+     * subpass's own targets is what puts slot 0 back; slot 1 keeps the last
+     * descriptor it was given, and the next pipeline's CB_TARGET_MASK decides
+     * whether anything writes there. */
+    vk_ps4_bind_subpass_targets(cmd);
+    vk_ps4_rebind_pipeline_state(cmd);
 }
 
