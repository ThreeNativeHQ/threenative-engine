 /* Convert float to uint32 bit pattern (like fui()). */
+/* PA_SC_AA_CONFIG: MSAA_NUM_SAMPLES is log2 of the sample count (0 = 1x,
+ * 2 = 4x) and MAX_SAMPLE_DIST the sample grid's distance field. Nothing in
+ * this driver ever wrote the register, so a 4x target rasterized against the
+ * boot value of 1x: one sample per pixel, the other three never written and a
+ * coverage mask the resolve reads as empty. */
+static void vk_ps4_emit_aa_config(VkPs4CommandBuffer *cmd, uint32_t samples) {
+    uint32_t log2 = 0;
+    for (uint32_t n = samples; n > 1; n >>= 1) log2++;
+    if (log2 > 3) log2 = 3;   /* 3-bit field, 8x is the PS4's maximum */
+    vk_ps4_emit_context_reg(&cmd->gnm_cmd, R_028BE0_PA_SC_AA_CONFIG,
+        S_028BE0_MSAA_NUM_SAMPLES(log2) | S_028BE0_MAX_SAMPLE_DIST(log2));
+}
