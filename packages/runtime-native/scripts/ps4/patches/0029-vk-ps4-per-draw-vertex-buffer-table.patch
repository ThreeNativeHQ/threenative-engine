+ * draw shares one command buffer, so one scratch table per command buffer is
+ * filled by the last draw that ran during recording and the GPU resolves all
+ * of them against THAT one (measured: draws 1-3 of a frame all emit table
+ * 0x20009d544). The 1-attribute fullscreen pass then left slot 1 zeroed, its
+ * dfmt 0 became VK_FORMAT_UNDEFINED in the emulator, and the host faulted on
+ * SET_VERTEX_ATTRIBUTE_A(1) with no component widths -- Xid 69 -- so the mesh
+ * lost its normal. Each draw now takes its own immutable copy from the command
+ * buffer's own storage, where the clear shader's colour already lives
+ * (vk_ps4_clear_color_draw, sceGnmCmdAllocInside): embeds the table in the
+ * command stream as a NOP packet, so it is GPU-visible, unique per draw, and
+ * released with the command buffer. */
+static GnmBuffer *vk_ps4_vertex_buffer_table_slot(VkPs4CommandBuffer *cmd) {
+    GnmBuffer *table = sceGnmCmdAllocInside(&cmd->gnm_cmd,
+                                           sizeof(cmd->gnm_vertex_buffers), 16);
+    if (!table) {
