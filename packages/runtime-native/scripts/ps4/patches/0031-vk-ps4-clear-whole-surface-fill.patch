+/* A whole-surface FillMemory clear writes one 32-bit word everywhere, so it
+ * reproduces the clear colour only when the target's pixel repeats that word:
+ * every format up to 32 bpp does, and a 64 bpp one does when its two words
+ * (R,G) and (B,A) are equal. Anything else needs the draw-based clear. */
+static bool vk_ps4_clear_val_uniform(VkFormat fmt, const VkClearColorValue *cc,
+                                     uint32_t *out) {
+    uint32_t bpp = vk_format_to_bpp(fmt);
+    if (bpp > 0 && bpp <= 4) {
+        *out = vk_ps4_pack_clear_val_32(fmt, cc);
+        return true;
+    }
+    if (fmt == VK_FORMAT_R16G16B16A16_SFLOAT) {
+        uint16_t half[4];
+        for (int i = 0; i < 4; i++) half[i] = vk_ps4_float_to_half(cc->float32[i]);
+        uint32_t lo = (uint32_t)half[0] | ((uint32_t)half[1] << 16);
+        uint32_t hi = (uint32_t)half[2] | ((uint32_t)half[3] << 16);
+        if (lo == hi) {
+            *out = lo;
+            return true;
+        }
+    }
+    return false;
+}
