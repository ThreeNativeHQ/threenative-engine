+        uint32_t idx = (uint32_t)((uint32_t *)slot - dev->gnm_epilogue_cmd) /
             dev->gnm_epilogue_cmd_dwords;
-    return slot;
+        vk_ps4_queue_retired(dev)[idx] = dev->gnm_epilogue_ticket[idx];
+    }
+    return result;
 }
 
