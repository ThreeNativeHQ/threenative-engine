+/* One retire dword per slice, after the idle label. */
+static volatile uint32_t *vk_ps4_queue_retired(VkPs4Device *dev) {
+    return dev->gnm_epilogue_cmd +
+        (uint64_t)VK_PS4_GNM_EPILOGUE_SLOTS * dev->gnm_epilogue_cmd_dwords + 1u;
+}
+
+/* The GPU reads a submitted slice when it parses it, which can be several
+ * submits after sceGnmSubmitCommandBuffers returns: rewriting a queued slice
+ * changes the packets under it (an EOP's 6 dwords overwritten by a WaitMem's 7
+ * derails shadPS4 at "count=7, remaining=6").  So a slice is reused only once
+ * the GPU has written the ticket of its last use. */
 static uint32_t *vk_ps4_queue_next_epilogue(VkPs4Device *dev) {
-    uint32_t *slot = dev->gnm_epilogue_cmd +
-        (dev->gnm_epilogue_next++ % VK_PS4_GNM_EPILOGUE_SLOTS) *
+    uint32_t idx = dev->gnm_epilogue_next++ % VK_PS4_GNM_EPILOGUE_SLOTS;
+    volatile uint32_t *retired = vk_ps4_queue_retired(dev);
+    while (retired[idx] != dev->gnm_epilogue_ticket[idx]) {
+        /* spin: the GPU is still behind this slice */
+    }
+    dev->gnm_epilogue_ticket[idx]++;
+    return dev->gnm_epilogue_cmd + idx * dev->gnm_epilogue_cmd_dwords;
+}
+
+/* Append the WRITE_DATA that retires `slot`, after its packet. */
+static void vk_ps4_queue_emit_retire(VkPs4Device *dev, GnmCommandBuffer *cmd,
+                                     uint32_t *slot) {
+    uint32_t idx = (uint32_t)(slot - dev->gnm_epilogue_cmd) /
+        dev->gnm_epilogue_cmd_dwords;
+    uint64_t addr = (uint64_t)(uintptr_t)(vk_ps4_queue_retired(dev) + idx);
+    if ((uint32_t)(cmd->endptr - cmd->cmdptr) < 5) return;
+    cmd->cmdptr[0] = PKT3(PKT3_WRITE_DATA, 3, 0);
+    cmd->cmdptr[1] = (5u << 8) | (1u << 20); /* DST_SEL memory, WR_CONFIRM */
+    cmd->cmdptr[2] = (uint32_t)addr;
+    cmd->cmdptr[3] = (uint32_t)(addr >> 32);
+    cmd->cmdptr[4] = dev->gnm_epilogue_ticket[idx];
+    cmd->cmdptr += 5;
+}
+
+/* Submit one slice; a slice the GPU never sees is retired on the CPU. */
+static int32_t vk_ps4_queue_submit_epilogue(VkPs4Device *dev, void *slot,
+                                            uint32_t bytes) {
+    int32_t result = sceGnmSubmitCommandBuffers(1, &slot, &bytes, NULL, NULL);
+#ifdef VK_USE_PLATFORM_PS4
+    if (result != 0)
+#endif
