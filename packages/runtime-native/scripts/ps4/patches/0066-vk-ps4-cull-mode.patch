+/* PA_SU_SC_MODE_CNTL from the pipeline's rasterization state: cull mode and front face, as RADV
+ * writes them (VkCullModeFlags FRONT=1/BACK=2 and VkFrontFace CCW=0/CW=1 are the register's own
+ * encodings). Without it every draw kept the reset value, no culling, so a FrontSide mesh drew its
+ * back faces too (PRD-784 P5-8). The rest of the register keeps that reset value: solid fill, first
+ * provoking vertex. A clear draw (a RECTLIST) passes VK_CULL_MODE_NONE; the next bind restores. */
+static void vk_ps4_emit_primitive_setup(VkPs4CommandBuffer *cmd, VkCullModeFlags cull, VkFrontFace face) {
+    GnmPrimitiveSetup ps;
+    memset(&ps, 0, sizeof(ps));
+    ps.cullmode = (GnmCullMode)(cull & VK_CULL_MODE_FRONT_AND_BACK);
+    ps.frontface = face == VK_FRONT_FACE_CLOCKWISE ? GNM_FACE_CW : GNM_FACE_CCW;
+    ps.frontmode = GNM_FILL_SOLID;
+    ps.backmode = GNM_FILL_SOLID;
+    sceGnmDrawCmdSetPrimitiveSetup(&cmd->gnm_cmd, &ps);
+}
