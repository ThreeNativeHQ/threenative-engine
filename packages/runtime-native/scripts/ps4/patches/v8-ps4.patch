+++ b/src/base/debug/stack_trace_ps4.cc
@@ -0,0 +1,41 @@
+// Copyright 2024 the V8 project authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// PS4 (OpenOrbis) port: the sysroot has no <execinfo.h>, so this mirrors
+// stack_trace_fuchsia.cc instead of stack_trace_posix.cc.
+
+#include "src/base/debug/stack_trace.h"
+
+#include <iomanip>
+#include <ostream>
+
+#include "src/base/platform/platform.h"
+
+namespace v8 {
+namespace base {
+namespace debug {
+
+bool EnableInProcessStackDumping() {
+  // No backtrace(3), and nothing to symbolize on device.
+  return false;
+}
+
+void DisableSignalStackDump() {}
+
+StackTrace::StackTrace() { count_ = 0; }
+
+void StackTrace::Print() const {
+  std::string backtrace = ToString();
+  OS::Print("%s\n", backtrace.c_str());
+}
+
+void StackTrace::OutputToStream(std::ostream* os) const {
+  for (size_t i = 0; i < count_; ++i) {
+    *os << "#" << std::setw(2) << i << trace_[i] << "\n";
+  }
+}
+
+}  // namespace debug
+}  // namespace base
+}  // namespace v8
