+                    seq, (int)pCreateInfo->format, pCreateInfo->extent.width,
+                    pCreateInfo->extent.height, (unsigned)samples, (unsigned)pCreateInfo->usage,
+                    (int)err);
             vk_ps4_free(alloc, img);
             return VK_ERROR_OUT_OF_DEVICE_MEMORY;
         }
@@ -114,6 +144,10 @@
         drt_ci.numfragments = 1;
         GnmError err = sceGnmCreateDepthRenderTarget(&img->gnm_drt, &drt_ci);
         if (err != GNM_ERROR_OK) {
+            vk_ps4_log("CreateImage #%lu: sceGnmCreateDepthRenderTarget FAILED err=%d "
