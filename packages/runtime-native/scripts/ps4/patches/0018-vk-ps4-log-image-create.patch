 static GnmTextureType vk_image_type_to_gnm(VkImageType type) {
@@ -61,6 +62,24 @@
     if (samples == 0) samples = 1;
     if (samples > 8) samples = 8;  /* clamp to PS4 max */
 
+    /* Breadcrumb: the descriptor OpenGNM is about to be handed. A create that
+     * fails is otherwise a bare VK_ERROR_OUT_OF_DEVICE_MEMORY with no way back
+     * to the image (vk_ps4_image.c:81 / :155), and no allocation is attempted
