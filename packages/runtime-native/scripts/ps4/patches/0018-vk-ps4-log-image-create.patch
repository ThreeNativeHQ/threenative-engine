+    static unsigned long image_seq = 0;
+    const unsigned long seq = ++image_seq;
+    const char *path_kind = vk_image_is_color_target(pCreateInfo) ? "color-target"
+                            : vk_image_is_depth(pCreateInfo)    ? "depth-target"
+                                                                : "texture";
+    vk_ps4_log(
+        "CreateImage #%lu: imageType=%u format=%d extent=%ux%ux%u mipLevels=%u arrayLayers=%u "
+        "samples=0x%x usage=0x%x flags=0x%x tiling=%d initialLayout=%d sharing=%u gnm_fmt=0x%x -> %s",
+        seq, (unsigned)pCreateInfo->imageType, (int)pCreateInfo->format,
+        pCreateInfo->extent.width, pCreateInfo->extent.height, pCreateInfo->extent.depth,
+        mip_levels, pCreateInfo->arrayLayers, (unsigned)samples, (unsigned)pCreateInfo->usage,
+        (unsigned)pCreateInfo->flags, (int)pCreateInfo->tiling, (int)pCreateInfo->initialLayout,
+        (unsigned)pCreateInfo->sharingMode, gnm_fmt.asuint, path_kind);
+
     if (vk_image_is_color_target(pCreateInfo)) {
         /* Create as render target */
         img->is_render_target = true;
@@ -77,6 +96,17 @@
 
         GnmError err = sceGnmCreateRenderTarget(&img->gnm_rt, &rt_ci);
         if (err != GNM_ERROR_OK) {
+            vk_ps4_log(
+                "CreateImage #%lu: sceGnmCreateRenderTarget FAILED err=%d (fmt=0x%x %ux%u numslices=%u "
+                "numsamples=%u numfragments=%u tilemode=%d) -> VK_ERROR_OUT_OF_DEVICE_MEMORY",
+                seq, (int)err, gnm_fmt.asuint, pCreateInfo->extent.width,
+                pCreateInfo->extent.height, pCreateInfo->arrayLayers, samples, samples,
