--- a/src/amd/compiler/instruction_selection/aco_isel_helpers.cpp	2026-11-06 22:48:31.077133954 -0700
+++ b/src/amd/compiler/instruction_selection/aco_isel_helpers.cpp	2026-11-06 22:48:31.093136649 -0700
@@ -100,6 +100,34 @@
    return val;
 }
 
+/* A scalar 64-bit logical right shift from 32-bit SALU ops. shadPS4 (v0.21.0 and main) does not
+ * translate S_LSHR_B64 and aborts the pipeline; psbc only targets the PS4, so every scalar 64-bit
+ * logical right shift takes this path. The amount reads its low 6 bits, as s_lshr_b64 does. */
+Temp
+emit_s_lshr_b64(Builder& bld, Temp src, Operand amount)
+{
+   Temp lo = bld.tmp(s1), hi = bld.tmp(s1);
+   bld.pseudo(aco_opcode::p_split_vector, Definition(lo), Definition(hi), src);
+   Temp amt =
+      bld.sop2(aco_opcode::s_and_b32, bld.def(s1), bld.def(s1, scc), amount, Operand::c32(63u));
+   /* s_lshr_b32 reads amt & 31: hi >> amt below 32, hi >> (amt - 32) from 32 up. */
+   Temp hi_shr = bld.sop2(aco_opcode::s_lshr_b32, bld.def(s1), bld.def(s1, scc), hi, amt);
+   Temp lo_shr = bld.sop2(aco_opcode::s_lshr_b32, bld.def(s1), bld.def(s1, scc), lo, amt);
+   /* hi << (32 - amt) as (hi << 1) << (31 - amt): 0 at amt == 0, where a shift by 32 is not. */
+   Temp hi_shl1 =
+      bld.sop2(aco_opcode::s_lshl_b32, bld.def(s1), bld.def(s1, scc), hi, Operand::c32(1u));
+   Temp rest =
+      bld.sop2(aco_opcode::s_sub_u32, bld.def(s1), bld.def(s1, scc), Operand::c32(31u), amt);
+   Temp carry = bld.sop2(aco_opcode::s_lshl_b32, bld.def(s1), bld.def(s1, scc), hi_shl1, rest);
+   Temp lo_small = bld.sop2(aco_opcode::s_or_b32, bld.def(s1), bld.def(s1, scc), lo_shr, carry);
+   Temp big = bld.sopc(aco_opcode::s_bitcmp1_b32, bld.def(s1, scc), amt, Operand::c32(5u));
+   Temp res_lo =
+      bld.sop2(aco_opcode::s_cselect_b32, bld.def(s1), hi_shr, lo_small, bld.scc(big));
+   Temp res_hi =
+      bld.sop2(aco_opcode::s_cselect_b32, bld.def(s1), Operand::zero(), hi_shr, bld.scc(big));
+   return bld.pseudo(aco_opcode::p_create_vector, bld.def(s2), res_lo, res_hi);
+}
+
 Temp
 as_vgpr(isel_context* ctx, Temp val)
 {
