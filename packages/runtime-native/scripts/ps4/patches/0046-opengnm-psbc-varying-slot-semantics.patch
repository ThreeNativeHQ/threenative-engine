 /* Build the shader binary into a memory buffer instead of a file. */
+/* VS/TES parameter exports as GNM export semantics. The semantic is the varying slot (the
+ * SPIR-V location, VARYING_SLOT_VAR0 + n), outindex the parameter radv assigned it. The pixel
+ * shader names its inputs by the same slot, so the driver can program SPI_PS_INPUT_CNTL by
+ * matching slots: a PS that reads a subset of the VS outputs then still reads the right ones. */
+static uint32_t psbc_vs_exports(const struct radv_shader_info *ri, GnmVertexExportSemantic *out)
+{
+    uint32_t n = 0;
+    for (unsigned slot = 0; slot < VARYING_SLOT_MAX; slot++) {
+        const uint8_t param = ri->outinfo.vs_output_param_offset[slot];
+        if (slot == VARYING_SLOT_POS || param == AC_EXP_PARAM_UNDEFINED || param >= 32)
+            continue;
+        if (out)
+            out[n] = (GnmVertexExportSemantic){.semantic = slot, .outindex = param};
+        n += 1;
+    }
+    return n;
+}
+
