+    sceGnmRtInitColorTargetCreateInfo(&rt_ci, sceGnmRtGetFormat(&img->gnm_rt),
+        lv.width, lv.height, 1, samples, samples,
+        (GnmTileMode)img->gnm_rt.attrib.tilemode_index, GNM_GPU_BASE);
+    rt_ci.pitch = lv.pitch;
+    if (sceGnmCreateRenderTarget(out, &rt_ci) != GNM_ERROR_OK) return false;
+
+    sceGnmRtSetBaseAddr(out, (char *)img->memory->gnm_mem.mapped +
+                                 img->memory_offset + lv.offset);
+    return true;
+}
