+        free(linear);
+        if (err != GPA_ERR_OK) {
+            static unsigned reported;
+            if (reported++ < 8)
+                fprintf(stderr, "TN_VKPS4_TILE_UPLOAD_FAILED %s level=%u slice=%u %ux%u bpp=%u tm=%d\n",
