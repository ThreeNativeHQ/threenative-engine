+     * this helper got wrong: every caller writes through it (copies, fills,
+     * level targets), so refuse it and let the caller keep its level-0 path
+     * rather than write past the image into whatever follows. */
+    if (img->memory && (img->memory_offset + offset + size > img->memory->size || size == 0)) {
+        static unsigned reported;
+        if (reported++ < 16)
+            fprintf(stderr, "TN_VKPS4_LEVEL_OOB rt=%d %ux%u mips=%u layers=%u level=%u layer=%u offset=%llu size=%llu bound=%llu\n",
+                    (int)img->is_render_target, info.width, info.height, info.nummips, info.numslices, level, layer,
+                    (unsigned long long)offset, (unsigned long long)size,
+                    (unsigned long long)(img->memory->size - img->memory_offset));
+        return false;
+    }
