+/* === Per-level geometry ===
+ *
+ * Array slices of a mipmapped surface are padded to a power of two: that is what
+ * both size functions allocate with (sceGnmTexCalcByteSize sums numslices per
+ * level), and what a T#'s POW2_PAD tells the sampler to walk. */
+static uint32_t vk_ps4_padded_slices(const VkPs4Image *img) {
+    uint32_t slices = img->create_info.arrayLayers ? img->create_info.arrayLayers : 1;
+    const uint32_t mips = img->create_info.mipLevels ? img->create_info.mipLevels : 1;
+    if (mips > 1) {
+        uint32_t padded = 1;
+        while (padded < slices) padded <<= 1;
+        slices = padded;
+    }
+    return slices;
+}
+
+/* A mip level of a GNM surface is a surface of its own.  The layout the driver
+ * allocates with (sceGnmTexCalcByteSize / sceGnmRtCalcByteSize) packs them in
+ * level order -- each level is numslices contiguous slices of that level's
+ * surface size -- and a T#'s baselevel..lastlevel makes the hardware walk that
+ * same table from the image's base address.  Packed w*h*bpp is not that table:
+ * a tiled surface is a whole number of tiles per level.  So level N is placed
+ * by the driver's own table walk, sceGpaComputeSurfaceSizeOffset, over a
+ * GpaTextureInfo that re-describes the image exactly as its size function does
+ * -- which keeps allocation, views, copies and clears on one formula. */
+static bool vk_ps4_image_gpa_info(const VkPs4Image *img, GpaTextureInfo *out) {
+    const VkImageCreateInfo *ci = &img->create_info;
+    const uint32_t mips = ci->mipLevels ? ci->mipLevels : 1;
+
+    if (img->is_depth_target) {
+        /* A GnmDepthRenderTarget carries no level fields at all: a depth image's
+         * mip chain is described nowhere, so there is no table to walk.  Depth
+         * mips stay unsupported (level 0 only). */
+        return false;
+    }
+
+    if (img->is_render_target) {
+        /* Re-describe the colour target with the mip/slice fields an RT lacks.
+         * The tile mode and sample count are the level-0 target's own; the
+         * level-0 pitch is the width the RT was created with
+         * (sceGnmRtInitColorTargetCreateInfo sets pitch = width). */
+        GpaTextureInfo info = sceGnmRtBuildInfo(&img->gnm_rt);
+        info.width = ci->extent.width;
+        info.height = ci->extent.height;
+        info.pitch = ci->extent.width;
+        info.depth = 1;
+        info.nummips = mips;
+        info.numslices = ci->arrayLayers ? ci->arrayLayers : 1;
+        info.numfrags = ci->samples ? ci->samples : 1;
+        info.tm = (GnmTileMode)img->gnm_rt.attrib.tilemode_index;
+        info.pow2pad = mips > 1;
+        *out = info;
+        return true;
+    }
+
+    /* Texture path: sceGnmTexBuildInfo is the argument sceGnmTexCalcByteSize
+     * itself feeds Gpa, so the sizes match the allocation to the byte.  A
+     * descriptor that was never created has no table. */
+    if (img->gnm_texture.dataformat == GNM_IMG_DATA_FORMAT_INVALID) return false;
+    *out = sceGnmTexBuildInfo(&img->gnm_texture);
+    return true;
+}
+
+bool vk_ps4_image_level(const VkPs4Image *img, uint32_t level, uint32_t layer,
+                        VkPs4ImageLevel *out) {
+    if (!img || !out) return false;
+
+    GpaTextureInfo info;
+    if (!vk_ps4_image_gpa_info(img, &info)) return false;
+    if (level >= info.nummips || layer >= info.numslices) return false;
+
+    uint64_t offset = 0;
+    uint64_t size = 0;
+    if (sceGpaComputeSurfaceSizeOffset(&size, &offset, &info, level, layer) != GPA_ERR_OK) {
+        return false;
+    }
+
+    /* The level walk counts the image's raw array slices, but a mipmapped
+     * surface pads them to a power of two -- see vk_ps4_padded_slices.  Put the
+     * offset on the allocation's side of that disagreement (only differs for a
+     * non-power-of-2 layer count on a mipmapped image). */
+    const uint32_t raw_slices = info.numslices;
+    if (info.pow2pad && raw_slices && (raw_slices & (raw_slices - 1)) != 0) {
+        offset = (offset - size * layer) * vk_ps4_padded_slices(img) / raw_slices +
+                 size * layer;
+    }
