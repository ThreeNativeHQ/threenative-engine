+/* One mip level (and array layer) of an image: where it sits and how wide a
+ * row of it is.  Offsets are byte offsets from the image's bound base address
+ * and follow the layout the driver's size functions allocate with: mip levels
+ * packed in level order, each level being numslices contiguous slices of that
+ * level's surface, which is also the table a T#'s baselevel..lastlevel walks. */
+typedef struct VkPs4ImageLevel {
+    uint64_t offset;  /* byte offset of this level (and layer) from image base */
+    uint64_t size;    /* byte size of one slice of this level */
+    uint32_t pitch;   /* surface pitch of this level, in texels (blocks if BC) */
+    uint32_t width;   /* Vulkan extent of this level: max(1, extent >> level) */
+    uint32_t height;
+} VkPs4ImageLevel;
