+/* Tiled upload.  Textures and colour targets are created 2D-tiled
+ * (GNM_TM_DISPLAY_2D_THIN), so writing the staging rows linearly into them left
+ * every uploaded texture scrambled under the sampler (PRD-784 P4-3: the floor's
+ * tile grid read as flat noise).  This tiles the region on the CPU into the
+ * image's own layout with the driver's tiler, which bounds every element write by
+ * `outlen`, here capped at the image's own allocation.
+ * ponytail: runs at record time, so it assumes the staging data is already
+ * written (Dawn fills its upload buffer before it records the copy) and that no
+ * earlier, still-queued command samples the destination; a GPU detile-copy pass
+ * removes both assumptions when a game streams textures mid-frame. */
+static bool vk_ps4_tiled_upload(VkPs4Image *dst, const VkBufferImageCopy *r, const uint8_t *src) {
+    const VkFormat format = dst->create_info.format;
+    if (vk_format_is_compressed(format) || dst->is_depth_target || dst->is_swapchain_image) return false;
+    if (r->imageExtent.depth > 1 || r->imageOffset.z != 0) return false;
+    const uint32_t bpp = vk_format_to_bpp(format);
+    if (bpp == 0) return false;
+
+    GpaTextureInfo info;
+    uint64_t alloc = 0;
+    uint32_t align = 0;
+    if (dst->is_render_target) {
+        /* A colour target names one level: only its level 0 is tiled here. */
+        if (r->imageSubresource.mipLevel != 0) return false;
+        info = sceGnmRtBuildInfo(&dst->gnm_rt);
+        info.height = dst->create_info.extent.height;
+        info.numslices = dst->create_info.arrayLayers ? dst->create_info.arrayLayers : 1;
+        if (sceGnmRtCalcByteSize(&alloc, &align, &dst->gnm_rt) != GNM_ERROR_OK) return false;
+    } else {
+        info = sceGnmTexBuildInfo(&dst->gnm_texture);
+        if (sceGnmTexCalcByteSize(&alloc, &align, &dst->gnm_texture) != GNM_ERROR_OK) return false;
+    }
+    if (info.tm == GNM_TM_DISPLAY_LINEAR_GENERAL || info.tm == GNM_TM_DISPLAY_LINEAR_ALIGNED) return false;
+    const uint32_t level = r->imageSubresource.mipLevel;
+    if (level >= info.nummips) return false;
+
+    const uint32_t row_px = r->bufferRowLength ? r->bufferRowLength : r->imageExtent.width;
+    const uint32_t rows = r->bufferImageHeight ? r->bufferImageHeight : r->imageExtent.height;
+    const uint32_t x0 = (uint32_t)r->imageOffset.x, y0 = (uint32_t)r->imageOffset.y;
+    uint32_t layers = r->imageSubresource.layerCount;
+    if (layers == VK_REMAINING_ARRAY_LAYERS) layers = info.numslices - r->imageSubresource.baseArrayLayer;
+    if (layers == 0) layers = 1;
