+bool vk_ps4_image_level_rt(const VkPs4Image *img, uint32_t level, uint32_t layer,
+                           GnmRenderTarget *out) {
+    if (!img || !out || !img->is_render_target) return false;
+    if (!img->memory || !img->memory->gnm_mem.mapped) return false;
