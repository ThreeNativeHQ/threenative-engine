+    /* The level's own pitch is the tile-aligned one Gpa reports, not the
+     * extent: a row of a tiled surface is a tile pitch wide. */
+    GpaTilingParams tp;
+    GpaSurfaceInfo si;
+    if (sceGpaTpInit(&tp, &info, level, layer) != GPA_ERR_OK ||
+        sceGpaComputeSurfaceInfo(&si, &tp) != GPA_ERR_OK) {
+        return false;
+    }
