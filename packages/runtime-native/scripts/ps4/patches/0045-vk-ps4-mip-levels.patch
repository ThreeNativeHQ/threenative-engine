+    uint8_t *base = (uint8_t *)dst->memory->gnm_mem.mapped + dst->memory_offset;
+    for (uint32_t l = 0; l < layers; l++) {
+        const uint32_t slice = r->imageSubresource.baseArrayLayer + l;
+        uint64_t size = 0, offset = 0;
+        if (sceGpaComputeSurfaceSizeOffset(&size, &offset, &info, level, slice) != GPA_ERR_OK) return false;
+        if (offset >= alloc) return false;
+        if (offset + size > alloc) size = alloc - offset;
+        GpaTilingParams dtp;
+        if (sceGpaTpInit(&dtp, &info, level, slice) != GPA_ERR_OK) return false;
+        /* inbuf starts (y0 * pitch + x0) elements before the first staged texel, so
+         * the region's coordinates land on it; the tiler reads only inside it. */
+        const uint8_t *layer_src = src + l * layer_bytes;
+        const uint64_t lead = ((uint64_t)y0 * (x0 + row_px) + x0) * bpp;
+        /* The linear source is (x0 + row_px) wide, so staged row y sits at
+         * (y0 + y) * (x0 + row_px) + x0 elements: copy it into that shape. */
+        const uint64_t linear_bytes = (uint64_t)(x0 + row_px) * (y0 + rows) * bpp;
+        uint8_t *linear = (uint8_t *)malloc(linear_bytes);
