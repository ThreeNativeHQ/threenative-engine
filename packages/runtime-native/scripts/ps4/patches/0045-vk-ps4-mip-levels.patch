+     * the tiler addresses source and destination with the same coordinates. */
+    GpaTilingParams stp;
+    memset(&stp, 0, sizeof(stp));
+    stp.tilemode = GNM_TM_DISPLAY_LINEAR_GENERAL;
+    stp.mingpumode = info.mingpumode;
+    stp.linearwidth = x0 + row_px;
+    stp.linearheight = y0 + rows;
+    stp.lineardepth = 1;
+    stp.numfragsperpixel = 1;
+    stp.bitsperfrag = bpp * 8;
+    GpaSurfaceRegion region = {x0, y0, 0, x0 + r->imageExtent.width, y0 + r->imageExtent.height, 1};
+    const uint64_t layer_bytes = (uint64_t)row_px * rows * bpp;
