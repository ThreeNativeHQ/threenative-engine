+    out->offset = offset;
+    out->size = size;
+    out->pitch = si.pitch;
+    out->width = (info.width >> level) ? (info.width >> level) : 1;
+    out->height = (info.height >> level) ? (info.height >> level) : 1;
+    return true;
+}
