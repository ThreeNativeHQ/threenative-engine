@@ -3192,7 +3227,14 @@ vk_ps4_CmdClearAttachments(VkCommandBuffer commandBuffer, uint32_t attachmentCou
                     rect->rect.offset.x + rect->rect.extent.width,
                     rect->rect.offset.y + rect->rect.extent.height);
             }
-            vk_ps4_clear_depth_draw(&cmd->gnm_cmd);
+            {
+                /* The clear binds the pass's depth target itself; it names the
