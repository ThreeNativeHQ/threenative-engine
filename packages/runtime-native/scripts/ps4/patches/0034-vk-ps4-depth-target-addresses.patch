+                vk_ps4_clear_depth_draw(cmd, ds_view ? ds_view->image : NULL);
+            }
 
             /* Restore scissor to render area */
             if (cmd->current_render_pass.pass) {
diff --git a/src/vk_ps4_image.c b/src/vk_ps4_image.c
index 66d3e1e..79e628a 100644
--- a/src/vk_ps4_image.c
+++ b/src/vk_ps4_image.c
@@ -159,7 +159,11 @@ vk_ps4_CreateImage(VkDevice device, const VkImageCreateInfo *pCreateInfo,
         drt_ci.tilemodehint = GNM_TM_DEPTH_2D_THIN_1K;
         drt_ci.pitch = pCreateInfo->extent.width;
         drt_ci.mingpumode = gpu_mode;
-        drt_ci.numfragments = 1;
+        /* numfragments is the sample COUNT (1, 2, 4, 8), as sceGnmDrtSetNumFragments
+         * reads it: a 4x Z plane laid out as 1x was a quarter of the surface the
+         * render pass samples, and its DB_Z_INFO.NUM_SAMPLES said 1x to a 4x
+         * colour attachment. */
+        drt_ci.numfragments = samples;
         GnmError err = sceGnmCreateDepthRenderTarget(&img->gnm_drt, &drt_ci);
         if (err != GNM_ERROR_OK) {
             vk_ps4_log("CreateImage #%lu: sceGnmCreateDepthRenderTarget FAILED err=%d "
@@ -242,12 +246,28 @@ vk_ps4_GetImageMemoryRequirements(VkDevice device, VkImage image, VkMemoryRequir
     if (!image || !pMemoryRequirements) return;
     VkPs4Image *img = (VkPs4Image *)image;
 
-    if (img->is_render_target) {
+    if (img->is_depth_target) {
+        /* A depth target's surface is not its texture's: the depth tile mode,
+         * the sample count (an MSAA Z plane is samples times the 1x surface)
+         * and the stencil plane that follows the Z plane all size it, and only
+         * the descriptor knows them. Sizing it as a DISPLAY_2D_THIN texture
+         * (the else branch) allocated one quarter of a 4x Z plane. */
+        uint64_t size = 0;
+        uint32_t align = 0;
+        if (sceGnmDrtCalcByteSize(&size, &align, &img->gnm_drt) != GNM_ERROR_OK || size == 0) {
+            const uint32_t samples = img->create_info.samples ? img->create_info.samples : 1;
+            size = (uint64_t)img->create_info.extent.width *
+                   img->create_info.extent.height * 4 * samples;
+            align = 0x100;
+        }
+        pMemoryRequirements->size = size;
+        pMemoryRequirements->alignment = align ? align : 0x100;
+    } else if (img->is_render_target) {
         uint64_t size = 0;
         uint32_t align = 0;
         sceGnmRtCalcByteSize(&size, &align, &img->gnm_rt);
         if (size == 0) {
-            /* Fallback for depth targets or unconfigured RTs */
+            /* Fallback for unconfigured RTs */
             GnmDataFormat fmt = vk_ps4_vk_format_to_gnm(img->create_info.format);
             uint32_t bpp = 4; /* default 4 bytes per pixel */
             (void)fmt;
@@ -295,6 +315,28 @@ vk_ps4_BindImageMemory(VkDevice device, VkImage image, VkDeviceMemory memory, Vk
 
     if (img->is_render_target) {
         sceGnmRtSetBaseAddr(&img->gnm_rt, gpu_addr);
+    } else if (img->is_depth_target) {
+        /* A depth target carries FOUR addresses of its own -- Z read, Z write,
+         * stencil read, stencil write -- and its bind has to publish them. A
+         * depth image is neither an RT nor a plain texture, so it used to fall
+         * into the texture arm below and only its sample-time T# got an
+         * address: the DRT stayed at zero, sceGnmDrtGetZReadAddress() answered
+         * NULL, and sceGnmDrawCmdSetDepthRenderTarget (opengnm
+         * src/drawcommandbuffer.c) took its no-target arm on every bind --
+         * DB_Z_INFO = DB_STENCIL_INFO = 0, so every draw ran with no depth
+         * buffer and therefore no depth test. */
+        sceGnmDrtSetZReadAddress(&img->gnm_drt, gpu_addr);
+        sceGnmDrtSetZWriteAddress(&img->gnm_drt, gpu_addr);
+        if (img->gnm_drt.stencilinfo.format != GNM_STENCIL_INVALID) {
+            uint64_t stencil_offset = 0;
+            sceGnmDrtCalcStencilByteOffset(&stencil_offset, &img->gnm_drt);
+            void *stencil_addr = (char *)gpu_addr + stencil_offset;
+            sceGnmDrtSetStencilReadAddress(&img->gnm_drt, stencil_addr);
+            sceGnmDrtSetStencilWriteAddress(&img->gnm_drt, stencil_addr);
+        }
+        /* Sampling a depth image reads its T#, which is a separate
+         * descriptor over the same memory. */
+        sceGnmTexSetBaseAddress(&img->gnm_texture, gpu_addr);
     } else {
         sceGnmTexSetBaseAddress(&img->gnm_texture, gpu_addr);
     }
