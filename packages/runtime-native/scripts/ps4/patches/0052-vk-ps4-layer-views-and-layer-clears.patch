diff --git a/src/vk_ps4_image.c b/src/vk_ps4_image.c
--- a/src/vk_ps4_image.c
+++ b/src/vk_ps4_image.c
@@ -635,15 +635,20 @@
         /* The view type picks the T# type. Every view used to keep the image's 2D type (a
          * render target's T# from sceGnmTexCreate2d is one 2D slice), so a cube view -- the
          * environment's PMREM cube, sampled by direction -- read one face or nothing, and every
-         * face lit only by the environment went black (PRD-784 P4-3). DEPTH is the cube count
-         * for a cube, the slice count for an array, as sceGnmCreateTexture sets them. */
+         * face lit only by the environment went black (PRD-784 P4-3). DEPTH describes the IMAGE,
+         * not the view: the cube count for a cube, the slice count for an array, as
+         * sceGnmCreateTexture sets them; base/last array pick the view's layers. A view of one
+         * layer of a layered image (a cube face) is therefore a 2D_ARRAY T# of the whole image
+         * with base = last = the layer: shadPS4 sizes the image from the T#, and a 2D T# of one
+         * slice read layer 0 for every face. */
         const VkImageViewType vt = pCreateInfo->viewType;
         if ((vt == VK_IMAGE_VIEW_TYPE_CUBE || vt == VK_IMAGE_VIEW_TYPE_CUBE_ARRAY) && layer_count >= 6) {
             view->gnm_view.type = GNM_TEXTURE_CUBEMAP;
-            sceGnmTexSetDepth(&view->gnm_view, layer_count / 6);
-        } else if (vt == VK_IMAGE_VIEW_TYPE_2D_ARRAY && !multisampled) {
+            sceGnmTexSetDepth(&view->gnm_view, layers / 6);
+        } else if ((vt == VK_IMAGE_VIEW_TYPE_2D_ARRAY || vt == VK_IMAGE_VIEW_TYPE_2D) &&
+                   !multisampled && layers > 1) {
             view->gnm_view.type = GNM_TEXTURE_2D_ARRAY;
-            sceGnmTexSetDepth(&view->gnm_view, layer_count);
+            sceGnmTexSetDepth(&view->gnm_view, layers);
         }
     }
 
