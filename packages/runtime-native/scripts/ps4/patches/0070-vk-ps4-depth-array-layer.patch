  * clear the depth buffer at EVERY later draw of the pass while the same bit
  * turns depth writes off (`SetDepthWriteEnabled(... && !depth_clear_enable)`)
  * -- no depth test at all, the symptom this path exists to fix. */
-static void vk_ps4_clear_depth_draw(VkPs4CommandBuffer *cmd, VkPs4Image *img) {
+/* Bind one array layer of a depth image: DB_DEPTH_VIEW.SLICE_START, the slice shadPS4 and the DB render to.
+ * The image's own descriptor names layer 0, so every cube face of a point-lamp shadow map rendered into
+ * face 0 and the other five never held depth: PS4 drew no lamp shadow (PRD-784 gap sweep). */
+static void vk_ps4_bind_depth_layer(VkPs4CommandBuffer *cmd, const VkPs4Image *img, uint32_t layer) {
+    GnmDepthRenderTarget drt = img->gnm_drt;
+    drt.depthview.slicestart = layer;
+    sceGnmDrawCmdSetDepthRenderTarget(&cmd->gnm_cmd, &drt);
+}
+
+static void vk_ps4_clear_depth_draw(VkPs4CommandBuffer *cmd, VkPs4Image *img, uint32_t layer) {
