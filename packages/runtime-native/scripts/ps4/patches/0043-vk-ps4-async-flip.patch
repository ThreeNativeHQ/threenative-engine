+
+/* === Flip helpers ===
+ * A flip is queued and shown at a later vblank.  Present never waits for it:
+ * the CPU records the next frame while the display works. */
+
+/* Queue one flip for buffer `index`.  Returns 0 (GNM_ERROR_OK) on success. */
+static int32_t vk_ps4_flip_submit(GnmVideoOut *vo, uint32_t index, int64_t flip_arg) {
+#ifdef __ORBIS__
+    return sceVideoOutSubmitFlip(vo->handle, (int32_t)index, GNM_VIDEO_OUT_FLIP_VSYNC, flip_arg);
+#else
+    /* The host has no display: keep the old call, which reports UNSUPPORTED. */
+    return (int32_t)sceGnmVideoOutSubmitFlipAndWait(
+        vo, index, flip_arg, GNM_VIDEO_OUT_FLIP_VSYNC);
+#endif
+}
+
+/* Flips the display finished, or UINT64_MAX when it cannot say (host). */
+static uint64_t vk_ps4_flip_total(GnmVideoOut *vo) {
+#ifdef __ORBIS__
+    OrbisVideoOutFlipStatus status;
+    memset(&status, 0, sizeof(status));
+    if (sceVideoOutGetFlipStatus(vo->handle, &status) != 0) {
+        return UINT64_MAX;
+    }
+    return (uint64_t)status.num;
+#else
+    (void)vo;
+    return UINT64_MAX;
+#endif
+}
+
+/* Refresh flips_completed.  A host has no display: every flip counts as done. */
+static void vk_ps4_flip_poll(VkPs4Swapchain *sc) {
+    const uint64_t total = vk_ps4_flip_total(&sc->video_out);
+    if (total == UINT64_MAX) {
+        sc->flips_completed = sc->flips_submitted;
+    } else if (total > sc->flip_count_base) {
+        sc->flips_completed = total - sc->flip_count_base;
+    } else {
+        sc->flips_completed = 0;
+    }
+}
