+/* SPI_PS_INPUT_CNTL: which VS parameter each PS input reads. Never programmed before, so every
+ * input read a stale mapping, and a pixel shader that reads a subset of the VS outputs (a lit
+ * material) read its UVs from another varying (PRD-784 P4-3). psbc names both tables by varying
+ * slot; the GS path exports through a copy shader and keeps the old behaviour. */
+static void vk_ps4_set_ps_inputs(VkPs4CommandBuffer *cmd, const VkPs4Pipeline *pipe) {
+    if (pipe->has_gs || pipe->ps_input_semantic_count == 0) return;
+    sceGnmDrawCmdSetPsInputUsage(&cmd->gnm_cmd, pipe->vs_export_semantics, pipe->vs_export_semantic_count,
+                                 pipe->ps_input_semantics, pipe->ps_input_semantic_count);
+}
