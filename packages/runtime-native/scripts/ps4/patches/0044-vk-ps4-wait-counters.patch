@@ -252,7 +310,8 @@
     /* An image is free when no caller holds it and the display moved past
      * its flip.  Poll the flip count until one frees, within `timeout`.
      * Round robin from current_image hands out the oldest image first. */
-    const uint64_t deadline = vk_ps4_now_ns() + timeout;
+    const uint64_t wait_start = vk_ps4_now_ns();
+    const uint64_t deadline = wait_start + timeout;
     uint32_t acquired = sc->image_count;  /* invalid sentinel */
     for (;;) {
         vk_ps4_flip_poll(sc);
@@ -264,12 +323,15 @@
             break;
         }
         if (acquired < sc->image_count) {
+            vk_ps4_diag_acquire_ns += vk_ps4_now_ns() - wait_start;
             break;
         }
         if (timeout == 0) {
+            vk_ps4_diag_acquire_ns += vk_ps4_now_ns() - wait_start;
             return VK_NOT_READY;
         }
         if (timeout != UINT64_MAX && vk_ps4_now_ns() >= deadline) {
+            vk_ps4_diag_acquire_ns += vk_ps4_now_ns() - wait_start;
             return VK_TIMEOUT;
         }
         vk_ps4_sleep_us(100);
@@ -345,6 +407,7 @@
     /* Signal semaphores (Vulkan 1.1+ via VkPresentTimesInfoGOOGLE etc.
      * Vulkan 1.0 VkPresentInfoKHR has no signal semaphores) */
     (void)q;
+    vk_ps4_diag_present();
     return VK_SUCCESS;
 }
 
