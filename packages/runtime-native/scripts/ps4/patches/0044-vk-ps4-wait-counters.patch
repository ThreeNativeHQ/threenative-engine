diff -ruN base/src/vk_ps4_swapchain.c new/src/vk_ps4_swapchain.c
--- a/src/vk_ps4_swapchain.c	2026-11-06 23:45:16.565571585 -0700
+++ b/src/vk_ps4_swapchain.c	2026-11-07 00:11:47.240416137 -0700
@@ -9,6 +9,7 @@
 
 #include "vk_ps4_internal.h"
 
+#include <stdio.h>   /* the TN_VKPS4_WAITS diagnostic line */
 #include <string.h>
 
 #ifdef __ORBIS__
@@ -57,6 +58,63 @@
     }
 }
 
+/* === Diagnostic wait counters (PRD-784 P4-2) ===
+ * E5 spends most of its 27.5 ms frame waiting somewhere in this driver, and the
+ * frame meter only says "host gap".  Each counter is wall-clock inside one
+ * entry point and is reset by the line it feeds, so a line covers exactly
+ * VK_PS4_DIAG_WINDOW presents. */
+#define VK_PS4_DIAG_WINDOW 100
+
+uint64_t vk_ps4_diag_acquire_ns;
+uint64_t vk_ps4_diag_fence_ns;
+uint64_t vk_ps4_diag_fence_calls;
+uint64_t vk_ps4_diag_idle_ns;
+uint64_t vk_ps4_diag_idle_calls;
+uint64_t vk_ps4_diag_submits;
+
+/* "whole.hundredths" printed as two integers: the PS4 libc printf is not
+ * relied on for %f, and the probe must not be the thing that breaks. */
+static void vk_ps4_diag_print(uint64_t presents) {
+    const uint64_t acquire_ns = vk_ps4_diag_acquire_ns / VK_PS4_DIAG_WINDOW;
+    const uint64_t fence_ns = vk_ps4_diag_fence_ns / VK_PS4_DIAG_WINDOW;
+    const uint64_t idle_ns = vk_ps4_diag_idle_ns / VK_PS4_DIAG_WINDOW;
+    printf("TN_VKPS4_WAITS presents=%llu acquire_ms=%llu.%02llu fence_ms=%llu.%02llu"
+           " fences=%llu.%02llu idle_ms=%llu.%02llu idles=%llu.%02llu submits=%llu.%02llu\n",
+           (unsigned long long)presents,
+           (unsigned long long)(acquire_ns / 1000000ULL),
+           (unsigned long long)((acquire_ns / 10000ULL) % 100ULL),
+           (unsigned long long)(fence_ns / 1000000ULL),
+           (unsigned long long)((fence_ns / 10000ULL) % 100ULL),
+           (unsigned long long)(vk_ps4_diag_fence_calls / VK_PS4_DIAG_WINDOW),
+           (unsigned long long)((vk_ps4_diag_fence_calls % VK_PS4_DIAG_WINDOW) * 100ULL /
+                                VK_PS4_DIAG_WINDOW),
+           (unsigned long long)(idle_ns / 1000000ULL),
+           (unsigned long long)((idle_ns / 10000ULL) % 100ULL),
+           (unsigned long long)(vk_ps4_diag_idle_calls / VK_PS4_DIAG_WINDOW),
+           (unsigned long long)((vk_ps4_diag_idle_calls % VK_PS4_DIAG_WINDOW) * 100ULL /
+                                VK_PS4_DIAG_WINDOW),
+           (unsigned long long)(vk_ps4_diag_submits / VK_PS4_DIAG_WINDOW),
+           (unsigned long long)((vk_ps4_diag_submits % VK_PS4_DIAG_WINDOW) * 100ULL /
+                                VK_PS4_DIAG_WINDOW));
+    fflush(stdout);
+
+    vk_ps4_diag_acquire_ns = 0;
+    vk_ps4_diag_fence_ns = 0;
+    vk_ps4_diag_fence_calls = 0;
+    vk_ps4_diag_idle_ns = 0;
+    vk_ps4_diag_idle_calls = 0;
+    vk_ps4_diag_submits = 0;
+}
+
+/* Count a present; every VK_PS4_DIAG_WINDOW-th one reports the window. */
+void vk_ps4_diag_present(void) {
+    static uint64_t presents = 0;
+    presents++;
+    if ((presents % VK_PS4_DIAG_WINDOW) == 0) {
+        vk_ps4_diag_print(presents);
+    }
+}
+
