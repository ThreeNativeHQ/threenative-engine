diff --git a/toolchain/ps4/BUILD.gn b/toolchain/ps4/BUILD.gn
new file mode 100644
index 0000000..4a87eb0
--- /dev/null
+++ b/toolchain/ps4/BUILD.gn
@@ -0,0 +1,54 @@
+# Copyright 2024 the V8 project authors. All rights reserved.
+# Use of this source code is governed by a BSD-style license that can be
+# found in the LICENSE file.
+
+# PS4 target toolchain (OpenOrbis). The compiler is the host clang driving
+# --target=x86_64-pc-freebsd12-elf with the OpenOrbis sysroot; libraries come
+# from $ps4_toolchain_root/lib and are linked by the embedder, not by V8.
+
+import("//build/toolchain/gcc_toolchain.gni")
+
+declare_args() {
+  ps4_toolchain_root = "/home/joao/.cache/tmp-tn/prd784/deps/oo/OpenOrbis/PS4Toolchain"
+}
+
+_ps4_sysroot = rebase_path(ps4_toolchain_root, root_build_dir)
+_ps4_compat = rebase_path("//build/toolchain/ps4", root_build_dir)
+_ps4_common =
+    "--target=x86_64-pc-freebsd12-elf -fPIC -funwind-tables " +
+    "-isysroot ${_ps4_sysroot} " +
+    "-isystem ${_ps4_sysroot}/include " +
+    "-isystem ${_ps4_sysroot}/include/c++/v1 " +
+    # Sysroot header fixes (sa_sigaction, ...), force-included everywhere.
+    "-isystem ${_ps4_compat} -include ps4-compat.h " +
+    # OpenOrbis libc++ hides ::abs from <cmath> unless <stdlib.h> comes first.
+    "-include stdlib.h " +
+    # OpenOrbis' libc++ __config undefines __FreeBSD__; v8config.h maps
+    # V8_OS_PS4 onto the freebsd flavour (V8_OS_FREEBSD/BSD/POSIX/STRING).
+    "-DV8_OS_PS4=1 " +
+    # newlib/OpenOrbis hides nanosleep, usleep, vasprintf, madvise otherwise.
+    "-D_GNU_SOURCE -D_POSIX_C_SOURCE=200809L"
+
+gcc_toolchain("ps4_clang") {
+  cc = "clang"
+  cxx = "clang++"
+  ld = "clang++"
+  ar = "llvm-ar"
+  nm = "llvm-nm"
+  readelf = "llvm-readelf"
+
+  extra_cppflags = _ps4_common
+  extra_cflags = "-std=c17"
+  extra_cxxflags = "-std=c++20"
+  extra_asmflags = "--target=x86_64-pc-freebsd12-elf -fPIC"
+
+  toolchain_args = {
+    current_cpu = "x64"
+    current_os = "ps4"
+    is_clang = true
+    use_lld = true
+    use_custom_libcxx = false
+    use_custom_libcxx_for_host = false
+    use_sysroot = false
+  }
+}
diff --git a/toolchain/ps4/ps4-compat.h b/toolchain/ps4/ps4-compat.h
new file mode 100644
index 0000000..0000000
--- /dev/null
+++ b/toolchain/ps4/ps4-compat.h
@@ -0,0 +1,25 @@
+// PS4 (OpenOrbis) compat shim, force-included into every target translation
+// unit. Fixes the OpenOrbis sysroot headers where they disagree with what
+// POSIX/glibc-based C++ code expects. Keep each entry one line + a reason.
+#ifndef V8_BUILD_TOOLCHAIN_PS4_COMPAT_H_
+#define V8_BUILD_TOOLCHAIN_PS4_COMPAT_H_
+
+// libkernel (FreeBSD ABI) keeps a pointer in each pthread attr object, but the
+// OpenOrbis musl alltypes.h declares 4 bytes, so libkernel's 8-byte store ran
+// past the caller's object (E4: pthread_mutexattr_destroy zeroed V8's saved
+// `this`). Declared first, the musl typedefs are skipped by their guards.
+typedef struct { void* __p; } pthread_mutexattr_t;
+#define __DEFINED_pthread_mutexattr_t
+typedef struct { void* __p; } pthread_condattr_t;
+#define __DEFINED_pthread_condattr_t
+typedef struct { void* __p; } pthread_barrierattr_t;
+#define __DEFINED_pthread_barrierattr_t
+
+#include <signal.h>
+
+// OpenOrbis signal.h:142 defines sa_sigaction as __sa_handler.sa_sigaction,
+// but the union member is spelled __sa_sigaction (the plugin-sdk typo).
+#undef sa_sigaction
+#define sa_sigaction __sa_handler.__sa_sigaction
+
+#endif  // V8_BUILD_TOOLCHAIN_PS4_COMPAT_H_
