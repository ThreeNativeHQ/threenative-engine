+/* A descriptor set base, and the indirect-descriptor table base, are 64-bit GPU
+ * addresses carried in a user SGPR pair: the low half is the set's own arg and
+ * the high half the null arg declared right after it (radv_shader_args.c
+ * add_descriptor_set). Widening the low half with address32_hi instead would
+ * truncate the base at 4 GiB -- PS4 and shadPS4 map well above that -- and
+ * would leave the high half a plain constant, which shadPS4's
+ * FlattenExtendedUserdataPass rejects: it requires both halves of a
+ * constant-memory base to come from user data, as Sony's 64-bit SRT pointers
+ * always do. Fall back to address32_hi when the set has no such pair (heaps,
+ * acceleration structures). */
+static nir_def *
+widen_descriptor_base(nir_builder *b, lower_descriptors_state *state, nir_def *ptr, unsigned set)
+{
+   if (set < MAX_SETS && state->args->descriptors[set].used) {
+      nir_def *hi = ac_nir_load_arg_at_offset(b, &state->args->ac, state->args->descriptors[set], 1);
+      return nir_pack_64_2x32_split(b, ptr, hi);
+   }
+
+   return convert_pointer_to_64_bit(b, state, ptr);
+}
