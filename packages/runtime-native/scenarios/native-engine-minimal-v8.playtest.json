{
  "schemaVersion": 1,
  "name": "native-engine-minimal-v8",
  "target": "desktop",
  "subject": "player",
  "viewport": { "width": 1280, "height": 720 },
  "warmupFrames": 10,
  "steps": [
    { "label": "move", "press": "ArrowUp", "holdTicks": 60, "release": true },
