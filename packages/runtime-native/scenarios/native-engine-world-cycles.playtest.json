{
  "schemaVersion": 1,
  "name": "native-engine-world-cycles",
  "target": "desktop",
  "subject": "world-beacon",
  "awaitStartup": false,
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "warmupFrames": 0,
  "steps": [
    {
      "label": "walking",
      "waitTicks": 30,
      "release": true,
      "screenshot": "world-cycles-walking"
    },
    {
      "label": "returning",
      "waitTicks": 120,
      "release": true
    },
    {
      "label": "unloaded",
      "waitTicks": 2500,
      "release": true,
      "screenshot": "world-cycles-unloaded"
    }
  ],
  "assert": {
    "resources": [
      {
        "id": "world",
        "path": "phase",
        "equals": "done"
      },
      {
        "id": "world",
        "path": "walkTicks",
        "equals": 168
      },
      {
        "id": "world",
        "path": "walkedMetres",
        "gte": 23
      },
      {
        "id": "world",
        "path": "maxCameraX",
        "equals": 14
      },
      {
        "id": "world",
        "path": "evictions",
        "gte": 4
      },
      {
        "id": "world",
        "path": "renderedWorldFrames",
        "gte": 30
      },
      {
        "id": "world",
        "path": "peakResidentCells",
        "equals": 2
      },
      {
        "id": "world",
        "path": "residentCells",
        "equals": 0,
        "allowTrivial": "The fixture begins unloaded; final phase, completed loads and rendered frames separately prove the complete lifecycle."
      },
      {
        "id": "world",
        "path": "inFlight",
        "equals": 0,
        "allowTrivial": "The fixture begins unloaded; final phase, completed loads and rendered frames separately prove the complete lifecycle."
      },
      {
        "id": "world",
        "path": "pendingCompletions",
        "equals": 0,
        "allowTrivial": "The fixture begins unloaded; final phase, completed loads and rendered frames separately prove the complete lifecycle."
      },
      {
        "id": "world",
        "path": "pendingDestroyCount",
        "equals": 0,
        "allowTrivial": "The fixture begins unloaded; final phase, completed loads and rendered frames separately prove the complete lifecycle."
      },
      {
        "id": "world",
        "path": "rendererDiagnosticCount",
        "equals": 0,
        "allowTrivial": "No renderer diagnostic is allowed on any submitted frame; this includes unsupported features."
      },
      {
        "id": "world",
        "path": "TN_FRAME_BUDGET.maxAdmissionMs",
        "lte": 4,
        "allowTrivial": "A held invariant: cumulative maxima include every driven/rendered admission, including between labeled samples."
      },
      {
        "id": "world",
        "path": "TN_FRAME_BUDGET.maxAdmissionBytes",
        "lte": 1024,
        "allowTrivial": "A held invariant: cumulative maxima include every driven/rendered admission, including between labeled samples."
      },
      {
        "id": "world",
        "path": "TN_FRAME_BUDGET.violations",
        "equals": 0,
        "allowTrivial": "A held invariant: cumulative maxima include every driven/rendered admission, including between labeled samples."
      },
      {
        "id": "world",
        "path": "TN_FRAME_BUDGET.maxAdmissionBytes",
        "gte": 88
      },
      {
        "id": "world",
        "path": "TN_FRAME_BUDGET.maxAdmissionMs",
        "gte": 1e-06
      },
      {
        "id": "world",
        "path": "cycles",
        "equals": 10
      },
      {
        "id": "world",
        "path": "visitedCells",
        "equals": 4
      },
      {
        "id": "world",
        "path": "completedLoads",
        "gte": 60
      },
      {
        "id": "world",
        "path": "diagnosticCount",
        "equals": 0,
        "allowTrivial": "The valid fixture must emit no load diagnostic at any point in the walk."
      },
      {
        "id": "world",
        "path": "skippedCells",
        "equals": [],
        "allowTrivial": "No valid cell may be held absent; visited cells and completed loads prove all four were exercised."
      },
      {
        "id": "world",
        "path": "samples.9.cpuHeapBytes",
        "gte": 1
      },
      {
        "id": "world",
        "path": "cpuSlopeBytesPerCycle",
        "gte": -65536,
        "lte": 65536
      },
      {
        "id": "world",
        "path": "cpuRangeBytes",
        "lte": 524288,
        "allowTrivial": "Allocator noise is bounded over ten post-unload samples; zero before collecting samples is intentional."
      },
      {
        "id": "world",
        "path": "gpuBufferSlopeBytesPerCycle",
        "equals": 0
      },
      {
        "id": "world",
        "path": "gpuTextureSlopeBytesPerCycle",
        "equals": 0
      },
      {
        "id": "world",
        "path": "handleSlopePerCycle",
        "equals": 0
      },
      {
        "id": "world",
        "path": "geometrySlopePerCycle",
        "equals": 0
      },
      {
        "id": "world",
        "path": "gpuBufferRangeBytes",
        "equals": 0,
        "allowTrivial": "Ten post-unload samples must all retain the same GPU allocation baseline."
      },
      {
        "id": "world",
        "path": "gpuTextureRangeBytes",
        "equals": 0,
        "allowTrivial": "Ten post-unload samples must all retain the same GPU allocation baseline."
      },
      {
        "id": "world",
        "path": "handleRange",
        "equals": 0,
        "allowTrivial": "Ten post-unload samples must all retain the same handle baseline."
      },
      {
        "id": "world",
        "path": "samples.9.geometryEntries",
        "equals": 3
      },
      {
        "id": "world",
        "path": "samples.9.gpuBufferBytes",
        "equals": 696
      },
      {
        "id": "world",
        "path": "samples.9.gpuTextureBytes",
        "equals": 0
      }
    ]
  }
}
