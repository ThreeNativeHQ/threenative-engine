{
  "name": "@threenative/runtime-native",
  "version": "0.3.6",
  "description": "ThreeNative-owned native host for desktop and Android",
  "keywords": [
    "threenative",
    "native",
    "desktop",
    "android",
    "ios",
    "webgpu",
    "three",
    "threejs"
  ],
  "homepage": "https://github.com/ThreeNativeHQ/threenative#readme",
  "bugs": {
    "url": "https://github.com/ThreeNativeHQ/threenative/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ThreeNativeHQ/threenative.git",
    "directory": "packages/runtime-native"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "files": [
    "build/web/tn-native-engine-web.mjs",
    "build/web/tn-native-engine-web.wasm",
    "LICENSE",
    "NOTICE",
    "README.md",
    "android/README.md",
    "android/app/build.gradle.kts",
    "android/app/proguard-rules.pro",
    "android/app/src/main/AndroidManifest.xml",
    "android/app/src/main/java",
    "android/app/src/main/res",
    "android/build.gradle.kts",
    "android/gradle.properties",
    "android/gradle/wrapper/gradle-wrapper.jar",
    "android/gradle/wrapper/gradle-wrapper.properties",
    "android/gradlew",
    "android/settings.gradle.kts",
    "scripts/asset-manifest.mjs",
    "scripts/asset-preflight.mjs",
    "scripts/bundle.mjs",
    "scripts/check-android-16kb-alignment.mjs",
    "scripts/check-source-list.mjs",
    "scripts/desktop-distribution.mjs",
    "scripts/windows-installer.mjs",
    "scripts/windows-installer.nsi",
    "scripts/device-preflight.mjs",
    "scripts/inspect-container-brand.mjs",
    "scripts/inspect-macos-icon.mjs",
    "scripts/install-prebuilt.mjs",
    "scripts/package-android.mjs",
    "scripts/package-desktop.mjs",
    "scripts/package-ios.mjs",
    "scripts/physical-device-evidence.mjs",
    "scripts/production-evidence.mjs",
    "scripts/profile-production.mjs",
    "scripts/qualify-physical-mobile.mjs",
    "scripts/verify-starter-consumer.mjs",
    "scripts/verify-starter-desktop-base.mjs",
    "scripts/verify-starter-desktop.mjs",
    "scripts/verify-windows-installer.mjs",
    "scripts/xvfb.sh",
    "scripts/package-engine-desktop.mjs",
    "scripts/bundle-native-engine.mjs",
    "src/engine/player/*.mjs"
  ],
  "scripts": {
    "deps:download": "node scripts/download-deps.mjs",
    "deps:verify": "node scripts/download-deps.mjs --check-lock",
    "deps:sbom": "node scripts/generate-native-sbom.mjs --out .runtime/sbom",
    "deps:sbom:check": "node scripts/generate-native-sbom.mjs --check --sbom .runtime/sbom/native-dependencies.cdx.json --inventory .runtime/sbom/native-license-inventory.json",
    "native:build": "node scripts/download-deps.mjs && node scripts/native-build.mjs",
    "native:coverage": "sh ../../scripts/xvfb.sh node scripts/measure-native-coverage.mjs",
    "native:test:cpp": "node scripts/measure-native-coverage.mjs --ctest",
    "native:test:asan": "node scripts/measure-native-coverage.mjs --sanitizers",
    "native:physics:cross": "node scripts/build-native-physics.mjs",
    "native:physics:measure": "node scripts/measure-physics-divergence.mjs",
    "native:physics:parity": "pnpm --dir ../.. exec vitest run packages/physics/__tests__/parity.spec.ts && cargo test --manifest-path native/physics/Cargo.toml --lib --test parity -- --nocapture",
    "native:physics:parity:device": "node scripts/verify-android-physics-parity.mjs",
    "native:qualify:physical": "node scripts/qualify-physical-mobile.mjs",
    "native:verify:desktop": "node scripts/verify-desktop-audio.mjs && node scripts/verify-desktop-stability.mjs && node scripts/verify-desktop-core.mjs && node scripts/verify-desktop-physics.mjs && sh ../../scripts/xvfb.sh node scripts/verify-native-contracts.mjs && pnpm --dir ../playtest build && sh ../../scripts/xvfb.sh node scripts/verify-desktop-loading.mjs && sh ../../scripts/xvfb.sh node scripts/verify-desktop-ui-frame.mjs && vitest run --config vitest.config.ts tests/external-bundle-discovery.test.mjs",
    "native:verify:metahuman": "node scripts/verify-desktop-metahuman.mjs",
    "native:verify:loading": "pnpm --dir ../playtest build && sh ../../scripts/xvfb.sh node scripts/verify-desktop-loading.mjs",
    "native:verify:ui-frame": "pnpm --dir ../playtest build && sh ../../scripts/xvfb.sh node scripts/verify-desktop-ui-frame.mjs",
    "native:verify:android:multitouch": "pnpm --dir ../playtest build && node scripts/verify-android-multitouch.mjs",
    "native:verify:android:artifact": "node scripts/check-android-16kb-alignment.mjs",
    "profile:production": "node scripts/profile-production.mjs",
    "parity": "node conformance/run-conformance.mjs",
    "install": "node scripts/install-prebuilt.mjs",
    "prepack": "node scripts/web-engine-stamp.mjs --check",
    "test": "vitest run --config vitest.config.ts && pnpm native:physics:parity && publint --strict",
    "native:css:licenses": "node scripts/native-css-license-inventory.mjs"
  },
  "devDependencies": {
    "@dimforge/rapier3d-compat": "catalog:",
    "@threenative/playtest": "workspace:*",
    "@types/three": "0.185.3",
    "publint": "catalog:",
    "three": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "pngjs": "catalog:",
    "@threenative/core": "workspace:*",
    "@threenative/assets": "workspace:*",
    "@threenative/three-native": "workspace:*",
    "esbuild": "catalog:",
    "typescript": "catalog:"
  }
}
