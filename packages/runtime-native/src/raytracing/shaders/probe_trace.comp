/**
 * Ray batch kernel (GI probe rays)
 *
 * One invocation traces one ray against the TLAS with a ray query and writes one hit record.
 * The ray and hit layouts are the ones in rt_common.h (kRayWords, kHitWords).
 *
 * Regenerate probe_trace_spirv.h after an edit: cmake -P cmake/CompileRTShaders.cmake
 */

#version 460
#extension GL_EXT_ray_query : require

layout(local_size_x = 64) in;

layout(set = 0, binding = 0) uniform accelerationStructureEXT tlas;
layout(set = 0, binding = 1, std430) readonly buffer Rays { vec4 rays[]; };
layout(set = 0, binding = 2, std430) writeonly buffer Hits { uvec4 hits[]; };
layout(push_constant) uniform Push { uint rayCount; } push;

void main() {
    const uint i = gl_GlobalInvocationID.x;
    if (i >= push.rayCount) return;

    const vec4 originMin = rays[2u * i];
    const vec4 directionMax = rays[2u * i + 1u];

    rayQueryEXT query;
    // Opaque: every triangle commits on its own, so the loop ends after the traversal.
    rayQueryInitializeEXT(query, tlas, gl_RayFlagsOpaqueEXT, 0xFFu,
                          originMin.xyz, originMin.w, directionMax.xyz, directionMax.w);
    while (rayQueryProceedEXT(query)) { }

    uvec4 hit = uvec4(floatBitsToUint(-1.0), 0xFFFFFFFFu, 0u, 0u);
    if (rayQueryGetIntersectionTypeEXT(query, true) != gl_RayQueryCommittedIntersectionNoneEXT) {
        const vec2 bary = rayQueryGetIntersectionBarycentricsEXT(query, true);
        hit = uvec4(floatBitsToUint(rayQueryGetIntersectionTEXT(query, true)),
                    uint(rayQueryGetIntersectionPrimitiveIndexEXT(query, true)),
                    floatBitsToUint(bary.x), floatBitsToUint(bary.y));
    }
    hits[i] = hit;
}
