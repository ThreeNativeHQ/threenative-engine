{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "tn-linux",
      "displayName": "ThreeNative Linux x64 V8 + Dawn",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/tn-linux",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_POSITION_INDEPENDENT_CODE": "ON",
        "MYSTRAL_USE_V8": "ON",
        "MYSTRAL_USE_DAWN": "ON",
        "MYSTRAL_USE_QUICKJS": "OFF",
        "MYSTRAL_USE_WGPU": "OFF",
        "TN_ENABLE_CANVAS2D": "ON",
        "TN_ENABLE_VIDEO": "OFF",
        "TN_ENABLE_RAYTRACING": "OFF",
        "TN_ENABLE_WEBTRANSPORT": "ON",
        "TN_ENABLE_NATIVE_GLTF": "OFF",
        "TN_ENABLE_DRACO": "OFF",
        "TN_ENABLE_DEBUG_SERVER": "OFF",
        "TN_ENABLE_NATIVE_PHYSICS": "ON",
        "THREENATIVE_PHYSICS_LIBRARY": "${sourceDir}/.runtime/physics-target/x86_64-unknown-linux-gnu/release/libthreenative_native_physics.a"
      }
    },
    {
      "name": "tn-windows",
      "displayName": "ThreeNative Windows x64 V8 + Dawn",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/tn-windows",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded",
        "MYSTRAL_USE_V8": "ON",
        "MYSTRAL_USE_DAWN": "ON",
        "MYSTRAL_USE_QUICKJS": "OFF",
        "MYSTRAL_USE_WGPU": "OFF",
        "TN_ENABLE_CANVAS2D": "ON",
        "TN_ENABLE_VIDEO": "OFF",
        "TN_ENABLE_RAYTRACING": "OFF",
        "TN_ENABLE_WEBTRANSPORT": "ON",
        "TN_ENABLE_NATIVE_GLTF": "OFF",
        "TN_ENABLE_DRACO": "OFF",
        "TN_ENABLE_DEBUG_SERVER": "OFF",
        "TN_ENABLE_NATIVE_PHYSICS": "ON",
        "THREENATIVE_PHYSICS_LIBRARY": "${sourceDir}/.runtime/physics-target/x86_64-pc-windows-msvc/release/threenative_native_physics.lib"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "tn-macos",
      "displayName": "ThreeNative macOS arm64 V8 + Dawn",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/tn-macos",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "MYSTRAL_USE_V8": "ON",
        "MYSTRAL_USE_DAWN": "ON",
        "MYSTRAL_USE_QUICKJS": "OFF",
        "MYSTRAL_USE_WGPU": "OFF",
        "TN_ENABLE_CANVAS2D": "ON",
        "TN_ENABLE_VIDEO": "OFF",
        "TN_ENABLE_RAYTRACING": "OFF",
        "TN_ENABLE_WEBTRANSPORT": "ON",
        "TN_ENABLE_NATIVE_GLTF": "OFF",
        "TN_ENABLE_DRACO": "OFF",
        "TN_ENABLE_DEBUG_SERVER": "OFF",
        "TN_ENABLE_NATIVE_PHYSICS": "ON",
        "THREENATIVE_PHYSICS_LIBRARY": "${sourceDir}/.runtime/physics-target/aarch64-apple-darwin/release/libthreenative_native_physics.a"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" }
    },
    {
      "name": "tn-android",
      "displayName": "ThreeNative Android V8 + wgpu-native bootstrap",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/tn-android",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_SYSTEM_NAME": "Android",
        "ANDROID_ABI": "arm64-v8a",
        "CMAKE_ANDROID_ARCH_ABI": "arm64-v8a",
        "CMAKE_ANDROID_STL_TYPE": "c++_shared",
        "CMAKE_POSITION_INDEPENDENT_CODE": "ON",
        "MYSTRAL_USE_V8": "ON",
        "MYSTRAL_USE_JSC": "OFF",
        "MYSTRAL_USE_QUICKJS": "OFF",
        "MYSTRAL_USE_DAWN": "OFF",
        "MYSTRAL_USE_WGPU": "ON",
        "TN_ENABLE_CANVAS2D": "OFF",
        "TN_ENABLE_VIDEO": "OFF",
        "TN_ENABLE_RAYTRACING": "OFF",
        "TN_ENABLE_WEBTRANSPORT": "OFF",
        "TN_ENABLE_NATIVE_GLTF": "OFF",
        "TN_ENABLE_DRACO": "OFF",
        "TN_ENABLE_DEBUG_SERVER": "OFF",
        "TN_ENABLE_NATIVE_PHYSICS": "ON"
      }
    },
    {
      "name": "tn-ios",
      "displayName": "ThreeNative iOS JSC + wgpu-native bootstrap",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/tn-ios",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_SYSTEM_NAME": "iOS",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "MYSTRAL_USE_V8": "OFF",
        "MYSTRAL_USE_JSC": "ON",
        "MYSTRAL_USE_QUICKJS": "OFF",
        "MYSTRAL_USE_DAWN": "OFF",
        "MYSTRAL_USE_WGPU": "ON",
        "TN_ENABLE_CANVAS2D": "OFF",
        "TN_ENABLE_VIDEO": "OFF",
        "TN_ENABLE_RAYTRACING": "OFF",
        "TN_ENABLE_WEBTRANSPORT": "OFF",
        "TN_ENABLE_NATIVE_GLTF": "OFF",
        "TN_ENABLE_DRACO": "OFF",
        "TN_ENABLE_DEBUG_SERVER": "OFF",
        "TN_ENABLE_NATIVE_PHYSICS": "ON"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" }
    },
    {
      "name": "wasm",
      "displayName": "ThreeNative engine core and renderer, Wasm (browser WebGPU)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/wasm",
      "toolchainFile": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "wasm-threads",
      "inherits": "wasm",
      "displayName": "ThreeNative web engine with Wasm threads (-pthread), for cross-origin-isolated pages",
      "binaryDir": "${sourceDir}/build/wasm-threads",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "TN_WEB_THREADS": "ON" }
    },
    {
      "name": "tn-ps4",
      "displayName": "ThreeNative PlayStation 4 (OpenOrbis): engine core + V8 adapter over the PS4 prebuilts",
      "description": "Cross build for the PS4 lane (PRD-784). Stage the prebuilts with packages/runtime-native/scripts/ps4/ps4-deps.sh first. No PS4 artifact is written inside the repo: binaryDir and the staged third_party both live under $TN_PS4_E5_DIR.",
      "generator": "Ninja",
      "binaryDir": "$env{HOME}/.cache/tmp-tn/prd784/e5/build",
      "toolchainFile": "${sourceDir}/cmake/ps4.toolchain.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_POSITION_INDEPENDENT_CODE": "ON",
        "MYSTRAL_USE_V8": "ON",
        "MYSTRAL_USE_JSC": "OFF",
        "MYSTRAL_USE_QUICKJS": "OFF",
        "MYSTRAL_USE_DAWN": "ON",
        "MYSTRAL_USE_WGPU": "OFF",
        "TN_ENABLE_CANVAS2D": "OFF",
        "TN_ENABLE_VIDEO": "OFF",
        "TN_ENABLE_RAYTRACING": "OFF",
        "TN_ENABLE_WEBTRANSPORT": "OFF",
        "TN_ENABLE_NATIVE_GLTF": "OFF",
        "TN_ENABLE_DRACO": "OFF",
        "TN_ENABLE_DEBUG_SERVER": "OFF",
        "TN_ENABLE_NATIVE_PHYSICS": "ON",
        "TN_ENABLE_CSS_UI": "ON",
        "TN_ENABLE_METAHUMAN": "OFF",
        "TN_ENGINE_ONLY": "ON",
        "TN_ENGINE_PLAYER": "ON",
        "MYSTRAL_USE_SWC": "OFF"
      }
    }
  ],
  "buildPresets": [
    { "name": "tn-linux", "configurePreset": "tn-linux" },
    { "name": "tn-windows", "configurePreset": "tn-windows" },
    { "name": "tn-macos", "configurePreset": "tn-macos" },
    { "name": "tn-android", "configurePreset": "tn-android" },
    { "name": "tn-ios", "configurePreset": "tn-ios" },
    { "name": "wasm", "configurePreset": "wasm", "targets": ["tn-native-engine-web"] },
    { "name": "wasm-threads", "configurePreset": "wasm-threads", "targets": ["tn-native-engine-web"] },
    { "name": "tn-ps4", "configurePreset": "tn-ps4" }
  ],
  "testPresets": [
    { "name": "tn-linux", "configurePreset": "tn-linux", "output": { "outputOnFailure": true } }
  ]
}
