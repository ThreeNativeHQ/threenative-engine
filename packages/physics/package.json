{
  "name": "@threenative/physics",
  "version": "0.3.7",
  "license": "MIT",
  "description": "Thin Rapier physics bindings for ThreeNative games.",
  "keywords": ["threenative", "three", "threejs", "physics", "rapier", "navigation", "gamedev"],
  "homepage": "https://github.com/ThreeNativeHQ/threenative#readme",
  "bugs": {
    "url": "https://github.com/ThreeNativeHQ/threenative/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ThreeNativeHQ/threenative.git",
    "directory": "packages/physics"
  },
  "type": "module",
  "files": ["dist", "README.md"],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "threenative-native": "./dist/native/index.js",
      "import": "./dist/index.js"
    },
    "./navigation": {
      "types": "./dist/navigation/index.d.ts",
      "import": "./dist/navigation/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": ["./src/web.ts", "./src/native.ts", "./dist/index.js", "./dist/native/index.js"],
  "dependencies": {
    "@dimforge/rapier3d-compat": "catalog:",
    "recast-navigation": "catalog:"
  },
  "peerDependencies": {
    "@threenative/core": ">=0.3.7 <0.4.0",
    "three": ">=0.185.0 <0.186.0"
  },
  "scripts": {
    "build": "tsup --config tsup.config.ts && publint",
    "typecheck": "tsc --noEmit",
    "test": "publint --strict"
  },
  "devDependencies": {
    "@types/three": "0.185.3",
    "@threenative/core": "workspace:*",
    "publint": "0.3.22",
    "three": "catalog:",
    "tsup": "8.5.1",
    "typescript": "catalog:",
    "@typescript/native": "catalog:"
  }
}
