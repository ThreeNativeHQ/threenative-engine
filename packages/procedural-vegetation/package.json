{
  "name": "@threenative/procedural-vegetation",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Optional, bake-first procedural tree GLBs for ThreeNative, from the Arbor generator.",
  "homepage": "https://github.com/ThreeNativeHQ/threenative#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ThreeNativeHQ/threenative-engine.git",
    "directory": "packages/procedural-vegetation"
  },
  "type": "module",
  "files": ["dist", "README.md", "LICENSES"],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup --config tsup.config.ts && publint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --root ../.. procedural-vegetation/__tests__ && publint --strict"
  },
  "dependencies": {
    "@napi-rs/canvas": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "publint": "0.3.22",
    "tsup": "8.5.1",
    "typescript": "catalog:"
  }
}
