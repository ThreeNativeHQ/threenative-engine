{
  "name": "@threenative/core",
  "version": "0.3.6",
  "license": "MIT AND GPL-2.0-or-later",
  "description": "The small vanilla Three.js game runtime foundation.",
  "keywords": [
    "threenative",
    "three",
    "threejs",
    "webgpu",
    "game-engine",
    "game-framework",
    "gamedev",
    "typescript"
  ],
  "homepage": "https://github.com/ThreeNativeHQ/threenative#readme",
  "bugs": {
    "url": "https://github.com/ThreeNativeHQ/threenative/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ThreeNativeHQ/threenative.git",
    "directory": "packages/core"
  },
  "type": "module",
  "files": [
    "dist",
    "LICENSE",
    "mcp",
    "gpl",
    "scripts/apply-three-patch.mjs",
    "scripts/ensure-mcp.mjs",
    "scripts/postinstall.mjs",
    "patches",
    "capabilities.json",
    "README.md",
    "src/**/*.ts"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./playtest": {
      "types": "./dist/playtest.d.ts",
      "import": "./dist/playtest.js"
    },
    "./hot": {
      "types": "./dist/hot.d.ts",
      "import": "./dist/hot.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./react-css": {
      "types": "./dist/react-css.d.ts",
      "import": "./dist/react-css.js"
    },
    "./ui-layer": {
      "types": "./dist/ui-layer.d.ts",
      "import": "./dist/ui-layer.js"
    },
    "./world": {
      "types": "./dist/world.d.ts",
      "import": "./dist/world.js"
    },
    "./net": {
      "types": "./dist/net.d.ts",
      "import": "./dist/net.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "scripts": {
    "postinstall": "node ./scripts/postinstall.mjs",
    "patch:generate": "node scripts/generate-three-patch.mjs",
    "build": "node scripts/generate-version.mjs && tsup --config tsup.config.ts && node scripts/bundle-engine-mcp.mjs && node scripts/bundle-blender-mcp.mjs && publint",
    "typecheck": "tsc --noEmit",
    "test": "publint --strict"
  },
  "dependencies": {
    "three": "catalog:",
    "three-mesh-bvh": "catalog:",
    "threenative-asset-mcp": "0.14.0",
    "threenative-sculpt-mcp": "0.2.2",
    "zustand": "catalog:"
  },
  "devDependencies": {
    "@threenative/playtest": "workspace:*",
    "@types/react": "catalog:",
    "@types/react-reconciler": "0.32.1",
    "@types/three": "0.185.3",
    "publint": "0.3.22",
    "react": "catalog:",
    "react-reconciler": "0.33.0",
    "threenative-blender-mcp": "workspace:*",
    "threenative-engine-mcp": "workspace:*",
    "tsup": "8.5.1",
    "typescript": "catalog:",
    "@typescript/native": "catalog:"
  },
  "peerDependencies": {
    "@threenative/playtest": ">=0.3.6 <0.4.0",
    "react": ">=19.2.0 <20",
    "react-reconciler": ">=0.33.0 <0.34"
  },
  "peerDependenciesMeta": {
    "@threenative/playtest": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-reconciler": {
      "optional": true
    }
  }
}
