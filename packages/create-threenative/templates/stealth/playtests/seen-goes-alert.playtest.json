{
  "name": "standing-in-a-cone-fills-suspicion-then-alert",
  "warmupFrames": 10,
  "schemaVersion": 1,
  "target": "web",
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "subject": "player",
  "steps": [
    {
      "label": "settled",
      "waitForResource": {
        "id": "state",
        "path": "missionTime",
        "gte": 0.5
      },
      "release": false,
      "timeoutMs": 5000
    },
    {
      "kind": "input",
      "label": "in-cone",
      "press": "Digit2",
      "holdTicks": 1,
      "release": true
    },
    {
      "label": "suspicious",
      "waitForResource": {
        "id": "state",
        "path": "suspicion",
        "gte": 0.3
      },
      "release": false,
      "timeoutMs": 5000
    },
    {
      "label": "alert",
      "waitForResource": {
        "id": "state",
        "path": "alertPhase",
        "equals": "alert"
      },
      "release": false,
      "timeoutMs": 9600
    },
    {
      "kind": "wait",
      "label": "under-fire",
      "waitTicks": 90,
      "release": true
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "runtimeReady": true
    },
    "resources": [
      {
        "id": "state",
        "path": "alerts",
        "atSteps": [
          {
            "label": "settled",
            "equals": 0
          },
          {
            "label": "alert",
            "equals": 1
          }
        ]
      },
      {
        "id": "state",
        "path": "radarJammed",
        "atSteps": [
          {
            "label": "settled",
            "equals": 0
          },
          {
            "label": "alert",
            "equals": 1
          }
        ]
      }
    ],
    "components": [
      {
        "entity": "guard.courtyard",
        "component": "state",
        "atSteps": [
          {
            "label": "alert",
            "equals": "alert"
          }
        ]
      },
      {
        "entity": "guard.courtyard",
        "component": "shots",
        "gte": 1
      }
    ]
  }
}
