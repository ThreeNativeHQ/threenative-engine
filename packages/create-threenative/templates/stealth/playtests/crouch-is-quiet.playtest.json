{
  "name": "running-is-loud-crouching-is-quiet",
  "warmupFrames": 10,
  "schemaVersion": 1,
  "target": "web",
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "subject": "player",
  "steps": [
    {
      "label": "settled",
      "waitForResource": {
        "id": "state",
        "path": "missionTime",
        "gte": 0.5
      },
      "release": false,
      "timeoutMs": 5000
    },
    {
      "kind": "input",
      "label": "running",
      "press": ["ShiftLeft", "ArrowLeft"],
      "holdTicks": 40,
      "release": false
    },
    {
      "kind": "input",
      "label": "stop",
      "press": ["ArrowLeft"],
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "input",
      "label": "crouch",
      "press": "KeyC",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "input",
      "label": "crouch-walk",
      "press": ["ShiftLeft", "ArrowRight"],
      "holdTicks": 40,
      "release": false
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "runtimeReady": true
    },
    "resources": [
      {
        "id": "state",
        "path": "running",
        "atSteps": [
          {
            "label": "running",
            "equals": 1
          },
          {
            "label": "crouch-walk",
            "equals": 0
          }
        ]
      },
      {
        "id": "state",
        "path": "stance",
        "atSteps": [
          {
            "label": "running",
            "equals": "stand"
          },
          {
            "label": "crouch-walk",
            "equals": "crouch"
          }
        ]
      },
      {
        "id": "state",
        "path": "noise",
        "atSteps": [
          {
            "label": "crouch-walk",
            "equals": 0
          }
        ]
      }
    ],
    "components": [
      {
        "entity": "player",
        "component": "action",
        "atSteps": [
          {
            "label": "running",
            "equals": "run"
          },
          {
            "label": "crouch-walk",
            "equals": "crouchWalk"
          }
        ]
      }
    ]
  }
}
