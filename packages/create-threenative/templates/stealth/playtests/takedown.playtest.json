{
  "name": "takedown-from-behind",
  "warmupFrames": 10,
  "schemaVersion": 1,
  "target": "web",
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "subject": "player",
  "steps": [
    {
      "label": "settled",
      "waitForResource": {
        "id": "state",
        "path": "missionTime",
        "gte": 0.5
      },
      "release": false,
      "timeoutMs": 5000
    },
    {
      "kind": "input",
      "label": "behind",
      "press": "Digit1",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "input",
      "label": "grab",
      "press": "KeyF",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "wait",
      "label": "holding",
      "waitTicks": 4,
      "release": true
    },
    {
      "kind": "input",
      "label": "pump-1",
      "press": "KeyF",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "wait",
      "waitTicks": 4,
      "release": true
    },
    {
      "kind": "input",
      "label": "pump-2",
      "press": "KeyF",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "wait",
      "waitTicks": 4,
      "release": true
    },
    {
      "kind": "input",
      "label": "pump-3",
      "press": "KeyF",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "wait",
      "waitTicks": 4,
      "release": true
    },
    {
      "kind": "input",
      "label": "pump-4",
      "press": "KeyF",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "wait",
      "waitTicks": 4,
      "release": true
    },
    {
      "kind": "input",
      "label": "pump-5",
      "press": "KeyF",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "wait",
      "label": "out-cold",
      "waitTicks": 10,
      "release": true
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "runtimeReady": true
    },
    "components": [
      {
        "entity": "guard.courtyard",
        "component": "state",
        "atSteps": [
          {
            "label": "holding",
            "equals": "held"
          },
          {
            "label": "out-cold",
            "equals": "down"
          }
        ]
      },
      {
        "entity": "player",
        "component": "held",
        "atSteps": [
          {
            "label": "holding",
            "equals": "courtyard"
          },
          {
            "label": "out-cold",
            "equals": ""
          }
        ]
      }
    ],
    "resources": [
      {
        "id": "state",
        "path": "takedowns",
        "atSteps": [
          {
            "label": "holding",
            "equals": 0
          },
          {
            "label": "out-cold",
            "equals": 1
          }
        ]
      },
      {
        "id": "state",
        "path": "alertPhase",
        "atSteps": [
          {
            "label": "out-cold",
            "equals": "infiltration"
          }
        ]
      }
    ]
  }
}
