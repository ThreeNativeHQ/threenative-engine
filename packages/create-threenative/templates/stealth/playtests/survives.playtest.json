{
  "name": "survives",
  "target": "web",
  "schemaVersion": 1,
  "viewport": { "width": 1280, "height": 720 },
  "warmupFrames": 10,
  "subject": "player",
  "steps": [
    { "kind": "input", "label": "move", "press": "ArrowUp", "holdTicks": 60, "release": true },
    { "kind": "wait", "label": "settle", "waitTicks": 10, "release": true }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "noRuntimeDiagnostics": true,
      "runtimeReady": true
    },
    "components": [
      {
        "allowTrivial": "The combat mannequin is authored 1.57 m to its Head joint, so normalising that joint to 1.545 m scales it just under one; either side of one proves normaliseToMetres ran in generated source.",
        "component": "normaliseFactor",
        "entity": "player",
        "lte": 0.99
      }
    ],
    "movement": { "entity": "player", "minDistance": 0.5 },
    "visibility": [
      {
        "entity": "touch-controls",
        "present": false,
        "allowTrivial": "Desktop keyboard lanes intentionally omit touch controls while movement proves the scene is active."
      },
      { "entity": "player", "minProjectedPixels": 20, "allowTrivial": "The overhead camera frames the player at spawn." }
    ],
    "visual": [
      { "region": { "x": 0, "y": 0, "width": 1280, "height": 720, "minNonblankPixelRatio": 0.01 } }
    ]
  }
}
