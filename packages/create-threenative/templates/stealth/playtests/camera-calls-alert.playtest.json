{
  "name": "the-security-camera-calls-the-alert",
  "warmupFrames": 10,
  "schemaVersion": 1,
  "target": "web",
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "subject": "player",
  "steps": [
    {
      "label": "settled",
      "waitForResource": {
        "id": "state",
        "path": "missionTime",
        "gte": 0.5
      },
      "release": false,
      "timeoutMs": 5000
    },
    {
      "kind": "input",
      "label": "in-view",
      "press": "Digit6",
      "holdTicks": 1,
      "release": true
    },
    {
      "label": "alarm",
      "waitForResource": {
        "id": "state",
        "path": "cameraAlarms",
        "gte": 1
      },
      "release": false,
      "timeoutMs": 24000
    },
    {
      "kind": "wait",
      "label": "after",
      "waitTicks": 2,
      "release": true
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "runtimeReady": true
    },
    "resources": [
      {
        "id": "state",
        "path": "cameraAlarms",
        "atSteps": [
          {
            "label": "settled",
            "equals": 0
          }
        ]
      },
      {
        "id": "state",
        "path": "alertPhase",
        "atSteps": [
          {
            "label": "after",
            "equals": "alert"
          }
        ]
      },
      {
        "id": "state",
        "path": "cameraAlarms",
        "gte": 1
      }
    ],
    "signals": [
      {
        "name": "camera-alarm",
        "entity": "camera.west",
        "minCount": 1
      }
    ]
  }
}
