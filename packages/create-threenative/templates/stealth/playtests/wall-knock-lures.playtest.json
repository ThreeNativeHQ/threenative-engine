{
  "name": "wall-press-then-knock-lures-a-guard",
  "warmupFrames": 10,
  "schemaVersion": 1,
  "target": "web",
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "subject": "player",
  "steps": [
    {
      "label": "settled",
      "waitForResource": {
        "id": "state",
        "path": "missionTime",
        "gte": 0.5
      },
      "release": false,
      "timeoutMs": 5000
    },
    {
      "kind": "input",
      "label": "at-fence",
      "press": "Digit3",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "input",
      "label": "press",
      "press": "ArrowRight",
      "holdTicks": 20,
      "release": true
    },
    {
      "kind": "wait",
      "label": "pressed",
      "waitTicks": 4,
      "release": true
    },
    {
      "kind": "input",
      "label": "knock",
      "press": "KeyQ",
      "holdTicks": 1,
      "release": true
    },
    {
      "label": "lured",
      "waitForResource": {
        "id": "state",
        "path": "investigating",
        "gte": 1
      },
      "release": false,
      "timeoutMs": 5000
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "runtimeReady": true
    },
    "resources": [
      {
        "id": "state",
        "path": "stance",
        "atSteps": [
          {
            "label": "pressed",
            "equals": "wall"
          }
        ]
      },
      {
        "id": "state",
        "path": "knocks",
        "atSteps": [
          {
            "label": "pressed",
            "equals": 0
          },
          {
            "label": "lured",
            "equals": 1
          }
        ]
      },
      {
        "id": "state",
        "path": "investigating",
        "atSteps": [
          {
            "label": "pressed",
            "equals": 0
          }
        ]
      },
      {
        "id": "state",
        "path": "investigating",
        "gte": 1
      }
    ]
  }
}
