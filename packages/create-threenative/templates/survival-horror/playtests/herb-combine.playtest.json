{
  "name": "herb-combine",
  "target": "web",
  "schemaVersion": 1,
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "warmupFrames": 10,
  "subject": "player",
  "steps": [
    {
      "label": "ready",
      "waitForResource": {
        "id": "state",
        "path": "time",
        "gte": 0.3
      },
      "release": true,
      "timeoutMs": 45000
    },
    {
      "kind": "input",
      "label": "face-table",
      "press": "KeyA",
      "holdTicks": 47,
      "release": true
    },
    {
      "kind": "input",
      "label": "walk-to-table",
      "press": "KeyW",
      "holdTicks": 100,
      "release": true
    },
    {
      "kind": "wait",
      "label": "at-table",
      "waitTicks": 10,
      "release": true
    },
    {
      "kind": "input",
      "label": "take-ribbon",
      "press": "KeyE",
      "holdTicks": 2,
      "release": true
    },
    {
      "kind": "wait",
      "label": "took-1",
      "waitTicks": 70,
      "release": true
    },
    {
      "kind": "input",
      "label": "take-herb",
      "press": "KeyE",
      "holdTicks": 2,
      "release": true
    },
    {
      "kind": "wait",
      "label": "took-2",
      "waitTicks": 70,
      "release": true
    },
    {
      "kind": "input",
      "label": "hurt-1",
      "press": "KeyH",
      "holdTicks": 2,
      "release": true
    },
    {
      "kind": "wait",
      "label": "h1",
      "waitTicks": 3,
      "release": true
    },
    {
      "kind": "input",
      "label": "hurt-2",
      "press": "KeyH",
      "holdTicks": 2,
      "release": true
    },
    {
      "kind": "wait",
      "label": "h2",
      "waitTicks": 3,
      "release": true
    },
    {
      "kind": "input",
      "label": "hurt-3",
      "press": "KeyH",
      "holdTicks": 2,
      "release": true
    },
    {
      "kind": "wait",
      "label": "hurt",
      "waitTicks": 5,
      "release": true
    },
    {
      "kind": "input",
      "label": "open-case",
      "press": "KeyI",
      "holdTicks": 2,
      "release": true
    },
    {
      "kind": "wait",
      "label": "case",
      "waitTicks": 5,
      "release": true
    },
    {
      "kind": "input",
      "label": "down",
      "press": "KeyS",
      "holdTicks": 3,
      "release": true
    },
    {
      "kind": "wait",
      "label": "on-herb",
      "waitTicks": 3,
      "release": true
    },
    {
      "kind": "input",
      "label": "mix",
      "press": "KeyC",
      "holdTicks": 2,
      "release": true
    },
    {
      "kind": "wait",
      "label": "mixed",
      "waitTicks": 5,
      "release": true
    },
    {
      "kind": "input",
      "label": "down-1",
      "press": "KeyS",
      "holdTicks": 3,
      "release": true
    },
    {
      "kind": "wait",
      "label": "m1",
      "waitTicks": 3,
      "release": true
    },
    {
      "kind": "input",
      "label": "down-2",
      "press": "KeyS",
      "holdTicks": 3,
      "release": true
    },
    {
      "kind": "wait",
      "label": "m2",
      "waitTicks": 3,
      "release": true
    },
    {
      "kind": "input",
      "label": "down-3",
      "press": "KeyS",
      "holdTicks": 3,
      "release": true
    },
    {
      "kind": "wait",
      "label": "on-mixed",
      "waitTicks": 3,
      "release": true
    },
    {
      "kind": "input",
      "label": "use",
      "press": "KeyE",
      "holdTicks": 2,
      "release": true
    },
    {
      "kind": "wait",
      "label": "used",
      "waitTicks": 5,
      "release": true
    },
    {
      "kind": "input",
      "label": "close",
      "press": "KeyI",
      "holdTicks": 2,
      "release": true
    },
    {
      "kind": "wait",
      "label": "closed",
      "waitTicks": 5,
      "release": true
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "noRuntimeDiagnostics": true,
      "runtimeReady": true
    },
    "resources": [
      {
        "id": "state",
        "path": "slots.1.item",
        "atSteps": [
          {
            "label": "on-herb",
            "equals": "herb"
          }
        ]
      },
      {
        "id": "state",
        "path": "combined",
        "atSteps": [
          {
            "label": "mixed",
            "equals": 1
          }
        ]
      },
      {
        "id": "state",
        "path": "slots.3.item",
        "atSteps": [
          {
            "label": "mixed",
            "equals": "mixed"
          }
        ]
      },
      {
        "id": "state",
        "path": "health",
        "atSteps": [
          {
            "label": "hurt",
            "equals": 40
          }
        ]
      },
      {
        "id": "state",
        "path": "health",
        "atSteps": [
          {
            "label": "used",
            "equals": 100
          }
        ]
      },
      {
        "id": "state",
        "path": "herbsUsed",
        "atSteps": [
          {
            "label": "used",
            "equals": 1
          }
        ]
      }
    ],
    "signals": [
      {
        "name": "combined",
        "entity": "player",
        "minCount": 1
      },
      {
        "name": "healed",
        "entity": "player",
        "minCount": 1
      }
    ]
  }
}
