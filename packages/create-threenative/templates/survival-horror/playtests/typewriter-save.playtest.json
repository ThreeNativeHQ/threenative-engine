{
  "name": "typewriter-save",
  "target": "web",
  "schemaVersion": 1,
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "warmupFrames": 10,
  "subject": "player",
  "steps": [
    {
      "label": "ready",
      "waitForResource": {
        "id": "state",
        "path": "time",
        "gte": 0.3
      },
      "release": true,
      "timeoutMs": 45000
    },
    {
      "kind": "input",
      "label": "save-without-ribbon-turn",
      "press": "KeyA",
      "holdTicks": 47,
      "release": true
    },
    {
      "kind": "input",
      "label": "walk-to-table",
      "press": "KeyW",
      "holdTicks": 100,
      "release": true
    },
    {
      "kind": "wait",
      "label": "at-table",
      "waitTicks": 10,
      "release": true
    },
    {
      "kind": "input",
      "label": "take-ribbon",
      "press": "KeyE",
      "holdTicks": 2,
      "release": true
    },
    {
      "kind": "wait",
      "label": "took",
      "waitTicks": 70,
      "release": true
    },
    {
      "kind": "input",
      "label": "quick-turn",
      "press": ["KeyS", "ShiftLeft"],
      "holdTicks": 4,
      "release": true
    },
    {
      "kind": "wait",
      "label": "turned",
      "waitTicks": 40,
      "release": true
    },
    {
      "kind": "input",
      "label": "walk-south",
      "press": "KeyW",
      "holdTicks": 81,
      "release": true
    },
    {
      "kind": "wait",
      "label": "centre",
      "waitTicks": 5,
      "release": true
    },
    {
      "kind": "input",
      "label": "face-west",
      "press": "KeyD",
      "holdTicks": 47,
      "release": true
    },
    {
      "kind": "input",
      "label": "walk-west",
      "press": "KeyW",
      "holdTicks": 260,
      "release": true
    },
    {
      "kind": "wait",
      "label": "at-wall",
      "waitTicks": 10,
      "release": true
    },
    {
      "kind": "input",
      "label": "face-typewriter",
      "press": "KeyA",
      "holdTicks": 47,
      "release": true
    },
    {
      "kind": "wait",
      "label": "facing",
      "waitTicks": 5,
      "release": true
    },
    {
      "kind": "input",
      "label": "save",
      "press": "KeyE",
      "holdTicks": 2,
      "release": true
    },
    {
      "kind": "wait",
      "label": "saved",
      "waitTicks": 10,
      "release": true
    },
    {
      "kind": "input",
      "label": "die-1",
      "press": "KeyH",
      "holdTicks": 2,
      "release": true
    },
    {
      "kind": "wait",
      "label": "d1",
      "waitTicks": 3,
      "release": true
    },
    {
      "kind": "input",
      "label": "die-2",
      "press": "KeyH",
      "holdTicks": 2,
      "release": true
    },
    {
      "kind": "wait",
      "label": "d2",
      "waitTicks": 3,
      "release": true
    },
    {
      "kind": "input",
      "label": "die-3",
      "press": "KeyH",
      "holdTicks": 2,
      "release": true
    },
    {
      "kind": "wait",
      "label": "d3",
      "waitTicks": 3,
      "release": true
    },
    {
      "kind": "input",
      "label": "die-4",
      "press": "KeyH",
      "holdTicks": 2,
      "release": true
    },
    {
      "kind": "wait",
      "label": "d4",
      "waitTicks": 3,
      "release": true
    },
    {
      "kind": "input",
      "label": "die-5",
      "press": "KeyH",
      "holdTicks": 2,
      "release": true
    },
    {
      "kind": "wait",
      "label": "dead",
      "waitTicks": 30,
      "release": true
    },
    {
      "kind": "input",
      "label": "continue",
      "press": "Enter",
      "holdTicks": 2,
      "release": true
    },
    {
      "kind": "wait",
      "label": "continued",
      "waitTicks": 60,
      "release": true
    },
    {
      "kind": "input",
      "label": "new-game",
      "press": "KeyN",
      "holdTicks": 2,
      "release": true
    },
    {
      "kind": "wait",
      "label": "fresh",
      "waitTicks": 60,
      "release": true
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "noRuntimeDiagnostics": true,
      "runtimeReady": true
    },
    "resources": [
      {
        "id": "state",
        "path": "saveCount",
        "atSteps": [
          {
            "label": "saved",
            "equals": 1
          }
        ]
      },
      {
        "id": "state",
        "path": "phase",
        "atSteps": [
          {
            "label": "dead",
            "equals": "lost"
          }
        ]
      },
      {
        "id": "state",
        "path": "phase",
        "atSteps": [
          {
            "label": "continued",
            "equals": "playing"
          }
        ]
      },
      {
        "id": "state",
        "path": "hasSave",
        "atSteps": [
          {
            "label": "dead",
            "equals": true
          }
        ]
      },
      {
        "id": "state",
        "path": "saveCount",
        "atSteps": [
          {
            "label": "continued",
            "equals": 1
          }
        ]
      },
      {
        "id": "state",
        "path": "health",
        "atSteps": [
          {
            "label": "continued",
            "equals": 100
          }
        ]
      },
      {
        "id": "state",
        "path": "saveCount",
        "atSteps": [
          {
            "label": "fresh",
            "equals": 0
          }
        ]
      },
      {
        "id": "state",
        "path": "hasSave",
        "atSteps": [
          {
            "label": "fresh",
            "equals": false
          }
        ]
      }
    ]
  }
}
