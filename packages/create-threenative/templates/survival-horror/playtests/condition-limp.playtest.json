{
  "name": "condition-limp",
  "target": "web",
  "schemaVersion": 1,
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "warmupFrames": 10,
  "subject": "player",
  "steps": [
    {
      "label": "ready",
      "waitForResource": {
        "id": "state",
        "path": "time",
        "gte": 0.3
      },
      "release": true,
      "timeoutMs": 45000
    },
    {
      "kind": "input",
      "label": "walk-fine",
      "press": "KeyW",
      "holdTicks": 40,
      "release": false
    },
    {
      "kind": "wait",
      "label": "w1",
      "waitTicks": 2,
      "release": true
    },
    {
      "kind": "input",
      "label": "hurt-1",
      "press": "KeyH",
      "holdTicks": 2,
      "release": true
    },
    {
      "kind": "wait",
      "label": "h1",
      "waitTicks": 3,
      "release": true
    },
    {
      "kind": "input",
      "label": "hurt-2",
      "press": "KeyH",
      "holdTicks": 2,
      "release": true
    },
    {
      "kind": "wait",
      "label": "caution",
      "waitTicks": 5,
      "release": true
    },
    {
      "kind": "input",
      "label": "hurt-3",
      "press": "KeyH",
      "holdTicks": 2,
      "release": true
    },
    {
      "kind": "wait",
      "label": "h3",
      "waitTicks": 3,
      "release": true
    },
    {
      "kind": "input",
      "label": "hurt-4",
      "press": "KeyH",
      "holdTicks": 2,
      "release": true
    },
    {
      "kind": "wait",
      "label": "danger",
      "waitTicks": 5,
      "release": true
    },
    {
      "kind": "input",
      "label": "turn",
      "press": "KeyA",
      "holdTicks": 94,
      "release": true
    },
    {
      "kind": "input",
      "label": "walk-danger",
      "press": "KeyW",
      "holdTicks": 40,
      "release": false
    },
    {
      "kind": "wait",
      "label": "limping",
      "waitTicks": 1,
      "release": true
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "noRuntimeDiagnostics": true,
      "runtimeReady": true
    },
    "resources": [
      {
        "id": "state",
        "path": "condition",
        "atSteps": [
          {
            "label": "ready",
            "equals": "fine"
          }
        ]
      },
      {
        "id": "state",
        "path": "condition",
        "atSteps": [
          {
            "label": "caution",
            "equals": "caution"
          }
        ]
      },
      {
        "id": "state",
        "path": "condition",
        "atSteps": [
          {
            "label": "danger",
            "equals": "danger"
          }
        ]
      },
      {
        "id": "state",
        "path": "health",
        "atSteps": [
          {
            "label": "danger",
            "equals": 20
          }
        ]
      }
    ],
    "components": [
      {
        "entity": "player",
        "component": "speed",
        "atSteps": [
          {
            "label": "walk-fine",
            "equals": 1.4
          }
        ]
      },
      {
        "entity": "player",
        "component": "speed",
        "atSteps": [
          {
            "label": "walk-danger",
            "equals": 0.85
          }
        ]
      }
    ]
  }
}
