{
  "name": "door-transition",
  "target": "web",
  "schemaVersion": 1,
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "warmupFrames": 10,
  "subject": "player",
  "steps": [
    {
      "label": "ready",
      "waitForResource": {
        "id": "state",
        "path": "time",
        "gte": 0.3
      },
      "release": true,
      "timeoutMs": 45000
    },
    {
      "kind": "wait",
      "label": "first-zone",
      "waitTicks": 5,
      "release": true,
      "screenshot": "first-zone"
    },
    {
      "kind": "input",
      "label": "open-door",
      "press": "KeyE",
      "holdTicks": 2,
      "release": true
    },
    {
      "kind": "wait",
      "label": "black",
      "waitTicks": 20,
      "release": true
    },
    {
      "label": "in-hall",
      "waitForResource": {
        "id": "state",
        "path": "room",
        "equals": "East hall"
      },
      "release": true,
      "timeoutMs": 25000
    },
    {
      "kind": "wait",
      "label": "door-done",
      "waitTicks": 60,
      "release": true
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "noRuntimeDiagnostics": true,
      "runtimeReady": true
    },
    "resources": [
      {
        "id": "state",
        "path": "menu",
        "atSteps": [
          {
            "label": "black",
            "equals": "door"
          }
        ]
      },
      {
        "id": "state",
        "path": "doorsOpened",
        "atSteps": [
          {
            "label": "door-done",
            "equals": 1
          }
        ]
      },
      {
        "id": "state",
        "path": "cameraZone",
        "atSteps": [
          {
            "label": "door-done",
            "equals": "hall-west"
          }
        ]
      },
      {
        "id": "state",
        "path": "menu",
        "atSteps": [
          {
            "label": "door-done",
            "equals": "none"
          }
        ]
      }
    ]
  }
}
