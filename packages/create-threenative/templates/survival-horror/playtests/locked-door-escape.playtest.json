{
  "name": "locked-door-escape",
  "target": "web",
  "schemaVersion": 1,
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "warmupFrames": 10,
  "subject": "player",
  "steps": [
    {
      "label": "ready",
      "waitForResource": {
        "id": "state",
        "path": "time",
        "gte": 0.3
      },
      "release": true,
      "timeoutMs": 45000
    },
    {
      "kind": "input",
      "label": "open-door",
      "press": "KeyE",
      "holdTicks": 2,
      "release": true
    },
    {
      "label": "in-hall",
      "waitForResource": {
        "id": "state",
        "path": "room",
        "equals": "East hall"
      },
      "release": true,
      "timeoutMs": 25000
    },
    {
      "kind": "wait",
      "label": "hall-settled",
      "waitTicks": 40,
      "release": true
    },
    {
      "kind": "input",
      "label": "face-door",
      "press": "KeyD",
      "holdTicks": 23,
      "release": true
    },
    {
      "kind": "input",
      "label": "walk-to-door",
      "press": "KeyW",
      "holdTicks": 84,
      "release": true
    },
    {
      "kind": "wait",
      "label": "at-door",
      "waitTicks": 5,
      "release": true
    },
    {
      "kind": "input",
      "label": "try",
      "press": "KeyE",
      "holdTicks": 2,
      "release": true
    },
    {
      "kind": "wait",
      "label": "locked",
      "waitTicks": 10,
      "release": true
    },
    {
      "kind": "input",
      "label": "probe-key",
      "press": "KeyK",
      "holdTicks": 2,
      "release": true
    },
    {
      "kind": "wait",
      "label": "has-key",
      "waitTicks": 5,
      "release": true
    },
    {
      "kind": "input",
      "label": "unlock",
      "press": "KeyE",
      "holdTicks": 2,
      "release": true
    },
    {
      "label": "in-back-hall",
      "waitForResource": {
        "id": "state",
        "path": "room",
        "equals": "Back hall"
      },
      "release": true,
      "timeoutMs": 25000
    },
    {
      "kind": "wait",
      "label": "door-done",
      "waitTicks": 50,
      "release": true
    },
    {
      "kind": "input",
      "label": "run",
      "press": ["KeyW", "ShiftLeft"],
      "holdTicks": 50,
      "release": true
    },
    {
      "kind": "wait",
      "label": "at-exit",
      "waitTicks": 5,
      "release": true
    },
    {
      "kind": "input",
      "label": "leave",
      "press": "KeyE",
      "holdTicks": 2,
      "release": true
    },
    {
      "label": "out",
      "waitForResource": {
        "id": "state",
        "path": "phase",
        "equals": "won"
      },
      "release": true,
      "timeoutMs": 25000
    },
    {
      "kind": "wait",
      "label": "end",
      "waitTicks": 10,
      "release": true
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "noRuntimeDiagnostics": true,
      "runtimeReady": true
    },
    "resources": [
      {
        "id": "state",
        "path": "lockedTries",
        "atSteps": [
          {
            "label": "locked",
            "equals": 1
          }
        ]
      },
      {
        "id": "state",
        "path": "message",
        "atSteps": [
          {
            "label": "locked",
            "textIncludes": "locked"
          }
        ]
      },
      {
        "id": "state",
        "path": "doorsOpened",
        "atSteps": [
          {
            "label": "door-done",
            "equals": 2
          }
        ]
      },
      {
        "id": "state",
        "path": "phase",
        "atSteps": [
          {
            "label": "end",
            "equals": "won"
          }
        ]
      }
    ],
    "signals": [
      {
        "name": "escaped",
        "entity": "player",
        "minCount": 1
      }
    ]
  }
}
