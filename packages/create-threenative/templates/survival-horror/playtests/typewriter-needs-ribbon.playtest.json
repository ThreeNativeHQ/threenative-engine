{
  "name": "typewriter-needs-ribbon",
  "target": "web",
  "schemaVersion": 1,
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "warmupFrames": 10,
  "subject": "player",
  "steps": [
    {
      "label": "ready",
      "waitForResource": {
        "id": "state",
        "path": "time",
        "gte": 0.3
      },
      "release": true,
      "timeoutMs": 45000
    },
    {
      "kind": "input",
      "label": "quick-turn",
      "press": [
        "KeyS",
        "ShiftLeft"
      ],
      "holdTicks": 4,
      "release": true
    },
    {
      "kind": "wait",
      "label": "turned",
      "waitTicks": 40,
      "release": true
    },
    {
      "kind": "input",
      "label": "walk-west",
      "press": "KeyW",
      "holdTicks": 260,
      "release": true
    },
    {
      "kind": "wait",
      "label": "at-wall",
      "waitTicks": 10,
      "release": true
    },
    {
      "kind": "input",
      "label": "face-typewriter",
      "press": "KeyA",
      "holdTicks": 47,
      "release": true
    },
    {
      "kind": "wait",
      "label": "facing",
      "waitTicks": 5,
      "release": true
    },
    {
      "kind": "input",
      "label": "save",
      "press": "KeyE",
      "holdTicks": 2,
      "release": true
    },
    {
      "kind": "wait",
      "label": "refused",
      "waitTicks": 10,
      "release": true
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "noRuntimeDiagnostics": true,
      "runtimeReady": true
    },
    "resources": [
      {
        "id": "state",
        "path": "saveCount",
        "atSteps": [
          {
            "label": "refused",
            "equals": 0
          }
        ]
      },
      {
        "id": "state",
        "path": "saveRefused",
        "atSteps": [
          {
            "label": "refused",
            "equals": 1
          }
        ]
      },
      {
        "id": "state",
        "path": "message",
        "atSteps": [
          {
            "label": "refused",
            "textIncludes": "Ink Ribbon"
          }
        ]
      }
    ]
  }
}
