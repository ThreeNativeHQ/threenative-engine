{
  "name": "fire-rate-cap",
  "target": "web",
  "schemaVersion": 1,
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "warmupFrames": 10,
  "subject": "player",
  "steps": [
    {
      "label": "ready",
      "waitForResource": {
        "id": "state",
        "path": "time",
        "gte": 0.3
      },
      "release": true,
      "timeoutMs": 45000
    },
    {
      "kind": "input",
      "label": "open-door",
      "press": "KeyE",
      "holdTicks": 2,
      "release": true
    },
    {
      "label": "in-hall",
      "waitForResource": {
        "id": "state",
        "path": "room",
        "equals": "East hall"
      },
      "release": true,
      "timeoutMs": 25000
    },
    {
      "kind": "wait",
      "label": "hall-settled",
      "waitTicks": 40,
      "release": true
    },
    {
      "kind": "input",
      "label": "raise",
      "press": ["KeyJ"],
      "holdTicks": 20,
      "release": false
    },
    {
      "kind": "input",
      "label": "tap-0",
      "press": ["KeyJ", "KeyE"],
      "holdTicks": 2,
      "release": false
    },
    {
      "kind": "input",
      "label": "gap-0",
      "press": ["KeyJ"],
      "holdTicks": 1,
      "release": false
    },
    {
      "kind": "input",
      "label": "tap-1",
      "press": ["KeyJ", "KeyE"],
      "holdTicks": 2,
      "release": false
    },
    {
      "kind": "input",
      "label": "gap-1",
      "press": ["KeyJ"],
      "holdTicks": 1,
      "release": false
    },
    {
      "kind": "input",
      "label": "tap-2",
      "press": ["KeyJ", "KeyE"],
      "holdTicks": 2,
      "release": false
    },
    {
      "kind": "input",
      "label": "gap-2",
      "press": ["KeyJ"],
      "holdTicks": 1,
      "release": false
    },
    {
      "kind": "input",
      "label": "tap-3",
      "press": ["KeyJ", "KeyE"],
      "holdTicks": 2,
      "release": false
    },
    {
      "kind": "input",
      "label": "gap-3",
      "press": ["KeyJ"],
      "holdTicks": 1,
      "release": false
    },
    {
      "kind": "input",
      "label": "tap-4",
      "press": ["KeyJ", "KeyE"],
      "holdTicks": 2,
      "release": false
    },
    {
      "kind": "input",
      "label": "gap-4",
      "press": ["KeyJ"],
      "holdTicks": 1,
      "release": false
    },
    {
      "kind": "input",
      "label": "tap-5",
      "press": ["KeyJ", "KeyE"],
      "holdTicks": 2,
      "release": false
    },
    {
      "kind": "input",
      "label": "gap-5",
      "press": ["KeyJ"],
      "holdTicks": 1,
      "release": false
    },
    {
      "kind": "input",
      "label": "tap-6",
      "press": ["KeyJ", "KeyE"],
      "holdTicks": 2,
      "release": false
    },
    {
      "kind": "input",
      "label": "gap-6",
      "press": ["KeyJ"],
      "holdTicks": 1,
      "release": false
    },
    {
      "kind": "input",
      "label": "tap-7",
      "press": ["KeyJ", "KeyE"],
      "holdTicks": 2,
      "release": false
    },
    {
      "kind": "input",
      "label": "gap-7",
      "press": ["KeyJ"],
      "holdTicks": 1,
      "release": false
    },
    {
      "kind": "input",
      "label": "tap-8",
