    },
    {
      "kind": "input",
      "label": "tap-9",
      "press": ["KeyJ", "KeyE"],
      "holdTicks": 2,
      "release": false
    },
    {
      "kind": "input",
      "label": "gap-9",
      "press": ["KeyJ"],
      "holdTicks": 1,
      "release": false
    },
    {
      "kind": "wait",
      "label": "settle",
      "waitTicks": 5,
      "release": true
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "noRuntimeDiagnostics": true,
      "runtimeReady": true
    },
    "resources": [
      {
        "id": "state",
        "path": "shots",
        "atSteps": [
          {
            "label": "settle",
            "lte": 2
          }
        ]
      }
    ],
    "signals": [
      {
        "name": "shot",
        "entity": "player",
        "minCount": 1
      }
    ]
  }
}
