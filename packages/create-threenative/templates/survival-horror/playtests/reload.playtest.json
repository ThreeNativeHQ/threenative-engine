{
  "name": "reload",
  "target": "web",
  "schemaVersion": 1,
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "warmupFrames": 10,
  "subject": "player",
  "steps": [
    {
      "label": "ready",
      "waitForResource": {
        "id": "state",
        "path": "time",
        "gte": 0.3
      },
      "release": true,
      "timeoutMs": 45000
    },
    {
      "kind": "input",
      "label": "reload",
      "press": "KeyR",
      "holdTicks": 2,
      "release": true
    },
    {
      "kind": "wait",
      "label": "reloading",
      "waitTicks": 30,
      "release": true
    },
    {
      "kind": "wait",
      "label": "reloaded",
      "waitTicks": 90,
      "release": true
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "noRuntimeDiagnostics": true,
      "runtimeReady": true
    },
    "resources": [
      {
        "id": "state",
        "path": "magazine",
        "atSteps": [
          {
            "label": "reloading",
            "equals": 10
          }
        ]
      },
      {
        "id": "state",
        "path": "magazine",
        "atSteps": [
          {
            "label": "reloaded",
            "equals": 15
          }
        ]
      },
      {
        "id": "state",
        "path": "reserve",
        "atSteps": [
          {
            "label": "reloaded",
            "equals": 10
          }
        ]
      }
    ],
    "components": [
      {
        "entity": "player",
        "component": "animation",
        "path": "current",
        "atSteps": [
          {
            "label": "reloading",
            "equals": "Pistol_Reload"
          }
        ]
      },
      {
        "entity": "player",
        "component": "reloads",
        "atSteps": [
          {
            "label": "reloaded",
            "equals": 1
          }
        ]
      }
    ]
  }
}
