{
  "name": "case-full-refuses",
  "target": "web",
  "schemaVersion": 1,
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "warmupFrames": 10,
  "subject": "player",
  "steps": [
    {
      "label": "ready",
      "waitForResource": {
        "id": "state",
        "path": "time",
        "gte": 0.3
      },
      "release": true,
      "timeoutMs": 45000
    },
    {
      "kind": "input",
      "label": "face-table",
      "press": "KeyA",
      "holdTicks": 47,
      "release": true
    },
    {
      "kind": "input",
      "label": "walk-to-table",
      "press": "KeyW",
      "holdTicks": 100,
      "release": true
    },
    {
      "kind": "wait",
      "label": "at-table",
      "waitTicks": 10,
      "release": true
    },
    {
      "kind": "input",
      "label": "take-1",
      "press": "KeyE",
      "holdTicks": 2,
      "release": true
    },
    {
      "kind": "wait",
      "label": "took-1",
      "waitTicks": 70,
      "release": true
    },
    {
      "kind": "input",
      "label": "take-2",
      "press": "KeyE",
      "holdTicks": 2,
      "release": true
    },
    {
      "kind": "wait",
      "label": "took-2",
      "waitTicks": 70,
      "release": true
    },
    {
      "kind": "input",
      "label": "take-3",
      "press": "KeyE",
      "holdTicks": 2,
      "release": true
    },
    {
      "kind": "wait",
      "label": "took-3",
      "waitTicks": 70,
      "release": true
    },
    {
      "kind": "input",
      "label": "take-4",
      "press": "KeyE",
      "holdTicks": 2,
      "release": true
    },
    {
      "kind": "wait",
      "label": "took-4",
      "waitTicks": 70,
      "release": true
    },
    {
      "kind": "input",
      "label": "take-5",
      "press": "KeyE",
      "holdTicks": 2,
      "release": true
    },
    {
      "kind": "wait",
      "label": "took-5",
      "waitTicks": 70,
      "release": true
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "noRuntimeDiagnostics": true,
      "runtimeReady": true
    },
    "resources": [
      {
        "id": "state",
        "path": "pickups",
        "atSteps": [
          {
            "label": "took-5",
            "equals": 4
          }
        ]
      },
      {
        "id": "state",
        "path": "refused",
        "atSteps": [
          {
            "label": "took-5",
            "equals": 1
          }
        ]
      },
      {
        "id": "state",
        "path": "reserve",
        "atSteps": [
          {
            "label": "took-5",
            "equals": 30
          }
        ]
      },
      {
        "id": "state",
        "path": "message",
        "atSteps": [
          {
            "label": "took-5",
            "textIncludes": "carry"
          }
        ]
      }
    ],
    "components": [
      {
        "entity": "player",
        "component": "animation",
        "path": "current",
        "atSteps": [
          {
            "label": "take-1",
            "equals": "PickUp_Table"
          }
        ]
      }
    ]
  }
}
