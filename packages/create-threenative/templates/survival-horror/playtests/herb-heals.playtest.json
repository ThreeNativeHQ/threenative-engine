{
  "name": "herb-heals",
  "target": "web",
  "schemaVersion": 1,
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "warmupFrames": 10,
  "subject": "player",
  "steps": [
    {
      "label": "ready",
      "waitForResource": {
        "id": "state",
        "path": "time",
        "gte": 0.3
      },
      "release": true,
      "timeoutMs": 45000
    },
    {
      "kind": "input",
      "label": "hurt-1",
      "press": "KeyH",
      "holdTicks": 2,
      "release": true
    },
    {
      "kind": "wait",
      "label": "h1",
      "waitTicks": 3,
      "release": true
    },
    {
      "kind": "input",
      "label": "hurt-2",
      "press": "KeyH",
      "holdTicks": 2,
      "release": true
    },
    {
      "kind": "wait",
      "label": "hurt",
      "waitTicks": 5,
      "release": true
    },
    {
      "kind": "input",
      "label": "open-case",
      "press": "KeyI",
      "holdTicks": 2,
      "release": true
    },
    {
      "kind": "wait",
      "label": "case",
      "waitTicks": 5,
      "release": true
    },
    {
      "kind": "input",
      "label": "down",
      "press": "KeyS",
      "holdTicks": 3,
      "release": true
    },
    {
      "kind": "wait",
      "label": "on-herb",
      "waitTicks": 3,
      "release": true
    },
    {
      "kind": "input",
      "label": "use",
      "press": "KeyE",
      "holdTicks": 2,
      "release": true
    },
    {
      "kind": "wait",
      "label": "used",
      "waitTicks": 5,
      "release": true
    },
    {
      "kind": "input",
      "label": "close",
      "press": "KeyI",
      "holdTicks": 2,
      "release": true
    },
    {
      "kind": "wait",
      "label": "closed",
      "waitTicks": 5,
      "release": true
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "noRuntimeDiagnostics": true,
      "runtimeReady": true
    },
    "resources": [
      {
        "id": "state",
        "path": "health",
        "atSteps": [
          {
            "label": "hurt",
            "equals": 60
          }
        ]
      },
      {
        "id": "state",
        "path": "menu",
        "atSteps": [
          {
            "label": "case",
            "equals": "inventory"
          }
        ]
      },
      {
        "id": "state",
        "path": "health",
        "atSteps": [
          {
            "label": "used",
            "equals": 85
          }
        ]
      },
      {
        "id": "state",
        "path": "herbsUsed",
        "atSteps": [
          {
            "label": "used",
            "equals": 1
          }
        ]
      },
      {
        "id": "state",
        "path": "condition",
        "atSteps": [
          {
            "label": "used",
            "equals": "fine"
          }
        ]
      },
      {
        "id": "state",
        "path": "menu",
        "atSteps": [
          {
            "label": "closed",
            "equals": "none"
          }
        ]
      }
    ],
    "signals": [
      {
        "name": "healed",
        "entity": "player",
        "minCount": 1
      }
    ]
  }
}
