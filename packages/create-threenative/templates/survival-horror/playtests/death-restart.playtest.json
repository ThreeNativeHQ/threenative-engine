{
  "name": "death-restart",
  "target": "web",
  "schemaVersion": 1,
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "warmupFrames": 10,
  "subject": "player",
  "steps": [
    {
      "label": "ready",
      "waitForResource": {
        "id": "state",
        "path": "time",
        "gte": 0.3
      },
      "release": true,
      "timeoutMs": 45000
    },
    {
      "kind": "input",
      "label": "open-door",
      "press": "KeyE",
      "holdTicks": 2,
      "release": true
    },
    {
      "kind": "wait",
      "label": "in-door",
      "waitTicks": 100,
      "release": true
    },
    {
      "kind": "input",
      "label": "enter-mid-play",
      "press": "Enter",
      "holdTicks": 2,
      "release": true
    },
    {
      "kind": "wait",
      "label": "ignored",
      "waitTicks": 10,
      "release": true
    },
    {
      "kind": "input",
      "label": "hurt-1",
      "press": "KeyH",
      "holdTicks": 2,
      "release": true
    },
    {
      "kind": "wait",
      "label": "h1",
      "waitTicks": 3,
      "release": true
    },
    {
      "kind": "input",
      "label": "hurt-2",
      "press": "KeyH",
      "holdTicks": 2,
      "release": true
    },
    {
      "kind": "wait",
      "label": "h2",
      "waitTicks": 3,
      "release": true
    },
    {
      "kind": "input",
      "label": "hurt-3",
      "press": "KeyH",
      "holdTicks": 2,
      "release": true
    },
    {
      "kind": "wait",
      "label": "h3",
      "waitTicks": 3,
      "release": true
    },
    {
      "kind": "input",
      "label": "hurt-4",
      "press": "KeyH",
      "holdTicks": 2,
      "release": true
    },
    {
      "kind": "wait",
      "label": "h4",
      "waitTicks": 3,
      "release": true
    },
    {
      "kind": "input",
      "label": "hurt-5",
      "press": "KeyH",
      "holdTicks": 2,
      "release": true
    },
    {
      "kind": "wait",
      "label": "h5",
      "waitTicks": 3,
      "release": true
    },
    {
      "kind": "wait",
      "label": "dead",
      "waitTicks": 60,
      "release": true
    },
    {
      "kind": "input",
      "label": "restart",
      "press": "Enter",
      "holdTicks": 2,
      "release": true
    },
    {
      "kind": "wait",
      "label": "restarted",
      "waitTicks": 60,
      "release": true
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "noRuntimeDiagnostics": true,
      "runtimeReady": true
    },
    "resources": [
      {
        "id": "state",
        "path": "doorsOpened",
        "atSteps": [
          {
            "label": "ignored",
            "equals": 1
          }
        ]
      },
      {
        "id": "state",
        "path": "phase",
        "atSteps": [
          {
            "label": "dead",
            "equals": "lost"
          }
        ]
      },
      {
        "id": "state",
        "path": "health",
        "atSteps": [
          {
            "label": "dead",
            "equals": 0
          }
        ]
      },
      {
        "id": "state",
        "path": "hasSave",
        "atSteps": [
          {
            "label": "dead",
            "equals": false
          }
        ]
      },
      {
        "id": "state",
        "path": "phase",
        "atSteps": [
          {
            "label": "restarted",
            "equals": "playing"
          }
        ]
      },
      {
        "id": "state",
        "path": "health",
        "atSteps": [
          {
            "label": "restarted",
            "equals": 100
          }
        ]
      },
      {
        "id": "state",
        "path": "doorsOpened",
        "atSteps": [
          {
            "label": "restarted",
            "equals": 0
          }
        ]
      }
    ],
    "components": [
      {
        "entity": "player",
        "component": "animation",
        "path": "current",
        "atSteps": [
          {
            "label": "dead",
            "equals": "Death01"
          }
        ]
      }
    ],
    "signals": [
      {
        "name": "died",
        "entity": "player",
        "minCount": 1
      }
    ]
  }
}
