{
  "name": "aim-fire-auto-target",
  "target": "web",
  "schemaVersion": 1,
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "warmupFrames": 10,
  "subject": "player",
  "steps": [
    {
      "label": "ready",
      "waitForResource": {
        "id": "state",
        "path": "time",
        "gte": 0.3
      },
      "release": true,
      "timeoutMs": 45000
    },
    {
      "kind": "input",
      "label": "open-door",
      "press": "KeyE",
      "holdTicks": 2,
      "release": true
    },
    {
      "label": "in-hall",
      "waitForResource": {
        "id": "state",
        "path": "room",
        "equals": "East hall"
      },
      "release": true,
      "timeoutMs": 25000
    },
    {
      "kind": "wait",
      "label": "hall-settled",
      "waitTicks": 40,
      "release": true
    },
    {
      "kind": "input",
      "label": "raise",
      "press": [
        "KeyJ"
      ],
      "holdTicks": 20,
      "release": false
    },
    {
      "kind": "input",
      "label": "shot-1",
      "press": [
        "KeyJ",
        "KeyE"
      ],
      "holdTicks": 2,
      "release": false
    },
    {
      "kind": "input",
      "label": "shot-1-hold",
      "press": [
        "KeyJ"
      ],
      "holdTicks": 30,
      "release": false,
      "screenshot": "aim-shot-1"
    },
    {
      "kind": "input",
      "label": "shot-2",
      "press": [
        "KeyJ",
        "KeyE"
      ],
      "holdTicks": 2,
      "release": false
    },
    {
      "kind": "input",
      "label": "shot-2-hold",
      "press": [
        "KeyJ"
      ],
      "holdTicks": 30,
      "release": false
    },
    {
      "kind": "input",
      "label": "shot-3",
      "press": [
        "KeyJ",
        "KeyE"
      ],
      "holdTicks": 2,
      "release": false
    },
    {
      "kind": "input",
      "label": "shot-3-hold",
      "press": [
        "KeyJ"
      ],
      "holdTicks": 30,
      "release": false
    },
    {
      "kind": "wait",
      "label": "settle",
      "waitTicks": 10,
      "release": true
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "noRuntimeDiagnostics": true,
      "runtimeReady": true
    },
    "resources": [
      {
        "id": "state",
        "path": "aiming",
        "atSteps": [
          {
            "label": "raise",
            "equals": 1
          }
        ]
      },
      {
        "id": "state",
        "path": "shots",
        "atSteps": [
          {
            "label": "shot-1-hold",
            "equals": 1
          }
        ]
      },
      {
        "id": "state",
        "path": "shots",
        "atSteps": [
          {
            "label": "settle",
            "equals": 3
          }
        ]
      },
      {
        "id": "state",
        "path": "magazine",
        "atSteps": [
          {
            "label": "settle",
            "equals": 7
          }
        ]
      }
    ],
    "components": [
      {
        "entity": "player",
        "component": "targeted",
        "atSteps": [
          {
            "label": "raise",
            "equals": true
          }
        ]
      },
      {
        "entity": "zombie.hall",
        "component": "heardShot",
        "atSteps": [
          {
            "label": "settle",
            "equals": true
          }
        ]
      }
    ],
    "signals": [
      {
        "name": "shot",
        "entity": "player",
        "minCount": 3
      },
      {
        "name": "hit",
        "entity": "player",
        "minCount": 2
      }
    ]
  }
}
