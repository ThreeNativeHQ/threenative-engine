{
  "name": "item-box",
  "target": "web",
  "schemaVersion": 1,
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "warmupFrames": 10,
  "subject": "player",
  "steps": [
    {
      "label": "ready",
      "waitForResource": {
        "id": "state",
        "path": "time",
        "gte": 0.3
      },
      "release": true,
      "timeoutMs": 45000
    },
    {
      "kind": "input",
      "label": "quick-turn",
      "press": [
        "KeyS",
        "ShiftLeft"
      ],
      "holdTicks": 4,
      "release": true
    },
    {
      "kind": "wait",
      "label": "turned",
      "waitTicks": 40,
      "release": true
    },
    {
      "kind": "input",
      "label": "walk-west",
      "press": "KeyW",
      "holdTicks": 260,
      "release": true
    },
    {
      "kind": "wait",
      "label": "at-wall",
      "waitTicks": 10,
      "release": true
    },
    {
      "kind": "input",
      "label": "face-box",
      "press": "KeyD",
      "holdTicks": 47,
      "release": true
    },
    {
      "kind": "wait",
      "label": "facing-box",
      "waitTicks": 5,
      "release": true
    },
    {
      "kind": "input",
      "label": "open-box",
      "press": "KeyE",
      "holdTicks": 2,
      "release": true
    },
    {
      "kind": "wait",
      "label": "box-open",
      "waitTicks": 10,
      "release": true
    },
    {
      "kind": "input",
      "label": "down-1",
      "press": "KeyS",
      "holdTicks": 3,
      "release": true
    },
    {
      "kind": "wait",
      "label": "g1",
      "waitTicks": 3,
      "release": true
    },
    {
      "kind": "input",
      "label": "store-herb",
      "press": "KeyE",
      "holdTicks": 2,
      "release": true
    },
    {
      "kind": "wait",
      "label": "stored",
      "waitTicks": 5,
      "release": true
    },
    {
      "kind": "input",
      "label": "to-box",
      "press": "KeyD",
      "holdTicks": 3,
      "release": true
    },
    {
      "kind": "wait",
      "label": "in-box",
      "waitTicks": 3,
      "release": true
    },
    {
      "kind": "input",
      "label": "take-herb",
      "press": "KeyE",
      "holdTicks": 2,
      "release": true
    },
    {
      "kind": "wait",
      "label": "retrieved",
      "waitTicks": 5,
      "release": true
    },
    {
      "kind": "input",
      "label": "close",
      "press": "KeyI",
      "holdTicks": 2,
      "release": true
    },
    {
      "kind": "wait",
      "label": "closed",
      "waitTicks": 10,
      "release": true
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "noRuntimeDiagnostics": true,
      "runtimeReady": true
    },
    "resources": [
      {
        "id": "state",
        "path": "menu",
        "atSteps": [
          {
            "label": "box-open",
            "equals": "box"
          }
        ]
      },
      {
        "id": "state",
        "path": "box.0.item",
        "atSteps": [
          {
            "label": "stored",
            "equals": "herb"
          }
        ]
      },
      {
        "id": "state",
        "path": "slots.1.item",
        "atSteps": [
          {
            "label": "stored",
            "equals": "ammo"
          }
        ]
      },
      {
        "id": "state",
        "path": "slots.2.item",
        "atSteps": [
          {
            "label": "retrieved",
            "equals": "herb"
          }
        ]
      },
      {
        "id": "state",
        "path": "menu",
        "atSteps": [
          {
            "label": "closed",
            "equals": "none"
          }
        ]
      }
    ],
    "signals": [
      {
        "name": "stored",
        "entity": "player",
        "minCount": 1
      },
      {
        "name": "retrieved",
        "entity": "player",
        "minCount": 1
      }
    ]
  }
}
