      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "noRuntimeDiagnostics": true,
      "runtimeReady": true
    },
    "components": [
      {
        "entity": "zombie.hall",
        "component": "state",
        "atSteps": [
          {
            "label": "shot-1-hold",
            "equals": "stagger"
          }
        ]
      },
      {
        "entity": "zombie.hall",
        "component": "state",
        "atSteps": [
          {
            "label": "lying",
            "equals": "down"
          }
        ]
      },
      {
        "entity": "zombie.hall",
        "component": "rose",
        "atSteps": [
