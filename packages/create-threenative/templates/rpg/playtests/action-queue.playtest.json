{
  "name": "action-queue",
  "warmupFrames": 10,
  "schemaVersion": 1,
  "target": "web",
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "subject": "hero",
  "steps": [
    {
      "label": "settled",
      "waitForResource": {
        "id": "state",
        "path": "missionTime",
        "gte": 0.5
      },
      "release": false,
      "timeoutMs": 5000
    },
    {
      "kind": "input",
      "label": "at-post",
      "press": "F1",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "input",
      "label": "q1",
      "press": "KeyF",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "input",
      "label": "q2",
      "press": "KeyF",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "wait",
      "label": "queued",
      "waitTicks": 6,
      "release": true
    },
    {
      "kind": "input",
      "label": "q3",
      "press": "KeyF",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "input",
      "label": "q4",
      "press": "KeyF",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "input",
      "label": "q5",
      "press": "KeyF",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "wait",
      "label": "full",
      "waitTicks": 6,
      "release": true
    },
    {
      "kind": "input",
      "label": "walk-away",
      "press": "ArrowRight",
      "holdTicks": 4,
      "release": true
    },
    {
      "kind": "wait",
      "label": "cleared",
      "waitTicks": 6,
      "release": true
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "runtimeReady": true
    },
    "components": [
      {
        "entity": "hero",
        "component": "queueLength",
        "atSteps": [
          {
            "label": "queued",
            "equals": 2
          },
          {
            "label": "full",
            "equals": 4
          },
          {
            "label": "cleared",
            "equals": 0
          }
        ]
      },
      {
        "entity": "hero",
        "component": "queued",
        "atSteps": [
          {
            "label": "queued",
            "equals": "attack:post"
          },
          {
            "label": "cleared",
            "equals": ""
          }
        ]
      }
    ]
  }
}
