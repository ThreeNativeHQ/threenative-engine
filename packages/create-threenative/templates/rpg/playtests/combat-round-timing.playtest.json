{
  "name": "combat-round-timing",
  "warmupFrames": 10,
  "schemaVersion": 1,
  "target": "web",
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "subject": "hero",
  "steps": [
    {
      "label": "settled",
      "waitForResource": {
        "id": "state",
        "path": "missionTime",
        "gte": 0.5
      },
      "release": false,
      "timeoutMs": 5000
    },
    {
      "kind": "input",
      "label": "at-post",
      "press": "F1",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "input",
      "label": "rig",
      "press": "F10",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "input",
      "label": "attack",
      "press": "KeyF",
      "holdTicks": 1,
      "release": true
    },
    {
      "label": "early",
      "waitForResource": {
        "id": "state",
        "path": "roundTime",
        "gte": 1.02
      },
      "release": false,
      "timeoutMs": 8000
    },
    {
      "label": "half",
      "waitForResource": {
        "id": "state",
        "path": "roundTime",
        "gte": 1.52
      },
      "release": false,
      "timeoutMs": 8000
    },
    {
      "label": "end",
      "waitForResource": {
        "id": "state",
        "path": "roundTime",
        "equals": 0
      },
      "release": false,
      "timeoutMs": 8000
    },
    {
      "kind": "wait",
      "label": "settled-down",
      "waitTicks": 4,
      "release": true
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "runtimeReady": true
    },
    "resources": [
      {
        "id": "state",
        "path": "roundTime",
        "atSteps": [
          {
            "label": "early",
            "lte": 1.4
          },
          {
            "label": "half",
            "lte": 1.6
          }
        ]
      },
      {
        "id": "state",
        "path": "lastRoll",
        "atSteps": [
          {
            "label": "early",
            "equals": 0
          },
          {
            "label": "half",
            "equals": 7
          },
          {
            "label": "end",
            "equals": 7
          }
        ]
      },
      {
        "id": "state",
        "path": "inCombat",
        "atSteps": [
          {
            "label": "early",
            "equals": 1
          }
        ]
      }
    ],
    "components": [
      {
        "entity": "hero",
        "component": "attacks",
        "atSteps": [
          {
            "label": "early",
            "equals": 0
          },
          {
            "label": "half",
            "equals": 1
          },
          {
            "label": "end",
            "equals": 1
          }
        ]
      },
      {
        "entity": "hero",
        "component": "queueLength",
        "atSteps": [
          {
            "label": "early",
            "equals": 1
          },
          {
            "label": "settled-down",
            "equals": 0
          }
        ]
      }
    ]
  }
}
