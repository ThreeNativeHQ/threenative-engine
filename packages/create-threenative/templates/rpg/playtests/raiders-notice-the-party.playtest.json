{
  "name": "raiders-notice-the-party",
  "warmupFrames": 10,
  "schemaVersion": 1,
  "target": "web",
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "subject": "hero",
  "steps": [
    {
      "label": "settled",
      "waitForResource": {
        "id": "state",
        "path": "missionTime",
        "gte": 0.5
      },
      "release": false,
      "timeoutMs": 5000
    },
    {
      "kind": "input",
      "label": "on-the-road",
      "press": "F5",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "wait",
      "label": "far",
      "waitTicks": 20,
      "release": true
    },
    {
      "kind": "input",
      "label": "step-in",
      "press": "ArrowUp",
      "holdTicks": 30,
      "release": true
    },
    {
      "kind": "wait",
      "label": "seen",
      "waitTicks": 20,
      "release": true
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "runtimeReady": true
    },
    "resources": [
      {
        "id": "state",
        "path": "inCombat",
        "atSteps": [
          {
            "label": "far",
            "equals": 0
          },
          {
            "label": "seen",
            "equals": 1
          }
        ]
      }
    ],
    "components": [
      {
        "entity": "raider.2",
        "component": "queueLength",
        "atSteps": [
          {
            "label": "far",
            "equals": 0
          },
          {
            "label": "seen",
            "equals": 1
          }
        ]
      }
    ]
  }
}
