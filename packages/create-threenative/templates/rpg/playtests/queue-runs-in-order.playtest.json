{
  "name": "queue-runs-in-order",
  "warmupFrames": 10,
  "schemaVersion": 1,
  "target": "web",
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "subject": "hero",
  "steps": [
    {
      "label": "settled",
      "waitForResource": {
        "id": "state",
        "path": "missionTime",
        "gte": 0.5
      },
      "release": false,
      "timeoutMs": 5000
    },
    {
      "kind": "input",
      "label": "at-post",
      "press": "F1",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "input",
      "label": "wound",
      "press": "Digit8",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "input",
      "label": "rig",
      "press": "F10",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "input",
      "label": "attack",
      "press": "KeyF",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "input",
      "label": "heal",
      "press": "KeyG",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "wait",
      "label": "queued",
      "waitTicks": 6,
      "release": true
    },
    {
      "label": "half",
      "waitForResource": {
        "id": "state",
        "path": "roundTime",
        "gte": 1.52
      },
      "release": false,
      "timeoutMs": 8000
    },
    {
      "label": "healed",
      "waitForResource": {
        "id": "state",
        "path": "medpacks",
        "equals": 2
      },
      "release": false,
      "timeoutMs": 12000
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "runtimeReady": true
    },
    "components": [
      {
        "entity": "hero",
        "component": "queueLength",
        "atSteps": [
          {
            "label": "queued",
            "equals": 2
          }
        ]
      },
      {
        "entity": "hero",
        "component": "queued",
        "atSteps": [
          {
            "label": "queued",
            "equals": "attack:post"
          }
        ]
      },
      {
        "entity": "hero",
        "component": "hp",
        "atSteps": [
          {
            "label": "queued",
            "equals": 26
          },
          {
            "label": "half",
            "equals": 26
          },
          {
            "label": "healed",
            "equals": 36
          }
        ]
      }
    ]
  }
}
