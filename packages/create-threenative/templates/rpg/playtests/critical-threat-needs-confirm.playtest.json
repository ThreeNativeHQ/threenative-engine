{
  "name": "critical-threat-needs-confirm",
  "warmupFrames": 10,
  "schemaVersion": 1,
  "target": "web",
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "subject": "hero",
  "steps": [
    {
      "label": "settled",
      "waitForResource": {
        "id": "state",
        "path": "missionTime",
        "gte": 0.5
      },
      "release": false,
      "timeoutMs": 5000
    },
    {
      "kind": "input",
      "label": "at-post",
      "press": "F1",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "input",
      "label": "rig-threat",
      "press": "F11",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "input",
      "label": "attack-1",
      "press": "KeyF",
      "holdTicks": 1,
      "release": true
    },
    {
      "label": "threat",
      "waitForResource": {
        "id": "state",
        "path": "lastRoll",
        "equals": 19
      },
      "release": false,
      "timeoutMs": 8000
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "runtimeReady": true
    },
    "resources": [
      {
        "id": "state",
        "path": "lastOutcome",
        "atSteps": [
          {
            "label": "threat",
            "equals": "hit"
          }
        ]
      },
      {
        "id": "state",
        "path": "lastDamage",
        "atSteps": [
          {
            "label": "threat",
            "equals": 6
          }
        ]
      },
      {
        "id": "state",
        "path": "lastAutomatic",
        "atSteps": [
          {
            "label": "threat",
            "equals": ""
          }
        ]
      }
    ]
  }
}
