{
  "name": "fallen-leader-then-fallen-party",
  "warmupFrames": 10,
  "schemaVersion": 1,
  "target": "web",
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "subject": "hero",
  "steps": [
    {
      "label": "settled",
      "waitForResource": {
        "id": "state",
        "path": "missionTime",
        "gte": 0.5
      },
      "release": false,
      "timeoutMs": 5000
    },
    {
      "kind": "input",
      "label": "hero-falls",
      "press": "Digit0",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "wait",
      "label": "handed-on",
      "waitTicks": 8,
      "release": true
    },
    {
      "kind": "input",
      "label": "ally-falls",
      "press": "Digit0",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "wait",
      "label": "lost",
      "waitTicks": 8,
      "release": true
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "runtimeReady": true
    },
    "resources": [
      {
        "id": "state",
        "path": "leader",
        "atSteps": [
          {
            "label": "handed-on",
            "equals": "ally"
          }
        ]
      },
      {
        "id": "state",
        "path": "phase",
        "atSteps": [
          {
            "label": "handed-on",
            "equals": "playing"
          },
          {
            "label": "lost",
            "equals": "lost"
          }
        ]
      }
    ],
    "components": [
      {
        "entity": "hero",
        "component": "state",
        "atSteps": [
          {
            "label": "handed-on",
            "equals": "down"
          }
        ]
      }
    ]
  }
}
