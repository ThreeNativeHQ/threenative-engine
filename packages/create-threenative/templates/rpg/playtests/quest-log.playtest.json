{
  "name": "quest-log",
  "warmupFrames": 10,
  "schemaVersion": 1,
  "target": "web",
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "subject": "hero",
  "steps": [
    {
      "label": "settled",
      "waitForResource": {
        "id": "state",
        "path": "missionTime",
        "gte": 0.5
      },
      "release": false,
      "timeoutMs": 5000
    },
    {
      "kind": "input",
      "label": "to-elder",
      "press": "F2",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "input",
      "label": "talk",
      "press": "KeyE",
      "holdTicks": 1,
      "release": true
    },
    {
      "label": "talking",
      "waitForResource": {
        "id": "state",
        "path": "shot",
        "equals": "dialogue"
      },
      "release": false,
      "timeoutMs": 8000
    },
    {
      "kind": "input",
      "label": "accept",
      "press": "Digit1",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "wait",
      "label": "started",
      "waitTicks": 4,
      "release": true
    },
    {
      "kind": "input",
      "label": "farewell",
      "press": "Digit1",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "input",
      "label": "journal",
      "press": "KeyJ",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "wait",
      "label": "journal-open",
      "waitTicks": 4,
      "release": true
    },
    {
      "kind": "input",
      "label": "clear-ruin",
      "press": "Digit9",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "wait",
      "label": "cleared",
      "waitTicks": 4,
      "release": true
    },
    {
      "kind": "input",
      "label": "report",
      "press": "KeyE",
      "holdTicks": 1,
      "release": true
    },
    {
      "label": "reporting",
      "waitForResource": {
        "id": "state",
        "path": "shot",
        "equals": "dialogue"
      },
      "release": false,
      "timeoutMs": 8000
    },
    {
      "kind": "input",
      "label": "done",
      "press": "Digit1",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "wait",
      "label": "rewarded",
      "waitTicks": 4,
      "release": true
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "runtimeReady": true
    },
    "resources": [
      {
        "id": "state",
        "path": "questStage",
        "atSteps": [
          {
            "label": "started",
            "equals": 1
          },
          {
            "label": "cleared",
            "equals": 2
          },
          {
            "label": "rewarded",
            "equals": 3
          }
        ]
      },
      {
        "id": "state",
        "path": "journalLines",
        "atSteps": [
          {
            "label": "started",
            "equals": 1
          },
          {
            "label": "cleared",
            "equals": 2
          },
          {
            "label": "rewarded",
            "equals": 3
          }
        ]
      },
      {
        "id": "state",
        "path": "journalOpen",
        "atSteps": [
          {
            "label": "started",
            "equals": 0
          },
          {
            "label": "journal-open",
            "equals": 1
          }
        ]
      },
      {
        "id": "state",
        "path": "kills",
        "atSteps": [
          {
            "label": "started",
            "equals": 0
          },
          {
            "label": "cleared",
            "equals": 3
          }
        ]
      },
      {
        "id": "state",
        "path": "coins",
        "atSteps": [
          {
            "label": "cleared",
            "equals": 0
          },
          {
            "label": "rewarded",
            "equals": 50
          }
        ]
      },
      {
        "id": "state",
        "path": "phase",
        "atSteps": [
          {
            "label": "cleared",
            "equals": "playing"
          },
          {
            "label": "rewarded",
            "equals": "won"
          }
        ]
      }
    ]
  }
}
