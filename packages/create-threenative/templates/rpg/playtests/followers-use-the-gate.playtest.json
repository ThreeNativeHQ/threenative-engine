{
  "name": "followers-use-the-gate",
  "warmupFrames": 10,
  "schemaVersion": 1,
  "target": "web",
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "subject": "hero",
  "steps": [
    {
      "label": "settled",
      "waitForResource": {
        "id": "state",
        "path": "missionTime",
        "gte": 0.5
      },
      "release": false,
      "timeoutMs": 5000
    },
    {
      "kind": "input",
      "label": "leader-inside",
      "press": "Digit5",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "wait",
      "label": "walking",
      "waitTicks": 480,
      "release": true
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "runtimeReady": true
    },
    "resources": [
      {
        "id": "state",
        "path": "followGap",
        "atSteps": [
          {
            "label": "walking",
            "lte": 5.8
          }
        ]
      }
    ],
    "components": [
      {
        "entity": "ally",
        "component": "queued",
        "atSteps": [
          {
            "label": "walking",
            "equals": "follow"
          }
        ]
      }
    ]
  }
}
