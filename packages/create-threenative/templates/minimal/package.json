{
  "name": "__PROJECT_NAME__",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "studio": "threenative-studio",
    "build": "threenative build",
    "build:web": "threenative build --target web",
    "build:desktop": "threenative build --target desktop",
    "build:android": "threenative build --target android",
    "build:ios": "threenative build --target ios",
    "pretest": "playwright install chromium",
    "test": "pnpm build:web && threenative-playtest --scenario \"playtests/*.playtest.json\" --browser-recipe webgpu --headed --server-command \"pnpm exec vite preview --host 127.0.0.1 --port $PORT --strictPort\"",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@threenative/core": "0.3.5",
    "@threenative/physics": "0.3.5",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@threenative/assets": "0.3.6",
    "@threenative/playtest": "0.3.5",
    "@types/three": "0.185.3",
    "create-threenative": "0.2.9",
    "esbuild": "0.27.0",
    "playwright": "1.62.1",
    "typescript": "7.0.2",
    "vite": "8.2.0",
    "@gltf-transform/cli": "4.4.2"
  },
  "optionalDependencies": {
    "@threenative/runtime-native": "0.3.5"
  },
  "overrides": {
    "sharp": ">=0.35.4"
  },
  "pnpm": {
    "overrides": {
      "sharp": ">=0.35.4"
    },
    "onlyBuiltDependencies": ["@threenative/core", "@threenative/runtime-native"],
    "patchedDependencies": {
      "three@0.185.1": "patches/three@0.185.1.patch",
      "vite@8.2.0": "patches/vite@8.2.0.patch"
    }
  }
}
