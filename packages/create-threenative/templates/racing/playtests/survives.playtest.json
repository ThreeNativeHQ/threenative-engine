{
  "name": "survives",
  "target": "web",
  "schemaVersion": 1,
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "warmupFrames": 10,
  "subject": "player",
  "steps": [
    {
      "kind": "input",
      "label": "move",
      "press": "ArrowUp",
      "holdTicks": 60,
      "release": true
    },
    {
      "kind": "wait",
      "label": "settle",
      "waitTicks": 10,
      "release": true
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "noRuntimeDiagnostics": true,
      "runtimeReady": true
    },
    "components": [
      {
        "allowTrivial": "The vehicle is authored at its real 4.4 m length and normalised down to the conventional 3 m, so the retained factor is below one; either side of one proves normaliseToMetres ran in the generated car.",
        "component": "normaliseFactor",
        "entity": "player",
        "lte": 0.99
      },
      {
        "allowTrivial": "The gap is held near zero by the sun target's world matrix; the target sits at the origin, tens of metres from the car, until a scene traversal refreshes it.",
        "component": "targetGap",
        "entity": "sun",
        "lte": 1.5
      }
    ],
    "movement": {
      "entity": "player",
      "minDistance": 0.5
    },
    "visibility": [
      {
        "entity": "touch-controls",
        "present": false,
        "allowTrivial": "Desktop keyboard lanes intentionally omit touch controls while movement proves the scene is active."
      }
    ],
    "visual": [
      {
        "region": {
          "x": 0,
          "y": 0,
          "width": 1280,
          "height": 720,
          "minNonblankPixelRatio": 0.01
        }
      }
    ]
  }
}
