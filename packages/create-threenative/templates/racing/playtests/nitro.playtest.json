{
  "name": "nitro",
  "target": "web",
  "schemaVersion": 1,
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "warmupFrames": 10,
  "subject": "player",
  "steps": [
    {
      "kind": "input",
      "label": "cruise",
      "press": ["ArrowUp"],
      "holdTicks": 30,
      "release": false
    },
    {
      "kind": "input",
      "label": "nitro",
      "press": ["ArrowUp", "Space"],
      "holdTicks": 120,
      "release": false
    },
    {
      "kind": "input",
      "label": "coast",
      "press": ["ArrowUp"],
      "holdTicks": 60,
      "release": true
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "runtimeReady": true
    },
    "resources": [
      {
        "id": "state",
        "path": "nitro",
        "lte": 0.8,
        "changed": true
      },
      {
        "id": "state",
        "path": "nitroActive",
        "atSteps": [
          {
            "label": "cruise",
            "equals": false
          },
          {
            "label": "nitro",
            "equals": true
          },
          {
            "label": "coast",
            "equals": false
          }
        ]
      },
      {
        "id": "state",
        "path": "topSpeed",
        "gte": 26.5
      }
    ],
    "components": [
      {
        "entity": "effects",
        "component": "flameTicks",
        "gte": 60
      }
    ]
  }
}
