{
  "name": "drift",
  "target": "web",
  "schemaVersion": 1,
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "warmupFrames": 10,
  "subject": "player",
  "steps": [
    {
      "kind": "input",
      "label": "straight",
      "press": ["ArrowUp"],
      "holdTicks": 170,
      "release": false
    },
    {
      "kind": "input",
      "label": "kick",
      "press": ["ArrowUp", "ArrowRight", "ShiftLeft"],
      "holdTicks": 8,
      "release": false
    },
    {
      "kind": "input",
      "label": "hold",
      "press": ["ArrowUp", "ArrowRight"],
      "holdTicks": 22,
      "release": false
    },
    {
      "kind": "input",
      "label": "catch",
      "press": ["ArrowUp", "ArrowLeft"],
      "holdTicks": 14,
      "release": false
    },
    {
      "kind": "input",
      "label": "straighten",
      "press": ["ArrowUp"],
      "holdTicks": 60,
      "release": true
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "runtimeReady": true
    },
    "resources": [
      {
        "id": "state",
        "path": "driftsBanked",
        "gte": 1,
        "changed": true
      },
      {
        "id": "state",
        "path": "driftSpins",
        "equals": 0,
        "allowTrivial": "A spin is the failure this scenario looks for; zero is the held invariant while the banked drift above proves the slide happened."
      },
      {
        "id": "state",
        "path": "drifting",
        "atSteps": [
          {
            "label": "straight",
            "equals": false
          },
          {
            "label": "hold",
            "equals": true
          }
        ]
      }
    ],
    "components": [
      {
        "entity": "effects",
        "component": "skidMarks",
        "gte": 5,
        "atSteps": [
          {
            "label": "straight",
            "equals": 0
          }
        ]
      },
      {
        "entity": "effects",
        "component": "smokeTicks",
        "gte": 5
      }
    ]
  }
}
