{
  "name": "racing-finish-behind-rival-is-dnf",
  "schemaVersion": 1,
  "target": "web",
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "warmupFrames": 10,
  "subject": "player",
  "steps": [
    {
      "kind": "input",
      "label": "autopilot",
      "press": "KeyP",
      "holdTicks": 2,
      "release": true
    },
    {
      "kind": "wait",
      "label": "three-laps",
      "waitTicks": 10600,
      "release": true
    },
    {
      "kind": "wait",
      "label": "observe-dnf",
      "waitTicks": 20,
      "release": true
    },
    {
      "kind": "wait",
      "label": "after-finish",
      "waitTicks": 600,
      "release": true
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "runtimeReady": true
    },
    "resources": [
      {
        "id": "state",
        "path": "completedLaps",
        "gte": 3,
        "changed": true
      },
      {
        "id": "state",
        "path": "place",
        "equals": 2,
        "allowTrivial": "The demo driver starts second on the grid and stays there, so the place is a held invariant; the DNF transition below is what proves the finish."
      },
      {
        "id": "state",
        "path": "rescues",
        "equals": 0,
        "allowTrivial": "The outcome path uses no rescue action; zero rescues is the intentional held invariant while laps and finish prove the result."
      },
      {
        "id": "state",
        "path": "raceStatus",
        "equals": "DNF",
        "changed": true,
        "atSteps": [
          {
            "label": "observe-dnf",
            "equals": "DNF"
          }
        ]
      },
      {
        "id": "state",
        "path": "elapsed",
        "lte": 177.5,
        "allowTrivial": "The race ended inside 10,620 ticks (177 s); ten seconds later the clock still reads the finishing time, not a clock that kept running."
      }
    ],
    "hud": [
      {
        "id": "outcome",
        "equals": "P2",
        "allowTrivial": "The player finished every lap behind the rival: the panel names the place, not DNF, which reads as did-not-finish."
      }
    ]
  }
}
