{
  "name": "native-render-chain",
  "target": "desktop",
  "schemaVersion": 1,
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "warmupFrames": 2,
  "startTick": 600,
  "steps": [
    {
      "kind": "input",
      "label": "move-across-the-platform",
      "press": "ArrowUp",
      "holdTicks": 60,
      "release": true
    },
    {
      "label": "frame-settles",
      "waitTicks": 600
    }
  ],
  "artifacts": {
    "screenshots": "after"
  },
  "assert": {
    "renderChain": {
      "tier": "high",
      "perAdapter": {
        "integrated": {
          "contributions": { "graphOutputChanged": ["grade", "grain"] },
          "stages": {
            "includes": ["ambientOcclusion", "bloom", "vignette", "grade", "grain"],
            "order": ["ambientOcclusion", "bloom", "vignette", "grade", "grain"]
          },
          "tier": "medium"
        },
        "mobile-high": {
          "contributions": { "graphOutputChanged": ["grade", "grain"] },
          "stages": {
            "includes": ["ambientOcclusion", "bloom", "vignette", "grade", "grain"],
            "order": ["ambientOcclusion", "bloom", "vignette", "grade", "grain"]
          },
          "tier": "medium"
        },
        "mobile-low": {
          "contributions": { "graphOutputChanged": ["grade"] },
          "stages": {
            "includes": ["bloom", "vignette", "grade"],
            "excludes": ["ambientOcclusion", "grain"],
            "order": ["bloom", "vignette", "grade"]
          },
          "tier": "low"
        },
        "mobile-mid": {
          "contributions": { "graphOutputChanged": ["grade"] },
          "stages": {
            "includes": ["bloom", "vignette", "grade"],
            "excludes": ["ambientOcclusion", "grain"],
            "order": ["bloom", "vignette", "grade"]
          },
          "tier": "low"
        },
        "software": {
          "contributions": { "graphOutputChanged": ["grade"] },
          "stages": {
            "includes": ["bloom", "vignette", "grade"],
            "excludes": ["ambientOcclusion", "grain"],
            "order": ["bloom", "vignette", "grade"]
          },
          "tier": "low"
        }
      },
      "stages": {
        "includes": ["ambientOcclusion", "bloom", "vignette", "grade", "grain"],
        "order": ["ambientOcclusion", "bloom", "vignette", "grade", "grain"]
      },
      "contributions": {
        "graphOutputChanged": ["grade", "grain"]
      }
    },
    "resources": [
      {
        "id": "state",
        "path": "odometer",
        "gte": 1,
        "changed": true
      }
    ]
  }
}
