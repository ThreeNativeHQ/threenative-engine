{
  "name": "native-app-lifecycle",
  "target": "desktop",
  "schemaVersion": 1,
  "warmupFrames": 0,
  "steps": [
    { "label": "playing", "waitTicks": 120 },
    { "kind": "lifecycle", "lifecycle": { "operation": "background" } },
    { "kind": "lifecycle", "lifecycle": { "operation": "foreground" } },
    { "label": "resumed", "waitTicks": 30 }
  ],
  "assert": {
    "resources": [
      {
        "id": "state",
        "path": "saves",
        "atSteps": [{ "label": "playing", "equals": 0 }, { "label": "resumed", "equals": 1 }]
      },
      {
        "id": "state",
        "path": "restored",
        "atSteps": [{ "label": "playing", "equals": false }, { "label": "resumed", "equals": true }]
      }
    ]
  }
}
