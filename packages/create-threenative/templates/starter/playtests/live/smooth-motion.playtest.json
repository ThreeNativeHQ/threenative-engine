{
  "schemaVersion": 1,
  "name": "smooth-motion",
  "target": "web",
  "subject": "player",
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "warmupFrames": 60,
  "steps": [
    {
      "kind": "wait",
      "label": "ready",
      "waitTicks": 240,
      "release": true
    },
    {
      "kind": "input",
      "label": "clear-crate",
      "press": ["KeyS"],
      "holdTicks": 35,
      "release": true
    },
    {
      "kind": "input",
      "label": "steady-walk",
      "press": ["KeyD"],
      "holdTicks": 180,
      "release": true
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "runtimeReady": true
    },
    "movement": {
      "entity": "player",
      "minDistance": 3
    },
    "components": [
      {
        "entity": "smooth-motion",
        "component": "samples",
        "gte": 21
      },
      {
        "entity": "smooth-motion",
        "component": "playerCv",
        "gte": 0,
        "lte": 0.1
      },
      {
        "entity": "smooth-motion",
        "component": "cameraCv",
        "gte": 0,
        "lte": 0.1
      }
    ]
  }
}
