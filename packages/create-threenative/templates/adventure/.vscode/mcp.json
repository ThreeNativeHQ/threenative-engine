{
  "servers": {
    "threenative-assets": {
      "type": "stdio",
      "command": "node",
      "args": [
        "./node_modules/@threenative/core/mcp/assets.mjs"
      ],
      "env": {
        "ASSET_DOWNLOAD_DIR": "./public/assets",
        "AUDIO_DOWNLOAD_DIR": "./public/audio"
      }
    },
    "threenative-sculpt": {
      "type": "stdio",
      "command": "node",
      "args": [
        "./node_modules/@threenative/core/mcp/sculpt.mjs"
      ]
    },
    "threenative-engine": {
      "type": "stdio",
      "command": "node",
      "args": [
        "./node_modules/@threenative/core/mcp/engine.mjs"
      ]
    },
    "threenative-blender": {
      "type": "stdio",
      "command": "node",
      "args": [
        "./node_modules/@threenative/core/mcp/blender.mjs"
      ]
    }
  }
}
