{
  "name": "adventure-native-survives",
  "target": "desktop",
  "schemaVersion": 1,
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "warmupFrames": 10,
  "subject": "player",
  "artifacts": {
    "screenshots": "after"
  },
  "steps": [
    {
      "kind": "input",
      "label": "run",
      "press": "ArrowUp",
      "holdTicks": 60,
      "release": true
    },
    {
      "kind": "wait",
      "label": "stand",
      "waitTicks": 240,
      "release": true
    }
  ],
  "assert": {
    "components": [
      {
        "entity": "player",
        "component": "feetY",
        "gte": -0.3,
        "lte": 0.3,
        "allowTrivial": "The capsule's origin is Wren's waist, so feet near zero after 300 ticks prove she stands on the clearing floor on the native host too."
      }
    ],
    "movement": {
      "entity": "player",
      "minDistance": 2
    }
  }
}
