{
  "name": "hearts",
  "target": "web",
  "schemaVersion": 1,
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "warmupFrames": 10,
  "subject": "player",
  "setup": {
    "spawn": {
      "x": 100,
      "y": 0.9,
      "z": -5
    },
    "place": [
      {
        "entity": "mossling.2",
        "at": {
          "x": 100,
          "y": 0.42,
          "z": -4
        }
      },
      {
        "entity": "flicker.1",
        "at": {
          "x": 96,
          "y": 1.9,
          "z": -5
        },
        "frozen": true
      },
      {
        "entity": "thornback.1",
        "at": {
          "x": 104,
          "y": 0.55,
          "z": -9
        },
        "frozen": true
      }
    ]
  },
  "steps": [
    {
      "kind": "input",
      "label": "behind",
      "press": ["ShiftLeft"],
      "holdTicks": 40,
      "release": false
    },
    {
      "kind": "input",
      "label": "face",
      "press": ["KeyQ", "ArrowUp"],
      "holdTicks": 30,
      "release": false
    },
    {
      "kind": "input",
      "label": "shield-front",
      "press": ["KeyQ", "ShiftLeft"],
      "holdTicks": 90,
      "release": false
    },
    {
      "kind": "input",
      "label": "let-go",
      "press": [],
      "holdTicks": 2,
      "release": false
    },
    {
      "label": "fallen",
      "waitForResource": {
        "id": "state",
        "path": "respawns",
        "gte": 1
      },
      "timeoutMs": 60000,
      "release": false
    },
    {
      "kind": "input",
      "label": "end",
      "press": [],
      "holdTicks": 5,
      "release": true
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "noRuntimeDiagnostics": true,
      "runtimeReady": true
    },
    "resources": [
      {
        "id": "state",
        "path": "hearts",
        "equals": 3,
        "atSteps": [
          {
            "label": "behind",
            "equals": 2.5
          },
          {
            "label": "shield-front",
            "equals": 2.5
          },
          {
            "label": "fallen",
            "equals": 3
          }
        ],
        "allowTrivial": "Full hearts at the start and after the respawn; the per-step values prove the half-heart cost, the free shield block and the refill."
      },
      {
        "id": "state",
        "path": "shieldBlocks",
        "gte": 1,
        "atSteps": [
          {
            "label": "behind",
            "equals": 0
          },
          {
            "label": "shield-front",
            "equals": 1
          }
        ]
      },
      {
        "id": "state",
        "path": "hitsTaken",
        "gte": 6
      },
      {
        "id": "state",
        "path": "respawns",
        "equals": 1
      },
      {
        "id": "state",
        "path": "lastRespawn",
        "equals": "hollow-entry",
        "atSteps": [
          {
            "label": "shield-front",
            "equals": ""
          }
        ]
      },
      {
        "id": "state",
        "path": "cameraBlocked",
        "lte": 0,
        "allowTrivial": "Ticks with something solid between Wren's head and the lens; a running count, 0 at the start."
      },
      {
        "id": "state",
        "path": "nearWallWorst",
        "lte": 0.2,
        "allowTrivial": "The most of the frame that walls in the front half of the way from the lens to Wren covered (a 24-ray grid, every 6th tick), so the camera never films her through a doorway; a running maximum, 0 at the start."
      }
    ]
  }
}
