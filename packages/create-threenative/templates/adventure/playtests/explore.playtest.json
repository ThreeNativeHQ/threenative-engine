      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "noRuntimeDiagnostics": true,
      "runtimeReady": true
    },
    "movement": {
      "entity": "player",
      "minDistance": 5
    },
    "visual": [
      {
        "region": {
          "x": 160,
          "y": 90,
          "width": 960,
          "height": 540,
          "minSharpness": 0.3
        }
      }
    ]
  }
}
