{
  "name": "adventure-explore",
  "target": "web",
  "schemaVersion": 1,
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "warmupFrames": 10,
  "subject": "player",
  "steps": [
    {
      "kind": "explore",
      "label": "explored",
      "seed": 1,
      "ticks": 7200,
      "move": ["KeyW", "KeyA", "KeyS", "KeyD"],
      "actions": ["KeyJ", "Space", "ShiftLeft", "KeyQ", "Tab", "KeyE"],
