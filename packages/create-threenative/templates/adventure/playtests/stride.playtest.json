{
  "name": "adventure-stride",
  "target": "web",
  "schemaVersion": 1,
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "warmupFrames": 10,
  "subject": "player",
  "steps": [
    {
      "kind": "input",
      "label": "accelerate",
      "press": "KeyW",
      "holdTicks": 30,
      "release": false
    },
    {
      "kind": "input",
      "label": "run",
      "press": "KeyW",
      "holdTicks": 90,
      "release": true
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "noRuntimeDiagnostics": true,
      "runtimeReady": true
    },
    "components": [
      {
        "entity": "player",
        "component": "stride",
        "path": "clip",
        "equals": "run",
        "changed": true
      },
      {
        "entity": "player",
        "component": "stride",
        "path": "synced",
        "equals": true,
        "changed": true
      },
      {
        "entity": "player",
        "component": "stride",
        "path": "footRatio",
        "gte": 0.9,
        "lte": 1.1,
        "allowTrivial": "Standing reads 1; at a run the planted foot sweeps within 10% of the ground speed."
      }
    ],
    "footSlip": [
      {
        "atStep": "run",
        "feet": ["footL", "footR"],
        "maxSlideSpeed": 1,
        "maxSlip": 0.35
      }
    ]
  }
}
