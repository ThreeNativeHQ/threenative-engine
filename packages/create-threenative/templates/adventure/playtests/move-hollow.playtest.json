{
  "name": "move-hollow",
  "target": "web",
  "schemaVersion": 1,
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "warmupFrames": 10,
  "subject": "player",
  "setup": {
    "spawn": {
      "x": 100,
      "y": 0.9,
      "z": -2
    },
    "place": [
      {
        "entity": "mossling.2",
        "at": {
          "x": 104,
          "y": 0.42,
          "z": -20
        },
        "frozen": true
      },
      {
        "entity": "flicker.1",
        "at": {
          "x": 96,
          "y": 1.9,
          "z": -5
        },
        "frozen": true
      },
      {
        "entity": "thornback.1",
        "at": {
          "x": 104,
          "y": 0.55,
          "z": -9
        },
        "frozen": true
      }
    ]
  },
  "steps": [
    {
      "kind": "input",
      "label": "run-north",
      "press": "ArrowUp",
      "holdTicks": 90,
      "release": true
    },
    {
      "kind": "wait",
      "label": "settle",
      "waitTicks": 30,
      "release": true
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "noRuntimeDiagnostics": true,
      "runtimeReady": true
    },
    "resources": [
      {
        "id": "state",
        "path": "zone",
        "equals": "hollow",
        "allowTrivial": "The run is in the Hollow's guard room, so the indoor run speed is the one measured."
      },
      {
        "id": "state",
        "path": "topSpeed",
        "gte": 2.375,
        "lte": 2.625
      },
      {
        "id": "state",
        "path": "stopSeconds",
        "gte": 0.01,
        "lte": 0.3
      }
    ],
    "movement": {
      "entity": "player",
      "minDistance": 3
    }
  }
}
