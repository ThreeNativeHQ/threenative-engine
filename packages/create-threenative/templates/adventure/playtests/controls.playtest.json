{
  "name": "adventure-controls",
  "target": "web",
  "schemaVersion": 1,
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "warmupFrames": 10,
  "subject": "player",
  "steps": [
    {
      "kind": "wait",
      "label": "spawn",
      "waitTicks": 30,
      "release": true
    },
    {
      "kind": "input",
      "label": "no-sword",
      "press": "KeyJ",
      "holdTicks": 20,
      "release": true
    },
    {
      "kind": "input",
      "label": "open-chest",
      "press": "KeyE",
      "holdTicks": 10,
      "release": true
    },
    {
      "kind": "input",
      "label": "slash",
      "press": "KeyJ",
      "holdTicks": 20,
      "release": true
    },
    {
      "kind": "wait",
      "label": "recover",
      "waitTicks": 30,
      "release": true
    },
    {
      "kind": "input",
      "label": "click",
      "pointerPosition": { "x": 0.5, "y": 0.5, "buttons": 1 },
      "waitTicks": 20,
      "release": false
    },
    {
      "kind": "input",
      "label": "click-up",
      "pointerPosition": { "x": 0.5, "y": 0.5, "buttons": 0 },
      "waitTicks": 30,
      "release": true
    },
    {
      "kind": "input",
      "label": "shield",
      "press": "ShiftLeft",
      "holdTicks": 30,
      "release": true
    },
    {
      "kind": "input",
      "label": "roll",
      "press": ["KeyW", "Space"],
      "holdTicks": 30,
      "release": true
    },
    {
      "kind": "input",
      "label": "lock",
      "press": "KeyQ",
      "holdTicks": 45,
      "release": false
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "noRuntimeDiagnostics": true,
      "runtimeReady": true
    },
    "resources": [
      {
        "id": "state",
        "path": "slashes",
        "gte": 2,
        "atSteps": [
          {
            "label": "no-sword",
            "equals": 0
          },
          {
            "label": "slash",
            "equals": 1
          },
          {
            "label": "click",
            "equals": 2
          }
        ]
      },
      {
        "id": "state",
        "path": "lockTarget",
        "changed": true
      }
    ],
    "movement": {
      "entity": "player",
      "minDistance": 0.5
    }
  }
}
