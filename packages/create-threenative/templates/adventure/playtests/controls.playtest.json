{
  "name": "adventure-controls",
  "target": "web",
  "schemaVersion": 1,
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "warmupFrames": 10,
  "subject": "player",
  "steps": [
    {
      "kind": "wait",
      "label": "spawn",
      "waitTicks": 30,
      "release": true
    },
    {
      "kind": "input",
      "label": "no-sword",
      "press": "KeyJ",
      "holdTicks": 20,
      "release": true
    },
    {
      "kind": "input",
      "label": "open-chest",
      "press": "KeyE",
      "holdTicks": 10,
      "release": true
    },
    {
      "kind": "click",
      "label": "capture",
      "at": { "x": 640, "y": 360 },
      "waitTicks": 20
    },
    {
      "kind": "input",
      "label": "click",
      "pointerPosition": { "x": 0.5, "y": 0.5, "buttons": 1 },
      "waitTicks": 20,
      "release": false
    },
    {
      "kind": "input",
      "label": "click-up",
      "pointerPosition": { "x": 0.5, "y": 0.5, "buttons": 0 },
      "waitTicks": 30,
      "release": true
    },
    {
      "kind": "input",
      "label": "shield",
      "pointerPosition": { "x": 0.5, "y": 0.5, "buttons": 2 },
      "waitTicks": 20,
      "release": false
    },
    {
      "kind": "input",
      "label": "shield-up",
      "pointerPosition": { "x": 0.5, "y": 0.5, "buttons": 0 },
      "waitTicks": 20,
      "release": true
    },
    {
      "kind": "input",
      "label": "roll",
      "press": ["KeyW", "Space"],
      "holdTicks": 30,
      "release": true
    },
    {
      "kind": "input",
      "label": "lock-tab",
      "press": "Tab",
      "holdTicks": 10,
      "release": true
    },
    {
      "kind": "wait",
      "label": "locked",
      "waitTicks": 20,
      "release": true
    },
    {
      "kind": "input",
      "label": "lock-middle",
      "pointerPosition": { "x": 0.5, "y": 0.5, "buttons": 4 },
      "waitTicks": 10,
      "release": false
    },
    {
      "kind": "input",
      "label": "lock-middle-up",
      "pointerPosition": { "x": 0.5, "y": 0.5, "buttons": 0 },
      "waitTicks": 20,
      "release": true
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "noRuntimeDiagnostics": true,
      "runtimeReady": true
    },
    "components": [
      {
        "entity": "player",
        "component": "state",
        "atSteps": [{ "label": "shield", "equals": "block" }]
      }
    ],
    "resources": [
      {
        "id": "state",
        "path": "slashes",
        "gte": 1,
        "atSteps": [
          { "label": "no-sword", "equals": 0 },
          { "label": "capture", "equals": 0 },
          { "label": "click", "equals": 1 }
        ]
      },
      {
        "id": "state",
        "path": "lockTarget",
        "atSteps": [
          { "label": "roll", "equals": "" },
          { "label": "lock-tab", "equals": "dummy.1" },
          { "label": "locked", "equals": "dummy.1" },
          { "label": "lock-middle-up", "equals": "dummy.0" }
        ]
      }
    ],
    "movement": {
      "entity": "player",
      "minDistance": 0.5
    }
  }
}
