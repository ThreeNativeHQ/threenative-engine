{
  "name": "survives",
  "target": "web",
  "schemaVersion": 1,
  "viewport": { "width": 1280, "height": 720 },
  "warmupFrames": 40,
  "subject": "player",
  "steps": [
    { "kind": "input", "label": "move", "press": "ArrowUp", "holdTicks": 60, "release": true },
    { "kind": "wait", "label": "settle", "waitTicks": 10, "release": true }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "noRuntimeDiagnostics": true,
      "runtimeReady": true
    },
    "components": [
      {
        "allowTrivial": "GroundSnap keeps the runner's feet out of the track; a jog's flight phase lifts them up to 0.27 m, so the call-site proof is a clearance that never sinks below the track.",
        "component": "groundClearance",
        "entity": "player",
        "gte": -0.01
      }
    ],
    "movement": {
      "entity": "player",
      "minDistance": 0.5,
      "minAxisDelta": { "axis": "-z", "min": 0.5 }
    },
    "visibility": [
      {
        "entity": "touch-controls",
        "present": false,
        "allowTrivial": "Desktop keyboard lanes intentionally omit touch controls while movement proves the scene is active."
      }
    ],
    "visual": [
      {
        "region": {
          "x": 0,
          "y": 0,
          "width": 1280,
          "height": 720,
          "minNonblankPixelRatio": 0.01
        }
      }
    ]
  }
}
