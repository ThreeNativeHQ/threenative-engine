{
  "name": "drowning-costs-health-then-kills",
  "warmupFrames": 10,
  "schemaVersion": 1,
  "target": "web",
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "subject": "player",
  "steps": [
    {
      "label": "settled",
      "waitForResource": {
        "id": "state",
        "path": "time",
        "gte": 0.5
      },
      "release": false,
      "timeoutMs": 8000
    },
    {
      "kind": "input",
      "label": "place",
      "press": "Digit6",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "wait",
      "label": "breathless",
      "waitTicks": 100,
      "release": true
    },
    {
      "kind": "wait",
      "label": "drowning",
      "waitTicks": 100,
      "release": true
    },
    {
      "label": "dead",
      "waitForResource": {
        "id": "state",
        "path": "mode",
        "equals": "dead"
      },
      "release": false,
      "timeoutMs": 20000
    },
    {
      "kind": "wait",
      "label": "lost",
      "waitTicks": 10,
      "release": true
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "runtimeReady": true
    },
    "resources": [
      {
        "id": "state",
        "path": "air",
        "atSteps": [
          {
            "label": "breathless",
            "lte": 0
          },
          {
            "label": "drowning",
            "equals": 0
          }
        ]
      },
      {
        "id": "state",
        "path": "health",
        "atSteps": [
          {
            "label": "breathless",
            "equals": 1000
          },
          {
            "label": "drowning",
            "lte": 900
          }
        ]
      },
      {
        "id": "state",
        "path": "phase",
        "atSteps": [
          {
            "label": "lost",
            "equals": "lost"
          }
        ]
      },
      {
        "id": "state",
        "path": "cause",
        "atSteps": [
          {
            "label": "lost",
            "equals": "drown"
          }
        ]
      }
    ]
  }
}
