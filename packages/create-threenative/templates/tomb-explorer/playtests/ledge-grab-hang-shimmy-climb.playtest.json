{
  "name": "ledge-grab-hang-shimmy-climb",
  "warmupFrames": 10,
  "schemaVersion": 1,
  "target": "web",
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "subject": "player",
  "steps": [
    {
      "label": "settled",
      "waitForResource": {
        "id": "state",
        "path": "time",
        "gte": 0.5
      },
      "release": false,
      "timeoutMs": 8000
    },
    {
      "kind": "input",
      "label": "place",
      "press": "Digit3",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "input",
      "label": "reach",
      "press": [
        "KeyE",
        "ArrowUp",
        "Space"
      ],
      "holdTicks": 6,
      "release": false
    },
    {
      "label": "hanging",
      "waitForResource": {
        "id": "state",
        "path": "mode",
        "equals": "hang"
      },
      "release": false,
      "timeoutMs": 5000
    },
    {
      "kind": "wait",
      "label": "hold",
      "waitTicks": 6,
      "release": false
    },
    {
      "kind": "input",
      "label": "try-climb",
      "press": [
        "KeyE",
        "ArrowUp"
      ],
      "holdTicks": 12,
      "release": false
    },
    {
      "kind": "input",
      "label": "shimmy",
      "press": [
        "KeyE",
        "ArrowRight"
      ],
      "holdTicks": 2,
      "release": false
    },
    {
      "label": "past-the-low-ceiling",
      "waitForResource": {
        "id": "state",
        "path": "playerX",
        "gte": 4300
      },
      "release": false,
      "timeoutMs": 8000
    },
    {
      "kind": "input",
      "label": "pull-up",
      "press": [
        "KeyE",
        "ArrowUp"
      ],
      "holdTicks": 2,
      "release": true
    },
    {
      "label": "standing",
      "waitForResource": {
        "id": "state",
        "path": "mode",
        "equals": "idle"
      },
      "release": false,
      "timeoutMs": 8000
    },
    {
      "kind": "wait",
      "label": "settled-up",
      "waitTicks": 10,
      "release": true
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "runtimeReady": true
    },
    "resources": [
      {
        "id": "state",
        "path": "mode",
        "atSteps": [
          {
            "label": "hanging",
            "equals": "hang"
          },
          {
            "label": "try-climb",
            "equals": "hang"
          },
          {
            "label": "settled-up",
            "equals": "idle"
          }
        ]
      },
      {
        "id": "state",
        "path": "playerY",
        "atSteps": [
          {
            "label": "hanging",
            "equals": 3296
          },
          {
            "label": "try-climb",
            "equals": 3296
          },
          {
            "label": "settled-up",
            "equals": 4096
          }
        ]
      },
      {
        "id": "state",
        "path": "message",
        "atSteps": [
          {
            "label": "try-climb",
            "textIncludes": "No room"
          }
        ]
      },
      {
        "id": "state",
        "path": "grabs",
        "equals": 1
      },
      {
        "id": "state",
        "path": "climbs",
        "equals": 1
      },
      {
        "id": "state",
        "path": "playerZ",
        "lte": 5000
      }
    ]
  }
}
