{
  "name": "tunnel-blocks-surface-swimming",
  "warmupFrames": 10,
  "schemaVersion": 1,
  "target": "web",
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "subject": "player",
  "steps": [
    {
      "label": "settled",
      "waitForResource": {
        "id": "state",
        "path": "time",
        "gte": 0.5
      },
      "release": false,
      "timeoutMs": 8000
    },
    {
      "kind": "input",
      "label": "place",
      "press": "Digit5",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "input",
      "label": "paddle",
      "press": "ArrowUp",
      "holdTicks": 260,
      "release": true
    },
    {
      "kind": "wait",
      "label": "stopped",
      "waitTicks": 10,
      "release": true
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "runtimeReady": true
    },
    "resources": [
      {
        "id": "state",
        "path": "mode",
        "atSteps": [
          {
            "label": "stopped",
            "equals": "surface"
          }
        ]
      },
      {
        "id": "state",
        "path": "playerX",
        "atSteps": [
          {
            "label": "stopped",
            "lte": 21504
          }
        ]
      }
    ]
  }
}
