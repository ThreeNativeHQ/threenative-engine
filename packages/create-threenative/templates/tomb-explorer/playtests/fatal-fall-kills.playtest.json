{
  "name": "fatal-fall-kills",
  "warmupFrames": 10,
  "schemaVersion": 1,
  "target": "web",
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "subject": "player",
  "steps": [
    {
      "label": "settled",
      "waitForResource": {
        "id": "state",
        "path": "time",
        "gte": 0.5
      },
      "release": false,
      "timeoutMs": 8000
    },
    {
      "kind": "input",
      "label": "place",
      "press": "Minus",
      "holdTicks": 1,
      "release": true
    },
    {
      "label": "dead",
      "waitForResource": {
        "id": "state",
        "path": "mode",
        "equals": "dead"
      },
      "release": false,
      "timeoutMs": 8000
    },
    {
      "kind": "wait",
      "label": "lost",
      "waitTicks": 10,
      "release": true
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "runtimeReady": true
    },
    "resources": [
      {
        "id": "state",
        "path": "phase",
        "atSteps": [
          {
            "label": "lost",
            "equals": "lost"
          }
        ]
      },
      {
        "id": "state",
        "path": "cause",
        "atSteps": [
          {
            "label": "lost",
            "equals": "fall"
          }
        ]
      },
      {
        "id": "state",
        "path": "health",
        "atSteps": [
          {
            "label": "lost",
            "equals": 0
          }
        ]
      }
    ],
    "components": [
      {
        "entity": "player",
        "component": "clip",
        "atSteps": [
          {
            "label": "lost",
            "equals": "Death01"
          }
        ]
      }
    ]
  }
}
