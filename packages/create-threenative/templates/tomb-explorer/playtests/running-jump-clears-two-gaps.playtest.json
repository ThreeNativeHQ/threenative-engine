{
  "name": "running-jump-clears-two-gaps",
  "warmupFrames": 10,
  "schemaVersion": 1,
  "target": "web",
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "subject": "player",
  "steps": [
    {
      "label": "settled",
      "waitForResource": {
        "id": "state",
        "path": "time",
        "gte": 0.5
      },
      "release": false,
      "timeoutMs": 8000
    },
    {
      "kind": "input",
      "label": "place",
      "press": "Digit2",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "input",
      "label": "run",
      "press": "ArrowUp",
      "holdTicks": 1,
      "release": false
    },
    {
      "label": "at-the-edge",
      "waitForResource": {
        "id": "state",
        "path": "playerZ",
        "lte": 10440
      },
      "release": false,
      "timeoutMs": 15000
    },
    {
      "kind": "input",
      "label": "jump",
      "press": ["ArrowUp", "Space"],
      "holdTicks": 2,
      "release": true
    },
    {
      "kind": "wait",
      "label": "landed",
      "waitTicks": 110,
      "release": true
    },
    {
      "kind": "wait",
      "label": "stopped",
      "waitTicks": 10,
      "release": true
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "runtimeReady": true
    },
    "resources": [
      {
        "id": "state",
        "path": "mode",
        "atSteps": [
          {
            "label": "stopped",
            "equals": "idle"
          }
        ]
      },
      {
        "id": "state",
        "path": "playerY",
        "atSteps": [
          {
            "label": "landed",
            "equals": 2816
          }
        ]
      },
      {
        "id": "state",
        "path": "playerZ",
        "atSteps": [
          {
            "label": "landed",
            "lte": 8192
          }
        ]
      },
      {
        "id": "state",
        "path": "health",
        "atSteps": [
          {
            "label": "landed",
            "equals": 1000
          }
        ]
      },
      {
        "id": "state",
        "path": "jumps",
        "equals": 1
      }
    ]
  }
}
