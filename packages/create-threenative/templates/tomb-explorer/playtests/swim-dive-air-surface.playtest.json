{
  "name": "swim-dive-air-surface",
  "warmupFrames": 10,
  "schemaVersion": 1,
  "target": "web",
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "subject": "player",
  "steps": [
    {
      "label": "settled",
      "waitForResource": {
        "id": "state",
        "path": "time",
        "gte": 0.5
      },
      "release": false,
      "timeoutMs": 8000
    },
    {
      "kind": "input",
      "label": "place",
      "press": "Digit5",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "input",
      "label": "paddle",
      "press": "ArrowUp",
      "holdTicks": 20,
      "release": true
    },
    {
      "kind": "input",
      "label": "dive",
      "press": ["Space"],
      "holdTicks": 30,
      "release": false
    },
    {
      "label": "under",
      "waitForResource": {
        "id": "state",
        "path": "mode",
        "equals": "swim"
      },
      "release": false,
      "timeoutMs": 5000
    },
    {
      "kind": "input",
      "label": "stroke",
      "press": ["Space"],
      "holdTicks": 20,
      "release": false
    },
    {
      "kind": "input",
      "label": "rise",
      "press": ["Space", "ArrowDown"],
      "holdTicks": 80,
      "release": true
    },
    {
      "kind": "wait",
      "label": "breathing",
      "waitTicks": 80,
      "release": true
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "runtimeReady": true
    },
    "resources": [
      {
        "id": "state",
        "path": "mode",
        "atSteps": [
          {
            "label": "paddle",
            "equals": "surface"
          },
          {
            "label": "under",
            "equals": "swim"
          },
          {
            "label": "breathing",
            "equals": "surface"
          }
        ]
      },
      {
        "id": "state",
        "path": "air",
        "atSteps": [
          {
            "label": "paddle",
            "equals": 1800
          },
          {
            "label": "stroke",
            "lte": 1790
          },
          {
            "label": "breathing",
            "equals": 1800
          }
        ]
      },
      {
        "id": "state",
        "path": "health",
        "atSteps": [
          {
            "label": "breathing",
            "equals": 1000
          }
        ]
      }
    ]
  }
}
