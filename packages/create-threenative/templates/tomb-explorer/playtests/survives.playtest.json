{
  "name": "survives",
  "target": "web",
  "schemaVersion": 1,
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "warmupFrames": 10,
  "subject": "player",
  "steps": [
    {
      "kind": "input",
      "label": "move",
      "press": "ArrowUp",
      "holdTicks": 60,
      "release": true
    },
    {
      "kind": "wait",
      "label": "settle",
      "waitTicks": 10,
      "release": true
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "runtimeReady": true,
      "noRuntimeDiagnostics": true
    },
    "movement": {
      "entity": "player",
      "minDistance": 0.5
    },
    "visibility": [
      {
        "entity": "player",
        "minProjectedPixels": 20,
        "allowTrivial": "The chase camera frames the player at spawn."
      }
    ],
    "visual": [
      {
        "region": {
          "x": 0,
          "y": 0,
          "width": 1280,
          "height": 720,
          "minNonblankPixelRatio": 0.01
        }
      }
    ]
  }
}
