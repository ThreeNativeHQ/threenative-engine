{
  "name": "fall-damage-from-fourteen-clicks",
  "warmupFrames": 10,
  "schemaVersion": 1,
  "target": "web",
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "subject": "player",
  "steps": [
    {
      "label": "settled",
      "waitForResource": {
        "id": "state",
        "path": "time",
        "gte": 0.5
      },
      "release": false,
      "timeoutMs": 8000
    },
    {
      "kind": "input",
      "label": "place",
      "press": "Digit4",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "input",
      "label": "run-off",
      "press": "ArrowUp",
      "holdTicks": 60,
      "release": true
    },
    {
      "kind": "wait",
      "label": "landed",
      "waitTicks": 80,
      "release": true
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "runtimeReady": true
    },
    "resources": [
      {
        "id": "state",
        "path": "landingSpeed",
        "atSteps": [
          {
            "label": "landed",
            "equals": 147
          }
        ]
      },
      {
        "id": "state",
        "path": "fallDamage",
        "atSteps": [
          {
            "label": "landed",
            "equals": 250
          }
        ]
      },
      {
        "id": "state",
        "path": "health",
        "atSteps": [
          {
            "label": "landed",
            "equals": 750
          }
        ]
      },
      {
        "id": "state",
        "path": "mode",
        "atSteps": [
          {
            "label": "landed",
            "equals": "idle"
          }
        ]
      },
      {
        "id": "state",
        "path": "message",
        "atSteps": [
          {
            "label": "landed",
            "textIncludes": "Hard landing"
          }
        ]
      }
    ]
  }
}
