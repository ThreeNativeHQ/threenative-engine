{
  "name": "ledge-grab-facing-cone",
  "warmupFrames": 10,
  "schemaVersion": 1,
  "target": "web",
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "subject": "player",
  "steps": [
    {
      "label": "settled",
      "waitForResource": {
        "id": "state",
        "path": "time",
        "gte": 0.5
      },
      "release": false,
      "timeoutMs": 8000
    },
    {
      "kind": "input",
      "label": "place",
      "press": "Digit3",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "input",
      "label": "turn-a-little",
      "press": "ArrowLeft",
      "holdTicks": 4,
      "release": true
    },
    {
      "kind": "wait",
      "label": "straight",
      "waitTicks": 24,
      "release": true
    },
    {
      "kind": "input",
      "label": "reach",
      "press": [
        "KeyE",
        "Space"
      ],
      "holdTicks": 6,
      "release": false
    },
    {
      "label": "hanging",
      "waitForResource": {
        "id": "state",
        "path": "mode",
        "equals": "hang"
      },
      "release": false,
      "timeoutMs": 5000
    },
    {
      "kind": "input",
      "label": "let-go",
      "press": [
        "KeyP"
      ],
      "holdTicks": 2,
      "release": true
    },
    {
      "kind": "wait",
      "label": "dropped",
      "waitTicks": 60,
      "release": true
    },
    {
      "kind": "input",
      "label": "again",
      "press": "Digit3",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "input",
      "label": "turn-a-lot",
      "press": "ArrowLeft",
      "holdTicks": 20,
      "release": true
    },
    {
      "kind": "wait",
      "label": "turned",
      "waitTicks": 24,
      "release": true
    },
    {
      "kind": "input",
      "label": "reach-again",
      "press": [
        "KeyE",
        "Space"
      ],
      "holdTicks": 6,
      "release": false
    },
    {
      "kind": "wait",
      "label": "missed",
      "waitTicks": 80,
      "release": true
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "runtimeReady": true
    },
    "resources": [
      {
        "id": "state",
        "path": "mode",
        "atSteps": [
          {
            "label": "hanging",
            "equals": "hang"
          },
          {
            "label": "dropped",
            "equals": "idle"
          },
          {
            "label": "missed",
            "equals": "idle"
          }
        ]
      },
      {
        "id": "state",
        "path": "playerY",
        "atSteps": [
          {
            "label": "missed",
            "equals": 2816
          }
        ]
      },
      {
        "id": "state",
        "path": "jumps",
        "atSteps": [
          {
            "label": "dropped",
            "equals": 1
          },
          {
            "label": "missed",
            "equals": 2
          }
        ]
      },
      {
        "id": "state",
        "path": "grabs",
        "equals": 1
      }
    ],
    "components": [
      {
        "entity": "player",
        "component": "yaw",
        "atSteps": [
          {
            "label": "hanging",
            "equals": 3.142
          }
        ]
      }
    ]
  }
}
