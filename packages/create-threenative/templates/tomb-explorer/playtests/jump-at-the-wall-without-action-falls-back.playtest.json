{
  "name": "jump-at-the-wall-without-action-falls-back",
  "warmupFrames": 10,
  "schemaVersion": 1,
  "target": "web",
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "subject": "player",
  "steps": [
    {
      "label": "settled",
      "waitForResource": {
        "id": "state",
        "path": "time",
        "gte": 0.5
      },
      "release": false,
      "timeoutMs": 8000
    },
    {
      "kind": "input",
      "label": "place",
      "press": "Digit3",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "input",
      "label": "jump",
      "press": ["ArrowUp", "Space"],
      "holdTicks": 6,
      "release": true
    },
    {
      "kind": "wait",
      "label": "landed",
      "waitTicks": 80,
      "release": true
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "runtimeReady": true
    },
    "resources": [
      {
        "id": "state",
        "path": "mode",
        "atSteps": [
          {
            "label": "landed",
            "equals": "idle"
          }
        ]
      },
      {
        "id": "state",
        "path": "playerY",
        "atSteps": [
          {
            "label": "landed",
            "equals": 2816
          }
        ]
      },
      {
        "id": "state",
        "path": "grabs",
        "equals": 0,
        "allowTrivial": "The count stays at zero on purpose: with the action key up, a jump at the wall must not catch the ledge, and playerY at the foot proves she landed back."
      }
    ]
  }
}
