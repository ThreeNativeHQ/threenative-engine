{
  "name": "dice-roll-walks-and-pays",
  "warmupFrames": 10,
  "schemaVersion": 1,
  "target": "web",
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "subject": "player",
  "steps": [
    {
      "label": "settled",
      "waitForResource": {
        "id": "state",
        "path": "time",
        "gte": 0.5
      },
      "release": false,
      "timeoutMs": 5000
    },
    {
      "kind": "input",
      "label": "set-up",
      "press": "Digit1",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "input",
      "label": "roll",
      "press": "Space",
      "holdTicks": 1,
      "release": true
    },
    {
      "label": "landed",
      "waitForResource": {
        "id": "state",
        "path": "players.0.space",
        "gte": 2
      },
      "release": false,
      "timeoutMs": 10000
    },
    {
      "kind": "wait",
      "waitTicks": 2,
      "release": true,
      "label": "after"
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "runtimeReady": true
    },
    "resources": [
      {
        "id": "state",
        "path": "players.0.space",
        "atSteps": [
          {
            "label": "landed",
            "equals": 2
          }
        ]
      },
      {
        "id": "state",
        "path": "players.0.coins",
        "atSteps": [
          {
            "label": "landed",
            "equals": 13
          }
        ]
      },
      {
        "id": "state",
        "path": "die",
        "atSteps": [
          {
            "label": "landed",
            "equals": 2
          }
        ]
      }
    ]
  }
}
