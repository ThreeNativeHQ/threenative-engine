{
  "name": "star-purchase",
  "warmupFrames": 10,
  "schemaVersion": 1,
  "target": "web",
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "subject": "player",
  "steps": [
    {
      "label": "settled",
      "waitForResource": {
        "id": "state",
        "path": "time",
        "gte": 0.5
      },
      "release": false,
      "timeoutMs": 5000
    },
    {
      "kind": "input",
      "label": "set-up",
      "press": "Digit4",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "input",
      "label": "roll",
      "press": "Space",
      "holdTicks": 1,
      "release": true
    },
    {
      "label": "offered",
      "waitForResource": {
        "id": "state",
        "path": "turnPhase",
        "equals": "star"
      },
      "release": false,
      "timeoutMs": 10000
    },
    {
      "kind": "input",
      "label": "yes",
      "press": "KeyY",
      "holdTicks": 1,
      "release": true
    },
    {
      "label": "bought",
      "waitForResource": {
        "id": "state",
        "path": "players.0.stars",
        "gte": 1
      },
      "release": false,
      "timeoutMs": 10000
    },
    {
      "kind": "wait",
      "waitTicks": 2,
      "release": true,
      "label": "after"
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "runtimeReady": true
    },
    "resources": [
      {
        "id": "state",
        "path": "prompt",
        "atSteps": [
          {
            "label": "offered",
            "equals": "star"
          }
        ]
      },
      {
        "id": "state",
        "path": "players.0.stars",
        "atSteps": [
          {
            "label": "bought",
            "equals": 1
          }
        ]
      },
      {
        "id": "state",
        "path": "players.0.coins",
        "atSteps": [
          {
            "label": "bought",
            "equals": 5
          }
        ]
      },
      {
        "id": "state",
        "path": "starSpace",
        "changed": true
      }
    ]
  }
}
