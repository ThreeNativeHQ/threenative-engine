{
  "name": "dash-false-start-freezes",
  "warmupFrames": 10,
  "schemaVersion": 1,
  "target": "web",
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "subject": "player",
  "steps": [
    {
      "label": "settled",
      "waitForResource": {
        "id": "state",
        "path": "time",
        "gte": 0.5
      },
      "release": false,
      "timeoutMs": 5000
    },
    {
      "kind": "input",
      "label": "set-up",
      "press": "Digit7",
      "holdTicks": 1,
      "release": true
    },
    {
      "label": "red-light",
      "waitForResource": {
        "id": "state",
        "path": "turnPhase",
        "equals": "minigame"
      },
      "release": false,
      "timeoutMs": 15000
    },
    {
      "kind": "input",
      "label": "jump-the-gun",
      "press": "ArrowRight",
      "holdTicks": 6,
      "release": true
    },
    {
      "kind": "wait",
      "waitTicks": 4,
      "release": true,
      "label": "frozen"
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "runtimeReady": true
    },
    "resources": [
      {
        "id": "state",
        "path": "miniFalseStarts",
        "atSteps": [
          {
            "label": "frozen",
            "equals": 1
          }
        ]
      }
    ]
  }
}
