{
  "name": "cpu-buys-the-star",
  "warmupFrames": 10,
  "schemaVersion": 1,
  "target": "web",
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "subject": "player",
  "steps": [
    {
      "label": "settled",
      "waitForResource": {
        "id": "state",
        "path": "time",
        "gte": 0.5
      },
      "release": false,
      "timeoutMs": 5000
    },
    {
      "kind": "input",
      "label": "set-up",
      "press": "Digit6",
      "holdTicks": 1,
      "release": true
    },
    {
      "label": "bought",
      "waitForResource": {
        "id": "state",
        "path": "players.1.stars",
        "gte": 1
      },
      "release": false,
      "timeoutMs": 20000
    },
    {
      "kind": "wait",
      "waitTicks": 2,
      "release": true,
      "label": "after"
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "runtimeReady": true
    },
    "resources": [
      {
        "id": "state",
        "path": "players.1.stars",
        "atSteps": [
          {
            "label": "bought",
            "equals": 1
          }
        ]
      },
      {
        "id": "state",
        "path": "players.1.coins",
        "atSteps": [
          {
            "label": "bought",
            "equals": 5
          }
        ]
      }
    ]
  }
}
