{
  "name": "turns-rotate-then-a-minigame",
  "warmupFrames": 10,
  "schemaVersion": 1,
  "target": "web",
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "subject": "player",
  "steps": [
    {
      "label": "settled",
      "waitForResource": {
        "id": "state",
        "path": "time",
        "gte": 0.5
      },
      "release": false,
      "timeoutMs": 5000
    },
    {
      "kind": "input",
      "label": "fast",
      "press": "Digit0",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "input",
      "label": "roll",
      "press": "Space",
      "holdTicks": 1,
      "release": true
    },
    {
      "label": "cpu-1",
      "waitForResource": {
        "id": "state",
        "path": "active",
        "gte": 1
      },
      "release": false,
      "timeoutMs": 15000
    },
    {
      "label": "cpu-3",
      "waitForResource": {
        "id": "state",
        "path": "active",
        "gte": 3
      },
      "release": false,
      "timeoutMs": 20000
    },
    {
      "label": "minigame-round",
      "waitForResource": {
        "id": "state",
        "path": "turnPhase",
        "equals": "intro"
      },
      "release": false,
      "timeoutMs": 20000
    },
    {
      "label": "next-turn",
      "waitForResource": {
        "id": "state",
        "path": "turn",
        "gte": 2
      },
      "release": false,
      "timeoutMs": 60000
    },
    {
      "kind": "wait",
      "waitTicks": 2,
      "release": true,
      "label": "after"
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "runtimeReady": true
    },
    "resources": [
      {
        "id": "state",
        "path": "active",
        "atSteps": [
          {
            "label": "cpu-1",
            "equals": 1
          },
          {
            "label": "cpu-3",
            "equals": 3
          }
        ]
      },
      {
        "id": "state",
        "path": "turnPhase",
        "atSteps": [
          {
            "label": "minigame-round",
            "equals": "intro"
          }
        ]
      },
      {
        "id": "state",
        "path": "turn",
        "atSteps": [
          {
            "label": "next-turn",
            "equals": 2
          }
        ]
      },
      {
        "id": "state",
        "path": "players.1.space",
        "atSteps": [
          {
            "label": "next-turn",
            "equals": 1
          }
        ]
      },
      {
        "id": "state",
        "path": "players.3.space",
        "atSteps": [
          {
            "label": "next-turn",
            "equals": 1
          }
        ]
      }
    ]
  }
}
