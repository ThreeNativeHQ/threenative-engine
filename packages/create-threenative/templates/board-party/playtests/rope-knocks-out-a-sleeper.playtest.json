{
  "name": "rope-knocks-out-a-sleeper",
  "warmupFrames": 10,
  "schemaVersion": 1,
  "target": "web",
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "subject": "player",
  "steps": [
    {
      "label": "settled",
      "waitForResource": {
        "id": "state",
        "path": "time",
        "gte": 0.5
      },
      "release": false,
      "timeoutMs": 5000
    },
    {
      "kind": "input",
      "label": "set-up",
      "press": "Digit8",
      "holdTicks": 1,
      "release": true
    },
    {
      "label": "running",
      "waitForResource": {
        "id": "state",
        "path": "turnPhase",
        "equals": "minigame"
      },
      "release": false,
      "timeoutMs": 15000
    },
    {
      "label": "knocked-out",
      "waitForResource": {
        "id": "state",
        "path": "miniAlive.0",
        "equals": 0
      },
      "release": false,
      "timeoutMs": 15000
    },
    {
      "label": "finished",
      "waitForResource": {
        "id": "state",
        "path": "miniDone",
        "equals": 1
      },
      "release": false,
      "timeoutMs": 40000
    },
    {
      "kind": "wait",
      "waitTicks": 2,
      "release": true,
      "label": "after"
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "runtimeReady": true
    },
    "resources": [
      {
        "id": "state",
        "path": "miniAlive.0",
        "atSteps": [
          {
            "label": "knocked-out",
            "equals": 0
          },
          {
            "label": "finished",
            "equals": 0
          }
        ]
      },
      {
        "id": "state",
        "path": "miniWinner",
        "atSteps": [
          {
            "label": "finished",
            "equals": 1
          }
        ]
      },
      {
        "id": "state",
        "path": "players.1.coins",
        "atSteps": [
          {
            "label": "finished",
            "equals": 20
          }
        ]
      }
    ]
  }
}
