{
  "name": "star-needs-twenty-coins",
  "warmupFrames": 10,
  "schemaVersion": 1,
  "target": "web",
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "subject": "player",
  "steps": [
    {
      "label": "settled",
      "waitForResource": {
        "id": "state",
        "path": "time",
        "gte": 0.5
      },
      "release": false,
      "timeoutMs": 5000
    },
    {
      "kind": "input",
      "label": "set-up",
      "press": "Digit5",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "input",
      "label": "roll",
      "press": "Space",
      "holdTicks": 1,
      "release": true
    },
    {
      "label": "refused",
      "waitForResource": {
        "id": "state",
        "path": "turnPhase",
        "equals": "settle"
      },
      "release": false,
      "timeoutMs": 10000
    },
    {
      "kind": "wait",
      "waitTicks": 2,
      "release": true,
      "label": "after"
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "runtimeReady": true
    },
    "resources": [
      {
        "id": "state",
        "path": "message",
        "atSteps": [
          {
            "label": "refused",
            "equals": "Need 20 coins for a star"
          }
        ]
      },
      {
        "id": "state",
        "path": "players.0.coins",
        "atSteps": [
          {
            "label": "refused",
            "equals": 19
          }
        ]
      },
      {
        "id": "state",
        "path": "players.0.stars",
        "atSteps": [
          {
            "label": "refused",
            "equals": 0
          }
        ],
        "allowTrivial": "A refused sale grants nothing: the star count holding at zero is the rule."
      }
    ]
  }
}
