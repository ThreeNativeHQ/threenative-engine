{
  "name": "enemy-body-is-a-body",
  "target": "web",
  "schemaVersion": 1,
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "warmupFrames": 30,
  "subject": "enemy",
  "artifacts": {
    "screenshots": "after"
  },
  "setup": {
    "entities": [
      {
        "entity": "player",
        "position": [0, 0.89, 5.2],
        "rotation": [-0.05722, 0, 0, 0.99836]
      },
      {
        "entity": "enemy-frozen",
        "position": [0, 0, 0]
      }
    ]
  },
  "steps": [
    {
      "kind": "wait",
      "label": "idle",
      "waitTicks": 40,
      "release": true,
      "screenshot": "standing"
    },
    {
      "kind": "input",
      "label": "walked",
      "press": "KeyW",
      "holdTicks": 200,
      "release": true,
      "screenshot": "running"
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "runtimeReady": true
    },
    "components": [
      {
        "entity": "enemy",
        "component": "headHeight",
        "gte": 1.4,
        "allowTrivial": "the head joint's authored height above the body's own origin is 1.545 m in the bind pose and measures 1.491 m through an Idle_Loop sway, so 1.4 is the floor a standing figure holds; a body folded at the waist or bound to the wrong skeleton reads below 1.2"
      },
      {
        "entity": "enemy",
        "component": "headHeight",
        "lte": 1.62,
        "allowTrivial": "a stretched skin reaches above the authored joint height, which is the other half of the same check; a body standing taller than the rig is what this bounds"
      },
      {
        "entity": "enemy",
        "component": "footClearance",
        "lte": 0.03,
        "allowTrivial": "grounded soldier contact is a standing invariant of the patrol loop"
      },
      {
        "entity": "enemy",
        "component": "bodyUsesOpaqueFade",
        "equals": true,
        "allowTrivial": "reads each live body material: blended soldiers leave background normals in the deferred pass even at opacity 1, producing a building-shaped stripe across the helmet"
      }
    ],
    "resources": [
      {
        "id": "state",
        "path": "playerZ",
        "gte": 0.2,
        "lte": 1.2
      }
    ]
  }
}
