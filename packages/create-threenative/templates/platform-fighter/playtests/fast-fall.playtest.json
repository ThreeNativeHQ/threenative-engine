{
  "name": "fast-fall",
  "schemaVersion": 1,
  "target": "web",
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "warmupFrames": 10,
  "subject": "p1",
  "steps": [
    {
      "label": "ready",
      "release": false,
      "timeoutMs": 8000,
      "waitForResource": {
        "gte": 0.3,
        "id": "state",
        "path": "time"
      }
    },
    {
      "kind": "input",
      "press": "Space",
      "holdTicks": 8,
      "label": "hop",
      "release": true
    },
    {
      "kind": "wait",
      "waitTicks": 34,
      "label": "falling",
      "release": true
    },
    {
      "kind": "input",
      "press": "ArrowDown",
      "holdTicks": 4,
      "label": "flick",
      "release": false
    },
    {
      "kind": "wait",
      "waitTicks": 2,
      "label": "fast",
      "release": true
    },
    {
      "kind": "wait",
      "waitTicks": 40,
      "label": "landed",
      "release": true
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "runtimeReady": true
    },
    "resources": [
      {
        "id": "state",
        "path": "p1.fastFalling",
        "atSteps": [
          {
            "label": "falling",
            "equals": 0
          },
          {
            "label": "fast",
            "equals": 1
          },
          {
            "label": "landed",
            "equals": 0
          }
        ]
      },
      {
        "id": "state",
        "path": "p1.vy",
        "atSteps": [
          {
            "label": "falling",
            "lte": -0.3
          },
          {
            "label": "fast",
            "equals": -12.6
          }
        ]
      },
      {
        "id": "state",
        "path": "p1.grounded",
        "atSteps": [
          {
            "label": "landed",
            "equals": 1
          }
        ]
      }
    ]
  }
}
