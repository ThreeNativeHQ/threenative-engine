{
  "name": "run-and-stop",
  "schemaVersion": 1,
  "target": "web",
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "warmupFrames": 10,
  "subject": "p1",
  "steps": [
    {
      "label": "ready",
      "release": false,
      "timeoutMs": 8000,
      "waitForResource": {
        "gte": 0.3,
        "id": "state",
        "path": "time"
      }
    },
    {
      "kind": "input",
      "press": "ArrowRight",
      "holdTicks": 40,
      "label": "running",
      "release": false
    },
    {
      "kind": "wait",
      "waitTicks": 20,
      "label": "stopped",
      "release": true
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "runtimeReady": true
    },
    "resources": [
      {
        "id": "state",
        "path": "p1.vx",
        "atSteps": [
          {
            "label": "running",
            "equals": 7.92
          },
          {
            "label": "stopped",
            "equals": 0
          }
        ]
      },
      {
        "id": "state",
        "path": "p1.grounded",
        "atSteps": [
          {
            "label": "running",
            "equals": 1
          }
        ]
      },
      {
        "id": "state",
        "path": "p1.x",
        "gte": 0
      }
    ]
  }
}
