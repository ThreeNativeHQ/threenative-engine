{
  "name": "cpu-approaches",
  "schemaVersion": 1,
  "target": "web",
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "warmupFrames": 10,
  "subject": "p1",
  "steps": [
    {
      "label": "ready",
      "release": false,
      "timeoutMs": 8000,
      "waitForResource": {
        "gte": 0.3,
        "id": "state",
        "path": "time"
      }
    },
    {
      "kind": "input",
      "press": "Digit8",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "wait",
      "waitTicks": 25,
      "label": "closing",
      "release": true
    },
    {
      "kind": "wait",
      "waitTicks": 60,
      "label": "arrived",
      "release": true
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "runtimeReady": true
    },
    "resources": [
      {
        "id": "state",
        "path": "cpu.x",
        "atSteps": [
          {
            "label": "closing",
            "lte": 2
          },
          {
            "label": "arrived",
            "lte": -1.5
          }
        ]
      }
    ]
  }
}
