{
  "name": "aerial-attack",
  "schemaVersion": 1,
  "target": "web",
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "warmupFrames": 10,
  "subject": "p1",
  "steps": [
    {
      "label": "ready",
      "release": false,
      "timeoutMs": 8000,
      "waitForResource": {
        "gte": 0.3,
        "id": "state",
        "path": "time"
      }
    },
    {
      "kind": "input",
      "press": ["Space"],
      "holdTicks": 8,
      "label": "hop",
      "release": true
    },
    {
      "kind": "wait",
      "waitTicks": 10,
      "release": true
    },
    {
      "kind": "input",
      "press": ["KeyJ"],
      "holdTicks": 1,
      "label": "swing",
      "release": true
    },
    {
      "kind": "wait",
      "waitTicks": 3,
      "label": "swinging",
      "release": true
    },
    {
      "kind": "wait",
      "waitTicks": 40,
      "label": "after",
      "release": true
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "runtimeReady": true
    },
    "resources": [
      {
        "id": "state",
        "path": "p1.mode",
        "atSteps": [
          {
            "label": "swinging",
            "equals": "attack"
          },
          {
            "label": "after",
            "equals": "free"
          }
        ]
      },
      {
        "id": "state",
        "path": "p1.grounded",
        "atSteps": [
          {
            "label": "swinging",
            "equals": 0
          }
        ]
      },
      {
        "id": "state",
        "path": "p1.phase",
        "atSteps": [
          {
            "label": "swinging",
            "equals": "startup"
          }
        ]
      }
    ],
    "signals": [
      {
        "atStep": "swinging",
        "entity": "p1",
        "name": "strike",
        "maxCount": 0
      },
      {
        "atStep": "after",
        "entity": "p1",
        "name": "strike",
        "minCount": 1
      }
    ]
  }
}
