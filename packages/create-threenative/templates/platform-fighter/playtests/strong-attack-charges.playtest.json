{
  "name": "strong-attack-charges",
  "schemaVersion": 1,
  "target": "web",
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "warmupFrames": 10,
  "subject": "p1",
  "steps": [
    {
      "label": "ready",
      "release": false,
      "timeoutMs": 8000,
      "waitForResource": {
        "gte": 0.3,
        "id": "state",
        "path": "time"
      }
    },
    {
      "kind": "input",
      "press": [
        "Digit1"
      ],
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "wait",
      "waitTicks": 3,
      "release": true
    },
    {
      "kind": "input",
      "press": [
        "KeyK"
      ],
      "holdTicks": 40,
      "label": "charging",
      "release": false
    },
    {
      "kind": "input",
      "press": [],
      "holdTicks": 60,
      "label": "swung",
      "release": true
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "runtimeReady": true
    },
    "resources": [
      {
        "id": "state",
        "path": "p1.phase",
        "atSteps": [
          {
            "label": "charging",
            "equals": "charge"
          }
        ]
      },
      {
        "id": "state",
        "path": "p1.mode",
        "atSteps": [
          {
            "label": "swung",
            "equals": "free"
          }
        ]
      },
      {
        "id": "state",
        "path": "cpu.percent",
        "gte": 16.8,
        "lte": 17.6
      }
    ]
  }
}
