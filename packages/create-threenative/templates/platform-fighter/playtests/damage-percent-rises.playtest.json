{
  "name": "damage-percent-rises",
  "schemaVersion": 1,
  "target": "web",
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "warmupFrames": 10,
  "subject": "p1",
  "steps": [
    {
      "label": "ready",
      "release": false,
      "timeoutMs": 8000,
      "waitForResource": {
        "gte": 0.3,
        "id": "state",
        "path": "time"
      }
    },
    {
      "kind": "input",
      "press": [
        "Digit1"
      ],
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "wait",
      "waitTicks": 3,
      "release": true
    },
    {
      "kind": "input",
      "press": [
        "KeyJ"
      ],
      "holdTicks": 1,
      "label": "jab-1",
      "release": true
    },
    {
      "kind": "wait",
      "waitTicks": 40,
      "label": "after-1",
      "release": true
    },
    {
      "kind": "input",
      "press": [
        "KeyJ"
      ],
      "holdTicks": 1,
      "label": "jab-2",
      "release": true
    },
    {
      "kind": "wait",
      "waitTicks": 40,
      "label": "after-2",
      "release": true
    },
    {
      "kind": "input",
      "press": [
        "KeyJ"
      ],
      "holdTicks": 1,
      "label": "jab-3",
      "release": true
    },
    {
      "kind": "wait",
      "waitTicks": 40,
      "label": "after-3",
      "release": true
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "runtimeReady": true
    },
    "resources": [
      {
        "id": "state",
        "path": "cpu.percent",
        "atSteps": [
          {
            "label": "after-1",
            "equals": 3
          },
          {
            "label": "after-2",
            "equals": 6
          },
          {
            "label": "after-3",
            "equals": 9
          }
        ]
      },
      {
        "id": "state",
        "path": "p1.percent",
        "atSteps": [
          {
            "label": "after-3",
            "equals": 0
          }
        ]
      }
    ],
    "visual": [
      {
        "region": {
          "element": {
            "id": "cpu-plate-percent"
          },
          "minNonblankPixelRatio": 0.01
        }
      }
    ]
  }
}
