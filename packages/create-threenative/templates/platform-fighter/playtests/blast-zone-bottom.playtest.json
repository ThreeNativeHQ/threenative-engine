{
  "name": "blast-zone-bottom",
  "schemaVersion": 1,
  "target": "web",
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "warmupFrames": 10,
  "subject": "p1",
  "steps": [
    {
      "label": "ready",
      "release": false,
      "timeoutMs": 8000,
      "waitForResource": {
        "gte": 0.3,
        "id": "state",
        "path": "time"
      }
    },
    {
      "kind": "input",
      "press": [
        "KeyZ"
      ],
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "wait",
      "waitTicks": 60,
      "label": "fell",
      "release": true
    },
    {
      "kind": "wait",
      "waitTicks": 100,
      "label": "back",
      "release": true
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "runtimeReady": true
    },
    "resources": [
      {
        "id": "state",
        "path": "p1.stocks",
        "atSteps": [
          {
            "label": "fell",
            "equals": 2
          }
        ]
      },
      {
        "id": "state",
        "path": "p1.kos",
        "atSteps": [
          {
            "label": "fell",
            "equals": 1
          }
        ]
      },
      {
        "id": "state",
        "path": "p1.mode",
        "atSteps": [
          {
            "label": "back",
            "equals": "free"
          }
        ]
      },
      {
        "id": "state",
        "path": "p1.percent",
        "atSteps": [
          {
            "label": "back",
            "equals": 0
          }
        ]
      }
    ]
  }
}
