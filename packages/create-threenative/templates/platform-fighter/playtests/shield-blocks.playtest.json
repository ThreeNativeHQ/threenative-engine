{
  "name": "shield-blocks",
  "schemaVersion": 1,
  "target": "web",
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "warmupFrames": 10,
  "subject": "p1",
  "steps": [
    {
      "label": "ready",
      "release": false,
      "timeoutMs": 8000,
      "waitForResource": {
        "gte": 0.3,
        "id": "state",
        "path": "time"
      }
    },
    {
      "kind": "input",
      "press": [
        "KeyL"
      ],
      "holdTicks": 6,
      "label": "raise",
      "release": false
    },
    {
      "kind": "input",
      "press": [
        "KeyL",
        "Digit9"
      ],
      "holdTicks": 1,
      "label": "cpu-jab",
      "release": false
    },
    {
      "kind": "input",
      "press": [
        "KeyL"
      ],
      "holdTicks": 14,
      "label": "blocked",
      "release": false
    },
    {
      "kind": "input",
      "press": [],
      "holdTicks": 20,
      "release": true
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "runtimeReady": true
    },
    "resources": [
      {
        "id": "state",
        "path": "p1.blocks",
        "atSteps": [
          {
            "label": "blocked",
            "equals": 1
          }
        ]
      },
      {
        "id": "state",
        "path": "p1.percent",
        "atSteps": [
          {
            "label": "blocked",
            "equals": 0
          }
        ]
      },
      {
        "id": "state",
        "path": "p1.shield",
        "atSteps": [
          {
            "label": "blocked",
            "lte": 53
          }
        ]
      },
      {
        "id": "state",
        "path": "p1.mode",
        "atSteps": [
          {
            "label": "blocked",
            "equals": "shield"
          }
        ]
      }
    ]
  }
}
