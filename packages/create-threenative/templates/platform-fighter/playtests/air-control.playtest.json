{
  "name": "air-control",
  "schemaVersion": 1,
  "target": "web",
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "warmupFrames": 10,
  "subject": "p1",
  "steps": [
    {
      "label": "ready",
      "release": false,
      "timeoutMs": 8000,
      "waitForResource": {
        "gte": 0.3,
        "id": "state",
        "path": "time"
      }
    },
    {
      "kind": "input",
      "press": "Space",
      "holdTicks": 8,
      "label": "hop",
      "release": true
    },
    {
      "kind": "wait",
      "waitTicks": 4,
      "release": true
    },
    {
      "kind": "input",
      "press": "ArrowRight",
      "holdTicks": 20,
      "label": "drift-right",
      "release": false
    },
    {
      "kind": "input",
      "press": "ArrowLeft",
      "holdTicks": 20,
      "label": "drift-left",
      "release": false
    },
    {
      "kind": "wait",
      "waitTicks": 70,
      "label": "landed",
      "release": true
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "runtimeReady": true
    },
    "resources": [
      {
        "id": "state",
        "path": "p1.vx",
        "atSteps": [
          {
            "label": "drift-right",
            "equals": 5.36
          },
          {
            "label": "drift-left",
            "lte": -1.5
          }
        ]
      },
      {
        "id": "state",
        "path": "p1.grounded",
        "atSteps": [
          {
            "label": "drift-right",
            "equals": 0
          },
          {
            "label": "landed",
            "equals": 1
          }
        ]
      }
    ]
  }
}
