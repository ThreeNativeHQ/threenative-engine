{
  "name": "cpu-recovers",
  "schemaVersion": 1,
  "target": "web",
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "warmupFrames": 10,
  "subject": "p1",
  "steps": [
    {
      "label": "ready",
      "release": false,
      "timeoutMs": 8000,
      "waitForResource": {
        "gte": 0.3,
        "id": "state",
        "path": "time"
      }
    },
    {
      "kind": "input",
      "press": ["Digit0"],
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "wait",
      "waitTicks": 8,
      "label": "off-stage",
      "release": true
    },
    {
      "kind": "wait",
      "waitTicks": 150,
      "label": "back",
      "release": true
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "runtimeReady": true
    },
    "resources": [
      {
        "id": "state",
        "path": "cpu.grounded",
        "atSteps": [
          {
            "label": "off-stage",
            "equals": 0
          },
          {
            "label": "back",
            "equals": 1
          }
        ]
      },
      {
        "id": "state",
        "path": "cpu.stocks",
        "atSteps": [
          {
            "label": "back",
            "equals": 3
          }
        ]
      },
      {
        "id": "state",
        "path": "cpu.doubleJumps",
        "gte": 1
      }
    ]
  }
}
