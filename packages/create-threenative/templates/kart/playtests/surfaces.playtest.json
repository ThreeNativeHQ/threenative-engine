{
  "name": "kart-surfaces",
  "target": "web",
  "schemaVersion": 1,
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "warmupFrames": 10,
  "subject": "player",
  "setup": {
    "place": [
      {
        "entity": "player",
        "at": {
          "x": 68.44,
          "y": -1.62,
          "z": -15.15
        },
        "facing": {
          "yaw": 1.9132
        }
      }
    ]
  },
  "steps": [
    {
      "label": "go",
      "waitForResource": {
        "id": "state",
        "path": "phase",
        "equals": "race"
      },
      "timeoutMs": 60000,
      "release": true
    },
    {
      "kind": "input",
      "label": "grass-settled",
      "press": [
        "KeyW"
      ],
      "holdTicks": 400,
      "release": false
    },
    {
      "kind": "input",
      "label": "back-right",
      "press": [
        "KeyW",
        "KeyD"
      ],
      "holdTicks": 22,
      "release": false
    },
    {
      "kind": "input",
      "label": "back-left",
      "press": [
        "KeyW",
        "KeyA"
      ],
      "holdTicks": 22,
      "release": false
    },
    {
      "kind": "input",
      "label": "over-pad",
      "press": [
        "KeyW"
      ],
      "holdTicks": 120,
      "release": true
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "noRuntimeDiagnostics": true,
      "runtimeReady": true
    },
    "components": [
      {
        "entity": "player",
        "component": "surface",
        "atSteps": [
          {
            "label": "grass-settled",
            "equals": "grass"
          }
        ]
      },
      {
        "entity": "player",
        "component": "settledGrass",
        "gte": 16.08,
        "lte": 17.52,
        "allowTrivial": "Full throttle with the wheel straight on grass settles at MK64's x0.70 of the 24 m/s road top (drag 0.30, medium weight)."
      },
      {
        "entity": "player",
        "component": "padHits",
        "equals": 1,
        "allowTrivial": "The kart crossed the boost pad on the back straight once."
      },
      {
        "entity": "player",
        "component": "boostLift",
        "gte": 1.083,
        "lte": 1.113,
        "allowTrivial": "The pad pins the throttle and adds MK64's +400/4096 force: the peak is 1.098 x the 24 m/s road top speed."
      },
      {
        "entity": "player",
        "component": "boostSeconds",
        "gte": 1.3,
        "lte": 1.36,
        "allowTrivial": "The pad's boost lasts MK64's 80 ticks, 1.33 s."
      }
    ]
  }
}
