{
  "name": "kart-drift",
  "target": "web",
  "schemaVersion": 1,
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "warmupFrames": 10,
  "subject": "player",
  "setup": {
    "place": [
      {
        "entity": "player",
        "at": {
          "x": 72.18,
          "y": -1.5,
          "z": -19.42
        },
        "facing": {
          "yaw": 1.9026
        }
      }
    ]
  },
  "steps": [
    {
      "label": "go",
      "waitForResource": {
        "id": "state",
        "path": "phase",
        "equals": "race"
      },
      "timeoutMs": 60000,
      "release": true
    },
    {
      "kind": "input",
      "label": "approach",
      "press": ["KeyW"],
      "holdTicks": 240,
      "release": false
    },
    {
      "kind": "input",
      "label": "hop-left",
      "press": ["KeyW", "KeyA", "Space"],
      "holdTicks": 8,
      "release": false
    },
    {
      "kind": "input",
      "label": "charge-1",
      "press": ["KeyW", "KeyD", "Space"],
      "holdTicks": 20,
      "release": false
    },
    {
      "kind": "input",
      "label": "let-back-1",
      "press": ["KeyW", "Space"],
      "holdTicks": 6,
      "release": false
    },
    {
      "kind": "input",
      "label": "release-stage-1",
      "press": ["KeyW"],
      "holdTicks": 1,
      "release": false
    },
    {
      "kind": "input",
      "label": "straighten",
      "press": ["KeyW", "KeyD"],
      "holdTicks": 12,
      "release": false
    },
    {
      "kind": "input",
      "label": "hop-right",
      "press": ["KeyW", "KeyD", "Space"],
      "holdTicks": 8,
      "release": false
    },
    {
      "kind": "input",
      "label": "charge-a",
      "press": ["KeyW", "KeyA", "Space"],
      "holdTicks": 20,
      "release": false
    },
    {
      "kind": "input",
      "label": "let-back-a",
      "press": ["KeyW", "Space"],
      "holdTicks": 6,
      "release": false
    },
    {
      "kind": "input",
      "label": "charge-b",
      "press": ["KeyW", "KeyA", "Space"],
      "holdTicks": 20,
      "release": false
    },
    {
      "kind": "input",
      "label": "let-back-b",
      "press": ["KeyW", "Space"],
      "holdTicks": 6,
      "release": false
    },
    {
      "kind": "input",
      "label": "charge-c",
      "press": ["KeyW", "KeyA", "Space"],
      "holdTicks": 20,
      "release": false
    },
    {
      "kind": "input",
      "label": "let-back-c",
      "press": ["KeyW", "Space"],
      "holdTicks": 6,
      "release": false
    },
    {
      "kind": "input",
      "label": "release-stage-3",
      "press": ["KeyW"],
      "holdTicks": 1,
      "release": false
    },
    {
      "kind": "input",
      "label": "turbo",
      "press": ["KeyW", "KeyA"],
      "holdTicks": 32,
      "release": false
    },
    {
      "kind": "input",
      "label": "coast",
      "press": ["KeyW"],
      "holdTicks": 45,
      "release": true
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "noRuntimeDiagnostics": true,
      "runtimeReady": true
    },
    "components": [
      {
        "entity": "player",
        "component": "drifts",
        "equals": 2,
        "allowTrivial": "Two hops with a held stick lock two power-slides, one each way."
      },
      {
        "entity": "player",
        "component": "stageLog",
        "equals": "1,3",
        "allowTrivial": "The first slide was released at stage 1 after one wiggle against it, the second at stage 3 after three."
      },
      {
        "entity": "player",
        "component": "miniTurbos",
        "equals": 1,
        "allowTrivial": "Only the second release fires a mini-turbo; the stage-1 release gives none."
      },
      {
        "entity": "player",
        "component": "driftEntrySpeed",
        "gte": 18,
        "allowTrivial": "The second slide began at racing speed, above MK64's 28% drift floor."
      },
      {
        "entity": "player",
        "component": "turboPeak",
        "gte": 24.5,
        "allowTrivial": "During the 31-tick mini-turbo the kart passes its own 24 m/s top speed, which throttle alone cannot reach."
      },
      {
        "entity": "player",
        "component": "wallHits",
        "equals": 0,
        "allowTrivial": "The whole run stays off the walls, so no wall cancelled a slide."
      },
      {
        "entity": "effects",
        "component": "spark1",
        "gte": 1,
        "allowTrivial": "White stage-1 sparks flew off the rear tyres."
      },
      {
        "entity": "effects",
        "component": "spark2",
        "gte": 1,
        "allowTrivial": "Yellow stage-2 sparks flew once the second wiggle landed."
      },
      {
        "entity": "effects",
        "component": "spark3",
        "gte": 1,
        "allowTrivial": "Orange stage-3 sparks flew after the third wiggle."
      },
      {
        "entity": "effects",
        "component": "flame",
        "gte": 1,
        "allowTrivial": "The mini-turbo blew a flame out of the exhausts."
      },
      {
        "entity": "effects",
        "component": "skids",
        "gte": 10,
        "allowTrivial": "The slides laid skid marks."
      }
    ]
  }
}
