{
  "name": "rts-orders",
  "target": "web",
  "schemaVersion": 1,
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "warmupFrames": 20,
  "subject": "selection",
  "steps": [
    {
      "kind": "wait",
      "label": "settle",
      "waitTicks": 60,
      "release": true
    },
    {
      "kind": "input",
      "label": "alt-down",
      "press": "Alt",
      "holdTicks": 2,
      "release": false
    },
    {
      "kind": "input",
      "label": "box-start",
      "pointerPosition": {
        "buttons": 1,
        "x": 0.08,
        "y": 0.28
      },
      "holdTicks": 2,
      "release": false
    },
    {
      "kind": "input",
      "label": "box-end",
      "pointerPosition": {
        "buttons": 1,
        "x": 0.94,
        "y": 0.96
      },
      "holdTicks": 6,
      "release": false
    },
    {
      "kind": "input",
      "label": "box-release",
      "pointerPosition": {
        "buttons": 0,
        "x": 0.94,
        "y": 0.96
      },
      "holdTicks": 2,
      "release": false
    },
    {
      "kind": "input",
      "label": "alt-up",
      "press": [],
      "holdTicks": 2,
      "release": true
    },
    {
      "kind": "input",
      "label": "order-gather",
      "pointerPosition": {
        "buttons": 2,
        "x": 0.39,
        "y": 0.4
      },
      "holdTicks": 4,
      "release": true
    },
    {
      "kind": "wait",
      "label": "gathering",
      "waitTicks": 240,
      "release": true
    },
    {
      "kind": "input",
      "label": "order-move",
      "pointerPosition": {
        "buttons": 2,
        "x": 0.68,
        "y": 0.7
      },
      "holdTicks": 4,
      "release": true
    },
    {
      "kind": "wait",
      "label": "ordered",
      "waitTicks": 20,
      "release": true
    },
    {
      "kind": "wait",
      "label": "moved",
      "waitTicks": 300,
      "release": true
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "noRuntimeDiagnostics": true,
      "runtimeReady": true
    },
    "movement": {
      "entity": "selection",
      "minDistance": 3
    },
    "components": [
      {
        "changed": true,
        "component": "count",
        "entity": "selection"
      },
      {
        "entity": "selection",
        "component": "order",
        "atSteps": [
          {
            "equals": "gather,idle",
            "label": "gathering"
          },
          {
            "equals": "move",
            "label": "ordered"
          }
        ]
      }
    ],
    "resources": [
      {
        "id": "state",
        "path": "gathered",
        "gte": 1
      }
    ],
    "renderChain": {
      "tier": "high",
      "perAdapter": {
        "integrated": { "tier": "medium" },
        "mobile-high": { "tier": "medium" },
        "mobile-low": { "tier": "low" },
        "mobile-mid": { "tier": "low" },
        "software": { "tier": "low" }
      }
    }
  }
}
