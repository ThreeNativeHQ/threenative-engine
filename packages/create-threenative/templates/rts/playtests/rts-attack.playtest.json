{
  "name": "rts-attack",
  "target": "web",
  "schemaVersion": 1,
  "viewport": { "width": 1280, "height": 720 },
  "warmupFrames": 20,
  "subject": "selection",
  "steps": [
    { "kind": "wait", "label": "settle", "waitTicks": 20, "release": true },
    {
      "kind": "input",
      "label": "box-start",
      "pointerPosition": { "buttons": 1, "x": 0.08, "y": 0.28 },
      "holdTicks": 2,
      "release": false
    },
    {
      "kind": "input",
      "label": "box-end",
      "pointerPosition": { "buttons": 1, "x": 0.94, "y": 0.96 },
      "holdTicks": 6,
      "release": false
    },
    {
      "kind": "input",
      "label": "box-release",
      "pointerPosition": { "buttons": 0, "x": 0.94, "y": 0.96 },
      "holdTicks": 2,
      "release": false
    },
    { "kind": "input", "label": "attack-mode", "press": "KeyA", "holdTicks": 2, "release": true },
    { "kind": "wait", "label": "armed", "waitTicks": 4, "release": true },
    {
      "kind": "input",
      "label": "order-attack",
      "pointerPosition": { "buttons": 2, "x": 0.87, "y": 0.48 },
      "holdTicks": 4,
      "release": true
    },
    { "kind": "wait", "label": "ordered", "waitTicks": 20, "release": true },
    { "kind": "wait", "label": "advance", "waitTicks": 800, "release": true },
    { "kind": "wait", "label": "contact", "waitTicks": 900, "release": true },
    { "kind": "wait", "label": "engaged", "waitTicks": 1900, "release": true }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "noRuntimeDiagnostics": true,
      "runtimeReady": true
    },
    "movement": {
      "entity": "selection",
      "minDistance": 3
    },
    "components": [
      {
        "entity": "selection",
        "component": "order",
        "atSteps": [
          { "label": "armed", "equals": "idle" },
          { "label": "ordered", "equals": "attackMove" }
        ]
      }
    ],
    "resources": [
      {
        "id": "state",
        "path": "mode",
        "atSteps": [{ "label": "armed", "equals": "attack" }, { "label": "ordered", "equals": "" }]
      },
      {
        "id": "state",
        "path": "cameraX",
        "atSteps": [{ "label": "box-release", "equals": -66 }, { "label": "armed", "equals": -66 }]
      }
    ],
    "renderChain": {
      "tier": "high",
      "perAdapter": {
        "integrated": { "tier": "medium" },
        "mobile-high": { "tier": "medium" },
        "mobile-low": { "tier": "low" },
        "mobile-mid": { "tier": "low" },
        "software": { "tier": "low" }
      }
    }
  }
}
