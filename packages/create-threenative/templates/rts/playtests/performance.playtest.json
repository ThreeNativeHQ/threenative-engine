{
  "name": "battlefield-performance",
  "target": "web",
  "schemaVersion": 1,
  "viewport": {
    "height": 1080,
    "width": 1920
  },
  "warmupFrames": 60,
  "steps": [
    {
      "holdTicks": 60,
      "kind": "input",
      "label": "pan",
      "press": "ArrowRight",
      "release": true
    },
    {
      "kind": "wait",
      "label": "settle",
      "release": true,
      "waitTicks": 600
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "runtimeReady": true
    },
    "performance": {
      "maxDrawCalls": 200,
      "maxTriangles": 400000,
      "minFps": 30
    },
    "renderChain": {
      "tier": "high",
      "perAdapter": {
        "integrated": { "tier": "medium" },
        "mobile-high": { "tier": "medium" },
        "mobile-low": { "tier": "low" },
        "mobile-mid": { "tier": "low" },
        "software": { "tier": "low" }
      }
    }
  }
}
