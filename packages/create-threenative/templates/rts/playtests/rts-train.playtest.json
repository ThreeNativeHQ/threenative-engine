{
  "name": "rts-train",
  "target": "web",
  "schemaVersion": 1,
  "viewport": { "width": 1280, "height": 720 },
  "warmupFrames": 20,
  "subject": "selection",
  "steps": [
    { "kind": "wait", "label": "settle", "waitTicks": 60, "release": true },
    {
      "kind": "click",
      "label": "select-core",
      "at": { "x": 583, "y": 352 },
      "waitTicks": 8
    },
    {
      "kind": "click",
      "label": "train",
      "at": { "x": 1232, "y": 460 },
      "waitTicks": 8
    },
    { "kind": "wait", "label": "queued", "waitTicks": 20, "release": true },
    { "kind": "wait", "label": "trained", "waitTicks": 200, "release": true }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "noRuntimeDiagnostics": true,
      "runtimeReady": true
    },
    "components": [
      {
        "entity": "selection",
        "component": "count",
        "atSteps": [{ "label": "select-core", "equals": 1 }]
      },
      {
        "entity": "selection",
        "component": "order",
        "atSteps": [{ "label": "select-core", "equals": "idle" }]
      }
    ],
    "resources": [
      {
        "id": "state",
        "path": "primaryType",
        "atSteps": [
          { "label": "select-core", "equals": "core" },
          { "label": "queued", "equals": "core" }
        ]
      },
      {
        "id": "state",
        "path": "notice",
        "atSteps": [{ "label": "queued", "textIncludes": "Surveyor queued" }]
      },
      { "id": "state", "path": "supplyUsed", "gte": 24 }
    ],
    "renderChain": {
      "tier": "high",
      "perAdapter": {
        "integrated": { "tier": "medium" },
        "mobile-high": { "tier": "medium" },
        "mobile-low": { "tier": "low" },
        "mobile-mid": { "tier": "low" },
        "software": { "tier": "low" }
      }
    }
  }
}
