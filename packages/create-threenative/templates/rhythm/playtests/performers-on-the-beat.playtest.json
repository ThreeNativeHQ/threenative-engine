{
  "name": "performers-on-the-beat",
  "warmupFrames": 10,
  "schemaVersion": 1,
  "target": "web",
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "subject": "player",
  "steps": [
    {
      "label": "called-left",
      "waitForResource": {
        "id": "state",
        "path": "songBeat",
        "gte": 0.1
      },
      "release": false,
      "timeoutMs": 90000
    },
    {
      "label": "call-done",
      "waitForResource": {
        "id": "state",
        "path": "songBeat",
        "gte": 3.5
      },
      "release": false,
      "timeoutMs": 90000
    },
    {
      "label": "n0-ready",
      "waitForResource": {
        "id": "state",
        "path": "songBeat",
        "gte": 3.96
      },
      "release": false,
      "timeoutMs": 90000
    },
    {
      "kind": "input",
      "label": "n0",
      "press": "ArrowLeft",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "wait",
      "label": "after-cool",
      "waitTicks": 2,
      "release": true
    },
    {
      "label": "n1-ready",
      "waitForResource": {
        "id": "state",
        "path": "songBeat",
        "gte": 4.74
      },
      "release": false,
      "timeoutMs": 90000
    },
    {
      "kind": "input",
      "label": "n1",
      "press": "ArrowRight",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "wait",
      "label": "after-bad",
      "waitTicks": 2,
      "release": true
    },
    {
      "label": "stray-ready",
      "waitForResource": {
        "id": "state",
        "path": "songBeat",
        "gte": 6.46
      },
      "release": false,
      "timeoutMs": 90000
    },
    {
      "kind": "input",
      "label": "stray",
      "press": "KeyZ",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "wait",
      "label": "after-miss",
      "waitTicks": 2,
      "release": true
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "noRuntimeDiagnostics": true,
      "runtimeReady": true
    },
    "animation": [
      {
        "atStep": "called-left",
        "entity": "teacher",
        "clip": "Punch_Jab",
        "entered": true
      },
      {
        "atStep": "after-cool",
        "entity": "player",
        "clip": "Punch_Jab",
        "entered": true
      },
      {
        "atStep": "after-bad",
        "entity": "player",
        "clip": "Hit_Chest",
        "entered": true
      },
      {
        "atStep": "after-miss",
        "entity": "player",
        "clip": "Hit_Head",
        "entered": true
      }
    ],
    "movement": {
      "entity": "teacher",
      "pathLength": 0.05
    },
    "components": [
      {
        "entity": "player",
        "component": "move",
        "atSteps": [
          {
            "label": "after-cool",
            "equals": "left"
          },
          {
            "label": "after-bad",
            "equals": "stumble"
          },
          {
            "label": "after-miss",
            "equals": "flinch"
          }
        ]
      }
    ]
  }
}
