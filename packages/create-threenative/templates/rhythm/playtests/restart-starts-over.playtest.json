{
  "name": "restart-starts-over",
  "warmupFrames": 10,
  "schemaVersion": 1,
  "target": "web",
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "subject": "player",
  "steps": [
    {
      "label": "line-1-judged",
      "waitForResource": {
        "id": "state",
        "path": "songBeat",
        "gte": 8.1
      },
      "release": false,
      "timeoutMs": 90000
    },
    {
      "kind": "input",
      "label": "restart",
      "press": "KeyR",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "wait",
      "label": "restarted",
      "waitTicks": 40,
      "release": true
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "noRuntimeDiagnostics": true,
      "runtimeReady": true
    },
    "resources": [
      {
        "id": "state",
        "path": "rung",
        "atSteps": [
          {
            "label": "line-1-judged",
            "equals": 4
          },
          {
            "label": "restarted",
            "equals": 3
          }
        ]
      },
      {
        "id": "state",
        "path": "linesJudged",
        "atSteps": [
          {
            "label": "line-1-judged",
            "equals": 1
          },
          {
            "label": "restarted",
            "equals": 0
          }
        ]
      },
      {
        "id": "state",
        "path": "part",
        "atSteps": [
          {
            "label": "line-1-judged",
            "equals": "teacher"
          },
          {
            "label": "restarted",
            "equals": "count-in"
          }
        ]
      },
      {
        "id": "state",
        "path": "miss",
        "atSteps": [
          {
            "label": "line-1-judged",
            "equals": 4
          },
          {
            "label": "restarted",
            "equals": 0
          }
        ]
      }
    ]
  }
}
