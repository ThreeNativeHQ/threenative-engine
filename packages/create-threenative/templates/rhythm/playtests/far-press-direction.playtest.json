{
  "name": "far-press-direction",
  "warmupFrames": 10,
  "schemaVersion": 1,
  "target": "web",
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "subject": "player",
  "steps": [
    {
      "label": "call-done",
      "waitForResource": {
        "id": "state",
        "path": "songBeat",
        "gte": 3.5
      },
      "release": false,
      "timeoutMs": 90000
    },
    {
      "label": "far-ready",
      "waitForResource": {
        "id": "state",
        "path": "songBeat",
        "gte": 4.62
      },
      "release": false,
      "timeoutMs": 90000
    },
    {
      "kind": "input",
      "label": "far",
      "press": "ArrowRight",
      "holdTicks": 1,
      "release": true
    },
    {
      "label": "after-far",
      "waitTicks": 2,
      "release": false
    },
    {
      "label": "far-late-ready",
      "waitForResource": {
        "id": "state",
        "path": "songBeat",
        "gte": 5.34
      },
      "release": false,
      "timeoutMs": 90000
    },
    {
      "kind": "input",
      "label": "far-late",
      "press": "ArrowRight",
      "holdTicks": 1,
      "release": true
    },
    {
      "label": "after-far-late",
      "waitTicks": 2,
      "release": false
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "noRuntimeDiagnostics": true,
      "runtimeReady": true
    },
    "resources": [
      {
        "id": "state",
        "path": "lastGrade",
        "atSteps": [
          {
            "label": "after-far",
            "equals": "miss"
          },
          {
            "label": "after-far-late",
            "equals": "miss"
          }
        ]
      },
      {
        "id": "state",
        "path": "lastTiming",
        "atSteps": [
          {
            "label": "after-far",
            "equals": "early"
          },
          {
            "label": "after-far-late",
            "equals": "late"
          }
        ]
      }
    ]
  }
}
