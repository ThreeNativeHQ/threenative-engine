      "noRuntimeDiagnostics": true,
      "runtimeReady": true
    },
    "resources": [
      {
        "id": "state",
        "path": "phase",
        "atSteps": [
          {
            "label": "result-shown",
            "equals": "cleared"
          }
        ]
      },
      {
        "id": "state",
        "path": "part",
        "atSteps": [
          {
            "label": "result-shown",
            "equals": "result"
          }
        ]
      },
      {
        "id": "state",
        "path": "linesJudged",
        "atSteps": [
          {
            "label": "result-shown",
            "equals": 8
          }
        ]
      },
      {
        "id": "state",
        "path": "level",
        "atSteps": [
          {
            "label": "result-shown",
            "equals": "cool"
          }
        ]
      },
      {
        "id": "state",
        "path": "miss",
        "atSteps": [
          {
            "label": "result-shown",
            "equals": 0
          }
        ],
        "allowTrivial": "A perfect song has no miss; the cleared phase above could not be reached with the rating this low otherwise."
      }
    ],
    "hud": [
      {
        "id": "stage-result",
        "textIncludes": "STAGE CLEAR",
        "visible": true,
        "allowTrivial": "The result panel exists only after the song ends; the cleared phase above proves the order."
      }
    ]
