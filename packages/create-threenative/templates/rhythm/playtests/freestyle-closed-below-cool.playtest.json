{
  "name": "freestyle-closed-below-cool",
  "warmupFrames": 10,
  "schemaVersion": 1,
  "target": "web",
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "subject": "player",
  "steps": [
    {
      "label": "l1-n0-ready",
      "waitForResource": {
        "id": "state",
        "path": "songBeat",
        "gte": 3.96
      },
      "release": false,
      "timeoutMs": 90000
    },
    {
      "kind": "input",
      "label": "l1-n0",
      "press": "ArrowLeft",
      "holdTicks": 1,
      "release": true
    },
    {
      "label": "l1-x0-ready",
      "waitForResource": {
        "id": "state",
        "path": "songBeat",
        "gte": 4.46
      },
      "release": false,
      "timeoutMs": 90000
    },
    {
      "kind": "input",
      "label": "l1-x0",
      "press": "KeyZ",
      "holdTicks": 1,
      "release": true
    },
    {
      "label": "l1-n1-ready",
      "waitForResource": {
        "id": "state",
        "path": "songBeat",
        "gte": 4.96
      },
      "release": false,
      "timeoutMs": 90000
    },
    {
      "kind": "input",
      "label": "l1-n1",
      "press": "ArrowRight",
      "holdTicks": 1,
      "release": true
    },
    {
      "label": "l1-x1-ready",
      "waitForResource": {
        "id": "state",
        "path": "songBeat",
        "gte": 5.46
      },
      "release": false,
      "timeoutMs": 90000
    },
    {
      "kind": "input",
      "label": "l1-x1",
      "press": "KeyZ",
      "holdTicks": 1,
      "release": true
    },
    {
      "label": "l1-n2-ready",
      "waitForResource": {
        "id": "state",
        "path": "songBeat",
        "gte": 5.96
      },
      "release": false,
      "timeoutMs": 90000
    },
    {
      "kind": "input",
      "label": "l1-n2",
      "press": "ArrowUp",
      "holdTicks": 1,
      "release": true
    },
    {
      "label": "l1-x2-ready",
      "waitForResource": {
        "id": "state",
        "path": "songBeat",
        "gte": 6.46
      },
      "release": false,
      "timeoutMs": 90000
    },
    {
      "kind": "input",
      "label": "l1-x2",
      "press": "KeyZ",
      "holdTicks": 1,
      "release": true
    },
    {
      "label": "l1-n3-ready",
      "waitForResource": {
        "id": "state",
        "path": "songBeat",
        "gte": 6.96
      },
      "release": false,
      "timeoutMs": 90000
    },
    {
      "kind": "input",
      "label": "l1-n3",
      "press": "ArrowDown",
      "holdTicks": 1,
      "release": true
    },
    {
      "label": "extras-done",
      "waitForResource": {
        "id": "state",
        "path": "songBeat",
        "gte": 7.1
      },
      "release": false,
      "timeoutMs": 90000
    },
    {
      "label": "line-1-judged",
      "waitForResource": {
        "id": "state",
        "path": "songBeat",
        "gte": 8.1
      },
      "release": false,
      "timeoutMs": 90000
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "noRuntimeDiagnostics": true,
      "runtimeReady": true
    },
    "resources": [
      {
        "id": "state",
        "path": "freestyleOpen",
        "atSteps": [
          {
            "label": "extras-done",
            "equals": 0
          }
        ],
        "allowTrivial": "The rating starts in the good band, so the freestyle flag is closed; the counts below prove nothing scored."
      },
      {
        "id": "state",
        "path": "freestyle",
        "atSteps": [
          {
            "label": "extras-done",
            "equals": 0
          },
          {
            "label": "line-1-judged",
            "equals": 0
          }
        ],
        "allowTrivial": "Nothing scores as freestyle outside the cool rating; the line score below proves the strays were charged."
      },
      {
        "id": "state",
        "path": "miss",
        "atSteps": [
          {
            "label": "extras-done",
            "equals": 3
          }
        ]
      },
      {
        "id": "state",
        "path": "lineScore",
        "atSteps": [
          {
            "label": "line-1-judged",
            "equals": 1
          }
        ]
      },
      {
        "id": "state",
        "path": "rung",
        "atSteps": [
          {
            "label": "line-1-judged",
            "equals": 3
          }
        ]
      }
    ]
  }
}
