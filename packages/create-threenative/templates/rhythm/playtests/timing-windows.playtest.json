{
  "name": "timing-windows",
  "warmupFrames": 10,
  "schemaVersion": 1,
  "target": "web",
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "subject": "player",
  "steps": [
    {
      "label": "call-done",
      "waitForResource": {
        "id": "state",
        "path": "songBeat",
        "gte": 3.5
      },
      "release": false,
      "timeoutMs": 90000
    },
    {
      "label": "n0-ready",
      "waitForResource": {
        "id": "state",
        "path": "songBeat",
        "gte": 3.96
      },
      "release": false,
      "timeoutMs": 90000
    },
    {
      "kind": "input",
      "label": "n0",
      "press": "ArrowLeft",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "wait",
      "label": "after-cool",
      "waitTicks": 2,
      "release": true
    },
    {
      "label": "n1-ready",
      "waitForResource": {
        "id": "state",
        "path": "songBeat",
        "gte": 5
      },
      "release": false,
      "timeoutMs": 90000
    },
    {
      "kind": "wait",
      "label": "n1-late",
      "waitTicks": 3,
      "release": true
    },
    {
      "kind": "input",
      "label": "n1",
      "press": "ArrowRight",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "wait",
      "label": "after-good",
      "waitTicks": 2,
      "release": true
    },
    {
      "label": "n2-ready",
      "waitForResource": {
        "id": "state",
        "path": "songBeat",
        "gte": 5.74
      },
      "release": false,
      "timeoutMs": 90000
    },
    {
      "kind": "input",
      "label": "n2",
      "press": "ArrowUp",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "wait",
      "label": "after-bad",
      "waitTicks": 2,
      "release": true
    },
    {
      "label": "n3-closed",
      "waitForResource": {
        "id": "state",
        "path": "songBeat",
        "gte": 7.4
      },
      "release": false,
      "timeoutMs": 90000
    },
    {
      "kind": "wait",
      "label": "after-miss",
      "waitTicks": 1,
      "release": true
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "noRuntimeDiagnostics": true,
      "runtimeReady": true
    },
    "resources": [
      {
        "id": "state",
        "path": "lastGrade",
        "atSteps": [
          {
            "label": "after-cool",
            "equals": "cool"
          },
          {
            "label": "after-good",
            "equals": "good"
          },
          {
            "label": "after-bad",
            "equals": "bad"
          },
          {
            "label": "after-miss",
            "equals": "miss"
          }
        ]
      },
      {
        "id": "state",
        "path": "lastTiming",
        "atSteps": [
          {
            "label": "after-cool",
            "equals": "on"
          },
          {
            "label": "after-good",
            "equals": "late"
          },
          {
            "label": "after-bad",
            "equals": "early"
          },
          {
            "label": "after-miss",
            "equals": "none"
          }
        ]
      },
      {
        "id": "state",
        "path": "cool",
        "atSteps": [
          {
            "label": "after-miss",
            "equals": 1
          }
        ]
      },
      {
        "id": "state",
        "path": "good",
        "atSteps": [
          {
            "label": "after-miss",
            "equals": 1
          }
        ]
      },
      {
        "id": "state",
        "path": "bad",
        "atSteps": [
          {
            "label": "after-miss",
            "equals": 1
          }
        ]
      },
      {
        "id": "state",
        "path": "miss",
        "atSteps": [
          {
            "label": "after-miss",
            "equals": 1
          }
        ]
      }
    ]
  }
}
