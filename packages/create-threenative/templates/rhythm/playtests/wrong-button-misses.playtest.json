{
  "name": "wrong-button-misses",
  "warmupFrames": 10,
  "schemaVersion": 1,
  "target": "web",
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "subject": "player",
  "steps": [
    {
      "label": "call-done",
      "waitForResource": {
        "id": "state",
        "path": "songBeat",
        "gte": 3.5
      },
      "release": false,
      "timeoutMs": 90000
    },
    {
      "label": "wrong-0-ready",
      "waitForResource": {
        "id": "state",
        "path": "songBeat",
        "gte": 3.96
      },
      "release": false,
      "timeoutMs": 90000
    },
    {
      "kind": "input",
      "label": "wrong-0",
      "press": "KeyZ",
      "holdTicks": 1,
      "release": true
    },
    {
      "label": "wrong-1-ready",
      "waitForResource": {
        "id": "state",
        "path": "songBeat",
        "gte": 4.96
      },
      "release": false,
      "timeoutMs": 90000
    },
    {
      "kind": "input",
      "label": "wrong-1",
      "press": "KeyZ",
      "holdTicks": 1,
      "release": true
    },
    {
      "label": "wrong-2-ready",
      "waitForResource": {
        "id": "state",
        "path": "songBeat",
        "gte": 5.96
      },
      "release": false,
      "timeoutMs": 90000
    },
    {
      "kind": "input",
      "label": "wrong-2",
      "press": "KeyZ",
      "holdTicks": 1,
      "release": true
    },
    {
      "label": "wrong-3-ready",
      "waitForResource": {
        "id": "state",
        "path": "songBeat",
        "gte": 6.96
      },
      "release": false,
      "timeoutMs": 90000
    },
    {
      "kind": "input",
      "label": "wrong-3",
      "press": "KeyZ",
      "holdTicks": 1,
      "release": true
    },
    {
      "label": "closed",
      "waitForResource": {
        "id": "state",
        "path": "songBeat",
        "gte": 8.0
      },
      "release": false,
      "timeoutMs": 90000
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "noRuntimeDiagnostics": true,
      "runtimeReady": true
    },
    "resources": [
      {
        "id": "state",
        "path": "matched",
        "atSteps": [
          {
            "label": "call-done",
            "equals": 0
          },
          {
            "label": "closed",
            "equals": 0
          }
        ],
        "allowTrivial": "Matched stays zero: the proof is that the miss count below rose to eight while the right timing was held."
      },
      {
        "id": "state",
        "path": "cool",
        "atSteps": [
          {
            "label": "closed",
            "equals": 0
          }
        ],
        "allowTrivial": "No wrong button earns a grade."
      },
      {
        "id": "state",
        "path": "miss",
        "atSteps": [
          {
            "label": "call-done",
            "equals": 0
          },
          {
            "label": "closed",
            "equals": 8
          }
        ]
      },
      {
        "id": "state",
        "path": "lastGrade",
        "atSteps": [
          {
            "label": "closed",
            "equals": "miss"
          }
        ]
      }
    ]
  }
}
