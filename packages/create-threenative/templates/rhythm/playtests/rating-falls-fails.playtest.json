{
  "name": "rating-falls-fails",
  "warmupFrames": 10,
  "schemaVersion": 1,
  "target": "web",
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "subject": "player",
  "steps": [
    {
      "label": "line-1-judged",
      "waitForResource": {
        "id": "state",
        "path": "songBeat",
        "gte": 8.1
      },
      "release": false,
      "timeoutMs": 120000
    },
    {
      "label": "line-2-judged",
      "waitForResource": {
        "id": "state",
        "path": "songBeat",
        "gte": 16.1
      },
      "release": false,
      "timeoutMs": 120000
    },
    {
      "label": "line-3-judged",
      "waitForResource": {
        "id": "state",
        "path": "songBeat",
        "gte": 24.1
      },
      "release": false,
      "timeoutMs": 120000
    },
    {
      "label": "line-4-judged",
      "waitForResource": {
        "id": "state",
        "path": "songBeat",
        "gte": 32.1
      },
      "release": false,
      "timeoutMs": 120000
    },
    {
      "label": "line-5-judged",
      "waitForResource": {
        "id": "state",
        "path": "songBeat",
        "gte": 40.1
      },
      "release": false,
      "timeoutMs": 120000
    },
    {
      "label": "failed",
      "waitForResource": {
        "id": "state",
        "path": "phase",
        "equals": "failed"
      },
      "release": false,
      "timeoutMs": 90000
    },
    {
      "kind": "wait",
      "label": "result-shown",
      "waitTicks": 20,
      "release": true
    },
    {
      "kind": "input",
      "label": "restart",
      "press": "KeyR",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "wait",
      "label": "restarted",
      "waitTicks": 40,
      "release": true
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "noRuntimeDiagnostics": true,
      "runtimeReady": true
    },
    "resources": [
      {
        "id": "state",
        "path": "rung",
        "atSteps": [
          {
            "label": "line-1-judged",
            "equals": 4
          },
          {
            "label": "line-2-judged",
            "equals": 5
          },
          {
            "label": "line-3-judged",
            "equals": 6
          },
          {
            "label": "line-4-judged",
            "equals": 7
          },
          {
            "label": "line-5-judged",
            "equals": 8
          },
          {
            "label": "restarted",
            "equals": 3
          }
        ]
      },
      {
        "id": "state",
        "path": "level",
        "atSteps": [
          {
            "label": "line-2-judged",
            "equals": "bad"
          },
          {
            "label": "line-4-judged",
            "equals": "awful"
          },
          {
            "label": "line-5-judged",
            "equals": "end"
          },
          {
            "label": "restarted",
            "equals": "good"
          }
        ]
      },
      {
        "id": "state",
        "path": "phase",
        "atSteps": [
          {
            "label": "line-4-judged",
            "equals": "playing"
          },
          {
            "label": "failed",
            "equals": "failed"
          },
          {
            "label": "restarted",
            "equals": "playing"
          }
        ]
      },
      {
        "id": "state",
        "path": "part",
        "atSteps": [
          {
            "label": "result-shown",
            "equals": "result"
          },
          {
            "label": "restarted",
            "equals": "count-in"
          }
        ]
      },
      {
        "id": "state",
        "path": "linesJudged",
        "atSteps": [
          {
            "label": "failed",
            "equals": 5
          },
          {
            "label": "restarted",
            "equals": 0
          }
        ]
      }
    ],
    "components": [
      {
        "entity": "player",
        "component": "fallen",
        "atSteps": [
          {
            "label": "line-4-judged",
            "equals": false
          },
          {
            "label": "result-shown",
            "equals": true
          },
          {
            "label": "restarted",
            "equals": false
          }
        ]
      }
    ],
    "hud": [
      {
        "id": "stage-result",
        "textIncludes": "STAGE FAILED",
        "visible": true,
        "allowTrivial": "The result panel exists only after the fall; the failed phase above proves the order."
      }
    ]
  }
}
