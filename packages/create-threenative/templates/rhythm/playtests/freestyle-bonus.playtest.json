    {
      "label": "extras-done",
      "waitForResource": {
        "id": "state",
        "path": "songBeat",
        "gte": 23.1
      },
      "release": false,
      "timeoutMs": 90000
    },
    {
      "label": "line-3-judged",
      "waitForResource": {
        "id": "state",
        "path": "songBeat",
        "gte": 24.1
      },
      "release": false,
      "timeoutMs": 90000
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "noRuntimeDiagnostics": true,
      "runtimeReady": true
    },
    "resources": [
      {
        "id": "state",
        "path": "freestyleOpen",
        "atSteps": [
          {
            "label": "extras-done",
            "equals": 1
          }
        ]
      },
      {
        "id": "state",
        "path": "freestyle",
        "atSteps": [
          {
            "label": "extras-done",
            "equals": 3
          },
          {
            "label": "line-3-judged",
            "equals": 3
          }
        ]
      },
      {
        "id": "state",
        "path": "miss",
        "atSteps": [
          {
            "label": "line-3-judged",
            "equals": 1
          }
        ]
      },
      {
        "id": "state",
        "path": "lineScore",
        "atSteps": [
          {
            "label": "line-3-judged",
            "equals": 9
          }
        ]
      },
      {
        "id": "state",
        "path": "rung",
        "atSteps": [
          {
            "label": "line-3-judged",
            "equals": 0
          }
        ]
      }
    ],
    "hud": [
      {
        "id": "grade-hud",
        "textIncludes": "FREESTYLE 3",
        "visible": true
      }
    ]
  }
}
