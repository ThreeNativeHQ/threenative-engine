{
  "name": "player-wrecked-loses",
  "target": "web",
  "schemaVersion": 1,
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "warmupFrames": 10,
  "subject": "player",
  "steps": [
    {
      "kind": "wait",
      "label": "settle",
      "waitTicks": 20,
      "release": true
    },
    {
      "kind": "input",
      "label": "staged",
      "press": "Digit0",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "wait",
      "label": "ready",
      "waitTicks": 2,
      "release": true
    },
    {
      "kind": "input",
      "label": "drive",
      "press": "ArrowUp",
      "holdTicks": 120,
      "release": true
    },
    {
      "kind": "wait",
      "label": "after",
      "waitTicks": 20,
      "release": true
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "runtimeReady": true
    },
    "components": [
      {
        "entity": "player",
        "component": "wrecked",
        "atSteps": [
          {
            "label": "ready",
            "equals": false
          }
        ]
      },
      {
        "entity": "player",
        "component": "wrecked",
        "equals": true
      }
    ],
    "resources": [
      {
        "id": "state",
        "path": "phase",
        "equals": "lost"
      },
      {
        "id": "state",
        "path": "banner",
        "textIncludes": "WRECKED"
      }
    ],
    "signals": [
      {
        "name": "wrecked",
        "entity": "player",
        "minCount": 1
      }
    ]
  }
}
