{
  "name": "damage-degrades-driving",
  "target": "web",
  "schemaVersion": 1,
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "warmupFrames": 10,
  "subject": "player",
  "steps": [
    {
      "kind": "wait",
      "label": "settle",
      "waitTicks": 20,
      "release": true
    },
    {
      "kind": "input",
      "label": "staged",
      "press": "BracketRight",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "wait",
      "label": "ready",
      "waitTicks": 2,
      "release": true
    },
    {
      "kind": "input",
      "label": "try-handbrake",
      "press": ["ArrowUp", "Space"],
      "holdTicks": 60,
      "release": true
    },
    {
      "kind": "wait",
      "label": "after",
      "waitTicks": 5,
      "release": true
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "runtimeReady": true
    },
    "components": [
      {
        "entity": "player",
        "component": "power",
        "atSteps": [
          {
            "label": "ready",
            "equals": 0.4
          }
        ]
      },
      {
        "entity": "player",
        "component": "brakeEfficiency",
        "lte": 0.65
      },
      {
        "entity": "player",
        "component": "handbrakeWorks",
        "equals": false
      },
      {
        "entity": "player",
        "component": "wheelWorst",
        "equals": 60
      },
      {
        "entity": "player",
        "component": "handbrake",
        "equals": false,
        "allowTrivial": "A dead rear brake leaves the handbrake off whatever the key says."
      }
    ]
  }
}
