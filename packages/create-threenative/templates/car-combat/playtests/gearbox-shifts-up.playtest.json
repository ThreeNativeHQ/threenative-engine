{
  "name": "gearbox-shifts-up",
  "target": "web",
  "schemaVersion": 1,
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "warmupFrames": 10,
  "subject": "player",
  "steps": [
    {
      "kind": "wait",
      "label": "settle",
      "waitTicks": 20,
      "release": true
    },
    {
      "kind": "input",
      "label": "staged",
      "press": "Digit1",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "wait",
      "label": "ready",
      "waitTicks": 2,
      "release": true
    },
    {
      "kind": "input",
      "label": "drive",
      "press": "ArrowUp",
      "holdTicks": 480,
      "release": true
    },
    {
      "kind": "wait",
      "label": "after",
      "waitTicks": 5,
      "release": true
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "runtimeReady": true
    },
    "components": [
      {
        "entity": "player",
        "component": "gear",
        "atSteps": [
          {
            "label": "ready",
            "equals": 0
          }
        ]
      },
      {
        "entity": "player",
        "component": "gear",
        "gte": 3
      },
      {
        "entity": "player",
        "component": "shifts",
        "gte": 3
      },
      {
        "entity": "player",
        "component": "kmh",
        "gte": 60
      },
      {
        "entity": "player",
        "component": "rpm",
        "lte": 7500,
        "changed": true
      }
    ]
  }
}
