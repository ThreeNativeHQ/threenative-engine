{
  "name": "time-up-loses",
  "target": "web",
  "schemaVersion": 1,
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "warmupFrames": 10,
  "subject": "player",
  "steps": [
    {
      "kind": "wait",
      "label": "settle",
      "waitTicks": 20,
      "release": true
    },
    {
      "kind": "input",
      "label": "staged",
      "press": "Digit9",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "wait",
      "label": "ready",
      "waitTicks": 2,
      "release": true
    },
    {
      "kind": "wait",
      "label": "running",
      "waitTicks": 240,
      "release": true
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "runtimeReady": true
    },
    "resources": [
      {
        "id": "state",
        "path": "phase",
        "atSteps": [
          {
            "label": "ready",
            "equals": "playing"
          }
        ]
      },
      {
        "id": "state",
        "path": "phase",
        "equals": "lost"
      },
      {
        "id": "state",
        "path": "banner",
        "textIncludes": "TIME UP"
      },
      {
        "id": "state",
        "path": "timeLeft",
        "equals": 0
      }
    ]
  }
}
