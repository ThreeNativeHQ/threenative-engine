{
  "name": "rival-wrecked-counts",
  "target": "web",
  "schemaVersion": 1,
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "warmupFrames": 10,
  "subject": "player",
  "steps": [
    {
      "kind": "wait",
      "label": "settle",
      "waitTicks": 20,
      "release": true
    },
    {
      "kind": "input",
      "label": "staged",
      "press": "Digit4",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "wait",
      "label": "ready",
      "waitTicks": 2,
      "release": true
    },
    {
      "kind": "input",
      "label": "drive",
      "press": "ArrowUp",
      "holdTicks": 120,
      "release": true
    },
    {
      "kind": "wait",
      "label": "after",
      "waitTicks": 20,
      "release": true
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "runtimeReady": true
    },
    "components": [
      {
        "entity": "rival.0",
        "component": "wrecked",
        "atSteps": [
          {
            "label": "ready",
            "equals": false
          }
        ]
      },
      {
        "entity": "rival.0",
        "component": "wrecked",
        "equals": true
      }
    ],
    "resources": [
      {
        "id": "state",
        "path": "rivalsWrecked",
        "equals": 1
      },
      {
        "id": "state",
        "path": "phase",
        "equals": "playing",
        "allowTrivial": "Two rivals still run, so the run goes on."
      }
    ],
    "signals": [
      {
        "name": "wrecked",
        "entity": "rival.0",
        "minCount": 1
      }
    ]
  }
}
