{
  "name": "win-by-laps",
  "target": "web",
  "schemaVersion": 1,
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "warmupFrames": 10,
  "subject": "player",
  "steps": [
    {
      "kind": "wait",
      "label": "settle",
      "waitTicks": 20,
      "release": true
    },
    {
      "kind": "input",
      "label": "staged",
      "press": "Digit8",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "wait",
      "label": "ready",
      "waitTicks": 2,
      "release": true
    },
    {
      "kind": "input",
      "label": "drive",
      "press": "ArrowUp",
      "holdTicks": 90,
      "release": true
    },
    {
      "kind": "wait",
      "label": "after",
      "waitTicks": 5,
      "release": true
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "runtimeReady": true
    },
    "resources": [
      {
        "id": "state",
        "path": "phase",
        "atSteps": [
          {
            "label": "ready",
            "equals": "playing"
          }
        ]
      },
      {
        "id": "state",
        "path": "phase",
        "equals": "won"
      },
      {
        "id": "state",
        "path": "winBy",
        "equals": "laps"
      },
      {
        "id": "state",
        "path": "banner",
        "textIncludes": "RACE WON"
      }
    ]
  }
}
