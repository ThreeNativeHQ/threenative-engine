{
  "name": "rain-native-strike-flashes-and-thunder-follows",
  "schemaVersion": 1,
  "target": "desktop",
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "warmupFrames": 30,
  "artifacts": {
    "screenshots": "after"
  },
  "steps": [
    {
      "kind": "wait",
      "label": "boot",
      "waitTicks": 30,
      "release": true
    },
    {
      "kind": "input",
      "press": "KeyM",
      "label": "sound",
      "waitTicks": 10,
      "release": true
    },
    {
      "kind": "input",
      "press": "KeyX",
      "label": "safe",
      "waitTicks": 4,
      "release": true
    },
    {
      "kind": "input",
      "press": "KeyL",
      "label": "safe-strike",
      "waitTicks": 6,
      "release": true
    },
    {
      "kind": "input",
      "press": "KeyX",
      "label": "flashes-on",
      "waitTicks": 4,
      "release": true
    },
    {
      "kind": "input",
      "press": "KeyL",
      "label": "strike",
      "waitTicks": 6,
      "screenshot": "native-strike",
      "release": true
    },
    {
      "kind": "wait",
      "label": "in-the-air",
      "waitTicks": 30,
      "release": true
    },
    {
      "kind": "wait",
      "label": "heard",
      "waitTicks": 150,
      "release": true
    }
  ],
  "assert": {
    "resources": [
      {
        "id": "state",
        "path": "reducedMotion",
        "allowTrivial": "the branch this run takes: the UI page answers its own prefers-reduced-motion query and this private display has no reduced-motion setting, so WebKit answers no-preference and the storm boots flashing. The suppressed branch is the web reduced-motion scenario's (it emulates reduce). If a host ever answers reduce, this assertion names it instead of the run failing later on `safe`.",
        "atSteps": [
          {
            "equals": false,
            "label": "boot"
          }
        ],
        "equals": false
      },
      {
        "id": "state",
        "path": "safe",
        "atSteps": [
          {
            "equals": false,
            "label": "boot"
          },
          {
            "equals": true,
            "label": "safe"
          },
          {
            "equals": true,
            "label": "safe-strike"
          },
          {
            "equals": false,
            "label": "flashes-on"
          },
          {
            "equals": false,
            "label": "strike"
          }
        ]
      },
      {
        "id": "state",
        "path": "autoLightning",
        "atSteps": [
          {
            "equals": false,
            "label": "safe"
          }
        ],
        "equals": false
      },
      {
        "id": "state",
        "path": "audioEnabled",
        "atSteps": [
          {
            "equals": true,
            "label": "sound"
          }
        ],
        "equals": true
      },
      {
        "id": "state",
        "path": "flash",
        "atSteps": [
          {
            "equals": 0,
            "label": "safe-strike"
          }
        ]
      },
      {
        "id": "state",
        "path": "strikes",
        "atSteps": [
          {
            "equals": 0,
            "label": "safe-strike"
          },
          {
            "equals": 1,
            "label": "strike"
          },
          {
            "equals": 1,
            "label": "heard"
          }
        ],
        "equals": 1
      },
      {
        "id": "state",
        "path": "status",
        "atSteps": [
          {
            "equals": "steady",
            "label": "safe-strike"
          },
          {
            "equals": "flashing",
            "label": "strike"
          }
        ]
      },
      {
        "id": "state",
        "path": "lastStrike.delay",
        "gte": 0.7,
        "lte": 1.6
      },
      {
        "id": "state",
        "path": "lastStrike.metres",
        "gte": 250,
        "lte": 520
      },
      {
        "id": "state",
        "path": "pendingThunderAt",
        "atSteps": [
          {
            "equals": -1,
            "label": "safe-strike"
          },
          {
            "equals": -1,
            "label": "heard"
          }
        ]
      }
    ],
    "components": [
      {
        "entity": "storm-audio",
        "component": "pendingThunder",
        "atSteps": [
          {
            "equals": 0,
            "label": "safe-strike"
          },
          {
            "equals": 1,
            "label": "strike"
          },
          {
            "equals": 1,
            "label": "in-the-air"
          },
          {
            "equals": 0,
            "label": "heard"
          }
        ]
      },
      {
        "entity": "storm-audio",
        "component": "thunderVoices",
        "atSteps": [
          {
            "equals": 0,
            "label": "in-the-air"
          },
          {
            "equals": 1,
            "label": "heard"
          }
        ],
        "equals": 1
      }
    ],
    "audio": [
      {
        "cue": "thunder",
        "minPlays": 1,
        "maxPlays": 1
      }
    ]
  }
}
