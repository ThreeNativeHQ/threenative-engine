{
  "name": "stall-drops-the-nose-then-recovers",
  "warmupFrames": 10,
  "schemaVersion": 1,
  "target": "web",
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "subject": "player",
  "steps": [
    {
      "label": "settled",
      "waitForResource": {
        "id": "state",
        "path": "time",
        "gte": 0.3
      },
      "release": false,
      "timeoutMs": 8000
    },
    {
      "kind": "input",
      "label": "open-air",
      "press": "Digit1",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "wait",
      "label": "trim",
      "waitTicks": 20,
      "release": true
    },
    {
      "kind": "input",
      "label": "dive",
      "press": "ArrowUp",
      "holdTicks": 30,
      "release": false
    },
    {
      "label": "dived",
      "waitForResource": {
        "id": "state",
        "path": "airspeed",
        "gte": 30
      },
      "release": false,
      "timeoutMs": 12000
    },
    {
      "kind": "wait",
      "label": "let-go",
      "waitTicks": 2,
      "release": true
    },
    {
      "kind": "input",
      "label": "pull",
      "press": "ArrowDown",
      "holdTicks": 30,
      "release": false
    },
    {
      "label": "stalled",
      "waitForResource": {
        "id": "state",
        "path": "stalls",
        "gte": 1
      },
      "release": false,
      "timeoutMs": 20000
    },
    {
      "label": "nose-drops",
      "waitForResource": {
        "id": "state",
        "path": "pitchDeg",
        "lte": -30
      },
      "release": false,
      "timeoutMs": 4000
    },
    {
      "label": "recovered",
      "waitForResource": {
        "id": "state",
        "path": "stalled",
        "equals": 0
      },
      "release": false,
      "timeoutMs": 6000
    },
    {
      "label": "flying-again",
      "waitForResource": {
        "id": "state",
        "path": "airspeed",
        "gte": 12
      },
      "release": false,
      "timeoutMs": 6000
    },
    {
      "kind": "wait",
      "label": "end",
      "waitTicks": 2,
      "release": true
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "runtimeReady": true
    },
    "resources": [
      {
        "id": "state",
        "path": "stalled",
        "atSteps": [
          {
            "label": "recovered",
            "equals": 0
          }
        ]
      }
    ],
    "signals": [
      {
        "name": "stall",
        "entity": "player",
        "minCount": 1
      }
    ]
  }
}
