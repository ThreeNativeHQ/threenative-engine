{
  "name": "ring-counts-when-flown-through-its-centre",
  "warmupFrames": 10,
  "schemaVersion": 1,
  "target": "web",
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "subject": "player",
  "steps": [
    {
      "label": "settled",
      "waitForResource": {
        "id": "state",
        "path": "time",
        "gte": 0.3
      },
      "release": false,
      "timeoutMs": 8000
    },
    {
      "kind": "input",
      "label": "approach",
      "press": "Digit3",
      "holdTicks": 1,
      "release": true
    },
    {
      "label": "passed",
      "waitForResource": {
        "id": "state",
        "path": "ringsPassed",
        "gte": 1
      },
      "release": true,
      "timeoutMs": 8000
    },
    {
      "kind": "wait",
      "label": "end",
      "waitTicks": 4,
      "release": true
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "runtimeReady": true
    },
    "resources": [
      {
        "id": "state",
        "path": "ringsMissed",
        "atSteps": [
          {
            "label": "end",
            "equals": 0
          }
        ]
      }
    ],
    "signals": [
      {
        "name": "ring-passed",
        "entity": "ring-1",
        "minCount": 1
      }
    ]
  }
}
