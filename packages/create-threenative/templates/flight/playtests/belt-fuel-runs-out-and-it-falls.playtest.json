{
  "name": "belt-fuel-runs-out-and-it-falls",
  "warmupFrames": 10,
  "schemaVersion": 1,
  "target": "web",
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "subject": "player",
  "steps": [
    {
      "kind": "input",
      "label": "swap",
      "press": "KeyV",
      "holdTicks": 1,
      "release": true
    },
    {
      "label": "belt",
      "waitForResource": {
        "id": "state",
        "path": "ringsTotal",
        "equals": 3
      },
      "release": true,
      "timeoutMs": 8000
    },
    {
      "label": "belt-up",
      "waitForResource": {
        "id": "state",
        "path": "time",
        "gte": 0.3
      },
      "release": false,
      "timeoutMs": 8000
    },
    {
      "kind": "input",
      "label": "low-tank",
      "press": "Digit2",
      "holdTicks": 1,
      "release": true
    },
    {
      "label": "low",
      "waitForResource": {
        "id": "state",
        "path": "lowFuel",
        "equals": 1
      },
      "release": true,
      "timeoutMs": 8000
    },
    {
      "label": "dry",
      "waitForResource": {
        "id": "state",
        "path": "burning",
        "equals": 0
      },
      "release": true,
      "timeoutMs": 12000
    },
    {
      "label": "falls",
      "waitForResource": {
        "id": "state",
        "path": "phase",
        "equals": "crashed"
      },
      "release": true,
      "timeoutMs": 8000
    },
    {
      "kind": "wait",
      "label": "end",
      "waitTicks": 2,
      "release": true
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "runtimeReady": true
    },
    "resources": [
      {
        "id": "state",
        "path": "fuel",
        "atSteps": [
          {
            "label": "falls",
            "equals": 0
          }
        ]
      }
    ]
  }
}
