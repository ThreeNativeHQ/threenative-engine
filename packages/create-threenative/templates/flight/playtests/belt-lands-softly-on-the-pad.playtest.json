{
  "name": "belt-lands-softly-on-the-pad",
  "warmupFrames": 10,
  "schemaVersion": 1,
  "target": "web",
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "subject": "player",
  "steps": [
    {
      "kind": "input",
      "label": "swap",
      "press": "KeyV",
      "holdTicks": 1,
      "release": true
    },
    {
      "label": "belt",
      "waitForResource": {
        "id": "state",
        "path": "ringsTotal",
        "equals": 3
      },
      "release": true,
      "timeoutMs": 8000
    },
    {
      "label": "belt-up",
      "waitForResource": {
        "id": "state",
        "path": "time",
        "gte": 0.3
      },
      "release": false,
      "timeoutMs": 8000
    },
    {
      "kind": "input",
      "label": "over-pad",
      "press": "Digit6",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "input",
      "label": "sink",
      "press": "ShiftLeft",
      "holdTicks": 30,
      "release": false
    },
    {
      "label": "down",
      "waitForResource": {
        "id": "state",
        "path": "phase",
        "equals": "landed"
      },
      "release": false,
      "timeoutMs": 12000
    },
    {
      "kind": "wait",
      "label": "end",
      "waitTicks": 2,
      "release": true
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "runtimeReady": true
    },
    "resources": [
      {
        "id": "state",
        "path": "onPad",
        "atSteps": [
          {
            "label": "down",
            "equals": 1
          }
        ]
      },
      {
        "id": "state",
        "path": "crashReason",
        "atSteps": [
          {
            "label": "down",
            "equals": ""
          }
        ]
      }
    ]
  }
}
