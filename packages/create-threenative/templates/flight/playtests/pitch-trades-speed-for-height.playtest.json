{
  "name": "pitch-trades-speed-for-height",
  "warmupFrames": 10,
  "schemaVersion": 1,
  "target": "web",
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "subject": "player",
  "steps": [
    {
      "label": "settled",
      "waitForResource": {
        "id": "state",
        "path": "time",
        "gte": 0.3
      },
      "release": false,
      "timeoutMs": 8000
    },
    {
      "kind": "input",
      "label": "open-air",
      "press": "Digit1",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "wait",
      "label": "trim",
      "waitTicks": 40,
      "release": true
    },
    {
      "kind": "input",
      "label": "push",
      "press": "ArrowUp",
      "holdTicks": 30,
      "release": false
    },
    {
      "label": "fast",
      "waitForResource": {
        "id": "state",
        "path": "airspeed",
        "gte": 26
      },
      "release": false,
      "timeoutMs": 18000
    },
    {
      "kind": "wait",
      "label": "let-go",
      "waitTicks": 2,
      "release": true
    },
    {
      "kind": "input",
      "label": "pull",
      "press": ["ArrowDown"],
      "holdTicks": 30,
      "release": false
    },
    {
      "label": "zoom",
      "waitForResource": {
        "id": "state",
        "path": "climb",
        "gte": 2
      },
      "release": false,
      "timeoutMs": 18000
    },
    {
      "label": "slow",
      "waitForResource": {
        "id": "state",
        "path": "airspeed",
        "lte": 19
      },
      "release": false,
      "timeoutMs": 24000
    },
    {
      "kind": "wait",
      "label": "end",
      "waitTicks": 2,
      "release": true
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "runtimeReady": true
    },
    "resources": [
      {
        "id": "state",
        "path": "airspeed",
        "atSteps": [
          {
            "label": "trim",
            "lte": 21
          }
        ],
        "allowTrivial": "The glider starts the run at rest in the state; this run proves it settles at its trim speed of about 18 m/s."
      }
    ],
    "signals": [
      {
        "name": "station1",
        "entity": "player",
        "minCount": 1
      }
    ]
  }
}
