{
  "name": "upside-down-is-a-crash",
  "warmupFrames": 10,
  "schemaVersion": 1,
  "target": "web",
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "subject": "player",
  "steps": [
    {
      "label": "settled",
      "waitForResource": {
        "id": "state",
        "path": "time",
        "gte": 0.3
      },
      "release": false,
      "timeoutMs": 8000
    },
    {
      "kind": "input",
      "label": "on-its-back",
      "press": "Digit8",
      "holdTicks": 1,
      "release": true
    },
    {
      "label": "crashed",
      "waitForResource": {
        "id": "state",
        "path": "phase",
        "equals": "crashed"
      },
      "release": true,
      "timeoutMs": 8000
    },
    {
      "kind": "wait",
      "label": "end",
      "waitTicks": 4,
      "release": true
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "runtimeReady": true
    },
    "resources": [
      {
        "id": "state",
        "path": "crashReason",
        "atSteps": [
          {
            "label": "crashed",
            "equals": "inverted"
          }
        ]
      }
    ]
  }
}
