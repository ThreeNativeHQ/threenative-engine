{
  "name": "landing-is-scored-on-distance-and-sink",
  "warmupFrames": 10,
  "schemaVersion": 1,
  "target": "web",
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "subject": "player",
  "steps": [
    {
      "label": "settled",
      "waitForResource": {
        "id": "state",
        "path": "time",
        "gte": 0.3
      },
      "release": false,
      "timeoutMs": 8000
    },
    {
      "kind": "input",
      "label": "short-final",
      "press": "Digit6",
      "holdTicks": 1,
      "release": true
    },
    {
      "label": "down",
      "waitForResource": {
        "id": "state",
        "path": "phase",
        "equals": "landed"
      },
      "release": true,
      "timeoutMs": 20000
    },
    {
      "label": "scored",
      "waitForResource": {
        "id": "state",
        "path": "landPoints",
        "gte": 30
      },
      "release": true,
      "timeoutMs": 2000
    },
    {
      "kind": "wait",
      "label": "end",
      "waitTicks": 4,
      "release": true
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "runtimeReady": true
    },
    "resources": [
      {
        "id": "state",
        "path": "onPad",
        "atSteps": [
          {
            "label": "down",
            "equals": 1
          }
        ]
      },
      {
        "id": "state",
        "path": "landDistance",
        "atSteps": [
          {
            "label": "down",
            "lte": 18
          }
        ]
      },
      {
        "id": "state",
        "path": "landSink",
        "atSteps": [
          {
            "label": "down",
            "lte": 5.5
          }
        ]
      }
    ],
    "hud": [
      {
        "id": "score-card",
        "textIncludes": "total",
        "visible": true
      }
    ]
  }
}
