{
  "name": "wind-drifts-the-glider",
  "warmupFrames": 10,
  "schemaVersion": 1,
  "target": "web",
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "subject": "player",
  "steps": [
    {
      "label": "settled",
      "waitForResource": {
        "id": "state",
        "path": "time",
        "gte": 0.3
      },
      "release": false,
      "timeoutMs": 8000
    },
    {
      "kind": "input",
      "label": "open-air",
      "press": "Digit1",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "wait",
      "label": "away",
      "waitTicks": 20,
      "release": true
    },
    {
      "label": "drifted",
      "waitForResource": {
        "id": "state",
        "path": "playerX",
        "gte": 312
      },
      "release": true,
      "timeoutMs": 12000
    },
    {
      "label": "breeze",
      "waitForResource": {
        "id": "state",
        "path": "windSpeed",
        "gte": 2
      },
      "release": true,
      "timeoutMs": 2000
    },
    {
      "kind": "wait",
      "label": "end",
      "waitTicks": 2,
      "release": true
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "runtimeReady": true
    },
    "resources": [
      {
        "id": "state",
        "path": "playerX",
        "atSteps": [
          {
            "label": "away",
            "lte": 303
          }
        ]
      }
    ]
  }
}
