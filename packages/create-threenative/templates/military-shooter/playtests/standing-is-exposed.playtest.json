{
  "name": "standing-is-exposed",
  "warmupFrames": 10,
  "schemaVersion": 1,
  "target": "web",
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "subject": "player",
  "steps": [
    {
      "kind": "input",
      "label": "place",
      "press": "Digit3",
      "holdTicks": 1,
      "release": true
    },
    {
      "label": "settled",
      "waitForResource": {
        "id": "state",
        "path": "time",
        "gte": 0.5
      },
      "release": false,
      "timeoutMs": 5000
    },
    {
      "label": "struck",
      "waitForResource": {
        "id": "state",
        "path": "hitsTaken",
        "gte": 1
      },
      "release": false,
      "timeoutMs": 14000
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "runtimeReady": true
    },
    "resources": [
      {
        "id": "state",
        "path": "blockedShots",
        "atSteps": [
          {
            "label": "struck",
            "equals": 0
          }
        ]
      },
      {
        "id": "state",
        "path": "shield",
        "lte": 99
      }
    ]
  }
}
