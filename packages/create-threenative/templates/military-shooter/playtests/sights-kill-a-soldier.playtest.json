{
  "name": "sights-kill-a-soldier",
  "warmupFrames": 10,
  "schemaVersion": 1,
  "target": "web",
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "subject": "player",
  "steps": [
    {
      "kind": "input",
      "label": "place",
      "press": "Digit5",
      "holdTicks": 1,
      "release": true
    },
    {
      "label": "settled",
      "waitForResource": {
        "id": "state",
        "path": "time",
        "gte": 0.5
      },
      "release": false,
      "timeoutMs": 5000
    },
    {
      "kind": "input",
      "label": "aim",
      "press": "KeyF",
      "holdTicks": 1,
      "release": false
    },
    {
      "label": "sights",
      "waitForResource": {
        "id": "state",
        "path": "fov",
        "lte": 46
      },
      "release": false,
      "timeoutMs": 3000
    },
    {
      "kind": "input",
      "label": "fire",
      "press": "Space",
      "holdTicks": 1,
      "release": false
    },
    {
      "label": "kill",
      "waitForResource": {
        "id": "state",
        "path": "kills",
        "gte": 1
      },
      "release": false,
      "timeoutMs": 8000
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "runtimeReady": true
    },
    "resources": [
      {
        "id": "state",
        "path": "enemiesLeft",
        "atSteps": [
          {
            "label": "kill",
            "equals": 4
          }
        ]
      },
      {
        "id": "state",
        "path": "aiming",
        "atSteps": [
          {
            "label": "kill",
            "equals": 1
          }
        ]
      },
      {
        "id": "state",
        "path": "hits",
        "gte": 2
      }
    ],
    "components": [
      {
        "entity": "soldier.far-west",
        "component": "state",
        "equals": "dead"
      }
    ]
  }
}
