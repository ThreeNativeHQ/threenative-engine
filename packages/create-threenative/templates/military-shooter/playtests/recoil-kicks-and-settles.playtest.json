{
  "name": "recoil-kicks-and-settles",
  "warmupFrames": 10,
  "schemaVersion": 1,
  "target": "web",
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "subject": "player",
  "steps": [
    {
      "kind": "input",
      "label": "place",
      "press": "Digit5",
      "holdTicks": 1,
      "release": true
    },
    {
      "label": "settled",
      "waitForResource": {
        "id": "state",
        "path": "time",
        "gte": 0.5
      },
      "release": false,
      "timeoutMs": 5000
    },
    {
      "kind": "input",
      "label": "fire",
      "press": "Space",
      "holdTicks": 1,
      "release": false
    },
    {
      "label": "kicked",
      "waitForResource": {
        "id": "state",
        "path": "kickPitch",
        "gte": 3
      },
      "release": false,
      "timeoutMs": 3000
    },
    {
      "kind": "input",
      "label": "release",
      "press": "Space",
      "holdTicks": 1,
      "release": true
    },
    {
      "label": "recovered",
      "waitForResource": {
        "id": "state",
        "path": "kickPitch",
        "lte": 0.05
      },
      "release": false,
      "timeoutMs": 4000
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "runtimeReady": true
    },
    "resources": [
      {
        "id": "state",
        "path": "kickPitch",
        "atSteps": [
          {
            "label": "kicked",
            "lte": 10.01
          },
          {
            "label": "recovered",
            "lte": 0.05
          }
        ]
      },
      {
        "id": "state",
        "path": "shots",
        "gte": 5
      }
    ]
  }
}
