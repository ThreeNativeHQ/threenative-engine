{
  "name": "sprint-is-a-budget",
  "warmupFrames": 10,
  "schemaVersion": 1,
  "target": "web",
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "subject": "player",
  "steps": [
    {
      "kind": "input",
      "label": "place",
      "press": "Digit1",
      "holdTicks": 1,
      "release": true
    },
    {
      "label": "settled",
      "waitForResource": {
        "id": "state",
        "path": "time",
        "gte": 0.5
      },
      "release": false,
      "timeoutMs": 5000
    },
    {
      "kind": "input",
      "label": "forward",
      "press": "ArrowUp",
      "holdTicks": 1,
      "release": false
    },
    {
      "kind": "input",
      "label": "sprint",
      "press": "ShiftLeft",
      "holdTicks": 1,
      "release": false
    },
    {
      "label": "sprint-on",
      "waitForResource": {
        "id": "state",
        "path": "sprinting",
        "equals": 1
      },
      "release": false,
      "timeoutMs": 2000
    },
    {
      "label": "sprint-fast",
      "waitForResource": {
        "id": "state",
        "path": "speed",
        "gte": 6.5
      },
      "release": false,
      "timeoutMs": 2000
    },
    {
      "label": "winded",
      "waitForResource": {
        "id": "state",
        "path": "sprinting",
        "equals": 0
      },
      "release": false,
      "timeoutMs": 6000
    },
    {
      "label": "refilled",
      "waitForResource": {
        "id": "state",
        "path": "sprintBudget",
        "gte": 1.2
      },
      "release": false,
      "timeoutMs": 6000
    },
    {
      "kind": "wait",
      "label": "held-no-chain",
      "waitTicks": 20,
      "release": false
    },
    {
      "kind": "input",
      "label": "let-go",
      "press": "ShiftLeft",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "wait",
      "label": "rested",
      "waitTicks": 10,
      "release": false
    },
    {
      "kind": "input",
      "label": "again",
      "press": "ShiftLeft",
      "holdTicks": 1,
      "release": false
    },
    {
      "label": "sprint-again",
      "waitForResource": {
        "id": "state",
        "path": "sprinting",
        "equals": 1
      },
      "release": false,
      "timeoutMs": 2000
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "runtimeReady": true
    },
    "resources": [
      {
        "id": "state",
        "path": "sprinting",
        "atSteps": [
          {
            "label": "sprint-on",
            "equals": 1
          },
          {
            "label": "winded",
            "equals": 0
          },
          {
            "label": "held-no-chain",
            "equals": 0
          },
          {
            "label": "sprint-again",
            "equals": 1
          }
        ]
      },
      {
        "id": "state",
        "path": "speed",
        "atSteps": [
          {
            "label": "sprint-fast",
            "lte": 7.0
          }
        ]
      },
      {
        "id": "state",
        "path": "sprintBudget",
        "atSteps": [
          {
            "label": "winded",
            "lte": 0.05
          }
        ]
      }
    ]
  }
}
