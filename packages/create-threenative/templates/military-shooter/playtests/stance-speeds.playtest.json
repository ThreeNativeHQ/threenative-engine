{
  "name": "stance-speeds",
  "warmupFrames": 10,
  "schemaVersion": 1,
  "target": "web",
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "subject": "player",
  "steps": [
    {
      "kind": "input",
      "label": "place",
      "press": "Digit1",
      "holdTicks": 1,
      "release": true
    },
    {
      "label": "settled",
      "waitForResource": {
        "id": "state",
        "path": "time",
        "gte": 0.5
      },
      "release": false,
      "timeoutMs": 5000
    },
    {
      "kind": "input",
      "label": "go",
      "press": "ArrowUp",
      "holdTicks": 1,
      "release": false
    },
    {
      "label": "stand-top",
      "waitForResource": {
        "id": "state",
        "path": "speed",
        "gte": 4.4
      },
      "release": false,
      "timeoutMs": 3000
    },
    {
      "kind": "input",
      "label": "crouch",
      "press": "KeyC",
      "holdTicks": 1,
      "release": false
    },
    {
      "kind": "wait",
      "label": "crouch-settle",
      "waitTicks": 60,
      "release": false
    },
    {
      "label": "crouch-floor",
      "waitForResource": {
        "id": "state",
        "path": "speed",
        "gte": 2.8
      },
      "release": false,
      "timeoutMs": 3000
    },
    {
      "kind": "input",
      "label": "prone",
      "press": "KeyZ",
      "holdTicks": 1,
      "release": false
    },
    {
      "kind": "wait",
      "label": "prone-settle",
      "waitTicks": 90,
      "release": false
    },
    {
      "label": "prone-floor",
      "waitForResource": {
        "id": "state",
        "path": "speed",
        "gte": 1.3
      },
      "release": false,
      "timeoutMs": 3000
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "runtimeReady": true
    },
    "resources": [
      {
        "id": "state",
        "path": "stance",
        "atSteps": [
          {
            "label": "stand-top",
            "equals": "stand"
          },
          {
            "label": "crouch-floor",
            "equals": "crouch"
          },
          {
            "label": "prone-floor",
            "equals": "prone"
          }
        ]
      },
      {
        "id": "state",
        "path": "speed",
        "atSteps": [
          {
            "label": "stand-top",
            "lte": 4.6
          },
          {
            "label": "crouch-floor",
            "lte": 3.0
          },
          {
            "label": "prone-floor",
            "lte": 1.5
          }
        ]
      },
      {
        "id": "state",
        "path": "eyeHeight",
        "atSteps": [
          {
            "label": "crouch-floor",
            "lte": 1.05
          },
          {
            "label": "prone-floor",
            "lte": 0.31
          }
        ]
      }
    ]
  }
}
