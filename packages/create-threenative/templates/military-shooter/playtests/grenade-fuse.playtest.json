{
  "name": "grenade-fuse",
  "warmupFrames": 10,
  "schemaVersion": 1,
  "target": "web",
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "subject": "player",
  "steps": [
    {
      "kind": "input",
      "label": "place",
      "press": "Digit4",
      "holdTicks": 1,
      "release": true
    },
    {
      "label": "settled",
      "waitForResource": {
        "id": "state",
        "path": "time",
        "gte": 0.5
      },
      "release": false,
      "timeoutMs": 5000
    },
    {
      "kind": "input",
      "label": "throw",
      "press": "KeyG",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "wait",
      "label": "in-flight",
      "waitTicks": 60,
      "release": true
    },
    {
      "kind": "wait",
      "label": "after-fuse",
      "waitTicks": 120,
      "release": true
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "runtimeReady": true
    },
    "resources": [
      {
        "id": "state",
        "path": "grenades",
        "atSteps": [
          {
            "label": "in-flight",
            "equals": 2
          }
        ]
      },
      {
        "id": "state",
        "path": "fuse",
        "atSteps": [
          {
            "label": "in-flight",
            "lte": 1.6
          },
          {
            "label": "after-fuse",
            "equals": 0
          }
        ]
      }
    ],
    "signals": [
      {
        "name": "grenade-blast",
        "entity": "grenade",
        "maxCount": 0,
        "atStep": "in-flight"
      },
      {
        "name": "grenade-blast",
        "entity": "grenade",
        "minCount": 1,
        "atStep": "after-fuse"
      }
    ],
    "components": [
      {
        "entity": "soldier.far-east",
        "component": "health",
        "lte": 80
      }
    ]
  }
}
