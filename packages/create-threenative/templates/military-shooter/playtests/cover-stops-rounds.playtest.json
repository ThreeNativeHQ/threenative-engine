{
  "name": "cover-stops-rounds",
  "warmupFrames": 10,
  "schemaVersion": 1,
  "target": "web",
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "subject": "player",
  "steps": [
    {
      "kind": "input",
      "label": "crouch",
      "press": "KeyC",
      "holdTicks": 1,
      "release": false
    },
    {
      "kind": "wait",
      "label": "crouched",
      "waitTicks": 20,
      "release": false
    },
    {
      "kind": "input",
      "label": "place",
      "press": "Digit3",
      "holdTicks": 1,
      "release": true
    },
    {
      "label": "settled",
      "waitForResource": {
        "id": "state",
        "path": "time",
        "gte": 0.5
      },
      "release": false,
      "timeoutMs": 5000
    },
    {
      "label": "rounds-blocked",
      "waitForResource": {
        "id": "state",
        "path": "blockedShots",
        "gte": 4
      },
      "release": false,
      "timeoutMs": 14000
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "runtimeReady": true
    },
    "resources": [
      {
        "id": "state",
        "path": "hitsTaken",
        "atSteps": [
          {
            "label": "rounds-blocked",
            "equals": 0
          }
        ]
      },
      {
        "id": "state",
        "path": "shield",
        "atSteps": [
          {
            "label": "rounds-blocked",
            "equals": 100
          }
        ]
      },
      {
        "id": "state",
        "path": "stance",
        "atSteps": [
          {
            "label": "rounds-blocked",
            "equals": "crouch"
          }
        ]
      }
    ]
  }
}
