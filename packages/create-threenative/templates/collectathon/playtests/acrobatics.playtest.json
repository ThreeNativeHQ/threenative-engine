{
  "name": "collectathon-acrobatics",
  "target": "web",
  "schemaVersion": 1,
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "warmupFrames": 10,
  "subject": "player",
  "setup": {
    "place": [
      {
        "entity": "player",
        "at": {
          "x": 0,
          "y": 0.85,
          "z": 30
        },
        "facing": {
          "yaw": 0
        }
      },
      {
        "entity": "walker.0",
        "at": {
          "x": 30,
          "y": 0,
          "z": -10
        },
        "frozen": true
      },
      {
        "entity": "walker.1",
        "at": {
          "x": -30,
          "y": 0,
          "z": -5
        },
        "frozen": true
      }
    ]
  },
  "steps": [
    {
      "kind": "input",
      "label": "run-up",
      "press": ["KeyW"],
      "holdTicks": 100,
      "release": false
    },
    {
      "kind": "input",
      "label": "running-jump",
      "press": ["KeyW", "Space"],
      "holdTicks": 22,
      "release": false
    },
    {
      "kind": "input",
      "label": "running-jump-fall",
      "press": ["KeyW"],
      "holdTicks": 1,
      "release": false
    },
    {
      "label": "running-jump-land",
      "waitForResource": {
        "id": "state",
        "path": "action",
        "equals": "run"
      },
      "timeoutMs": 120000,
      "release": false
    },
    {
      "kind": "wait",
      "label": "rerun",
      "waitTicks": 30,
      "release": false
    },
    {
      "kind": "input",
      "label": "crouch-slide",
      "press": ["KeyW", "ShiftLeft"],
      "holdTicks": 3,
      "release": false
    },
    {
      "kind": "input",
      "label": "long-jump",
      "press": ["KeyW", "ShiftLeft", "Space"],
      "holdTicks": 20,
      "release": false
    },
    {
      "kind": "input",
      "label": "long-jump-fall",
      "press": ["KeyW"],
      "holdTicks": 1,
      "release": false
    },
    {
      "label": "long-jump-land",
      "waitForResource": {
        "id": "state",
        "path": "action",
        "equals": "run"
      },
      "timeoutMs": 120000,
      "release": false
    },
    {
      "kind": "input",
      "label": "stop",
      "press": [],
      "holdTicks": 45,
      "release": false
    },
    {
      "kind": "input",
      "label": "crouch",
      "press": ["ShiftLeft"],
      "holdTicks": 3,
      "release": false
    },
    {
      "kind": "input",
      "label": "backflip",
      "press": ["ShiftLeft", "Space"],
      "holdTicks": 30,
      "release": false
    },
    {
      "kind": "input",
      "label": "backflip-fall",
      "press": [],
      "holdTicks": 1,
      "release": false
    },
    {
      "label": "backflip-land",
      "waitForResource": {
        "id": "state",
        "path": "action",
        "equals": "idle"
      },
      "timeoutMs": 120000,
      "release": false
    },
    {
      "kind": "input",
      "label": "side-run",
      "press": ["KeyW"],
      "holdTicks": 60,
      "release": false
    },
    {
      "kind": "input",
      "label": "skid",
      "press": ["KeyS"],
      "holdTicks": 4,
      "release": false
    },
    {
      "kind": "input",
      "label": "sideflip",
      "press": ["KeyS", "Space"],
      "holdTicks": 30,
      "release": false
    },
    {
      "kind": "input",
      "label": "sideflip-fall",
      "press": ["KeyS"],
      "holdTicks": 1,
      "release": false
    },
    {
      "label": "sideflip-land",
      "waitForResource": {
        "id": "state",
        "path": "grounded",
        "equals": true
      },
      "timeoutMs": 120000,
      "release": false
    },
    {
      "kind": "wait",
      "label": "settle",
      "waitTicks": 10,
      "release": true
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "noRuntimeDiagnostics": true,
      "runtimeReady": true
    },
    "components": [
      {
        "entity": "player",
        "component": "distance",
        "path": "single",
        "gte": 3,
        "lte": 9
      },
      {
        "entity": "player",
        "component": "distance",
        "path": "longJump",
        "gte": 10
      },
      {
        "entity": "player",
        "component": "distance",
        "path": "backflip",
        "lte": -2
      },
      {
        "entity": "player",
        "component": "counts",
        "path": "sideflip",
        "equals": 1,
        "allowTrivial": "One skid then one jump press gives exactly one side flip."
      },
      {
        "entity": "player",
        "component": "sideflipFacingError",
        "lte": 0.35,
        "allowTrivial": "Facing the stick within 20 degrees on landing is the side flip's defining property; zero is the target."
      }
    ]
  }
}
