{
  "name": "on-foot-walk-sprint",
  "target": "web",
  "schemaVersion": 1,
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "warmupFrames": 10,
  "subject": "player",
  "steps": [
    {
      "kind": "wait",
      "label": "settle",
      "waitTicks": 20,
      "release": true
    },
    {
      "kind": "input",
      "label": "walk",
      "press": "KeyW",
      "holdTicks": 60,
      "release": false
    },
    {
      "kind": "input",
      "label": "sprint",
      "press": [
        "KeyW",
        "ShiftLeft"
      ],
      "holdTicks": 60,
      "release": false
    },
    {
      "kind": "input",
      "label": "let-go",
      "press": [
        "KeyW",
        "ShiftLeft"
      ],
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "wait",
      "label": "stopped",
      "waitTicks": 40,
      "release": true
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "runtimeReady": true
    },
    "components": [
      {
        "entity": "player",
        "component": "action",
        "atSteps": [
          {
            "label": "walk",
            "equals": "run"
          },
          {
            "label": "sprint",
            "equals": "sprint"
          },
          {
            "label": "stopped",
            "equals": "idle"
          }
        ]
      },
      {
        "entity": "player",
        "component": "mode",
        "atSteps": [
          {
            "label": "stopped",
            "equals": "foot"
          }
        ]
      },
      {
        "entity": "player",
        "component": "stamina",
        "lte": 140
      }
    ],
    "movement": {
      "entity": "player",
      "minDistance": 4
    }
  }
}
