{
  "name": "enter-drive-exit",
  "target": "web",
  "schemaVersion": 1,
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "warmupFrames": 10,
  "subject": "player",
  "steps": [
    {
      "kind": "wait",
      "label": "settle",
      "waitTicks": 20,
      "release": true
    },
    {
      "kind": "input",
      "label": "staged",
      "press": "Digit3",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "wait",
      "label": "ready",
      "waitTicks": 2,
      "release": true
    },
    {
      "kind": "input",
      "label": "enter",
      "press": "KeyF",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "wait",
      "label": "entering",
      "waitTicks": 4,
      "release": true
    },
    {
      "kind": "wait",
      "label": "seated",
      "waitTicks": 50,
      "release": true
    },
    {
      "kind": "input",
      "label": "throttle",
      "press": "KeyW",
      "holdTicks": 120,
      "release": false
    },
    {
      "kind": "input",
      "label": "handbrake-turn",
      "press": ["KeyW", "KeyD", "Space"],
      "holdTicks": 30,
      "release": false
    },
    {
      "kind": "input",
      "label": "let-go",
      "press": ["KeyW", "KeyD", "Space"],
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "input",
      "label": "brake",
      "press": "KeyS",
      "holdTicks": 90,
      "release": true
    },
    {
      "kind": "wait",
      "label": "stopped",
      "waitTicks": 20,
      "release": true
    },
    {
      "kind": "input",
      "label": "exit",
      "press": "KeyF",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "wait",
      "label": "out",
      "waitTicks": 40,
      "release": true
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "runtimeReady": true
    },
    "components": [
      {
        "entity": "player",
        "component": "mode",
        "atSteps": [
          {
            "label": "entering",
            "equals": "entering"
          },
          {
            "label": "seated",
            "equals": "driving"
          },
          {
            "label": "out",
            "equals": "foot"
          }
        ]
      },
      {
        "entity": "car.8",
        "component": "moving",
        "atSteps": [
          {
            "label": "throttle",
            "equals": true
          }
        ]
      },
      {
        "entity": "car.8",
        "component": "handbrake",
        "atSteps": [
          {
            "label": "handbrake-turn",
            "equals": true
          },
          {
            "label": "out",
            "equals": false
          }
        ]
      }
    ],
    "signals": [
      {
        "name": "entered-car",
        "entity": "player",
        "minCount": 1
      },
      {
        "name": "exited-car",
        "entity": "player",
        "minCount": 1
      }
    ],
    "movement": {
      "entity": "player",
      "minDistance": 5
    }
  }
}
