{
  "name": "traffic-stops-and-resumes",
  "target": "web",
  "schemaVersion": 1,
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "warmupFrames": 10,
  "subject": "player",
  "steps": [
    {
      "kind": "wait",
      "label": "settle",
      "waitTicks": 20,
      "release": true
    },
    {
      "kind": "wait",
      "label": "flowing",
      "waitTicks": 60,
      "release": true
    },
    {
      "kind": "input",
      "label": "staged",
      "press": "Digit4",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "wait",
      "label": "blocked",
      "waitTicks": 200,
      "release": true
    },
    {
      "kind": "input",
      "label": "step-aside",
      "press": "KeyA",
      "holdTicks": 70,
      "release": true
    },
    {
      "kind": "wait",
      "label": "resumed",
      "waitTicks": 150,
      "release": true
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "runtimeReady": true
    },
    "components": [
      {
        "entity": "car.0",
        "component": "moving",
        "atSteps": [
          {
            "label": "flowing",
            "equals": true
          },
          {
            "label": "resumed",
            "equals": true
          }
        ]
      },
      {
        "entity": "car.0",
        "component": "stopped",
        "atSteps": [
          {
            "label": "blocked",
            "equals": true
          },
          {
            "label": "resumed",
            "equals": false
          }
        ]
      }
    ],
    "signals": [
      {
        "name": "station",
        "entity": "player",
        "minCount": 1
      }
    ]
  }
}
