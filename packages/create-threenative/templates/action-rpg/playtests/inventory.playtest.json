{
  "name": "action-rpg-loot-inventory-equipment",
  "target": "web",
  "schemaVersion": 1,
  "viewport": { "width": 1280, "height": 720 },
  "warmupFrames": 10,
  "subject": "player",
  "steps": [
    { "kind": "wait", "label": "start", "waitTicks": 2, "release": true },
    { "kind": "input", "label": "equip", "press": "KeyQ", "holdTicks": 1, "release": true },
    { "kind": "wait", "label": "equipped", "waitTicks": 4, "release": true },
    { "kind": "input", "label": "unequip", "press": "KeyU", "holdTicks": 1, "release": true },
    { "kind": "wait", "label": "unequipped", "waitTicks": 2, "release": true },
    {
      "kind": "input",
      "label": "equip-before-fill",
      "press": "KeyQ",
      "holdTicks": 1,
      "release": true
    },
    { "kind": "wait", "label": "re-equipped", "waitTicks": 2, "release": true },
    { "kind": "input", "label": "fill", "press": "KeyP", "holdTicks": 1, "release": true },
    { "kind": "input", "label": "full-refusal", "press": "KeyL", "holdTicks": 1, "release": true },
    { "kind": "input", "label": "swap-retrieve", "press": "KeyL", "holdTicks": 1, "release": true },
    { "kind": "input", "label": "seeded-drops", "press": "KeyT", "holdTicks": 1, "release": true }
  ],
  "assert": {
    "diagnostics": { "noConsoleErrors": true, "noNetworkErrors": true, "runtimeReady": true },
    "resources": [
      {
        "id": "state",
        "path": "damage",
        "atSteps": [
          { "label": "equipped", "equals": 18 },
          { "label": "unequipped", "equals": 12 },
          { "label": "re-equipped", "equals": 18 }
        ]
      },
      {
        "id": "state",
        "path": "equippedItem",
        "atSteps": [
          { "label": "equipped", "equals": "ember-blade" },
          { "label": "unequipped", "equals": "" },
          { "label": "re-equipped", "equals": "ember-blade" },
          { "label": "swap-retrieve", "equals": "ember-blade" }
        ]
      },
      {
        "id": "state",
        "path": "inventoryFullRefused",
        "atSteps": [
          { "label": "full-refusal", "equals": 1 },
          { "label": "swap-retrieve", "equals": 1 }
        ]
      },
      {
        "id": "state",
        "path": "pendingLootItem",
        "atSteps": [
          { "label": "full-refusal", "equals": "ember-blade" },
          { "label": "swap-retrieve", "equals": "rusted-blade" }
        ]
      },
      {
        "id": "state",
        "path": "pendingLootQuantity",
        "atSteps": [
          { "label": "full-refusal", "equals": 1 },
          { "label": "swap-retrieve", "equals": 1 }
        ]
      },
      {
        "id": "state",
        "path": "inventorySlots",
        "atSteps": [
          {
            "label": "swap-retrieve",
            "equals": [
              { "itemId": "ember-blade", "quantity": 1 },
              { "itemId": "potion", "quantity": 3 },
              { "itemId": "potion", "quantity": 3 },
              { "itemId": "potion", "quantity": 3 },
              { "itemId": "potion", "quantity": 3 },
              { "itemId": "potion", "quantity": 1 }
            ]
          }
        ]
      },
      { "id": "state", "path": "dropProof", "equals": 1, "changed": true },
      {
        "id": "state",
        "path": "enemiesDefeated",
        "atSteps": [{ "label": "seeded-drops", "equals": 1 }]
      },
      {
        "id": "state",
        "path": "lastDrop",
        "atSteps": [{ "label": "seeded-drops", "equals": "potion x1, potion x1" }]
      }
    ],
    "signals": [
      { "name": "equipped", "entity": "player", "minCount": 1 },
      { "name": "unequipped", "entity": "player", "minCount": 1 },
      { "name": "loot-refused", "entity": "player", "minCount": 1 },
      { "name": "loot-collected", "entity": "loot", "minCount": 1 },
      { "name": "defeated", "entity": "enemy", "minCount": 1, "atStep": "seeded-drops" },
      { "name": "seeded", "entity": "loot", "minCount": 1 }
    ],
    "components": [
      {
        "allowTrivial": "The hero is built holding the rusted blade, so the first observation already names it; the held value is what the HUD and the hand must agree on from the first frame.",
        "entity": "player",
        "component": "equippedItem",
        "atSteps": [{ "label": "start", "equals": "rusted-blade" }]
      },
      {
        "entity": "player",
        "component": "weaponVisible",
        "atSteps": [
          { "label": "start", "equals": true },
          { "label": "unequipped", "equals": false },
          { "label": "re-equipped", "equals": true }
        ]
      }
    ],
    "visibility": [
      {
        "allowTrivial": "The action RPG scene begins with the player visible and in frame; this held visibility row accompanies the inventory assertion.",
        "entity": "player",
        "minProjectedPixels": 20
      }
    ]
  }
}
