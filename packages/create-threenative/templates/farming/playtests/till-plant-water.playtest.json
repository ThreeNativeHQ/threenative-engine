{
  "name": "till-plant-water",
  "warmupFrames": 10,
  "schemaVersion": 1,
  "target": "web",
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "subject": "player",
  "steps": [
    {
      "label": "settled",
      "waitForResource": {
        "id": "state",
        "path": "playTime",
        "gte": 0.5
      },
      "release": false,
      "timeoutMs": 8000
    },
    {
      "kind": "input",
      "label": "plain-tile",
      "press": "Numpad2",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "input",
      "label": "no-soil-slot",
      "press": "Digit5",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "input",
      "label": "no-soil-swing",
      "press": "Space",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "wait",
      "label": "no-soil",
      "waitTicks": 48,
      "release": true
    },
    {
      "kind": "input",
      "label": "tile",
      "press": "Numpad1",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "input",
      "label": "tilled-slot",
      "press": "Digit1",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "input",
      "label": "tilled-swing",
      "press": "Space",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "wait",
      "label": "tilled",
      "waitTicks": 48,
      "release": true
    },
    {
      "kind": "input",
      "label": "planted-slot",
      "press": "Digit5",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "input",
      "label": "planted-swing",
      "press": "Space",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "wait",
      "label": "planted",
      "waitTicks": 48,
      "release": true
    },
    {
      "kind": "input",
      "label": "watered-slot",
      "press": "Digit2",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "input",
      "label": "watered-swing",
      "press": "Space",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "wait",
      "label": "watered",
      "waitTicks": 48,
      "release": true
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "runtimeReady": true
    },
    "resources": [
      {
        "id": "state",
        "path": "tilled",
        "atSteps": [
          {
            "label": "no-soil",
            "equals": 0
          },
          {
            "label": "tilled",
            "equals": 1
          },
          {
            "label": "planted",
            "equals": 1
          },
          {
            "label": "watered",
            "equals": 1
          }
        ]
      },
      {
        "id": "state",
        "path": "planted",
        "atSteps": [
          {
            "label": "no-soil",
            "equals": 0
          },
          {
            "label": "tilled",
            "equals": 0
          },
          {
            "label": "planted",
            "equals": 1
          },
          {
            "label": "watered",
            "equals": 1
          }
        ]
      },
      {
        "id": "state",
        "path": "watered",
        "atSteps": [
          {
            "label": "planted",
            "equals": 0
          },
          {
            "label": "watered",
            "equals": 1
          }
        ]
      },
      {
        "id": "state",
        "path": "seeds.turnip",
        "atSteps": [
          {
            "label": "no-soil",
            "equals": 6
          },
          {
            "label": "tilled",
            "equals": 6
          },
          {
            "label": "planted",
            "equals": 5
          },
          {
            "label": "watered",
            "equals": 5
          }
        ]
      },
      {
        "id": "state",
        "path": "water",
        "atSteps": [
          {
            "label": "planted",
            "equals": 10
          },
          {
            "label": "watered",
            "equals": 9
          }
        ]
      },
      {
        "id": "state",
        "path": "stamina",
        "atSteps": [
          {
            "label": "tilled",
            "equals": 244
          },
          {
            "label": "planted",
            "equals": 243
          },
          {
            "label": "watered",
            "equals": 241
          }
        ]
      },
      {
        "id": "state",
        "path": "message",
        "atSteps": [
          {
            "label": "no-soil",
            "textIncludes": "Till"
          }
        ]
      },
      {
        "id": "state",
        "path": "targetKind",
        "atSteps": [
          {
            "label": "plain-tile",
            "equals": "plain"
          },
          {
            "label": "tilled",
            "equals": "tilled"
          },
          {
            "label": "planted",
            "equals": "seedling"
          }
        ]
      }
    ],
    "signals": [
      {
        "name": "tilled",
        "entity": "player",
        "minCount": 1
      },
      {
        "name": "planted",
        "entity": "player",
        "minCount": 1
      },
      {
        "name": "watered",
        "entity": "player",
        "minCount": 1
      }
    ]
  }
}
