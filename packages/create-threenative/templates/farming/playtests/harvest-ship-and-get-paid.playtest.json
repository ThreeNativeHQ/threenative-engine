{
  "name": "harvest-ship-and-get-paid",
  "warmupFrames": 10,
  "schemaVersion": 1,
  "target": "web",
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "subject": "player",
  "steps": [
    {
      "label": "settled",
      "waitForResource": {
        "id": "state",
        "path": "playTime",
        "gte": 0.5
      },
      "release": false,
      "timeoutMs": 8000
    },
    {
      "kind": "input",
      "label": "tile",
      "press": "Numpad1",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "input",
      "label": "tilled-slot",
      "press": "Digit1",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "input",
      "label": "tilled-swing",
      "press": "Space",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "wait",
      "label": "tilled",
      "waitTicks": 48,
      "release": true
    },
    {
      "kind": "input",
      "label": "planted-slot",
      "press": "Digit5",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "input",
      "label": "planted-swing",
      "press": "Space",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "wait",
      "label": "planted",
      "waitTicks": 48,
      "release": true
    },
    {
      "kind": "input",
      "label": "watered-0-slot",
      "press": "Digit2",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "input",
      "label": "watered-0-swing",
      "press": "Space",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "wait",
      "label": "watered-0",
      "waitTicks": 48,
      "release": true
    },
    {
      "kind": "input",
      "label": "one-bed",
      "press": "Numpad6",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "input",
      "label": "one-sleep",
      "press": "KeyE",
      "holdTicks": 1,
      "release": true
    },
    {
      "label": "one-night",
      "waitForResource": {
        "id": "state",
        "path": "phase",
        "equals": "summary"
      },
      "release": false,
      "timeoutMs": 12000
    },
    {
      "kind": "input",
      "label": "one-wake",
      "press": "KeyE",
      "holdTicks": 1,
      "release": true
    },
    {
      "label": "one-morning",
      "waitForResource": {
        "id": "state",
        "path": "phase",
        "equals": "playing"
      },
      "release": false,
      "timeoutMs": 12000
    },
    {
      "kind": "input",
      "label": "tile-1",
      "press": "Numpad1",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "input",
      "label": "watered-1-slot",
      "press": "Digit2",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "input",
      "label": "watered-1-swing",
      "press": "Space",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "wait",
      "label": "watered-1",
      "waitTicks": 48,
      "release": true
    },
    {
      "kind": "input",
      "label": "two-bed",
      "press": "Numpad6",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "input",
      "label": "two-sleep",
      "press": "KeyE",
      "holdTicks": 1,
      "release": true
    },
    {
      "label": "two-night",
      "waitForResource": {
        "id": "state",
        "path": "phase",
        "equals": "summary"
      },
      "release": false,
      "timeoutMs": 12000
    },
    {
      "kind": "input",
      "label": "two-wake",
      "press": "KeyE",
      "holdTicks": 1,
      "release": true
    },
    {
      "label": "two-morning",
      "waitForResource": {
        "id": "state",
        "path": "phase",
        "equals": "playing"
      },
      "release": false,
      "timeoutMs": 12000
    },
    {
      "kind": "input",
      "label": "tile-2",
      "press": "Numpad1",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "input",
      "label": "watered-2-slot",
      "press": "Digit2",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "input",
      "label": "watered-2-swing",
      "press": "Space",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "wait",
      "label": "watered-2",
      "waitTicks": 48,
      "release": true
    },
    {
      "kind": "input",
      "label": "three-bed",
      "press": "Numpad6",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "input",
      "label": "three-sleep",
      "press": "KeyE",
      "holdTicks": 1,
      "release": true
    },
    {
      "label": "three-night",
      "waitForResource": {
        "id": "state",
        "path": "phase",
        "equals": "summary"
      },
      "release": false,
      "timeoutMs": 12000
    },
    {
      "kind": "input",
      "label": "three-wake",
      "press": "KeyE",
      "holdTicks": 1,
      "release": true
    },
    {
      "label": "three-morning",
      "waitForResource": {
        "id": "state",
        "path": "phase",
        "equals": "playing"
      },
      "release": false,
      "timeoutMs": 12000
    },
    {
      "kind": "input",
      "label": "ripe-tile",
      "press": "Numpad1",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "wait",
      "label": "ripe",
      "waitTicks": 4,
      "release": true
    },
    {
      "kind": "input",
      "label": "pick",
      "press": "KeyE",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "wait",
      "label": "carried",
      "waitTicks": 48,
      "release": true
    },
    {
      "kind": "input",
      "label": "bin",
      "press": "Numpad7",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "input",
      "label": "ship",
      "press": "KeyE",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "wait",
      "label": "shipped",
      "waitTicks": 48,
      "release": true
    },
    {
      "kind": "input",
      "label": "four-bed",
      "press": "Numpad6",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "input",
      "label": "four-sleep",
      "press": "KeyE",
      "holdTicks": 1,
      "release": true
    },
    {
      "label": "four-night",
      "waitForResource": {
        "id": "state",
        "path": "phase",
        "equals": "summary"
      },
      "release": false,
      "timeoutMs": 12000
    },
    {
      "kind": "input",
      "label": "four-wake",
      "press": "KeyE",
      "holdTicks": 1,
      "release": true
    },
    {
      "label": "four-morning",
      "waitForResource": {
        "id": "state",
        "path": "phase",
        "equals": "playing"
      },
      "release": false,
      "timeoutMs": 12000
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "runtimeReady": true
    },
    "resources": [
      {
        "id": "state",
        "path": "stageSum",
        "atSteps": [
          {
            "label": "two-morning",
            "equals": 2
          },
          {
            "label": "three-night",
            "equals": 3
          }
        ]
      },
      {
        "id": "state",
        "path": "ripe",
        "atSteps": [
          {
            "label": "two-morning",
            "equals": 0
          },
          {
            "label": "three-morning",
            "equals": 1
          },
          {
            "label": "ripe",
            "equals": 1
          },
          {
            "label": "carried",
            "equals": 0
          }
        ]
      },
      {
        "id": "state",
        "path": "targetKind",
        "atSteps": [
          {
            "label": "ripe",
            "equals": "ripe"
          }
        ]
      },
      {
        "id": "state",
        "path": "carrying",
        "atSteps": [
          {
            "label": "ripe",
            "equals": ""
          },
          {
            "label": "carried",
            "equals": "turnip"
          },
          {
            "label": "shipped",
            "equals": ""
          }
        ]
      },
      {
        "id": "state",
        "path": "binCount",
        "atSteps": [
          {
            "label": "carried",
            "equals": 0
          },
          {
            "label": "shipped",
            "equals": 1
          },
          {
            "label": "four-night",
            "equals": 0
          }
        ]
      },
      {
        "id": "state",
        "path": "binValue",
        "atSteps": [
          {
            "label": "shipped",
            "equals": 60
          }
        ]
      },
      {
        "id": "state",
        "path": "summary.earned",
        "atSteps": [
          {
            "label": "four-night",
            "equals": 60
          }
        ]
      },
      {
        "id": "state",
        "path": "money",
        "atSteps": [
          {
            "label": "shipped",
            "equals": 200
          },
          {
            "label": "four-morning",
            "equals": 260
          }
        ]
      },
      {
        "id": "state",
        "path": "planted",
        "atSteps": [
          {
            "label": "carried",
            "equals": 0
          }
        ]
      }
    ],
    "signals": [
      {
        "name": "harvested",
        "entity": "player",
        "minCount": 1
      },
      {
        "name": "shipped",
        "entity": "player",
        "minCount": 1
      }
    ]
  }
}
