{
  "name": "out-of-season-crop-does-not-grow",
  "warmupFrames": 10,
  "schemaVersion": 1,
  "target": "web",
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "subject": "player",
  "steps": [
    {
      "label": "settled",
      "waitForResource": {
        "id": "state",
        "path": "playTime",
        "gte": 0.5
      },
      "release": false,
      "timeoutMs": 8000
    },
    {
      "kind": "input",
      "label": "stall",
      "press": "Numpad9",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "input",
      "label": "tomato-bag",
      "press": "Digit6",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "input",
      "label": "buy",
      "press": "KeyE",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "wait",
      "label": "bought",
      "waitTicks": 4,
      "release": true
    },
    {
      "kind": "input",
      "label": "tomato-tile",
      "press": "Numpad1",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "input",
      "label": "tilled-a-slot",
      "press": "Digit1",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "input",
      "label": "tilled-a-swing",
      "press": "Space",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "wait",
      "label": "tilled-a",
      "waitTicks": 48,
      "release": true
    },
    {
      "kind": "input",
      "label": "planted-a-slot",
      "press": "Digit6",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "input",
      "label": "planted-a-swing",
      "press": "Space",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "wait",
      "label": "planted-a",
      "waitTicks": 48,
      "release": true
    },
    {
      "kind": "input",
      "label": "watered-a-slot",
      "press": "Digit2",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "input",
      "label": "watered-a-swing",
      "press": "Space",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "wait",
      "label": "watered-a",
      "waitTicks": 48,
      "release": true
    },
    {
      "kind": "input",
      "label": "turnip-tile",
      "press": "Numpad2",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "input",
      "label": "tilled-b-slot",
      "press": "Digit1",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "input",
      "label": "tilled-b-swing",
      "press": "Space",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "wait",
      "label": "tilled-b",
      "waitTicks": 48,
      "release": true
    },
    {
      "kind": "input",
      "label": "planted-b-slot",
      "press": "Digit5",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "input",
      "label": "planted-b-swing",
      "press": "Space",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "wait",
      "label": "planted-b",
      "waitTicks": 48,
      "release": true
    },
    {
      "kind": "input",
      "label": "watered-b-slot",
      "press": "Digit2",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "input",
      "label": "watered-b-swing",
      "press": "Space",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "wait",
      "label": "watered-b",
      "waitTicks": 48,
      "release": true
    },
    {
      "kind": "input",
      "label": "one-bed",
      "press": "Numpad6",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "input",
      "label": "one-sleep",
      "press": "KeyE",
      "holdTicks": 1,
      "release": true
    },
    {
      "label": "one-night",
      "waitForResource": {
        "id": "state",
        "path": "phase",
        "equals": "summary"
      },
      "release": false,
      "timeoutMs": 12000
    },
    {
      "kind": "input",
      "label": "one-wake",
      "press": "KeyE",
      "holdTicks": 1,
      "release": true
    },
    {
      "label": "one-morning",
      "waitForResource": {
        "id": "state",
        "path": "phase",
        "equals": "playing"
      },
      "release": false,
      "timeoutMs": 12000
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "runtimeReady": true
    },
    "resources": [
      {
        "id": "state",
        "path": "seeds.tomato",
        "atSteps": [
          {
            "label": "bought",
            "equals": 1
          },
          {
            "label": "planted-a",
            "equals": 0
          }
        ]
      },
      {
        "id": "state",
        "path": "planted",
        "atSteps": [
          {
            "label": "watered-b",
            "equals": 2
          },
          {
            "label": "one-night",
            "equals": 2
          }
        ]
      },
      {
        "id": "state",
        "path": "watered",
        "atSteps": [
          {
            "label": "watered-b",
            "equals": 2
          },
          {
            "label": "one-night",
            "equals": 0
          }
        ]
      },
      {
        "id": "state",
        "path": "stageSum",
        "atSteps": [
          {
            "label": "watered-b",
            "equals": 0
          },
          {
            "label": "one-night",
            "equals": 1
          },
          {
            "label": "one-morning",
            "equals": 1
          }
        ]
      },
      {
        "id": "state",
        "path": "message",
        "atSteps": [
          {
            "label": "planted-a",
            "textIncludes": "summer"
          }
        ]
      }
    ],
    "signals": [
      {
        "name": "bought",
        "entity": "player",
        "minCount": 1
      }
    ]
  }
}
