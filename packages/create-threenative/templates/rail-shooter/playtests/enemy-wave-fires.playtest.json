{
  "name": "a-wave-enters-and-fires",
  "warmupFrames": 10,
  "schemaVersion": 1,
  "target": "web",
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "subject": "player",
  "steps": [
    {
      "label": "settled",
      "waitForResource": {
        "id": "state",
        "path": "missionTime",
        "gte": 0.5
      },
      "release": false,
      "timeoutMs": 5000
    },
    {
      "kind": "wait",
      "label": "clear-sky",
      "waitTicks": 5,
      "release": true
    },
    {
      "kind": "input",
      "label": "jump",
      "press": "Digit4",
      "holdTicks": 1,
      "release": true
    },
    {
      "label": "wave-one",
      "waitForResource": {
        "id": "state",
        "path": "wave",
        "gte": 1
      },
      "release": false,
      "timeoutMs": 4000
    },
    {
      "kind": "wait",
      "label": "entering",
      "waitTicks": 30,
      "release": true
    },
    {
      "kind": "wait",
      "label": "engaged",
      "waitTicks": 240,
      "release": true
    },
    {
      "kind": "wait",
      "label": "hit-home",
      "waitTicks": 120,
      "release": true
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "runtimeReady": true
    },
    "resources": [
      {
        "id": "state",
        "path": "wave",
        "atSteps": [
          {
            "label": "clear-sky",
            "equals": 0
          },
          {
            "label": "wave-one",
            "equals": 1
          }
        ]
      },
      {
        "id": "state",
        "path": "enemiesLive",
        "atSteps": [
          {
            "label": "clear-sky",
            "equals": 0
          },
          {
            "label": "entering",
            "gte": 1
          }
        ]
      },
      {
        "id": "state",
        "path": "enemyShots",
        "atSteps": [
          {
            "label": "clear-sky",
            "equals": 0
          },
          {
            "label": "engaged",
            "gte": 1
          }
        ]
      },
      {
        "id": "state",
        "path": "shield",
        "atSteps": [
          {
            "label": "clear-sky",
            "equals": 255
          },
          {
            "label": "hit-home",
            "lte": 235
          }
        ]
      }
    ],
    "signals": [
      {
        "name": "wave",
        "entity": "director",
        "minCount": 1,
        "atStep": "wave-one"
      }
    ]
  }
}
