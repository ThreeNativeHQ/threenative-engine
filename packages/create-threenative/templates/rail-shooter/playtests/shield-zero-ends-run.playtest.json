{
  "name": "zero-shield-ends-the-run",
  "warmupFrames": 10,
  "schemaVersion": 1,
  "target": "web",
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "subject": "player",
  "steps": [
    {
      "label": "settled",
      "waitForResource": {
        "id": "state",
        "path": "missionTime",
        "gte": 0.5
      },
      "release": false,
      "timeoutMs": 5000
    },
    {
      "kind": "wait",
      "label": "flying",
      "waitTicks": 20,
      "release": true
    },
    {
      "kind": "input",
      "label": "killing-blow",
      "press": "Digit7",
      "holdTicks": 1,
      "release": true
    },
    {
      "label": "wrecked",
      "waitForResource": {
        "id": "state",
        "path": "phase",
        "equals": "lost"
      },
      "release": false,
      "timeoutMs": 9000
    },
    {
      "kind": "wait",
      "label": "result-card",
      "waitTicks": 10,
      "release": true,
      "screenshot": "result-card"
    },
    {
      "kind": "input",
      "label": "restart",
      "press": "KeyR",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "wait",
      "label": "restarted",
      "waitTicks": 40,
      "release": true
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "runtimeReady": true
    },
    "resources": [
      {
        "id": "state",
        "path": "phase",
        "atSteps": [
          {
            "label": "flying",
            "equals": "playing"
          },
          {
            "label": "result-card",
            "equals": "lost"
          },
          {
            "label": "restarted",
            "equals": "playing"
          }
        ]
      },
      {
        "id": "state",
        "path": "shield",
        "atSteps": [
          {
            "label": "flying",
            "equals": 255
          },
          {
            "label": "result-card",
            "equals": 0
          },
          {
            "label": "restarted",
            "equals": 255
          }
        ]
      },
      {
        "id": "state",
        "path": "railS",
        "atSteps": [
          {
            "label": "restarted",
            "lte": 40
          }
        ]
      },
      {
        "id": "state",
        "path": "score",
        "atSteps": [
          {
            "label": "restarted",
            "equals": 0
          }
        ]
      }
    ],
    "signals": [
      {
        "name": "destroyed",
        "entity": "player",
        "minCount": 1,
        "atStep": "wrecked"
      }
    ]
  }
}
