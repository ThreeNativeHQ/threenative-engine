{
  "name": "boost-and-brake-gauge",
  "warmupFrames": 10,
  "schemaVersion": 1,
  "target": "web",
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "subject": "player",
  "steps": [
    {
      "label": "settled",
      "waitForResource": {
        "id": "state",
        "path": "missionTime",
        "gte": 0.5
      },
      "release": false,
      "timeoutMs": 5000
    },
    {
      "kind": "wait",
      "label": "cruising",
      "waitTicks": 10,
      "release": true
    },
    {
      "kind": "input",
      "label": "boosting",
      "press": "ShiftLeft",
      "holdTicks": 22,
      "release": false
    },
    {
      "label": "boosting:speed",
      "waitForResource": {
        "id": "state",
        "path": "speed",
        "gte": 28
      },
      "release": false,
      "timeoutMs": 300
    },
    {
      "label": "boosting:gauge",
      "waitForResource": {
        "id": "state",
        "path": "gauge",
        "gte": 25
      },
      "release": false,
      "timeoutMs": 300
    },
    {
      "kind": "input",
      "label": "boost-ends",
      "press": "ShiftLeft",
      "holdTicks": 8,
      "release": true
    },
    {
      "kind": "wait",
      "label": "boost-released",
      "waitTicks": 2,
      "release": true
    },
    {
      "kind": "wait",
      "label": "recovering",
      "waitTicks": 30,
      "release": true
    },
    {
      "label": "recovering:gauge",
      "waitForResource": {
        "id": "state",
        "path": "gauge",
        "gte": 1
      },
      "release": false,
      "timeoutMs": 300
    },
    {
      "kind": "wait",
      "label": "settling",
      "waitTicks": 120,
      "release": true
    },
    {
      "kind": "input",
      "label": "braking",
      "press": "KeyX",
      "holdTicks": 34,
      "release": false
    },
    {
      "label": "braking:gauge",
      "waitForResource": {
        "id": "state",
        "path": "gauge",
        "gte": 10
      },
      "release": false,
      "timeoutMs": 300
    },
    {
      "kind": "input",
      "label": "brake-ends",
      "press": "KeyX",
      "holdTicks": 12,
      "release": true
    },
    {
      "kind": "wait",
      "label": "brake-released",
      "waitTicks": 2,
      "release": true
    },
    {
      "kind": "wait",
      "label": "coasting",
      "waitTicks": 90,
      "release": true
    },
    {
      "kind": "input",
      "label": "overheating",
      "press": "ShiftLeft",
      "holdTicks": 100,
      "release": true
    },
    {
      "label": "overheating:gaugeLocked",
      "waitForResource": {
        "id": "state",
        "path": "gaugeLocked",
        "equals": 1
      },
      "release": false,
      "timeoutMs": 300
    },
    {
      "kind": "wait",
      "label": "cooling-down",
      "waitTicks": 2,
      "release": true
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "runtimeReady": true
    },
    "resources": [
      {
        "id": "state",
        "path": "speed",
        "atSteps": [
          {
            "label": "cruising",
            "lte": 22.5
          },
          {
            "label": "braking",
            "lte": 17
          },
          {
            "label": "coasting",
            "lte": 22.5
          }
        ]
      },
      {
        "id": "state",
        "path": "mode",
        "atSteps": [
          {
            "label": "cruising",
            "equals": "cruise"
          },
          {
            "label": "boosting",
            "equals": "boost"
          },
          {
            "label": "braking",
            "equals": "brake"
          },
          {
            "label": "coasting",
            "equals": "cruise"
          }
        ]
      },
      {
        "id": "state",
        "path": "gauge",
        "atSteps": [
          {
            "label": "cruising",
            "lte": 0.5
          },
          {
            "label": "recovering",
            "lte": 40
          },
          {
            "label": "coasting",
            "lte": 55
          }
        ]
      },
      {
        "id": "state",
        "path": "gaugeLocked",
        "atSteps": [
          {
            "label": "boosting",
            "equals": 0
          },
          {
            "label": "braking",
            "equals": 0
          },
          {
            "label": "cooling-down",
            "equals": 1
          }
        ]
      }
    ]
  }
}
