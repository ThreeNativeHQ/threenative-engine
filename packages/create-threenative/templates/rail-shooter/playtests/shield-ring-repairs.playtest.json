{
  "name": "a-shield-ring-restores-shield",
  "warmupFrames": 10,
  "schemaVersion": 1,
  "target": "web",
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "subject": "player",
  "steps": [
    {
      "label": "settled",
      "waitForResource": {
        "id": "state",
        "path": "missionTime",
        "gte": 0.5
      },
      "release": false,
      "timeoutMs": 5000
    },
    {
      "kind": "wait",
      "label": "flying",
      "waitTicks": 10,
      "release": true
    },
    {
      "kind": "input",
      "label": "wounded",
      "press": "Digit5",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "wait",
      "label": "lined-up",
      "waitTicks": 4,
      "release": true
    },
    {
      "kind": "wait",
      "label": "repaired",
      "waitTicks": 150,
      "release": true
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "runtimeReady": true
    },
    "resources": [
      {
        "id": "state",
        "path": "pickups",
        "atSteps": [
          {
            "label": "flying",
            "equals": 0
          },
          {
            "label": "repaired",
            "equals": 1
          }
        ]
      },
      {
        "id": "state",
        "path": "shield",
        "atSteps": [
          {
            "label": "flying",
            "equals": 255
          },
          {
            "label": "repaired",
            "gte": 228,
            "lte": 240
          }
        ]
      }
    ],
    "signals": [
      {
        "name": "pickup",
        "entity": "player",
        "minCount": 1,
        "atStep": "repaired"
      }
    ]
  }
}
