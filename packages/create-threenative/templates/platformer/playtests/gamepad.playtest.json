{
  "name": "platformer-gamepad",
  "schemaVersion": 1,
  "target": "web",
  "viewport": { "width": 1280, "height": 720 },
  "warmupFrames": 20,
  "subject": "player",
  "steps": [
    {
      "kind": "input",
      "label": "stick right",
      "gamepad": { "axes": [1, 0] },
      "waitTicks": 180,
      "release": true
    },
    {
      "kind": "input",
      "label": "south button",
      "gamepad": { "buttons": [0] },
      "waitTicks": 120,
      "release": true
    },
    { "kind": "wait", "label": "settle", "waitFrames": 40, "release": true }
  ],
  "assert": {
    "diagnostics": { "noConsoleErrors": true, "runtimeReady": true },
    "movement": { "entity": "player", "minAxisDelta": { "axis": "x", "min": 3 } },
    "resources": [{ "changed": true, "gte": 1, "id": "state", "path": "jumps" }]
  }
}
