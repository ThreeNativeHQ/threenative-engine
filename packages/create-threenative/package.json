{
  "name": "create-threenative",
  "version": "0.2.11",
  "license": "MIT",
  "description": "Scaffold a readable ThreeNative game project.",
  "keywords": [
    "threenative",
    "three",
    "threejs",
    "scaffold",
    "create",
    "starter",
    "gamedev",
    "template"
  ],
  "homepage": "https://github.com/ThreeNativeHQ/threenative#readme",
  "bugs": {
    "url": "https://github.com/ThreeNativeHQ/threenative/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ThreeNativeHQ/threenative.git",
    "directory": "packages/create-threenative"
  },
  "type": "module",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=10.0.0"
  },
  "files": [
    "dist",
    "templates",
    "template-assets",
    "agent-docs",
    "agent-files",
    "capabilities.json",
    "README.md"
  ],
  "bin": {
    "create-threenative": "./dist/index.js",
    "threenative": "./dist/threenative.js"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./web-brand": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./quality": {
      "types": "./dist/quality.d.ts",
      "import": "./dist/quality.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup --config tsup.config.ts && publint",
    "typecheck": "tsc --noEmit",
    "test": "publint --strict",
    "prepack": "node -e \"const fs=require('node:fs');for(const [s,n] of [['../core/patches/three@0.185.1.patch','three@0.185.1.patch'],['../../patches/vite@8.2.0.patch','vite@8.2.0.patch'],['../../patches/@tailwindcss__node@4.3.3.patch','@tailwindcss__node@4.3.3.patch']]){const d='template-assets/patches/'+n;fs.mkdirSync('template-assets/patches',{recursive:true});if(fs.existsSync(s))fs.cpSync(s,d);else if(!fs.existsSync(d))throw new Error('TN_FRAMEWORK_PATCH_MISSING: '+s)}\""
  },
  "dependencies": {
    "@gltf-transform/core": "catalog:",
    "@gltf-transform/extensions": "catalog:",
    "@gltf-transform/functions": "catalog:",
    "draco3dgltf": "^1.5.7",
    "ktx-parse": "^1.1.0",
    "ktx2-encoder": "0.6.0",
    "meshoptimizer": "1.1.1",
    "three": "catalog:",
    "@jridgewell/trace-mapping": "catalog:",
    "@eslint-community/eslint-plugin-eslint-comments": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "typescript": "catalog:"
  },
  "devDependencies": {
    "@gltf-transform/core": "catalog:",
    "@threenative/assets": "workspace:*",
    "@threenative/core": "workspace:*",
    "@threenative/physics": "workspace:*",
    "@types/node": "20.19.43",
    "@types/three": "0.185.3",
    "esbuild": "catalog:",
    "publint": "0.3.22",
    "@threenative/blender-bridge": "workspace:*",
    "tsup": "8.5.1",
    "vite": "catalog:",
    "@typescript/native": "catalog:",
    "@typescript/typescript6": "catalog:",
    "eslint": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "@typescript-eslint/eslint-plugin": "catalog:",
    "@types/estree": "1.0.8"
  },
  "peerDependencies": {
    "@threenative/assets": ">=0.3.8 <0.4.0"
  }
}
