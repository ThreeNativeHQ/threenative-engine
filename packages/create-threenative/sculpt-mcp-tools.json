  "descriptions": {
    "sculpt_plan": "Validate a reference image and return the locked eight-pass sculpt order plus relevant technique-safe grimoire resources.",
    "sculpt_spec_gate": "Validate the MCP runtime ObjectSculptSpec contract and canonical complexity depth thresholds before code is written.",
    "sculpt_compare": "Produce deterministic diagnostic evidence from an existing capture and reference, globally and per normalized region. Never launches a browser and never authorizes advancement.",
    "sculpt_pass_gate": "Return advance, retry, or stop. Semantic review controls advancement; deterministic scores supply corrections, while an explicitly ambiguous comparison blocks advancement.",
    "sculpt_grimoire": "Fetch a technique-safe grimoire page by topic. Unknown and concrete shader/material recipe topics fail and list valid topics.",
    "sculpt_clip_measure": "Measure every sampled animation clip, classify all matching motion labels, name intent honestly, decide looping from pose return, and surface joint scale.",
    "sculpt_rig_reference": "Read the GLB's own skin joint order, inverse binds, animation channels and sampled landmark clips; ambiguous skins, landmarks and interpolation fail closed.",
    "sculpt_rig_spec_gate": "Validate a structural Stage R rig payload: hierarchy, matrices, four-slot weights, joint indices and coverage.",
    "sculpt_skin_condition": "Blend four-slot skin weights across nearby multipart seams, report the deliberate crease trade, and fail if Gate R2 rejects the result.",
    "sculpt_mesh_parity": "Freeze packed position, normal, UV and index buffers before rigging or verify them afterward; skin attributes are legal additions.",
    "sculpt_action_design": "Resolve topology-based limb chains, measure foot contact, accept a measured clip against walk/run targets, or synthesize an explicit gait payload.",
    "sculpt_rig_gate": "Run every Stage R G1-G12 observation gate without short-circuiting; fail closed when any result is failed or unevaluated."
  }
}
