{
  "enabledMcpjsonServers": [
    "threenative-assets",
    "threenative-sculpt",
    "threenative-engine",
    "threenative-terrain",
    "threenative-animation",
    "threenative-devtools"
  ],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/ponytail-context.mjs\"",
            "timeout": 5,
            "statusMessage": "Loading ponytail..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/ponytail-context.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/ponytail-context.mjs\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
