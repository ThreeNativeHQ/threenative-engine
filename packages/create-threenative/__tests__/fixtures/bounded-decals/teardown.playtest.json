{
  "name": "vq11-teardown",
  "schemaVersion": 1,
  "target": "web",
  "viewport": {
    "width": 960,
    "height": 540
  },
  "warmupFrames": 10,
  "artifacts": {
    "screenshots": true,
    "console": true
  },
  "steps": [
    {
      "kind": "wait",
      "label": "lod-and-pool",
      "waitFrames": 40
    },
    {
      "kind": "input",
      "label": "teardown",
      "press": "KeyX",
      "holdTicks": 2,
      "release": true
    },
    {
      "kind": "wait",
      "label": "settled",
      "waitFrames": 90
    }
  ],
  "assert": {
    "diagnostics": {
      "runtimeReady": true,
      "noConsoleErrors": true,
      "noNetworkErrors": true
    },
    "components": [
      {
        "entity": "decals",
        "component": "active",
        "equals": 128,
        "allowTrivial": "Removing one receiver releases its remaining 128 marks while the other retains its half."
      },
      {
        "entity": "decals",
        "component": "created",
        "gte": 321,
        "allowTrivial": "320 initial marks plus a real post-LOD raycast hit."
      },
      {
        "entity": "decals",
        "component": "geometryBytes",
        "allowTrivial": "Measures actual projected GPU-upload buffer bytes, not an empty field.",
        "gte": 1
      },
      {
        "entity": "decals",
        "component": "renderTriangles",
        "equals": 2,
        "allowTrivial": "The loaded 128-triangle authored receiver actually selects its two-triangle LOD."
      },
      {
        "entity": "decals",
        "component": "released",
        "gte": 193,
        "allowTrivial": "65 cap evictions plus 128 receiver-owned projections."
      },
      {
        "entity": "decals",
        "component": "generation",
        "equals": 1,
        "allowTrivial": "The restart input must construct a new scene; unchanged initial state is not evidence."
      }
    ],
    "visual": [
      {
        "region": {
          "x": 0,
          "y": 0,
          "width": 960,
          "height": 540,
          "minNonblankPixelRatio": 0.15
        }
      },
      {
        "region": {
          "x": 270,
          "y": 185,
          "width": 170,
          "height": 125,
          "minNonblankPixelRatio": 0.9,
          "maxLuminance": 0.35,
          "minDarkPixelRatio": 0.01,
          "maxDarkPixelRatio": 0.2
        }
      }
    ]
  }
}
