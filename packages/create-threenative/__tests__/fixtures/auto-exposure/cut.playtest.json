{
  "name": "prd339-exposure-dark-to-sunlight",
  "schemaVersion": 1,
  "target": "web",
  "viewport": {
    "width": 640,
    "height": 360
  },
  "warmupFrames": 20,
  "artifacts": {
    "screenshots": true,
    "console": true
  },
  "steps": [
    {
      "kind": "wait",
      "label": "initial",
      "waitFrames": 180
    },
    {
      "holdTicks": 1,
      "press": ["KeyC"],
      "release": true
    },
    {
      "kind": "wait",
      "label": "changed",
      "waitFrames": 180
    }
  ],
  "assert": {
    "diagnostics": {
      "runtimeReady": true,
      "noConsoleErrors": true
    },
    "visual": [
      {
        "region": {
          "x": 0,
          "y": 0,
          "width": 640,
          "height": 360,
          "minNonblankPixelRatio": 0.15
        }
      }
    ]
  }
}
