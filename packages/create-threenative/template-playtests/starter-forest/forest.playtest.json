{
  "name": "starter-forest-walk",
  "target": "web",
  "schemaVersion": 1,
  "viewport": {
    "width": 1920,
    "height": 1080
  },
  "warmupFrames": 60,
  "subject": "player",
  "steps": [
    {
      "kind": "wait",
      "label": "forest-loads",
      "waitTicks": 240,
      "release": true
    },
    {
      "kind": "input",
      "label": "walk-forward",
      "press": "ArrowUp",
      "holdTicks": 300,
      "release": true
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "runtimeReady": true
    },
    "movement": {
      "entity": "player",
      "minAxisDelta": {
        "axis": "-z",
        "min": 0.5
      }
    },
    "performance": {
      "maxFrameMsP95": 16.7
    }
  }
}
