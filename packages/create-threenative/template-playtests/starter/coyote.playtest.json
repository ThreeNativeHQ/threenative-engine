{
  "name": "starter-coyote-and-buffer",
  "target": "web",
  "schemaVersion": 1,
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "warmupFrames": 10,
  "subject": "player",
  "steps": [
    {
      "kind": "wait",
      "label": "play-scene-loads",
      "waitTicks": 600,
      "release": true
    },
    {
      "kind": "input",
      "label": "leave-ledge",
      "press": "ArrowLeft",
      "holdTicks": 130,
      "release": true
    },
    {
      "kind": "input",
      "label": "off-ledge",
      "press": "ArrowLeft",
      "holdTicks": 4,
      "release": false
    },
    {
      "kind": "input",
      "label": "airborne",
      "press": "ArrowLeft",
      "holdTicks": 5,
      "release": false
    },
    {
      "kind": "input",
      "label": "late-jump",
      "press": "Space",
      "holdTicks": 2,
      "release": true
    },
    {
      "kind": "wait",
      "label": "jump-arc",
      "waitTicks": 18,
      "release": true
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "runtimeReady": true
    },
    "resources": [
      {
        "id": "state",
        "path": "jumps",
        "equals": 1,
        "changed": true
      },
      {
        "id": "state",
        "path": "coyoteJumps",
        "equals": 1,
        "changed": true
      },
      {
        "id": "state",
        "path": "peakRise",
        "gte": 0.5,
        "changed": true
      }
    ],
    "visibility": [
      {
        "allowTrivial": "The starter scene begins with the player visible and in frame; this held visibility row accompanies the coyote assertion.",
        "entity": "player",
        "minProjectedPixels": 20
      }
    ]
  }
}
