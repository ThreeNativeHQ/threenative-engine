{
  "name": "starter-respawn",
  "target": "web",
  "schemaVersion": 1,
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "warmupFrames": 10,
  "subject": "player",
  "steps": [
    {
      "kind": "wait",
      "label": "play-scene-loads",
      "waitTicks": 600,
      "release": true
    },
    {
      "kind": "input",
      "label": "run-off-world",
      "press": "ArrowRight",
      "holdTicks": 329,
      "release": true
    },
    {
      "kind": "wait",
      "label": "respawn",
      "waitTicks": 240,
      "release": true
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "runtimeReady": true
    },
    "movement": {
      "entity": "player",
      "pathLength": 4,
      "reachesPositionWithin": {
        "position": [-2, 0.9, 0],
        "maxDistance": 0.35
      }
    },
    "resources": [
      {
        "id": "state",
        "path": "respawns",
        "gte": 1,
        "changed": true
      },
      {
        "id": "state",
        "path": "lives",
        "equals": 2,
        "changed": true
      }
    ],
    "visibility": [
      {
        "allowTrivial": "The starter scene begins with the player visible and in frame; this held visibility row accompanies the respawn assertion.",
        "entity": "player",
        "minProjectedPixels": 20
      }
    ]
  }
}
