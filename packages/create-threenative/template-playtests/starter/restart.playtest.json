{
  "name": "starter-react-restart",
  "target": "web",
  "schemaVersion": 1,
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "warmupFrames": 10,
  "subject": "player",
  "steps": [
    {
      "kind": "wait",
      "label": "play-scene-loads",
      "waitTicks": 600,
      "release": true
    },
    {
      "kind": "input",
      "label": "collected",
      "press": "ArrowRight",
      "holdTicks": 142,
      "release": true
    },
    {
      "kind": "input",
      "label": "focus-pause",
      "press": "Tab",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "input",
      "label": "focus-restart",
      "press": "Tab",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "input",
      "label": "restarted",
      "press": "Enter",
      "holdTicks": 1,
      "release": true
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "runtimeReady": true
    },
    "resources": [
      {
        "id": "state",
        "path": "score",
        "atSteps": [
          {
            "label": "collected",
            "equals": 1
          },
          {
            "label": "restarted",
            "equals": 0
          }
        ]
      },
      {
        "id": "state",
        "path": "entityCount",
        "atSteps": [
          {
            "label": "collected",
            "equals": 3
          },
          {
            "label": "restarted",
            "equals": 4
          }
        ]
      }
    ],
    "visibility": [
      {
        "allowTrivial": "The starter scene begins with the player visible and in frame; this held visibility row accompanies the restart assertion.",
        "entity": "player",
        "minProjectedPixels": 20
      }
    ]
  }
}
