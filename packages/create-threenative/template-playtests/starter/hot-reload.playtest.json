{
  "name": "starter-hot-reload-subject",
  "target": "web",
  "schemaVersion": 1,
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "warmupFrames": 10,
  "subject": "player",
  "artifacts": {
    "console": true,
    "network": true,
    "runtimeTrace": true
  },
  "steps": [
    {
      "kind": "wait",
      "label": "play-scene-loads",
      "waitTicks": 600,
      "release": true
    },
    {
      "kind": "input",
      "label": "collect",
      "press": "ArrowRight",
      "holdTicks": 142,
      "release": true
    },
    {
      "kind": "wait",
      "label": "settled",
      "waitTicks": 30,
      "release": true
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "runtimeReady": true
    },
    "movement": {
      "entity": "player",
      "minDistance": 0.5
    },
    "resources": [
      {
        "id": "state",
        "path": "score",
        "gte": 1,
        "changed": true
      },
      {
        "id": "state",
        "path": "playerX",
        "changed": true
      }
    ],
    "visibility": [
      {
        "allowTrivial": "The starter scene begins with the player visible and in frame; this held visibility row accompanies the hot-reload assertion.",
        "entity": "player",
        "minProjectedPixels": 20
      }
    ]
  }
}
