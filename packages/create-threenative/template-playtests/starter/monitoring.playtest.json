{
  "name": "starter-area-monitoring",
  "target": "web",
  "schemaVersion": 1,
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "warmupFrames": 10,
  "subject": "player",
  "steps": [
    {
      "kind": "wait",
      "label": "play-scene-loads",
      "waitTicks": 600,
      "release": true
    },
    {
      "kind": "input",
      "label": "collect",
      "press": "ArrowRight",
      "holdTicks": 142,
      "release": true
    },
    {
      "kind": "input",
      "label": "leave",
      "press": "ArrowLeft",
      "holdTicks": 50,
      "release": true
    },
    {
      "kind": "input",
      "label": "reenter-while-disabled",
      "press": "ArrowRight",
      "holdTicks": 50,
      "release": true
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "runtimeReady": true
    },
    "resources": [
      {
        "id": "state",
        "path": "score",
        "equals": 1,
        "changed": true,
        "atSteps": [
          {
            "label": "collect",
            "equals": 1
          },
          {
            "label": "reenter-while-disabled",
            "equals": 1
          }
        ]
      }
    ],
    "visibility": [
      {
        "allowTrivial": "The starter scene begins with the player visible and in frame; this held visibility row accompanies the monitoring assertion.",
        "entity": "player",
        "minProjectedPixels": 20
      }
    ]
  }
}
