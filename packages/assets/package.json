{
  "name": "@threenative/assets",
  "version": "0.3.5",
  "license": "MIT",
  "description": "Content-addressed asset compile step for ThreeNative games.",
  "keywords": ["threenative", "three", "threejs", "assets", "gltf", "asset-pipeline", "webgpu"],
  "homepage": "https://github.com/ThreeNativeHQ/threenative#readme",
  "bugs": {
    "url": "https://github.com/ThreeNativeHQ/threenative/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ThreeNativeHQ/threenative.git",
    "directory": "packages/assets"
  },
  "type": "module",
  "files": ["dist", "README.md", "THIRD_PARTY_NOTICES.md", "LICENSES"],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup --config tsup.config.ts && node scripts/copy-basis-encoder.mjs && node scripts/bundle-blender-gpl.mjs && publint",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run build && publint --strict"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@types/pngjs": "6.0.5",
    "@types/three": "0.185.3",
    "ooz-wasm": "2.0.0",
    "publint": "0.3.22",
    "threenative-blender-mcp": "workspace:*",
    "tsup": "8.5.1",
    "typescript": "catalog:",
    "@typescript/native": "catalog:"
  },
  "dependencies": {
    "@gltf-transform/core": "catalog:",
    "@gltf-transform/extensions": "catalog:",
    "@gltf-transform/functions": "catalog:",
    "@threenative/terrain": "workspace:*",
    "@wasm-audio-decoders/ogg-vorbis": "0.1.20",
    "draco3dgltf": "^1.5.7",
    "jpeg-js": "0.4.4",
    "ktx-parse": "^1.1.0",
    "meshoptimizer": "1.1.1",
    "pngjs": "7.0.0",
    "sharp": "catalog:",
    "three": "catalog:",
    "three-mesh-bvh": "catalog:",
    "wasm-media-encoders": "0.7.0",
    "xatlasjs": "0.2.0"
  }
}
