{
  "name": "spell-lab-inferno",
  "target": "web",
  "schemaVersion": 1,
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "warmupFrames": 12,
  "subject": "spell-lab",
  "artifacts": {
    "screenshots": "before-after"
  },
  "steps": [
    {
      "kind": "wait",
      "label": "settled",
      "waitTicks": 20,
      "release": true
    },
    {
      "kind": "input",
      "label": "cast",
      "press": "Digit6",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "wait",
      "label": "impact",
      "waitTicks": 20,
      "release": true
    },
    {
      "kind": "wait",
      "label": "linger",
      "waitTicks": 55,
      "release": true
    }
  ],
  "assert": {
    "components": [
      {
        "entity": "spell-lab",
        "component": "casts",
        "gte": 1
      },
      {
        "entity": "spell-lab",
        "component": "impacts",
        "gte": 1
      },
      {
        "entity": "spell-lab",
        "component": "spawned",
        "gte": 1
      }
    ],
    "diagnostics": {
      "noConsoleErrors": true
    },
    "visual": [
      {
        "frameDiff": {
          "minChangedPixelRatio": 0.001
        }
      }
    ]
  }
}
