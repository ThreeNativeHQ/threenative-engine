      "label": "settle-0",
      "waitTicks": 50,
      "release": true
    },
    {
      "kind": "wait",
      "label": "settle-1",
      "waitTicks": 50,
      "release": true
    },
    {
      "kind": "wait",
      "label": "settle-2",
      "waitTicks": 50,
      "release": true
    },
    {
      "kind": "wait",
      "label": "settle-3",
      "waitTicks": 50,
      "release": true
    },
    {
      "kind": "wait",
