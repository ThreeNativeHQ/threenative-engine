{
  "name": "prd476-fluid-particles-native-dam-break",
  "schemaVersion": 1,
  "subject": "a released dam-break column runs across the tank and settles on the GPU",
  "target": "desktop",
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "warmupFrames": 20,
  "artifacts": {
    "screenshots": true,
    "console": true
  },
  "steps": [
    {
      "kind": "wait",
      "label": "gated",
      "waitTicks": 30,
      "release": true,
      "screenshot": "gated"
    },
    {
      "kind": "wait",
      "label": "running",
      "waitTicks": 90,
      "release": true,
      "screenshot": "running"
    },
    {
