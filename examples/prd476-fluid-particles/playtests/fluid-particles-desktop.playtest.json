  "assert": {
    "resources": [
      {
        "id": "GameState",
        "path": "steps",
        "changed": true
      },
      {
        "id": "GameState",
        "path": "peakFrontX",
        "gte": 1.0
      },
      {
        "id": "GameState",
        "path": "maxSpeed",
        "lte": 1.0
      },
      {
        "id": "GameState",
        "path": "meanCompression",
        "lte": 0.05,
        "allowTrivial": "Native stats readbacks have landed before the first observation, so this held invariant is satisfied from the start; peakFrontX and maxSpeed prove the water moved and settled."
      },
      {
        "id": "GameState",
        "path": "inBounds",
        "equals": 1,
        "allowTrivial": "Native stats readbacks have landed before the first observation, so this held invariant is satisfied from the start; peakFrontX and maxSpeed prove the water moved and settled."
      }
    ]
  }
}
