{
  "name": "lod-near-desktop",
  "schemaVersion": 1,
  "subject": "the native host's near camera selects LOD0 for the model",
  "target": "desktop",
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "warmupFrames": 90,
  "artifacts": {
    "screenshots": false,
    "console": true
  },
  "steps": [
    {
      "kind": "input",
      "label": "close",
      "press": "Space",
      "holdTicks": 2,
      "release": true
    },
    {
      "kind": "wait",
      "label": "settled",
      "waitTicks": 120,
      "release": true
    }
  ],
  "assert": {
    "resources": [
      {
        "changed": true,
        "gte": 8000,
        "id": "GameState",
        "path": "triangles"
      },
      {
        "changed": true,
        "id": "GameState",
        "lte": 0,
        "path": "cardCopies"
      },
      {
        "changed": true,
        "gte": 2400,
        "id": "GameState",
        "path": "cardTriangles"
      }
    ],
    "sceneNodes": [
      {
        "select": {
          "nameContains": "hull-mesh"
        },
        "minCount": 1,
        "minTriangles": 8000,
        "visible": true
      }
    ]
  }
}
