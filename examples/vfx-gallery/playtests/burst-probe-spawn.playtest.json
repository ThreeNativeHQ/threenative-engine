{
  "name": "vfx-gallery-burst-probe-spawn",
  "target": "web",
  "schemaVersion": 1,
  "viewport": { "width": 1280, "height": 720 },
  "warmupFrames": 8,
  "subject": "burst-probe",
  "artifacts": { "screenshots": "before-after" },
  "steps": [
    { "kind": "wait", "label": "burst-window-complete", "waitTicks": 600, "release": true }
  ],
  "assert": {
    "components": [
      { "entity": "burst-probe", "component": "done", "equals": true },
      { "entity": "burst-probe", "component": "firstFrameMaxRadius", "gte": 0, "lte": 0.4 },
      { "entity": "burst-probe", "component": "firstFrameMeanAgeSeconds", "gte": 0, "lte": 0.05 },
      { "entity": "burst-probe", "component": "maxOneFrameMoveOfFirstBurst", "gte": 0, "lte": 0.5 },
      { "entity": "burst-probe", "component": "bothBurstsLiveFull", "equals": 1 },
      { "entity": "burst-probe", "component": "clamped", "equals": 0 }
    ]
  }
}
