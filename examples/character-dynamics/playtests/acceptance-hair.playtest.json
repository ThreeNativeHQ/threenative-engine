  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "runtimeReady": true
    },
    "resources": [
      {
        "id": "GameState",
        "path": "complete",
        "equals": true,
        "changed": true
      },
      {
        "id": "GameState",
        "path": "finite",
        "equals": true,
        "allowTrivial": "finite starts true and must stay true through all eight phases"
      },
      {
        "id": "GameState",
        "path": "phases.settle.hairStretch",
        "lte": 0.05,
        "allowTrivial": "the settle phase is measured from the first tick, so its bound already holds when the scenario starts"
      },
      {
        "id": "GameState",
        "path": "phases.settle.hairInsideHead",
