      "screenshot": "settled"
    },
    {
      "kind": "wait",
      "label": "jog",
      "waitTicks": 75,
      "release": true,
      "screenshot": "jog"
    },
    {
      "kind": "wait",
      "label": "jog-turn",
      "waitTicks": 100,
      "release": true,
      "screenshot": "jog-turn"
