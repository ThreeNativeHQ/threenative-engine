{
  "name": "character-dynamics-acceptance-hair",
  "schemaVersion": 1,
  "subject": "the ponytail bounds of PRD-912: segment stretch at most 5% and no simulated bone inside the head or neck capsule in every phase; red on ?arm=softbody, green on ?arm=hair",
