      "reject": ["softBodyCollision"]
    },
    {
      "id": "brief.physics-puzzle.2",
      "query": "Give the controlled character a visible controller that can push solid bodies and cannot walk through them.",
      "scope": "mechanic",
      "source": "brief:physics-puzzle#2",
      "expect": ["CharacterBody3D"],
      "reject": ["AnimationPlayer", "supportedGlyphs", "rapier", "RigidBody3D"]
    },
    {
      "id": "brief.physics-puzzle.3",
      "query": "Include one body class that the controlled character passes through and another that blocks the controlled character; make the distinction visible in the scene.",
      "scope": "mechanic",
      "source": "brief:physics-puzzle#3",
      "expect": ["CollisionShape3D"],
      "reject": ["onUiIntent", "CharacterBody3D", "Joint3D", "rapier", "RigidBody3D"]
    },
    {
      "id": "brief.physics-puzzle.4",
      "query": "Reach the destination only through simulated contact with the controlled character or a pushed body. A distance check or scripted timer is not a valid win condition. When it is reached, some gameplay state must read the literal `won`; the proof compares against that word and cannot infer it.",
      "scope": "mechanic",
      "source": "brief:physics-puzzle#4",
      "expect": ["RigidBody3D"],
      "reject": [
        "AnimationPlayer",
        "ClusteredBatch",
        "ensureVelocityOutput",
        "GPUReadback",
        "GPUSceneBVH"
      ]
    },
    {
      "id": "brief.physics-puzzle.5",
      "query": "Run the same input sequence twice with a fixed seed and fixed-step simulation, and expose whether the final state matched on both runs.",
      "scope": "mechanic",
      "source": "brief:physics-puzzle#5",
      "expect": ["createReplayDriver", "replay"],
      "reject": [
        "ComputeDrivenRegistry",
        "Scheduler",
        "connectDevicePlaytestBridge",
        "readPlaytestEndpoint"
      ]
    },
    {
      "id": "brief.physics-puzzle.6",
      "query": "Use an angled camera and a readable HUD so the controlled character, stack, pass-through body, and destination remain legible on the first screen.",
      "scope": "mechanic",
      "source": "brief:physics-puzzle#6",
      "expect": ["Text", "publishUiState"],
      "reject": ["supportedGlyphs", "CharacterBody3D", "rapier", "RigidBody3D"]
    },
    {
      "id": "brief.physics-puzzle.8",
      "query": "The direct proof supplies no gameplay entity identifiers; the replay proof reads resource `state` paths `state.replayPhase` and `state.replayMatch`.",
      "scope": "mechanic",
      "source": "brief:physics-puzzle#8",
      "expect": ["subscribeUiState"],
      "reject": ["assertJsonSafe"]
    },
