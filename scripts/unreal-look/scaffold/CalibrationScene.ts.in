// Written by scripts/unreal-look/capture-threenative.ts into a scaffolded copy of the starter
// (PRD-646). It recreates a PRD-638 calibration scene: geometry and materials from the scene.glb
// that Unreal exported, lights and exposure from its scene.json (src/scenes/calibrationData.ts).
// It is scene setup only; every look decision comes from the copy's own `src/render/`.
//   ?tnGi=<scene>&layer=<ID|L1..L9>&tier=<low|medium|high>
// and `window.__tnRef.pose(...)` frames one camera pose, as in Reference.ts.
import {
  type ICtx,
  Scene,
  type SceneFrame,
  type ShadowFilterTier,
  sourceRadiusShadowFilter,
} from "@threenative/core";
import type { IPhysicsContext } from "@threenative/physics";
import {
  BackSide,
  Box3,
  Color,
  DoubleSide,
  FrontSide,
  type Group,
  Mesh,
  MeshBasicMaterial,
  type MeshStandardMaterial,
  NoToneMapping,
  type Object3D,
  type PerspectiveCamera,
  PointLight,
  SRGBColorSpace,
  SpotLight,
  Vector3,
} from "three";
import { texture, uniform, vec4 } from "three/tsl";
import { MeshBasicNodeMaterial, type Node } from "three/webgpu";
import { giCache, installGi } from "../render/giCache.js";
import { watchGi } from "../render/giTier.js";
import { type IGlbMaterialImages, glbMaterialImages } from "../render/glbImages.js";
import { watchShadowTier } from "../render/shadowTier.js";
import { pointLightMean, translucentTwin } from "../render/translucency.js";
import { createVolumetricFog } from "../render/volumetricFog.js";
import {
  EPIC_SSGI,
  type FinalGatherMethod,
  giPreset,
  qualityPreset,
  resolveQualityTier,
  shadowPreset,
} from "../render/quality.js";
import { WorldEnvironment } from "../render/worldEnvironment.js";
import type { GameState } from "../state.js";
import { SCENES } from "./calibrationData.js";
import { Play } from "./Play.js";

type GameCtx = ICtx<GameState, IPhysicsContext>;
type Pose = { position: number[]; target: number[]; hfovDeg: number };

const params = new URLSearchParams(location.search);
const NAME = params.get("tnGi") ?? "";
const LAYER = params.get("layer") ?? "L7";
const level = LAYER === "ID" ? -1 : Number(LAYER.slice(1));
// The quality tier the cell is drawn at (default high, Unreal's Epic): its GI method and shadow filter come
// from `render/quality.ts` (PRD-644, PRD-652). GI enters at L7; below it there is none, as in Unreal's ladder.
const TIER = resolveQualityTier({ tier: params.get("tier") ?? "high" });
const GI_METHOD = level >= 7 ? giPreset(TIER).finalGatherMethod : "none";
// Unreal's GI and shadow levels are separate scalability groups: `shadowTier=` draws the shadows at another tier.
const SHADOW_TIER = resolveQualityTier({ tier: params.get("shadowTier") ?? TIER });
const SHADOW = shadowPreset(SHADOW_TIER);
const DATA = SCENES[NAME];
// Diagnosis only: scales every light, so a capture can bracket a unit error. Unset in every judged capture.
const LIGHT_SCALE = Number(params.get("lightScale") ?? 1);
const EXPOSURE = Number(params.get("exposure") ?? DATA?.exposure?.exposureScale ?? 1);

/**
 * Unreal light units to three's. three's punctual light intensity is candela, and its Lambert
 * BRDF carries the same 1 / pi as Unreal's (Engine/Shaders/Private/BRDF.ush, Diffuse_Lambert), so
 * the falloff and the window at the attenuation radius map one to one.
 */
export function candela(intensity: number, units: string): number {
  if (units === "candelas") return intensity;
  // An unshaded point light spreads its lumens over the whole sphere (PointLightComponent.cpp).
  if (units === "lumens") return intensity / (4 * Math.PI);
  throw new Error(`TN_CALIBRATION_SCENE_UNIT: ${units}`);
}

export class CalibrationScene extends Scene<GameState, IPhysicsContext> {
  static override readonly initialState: GameState = Play.initialState;
  #model: Group | undefined;
  #images: Map<string, IGlbMaterialImages> = new Map();
  #dispose: (() => void) | undefined;
  #gi: ReturnType<typeof watchGi> | undefined;
  #shadow: ReturnType<typeof watchShadowTier> | undefined;

  override async load(ctx: GameCtx): Promise<void> {
    if (DATA === undefined) throw new Error(`TN_CALIBRATION_SCENE_UNKNOWN: ${NAME}`);
    const model = await ctx.assets.model<{ scene: Group }>(
      // A family scene `shadow:<name>` lives in its family folder (PRD-649).
      `unreal-reference/gi/${NAME.replace(":", "/")}/scene.glb`,
    );
    this.#model = model.scene;
    // The engine decodes the scene's maps itself and shows JavaScript only their size. The Surface Cache reads
    // the same images again from the file (PRD-639).
    const file = `unreal-reference/gi/${NAME.replace(":", "/")}/scene.glb`;
    const tried: string[] = [];
    for (const url of await ctx.assets.resolve(file)) {
      const response = await fetch(url);
      tried.push(`${response.status} ${url}`);
      if (!response.ok) continue;
      try {
        this.#images = await glbMaterialImages(await response.arrayBuffer(), new URL(url, location.href).href);
        break;
      } catch (error) {
        tried.push(String(error));
      }
    }
    console.info(`TN_CALIBRATION_IMAGES ${JSON.stringify({ tried, materials: [...this.#images.keys()] })}`);
  }

  override enter(ctx: GameCtx): SceneFrame<GameState, IPhysicsContext> {
    const model = this.#model;
    if (model === undefined || DATA === undefined) throw new Error("TN_CALIBRATION_SCENE_NOT_LOADED");
    ctx.add(model);
    const scene = ctx.scene;
    const camera = ctx.camera as PerspectiveCamera;
    const raw = ctx.renderer.raw as unknown as { toneMapping: number };
    // Every scene.json property this recreation does not carry, with the PRD that owns it.
    const unsupported: { actor: string; property: string; reason: string }[] = [];
    // Draws the lamps' shadows at another tier: what a `ShadowFilterBudget` step does, callable from the page.
    let setShadowTier = (_tier: ShadowFilterTier): void => undefined;
    // The region a mesh belongs to: the scene.glb node named after the Unreal actor, or, when the
    // asset pipeline flattened the nodes away, the mesh named after its static mesh, SM_<actor>. An
    // actor shares its region with others when scene.json names one (the leaf cards: Leaves).
    const regionByActor = new Map<string, string>(
      (DATA.meshes as { name: string; region?: string }[]).map((m) => [m.name, m.region ?? m.name]),
    );
    const regionOf = (object: Object3D): string | undefined => {
      for (let o: Object3D | null = object; o !== null; o = o.parent) {
        const region = regionByActor.get(o.name.replace(/^SM_/, ""));
        if (region !== undefined) return region;
      }
      return undefined;
    };
    const meshes: Mesh[] = [];
    model.traverse((object) => {
      if (object instanceof Mesh) meshes.push(object);
    });
    for (const mesh of meshes)
      if (regionOf(mesh) === undefined) throw new Error(`TN_CALIBRATION_SCENE_UNMAPPED: ${mesh.name}`);

    scene.background = new Color(0x000000);
    scene.environment = null;
    if (level <= 0) {
      // ID and L0: the region colour unlit, no post. Unreal: ShowFlag.Lighting 0, post off, base
      // colour id / 255 as linear, display-encoded on output.
      for (const mesh of meshes) {
        const [r = 0, g = 0, b = 0] = DATA.regions[regionOf(mesh) ?? ""] ?? [];
        const colour = new Color().setRGB(r / 255, g / 255, b / 255);
        // A slot keeps its sides. A masked slot (leaf cards) keeps its cut too. The ID colour is flat: a real leaf
        // texture is green, so the node material takes only the texture's alpha, where a `map` would tint it (PRD-651).
        const flat = (source: MeshStandardMaterial) => {
          if (!(source.alphaTest > 0 && source.map))
            return new MeshBasicMaterial({ color: colour, side: source.side, toneMapped: false });
          const masked = new MeshBasicNodeMaterial({ side: source.side, toneMapped: false });
          masked.colorNode = vec4(uniform(colour), texture(source.map).a);
          masked.alphaTest = source.alphaTest;
          return masked;
        };
        mesh.material = Array.isArray(mesh.material)
          ? mesh.material.map((m) => flat(m as MeshStandardMaterial))
          : flat(mesh.material as MeshStandardMaterial);
      }
      raw.toneMapping = NoToneMapping;
    } else {
      // Unreal L1 to L4 render without shadows (r.ShadowQuality 0); from L5 every light casts.
      const shadows = level >= 5;
      // Casters and receivers do nothing until the renderer runs a shadow pass (scaffold lighting.ts does
      // this for the reference scene, which this scene does not use).
      (ctx.renderer.raw as unknown as { shadowMap: { enabled: boolean } }).shadowMap.enabled = shadows;
      // Casters keep three's derived shadowSide (back faces of a front-sided material). With a hard
      // filter those leak a bright line at a box's far foot (native_engine_contact_shadow_foot); the
      // lamps' source-radius filter closes it, and front faces instead add acne on the grazing walls
      // (cornell L6, 2026-10-20). Diagnosis knob: shadowSide=front|back|double|three.
      const side = { front: FrontSide, back: BackSide, double: DoubleSide }[params.get("shadowSide") ?? "three"];
      for (const mesh of meshes) {
        // A translucent material casts no dynamic shadow in Unreal unless it asks to be cut out like a mask (UE 5.8.3:
        // Engine/Public/MaterialShared.h, FMaterial::ShouldCastDynamicShadows): the lamp's light passes a glass pane.
        mesh.castShadow = shadows && (mesh.material as MeshStandardMaterial).transparent !== true;
        mesh.receiveShadow = shadows;
        if (side !== undefined) for (const m of [mesh.material].flat()) m.shadowSide = side;
      }
      const lights: (PointLight | SpotLight)[] = [];
      const lamps: { point: PointLight | SpotLight; radius: number; casts: boolean }[] = [];
      for (const light of DATA.lights) {
        if (light.class !== "PointLight" && light.class !== "SpotLight")
          throw new Error(`TN_CALIBRATION_SCENE_LIGHT: ${light.name} ${light.class}`);
        const [r = 1, g = 1, b = 1] = light.color;
        // scene.json holds Unreal's `light_color`, an FColor: Unreal reads its bytes as sRGB and lights with the linear
        // value (neon-corridor L1 EXR: a [1, 0.85, 0.65] lamp lights a grey wall at G/R 0.70 and B/R 0.41, the
        // decoded (1, 0.69, 0.38), not the raw numbers). A white lamp reads the same either way.
        const colour = new Color().setRGB(r, g, b, SRGBColorSpace);
        const cd = candela(light.intensity, light.units) * LIGHT_SCALE;
        // A spot looks at its target through the outer cone; three's penumbra is the share of the cone that
        // fades, Unreal's inner cone the part that does not (PRD-649 lamp-room).
        const outer = ((light.outerConeDeg ?? 0) * Math.PI) / 180;
        const point =
          light.class === "SpotLight"
            ? new SpotLight(
                colour,
                cd,
                light.attenuationRadiusM,
                outer,
                ((light.outerConeDeg ?? 0) - (light.innerConeDeg ?? 0)) / (light.outerConeDeg ?? 1),
                2,
              )
            : new PointLight(colour, cd, light.attenuationRadiusM, 2);
        if (point instanceof SpotLight) {
          point.target.position.fromArray(light.target ?? [0, 0, 0]);
          scene.add(point.target);
        }
        point.name = light.name;
        point.position.fromArray(light.position);
        lamps.push({ point, radius: light.sourceRadiusM ?? 0, casts: shadows && light.castShadows });
        // Unreal's lamp shadow has no near plane: three's 0.5 m default clipped cornell's shade, 0.3 m
        // from the lamp. Diagnosis knobs: shadowNear, shadowMap (texels), shadowBias, shadowNormalBias.
        point.shadow.camera.near = Number(params.get("shadowNear") ?? 0.02);
        // 1024 texels a cube face: at three's 512 the edge of the tall box's shadow on the red wall
        // steps where its penumbra is narrow (cornell corner, 2026-10-20); PRD-650 Phase 1 makes the
        // size follow the lamp's footprint. The lamp cache draws a still lamp's map once.
        const mapSize = Number(params.get("shadowMap") ?? 1024);
        point.shadow.mapSize.set(mapSize, mapSize);
        point.shadow.bias = Number(params.get("shadowBias") ?? point.shadow.bias);
        point.shadow.normalBias = Number(params.get("shadowNormalBias") ?? point.shadow.normalBias);
        scene.add(point);
        lights.push(point);
        if ((light.sourceRadiusM ?? 0) > 0 && params.get("sourceRadius") !== "0")
          unsupported.push({
            actor: light.name,
            property: "sourceRadiusM",
            reason: "a punctual light has no area: highlights stay hard (PRD-634)",
          });
      }
      // A shadow tier decides whether a lamp casts and what its filter samples; `ShadowFilterBudget` moves
      // it with the frame time when the URL asks for shadowAuto=1 (PRD-652). Diagnosis knobs: sourceRadius=0
      // leaves the shadow on the hard filter (the filter's cost arm); blockers and samples set the tap counts.
      const applyShadowTier = (next: ShadowFilterTier) => {
        const preset = shadowPreset(next);
        for (const { point, radius, casts } of lamps) {
          point.castShadow = casts && preset.castShadows;
          // The lamp's radius softens its shadow as Unreal's does (PRD-650); its highlight stays a point's.
          if (radius > 0 && params.get("sourceRadius") !== "0")
            // three's WebGPU ShadowNode reads `shadow.filterNode`; its types do not declare it yet.
            (point.shadow as unknown as { filterNode: unknown }).filterNode = sourceRadiusShadowFilter({
              sourceRadius: radius,
              blockerSamples: Number(params.get("blockers") ?? preset.filter.blockerSamples),
              filterSamples: Number(params.get("samples") ?? preset.filter.filterSamples),
            });
        }
      };
      applyShadowTier(SHADOW_TIER);
      setShadowTier = applyShadowTier;
      if (shadows) this.#shadow = watchShadowTier(ctx, { tier: SHADOW_TIER, apply: applyShadowTier });
      if (GI_METHOD !== "none") {
        // Diagnosis: ?giSkip=<region> bakes with that region black, to measure its share of the bounce.
        const skipped = meshes.filter((m) => regionOf(m) === params.get("giSkip"));
        const kept = skipped.map((m) => (m.material as unknown as { color: Color }).color.clone());
        for (const m of skipped) {
          // Materials are shared (every white surface is one MI_White): only this region goes black.
          m.material = (m.material as MeshBasicMaterial).clone();
          (m.material as unknown as { color: Color }).color.setScalar(0);
        }
        const gi = installGi(ctx, model, {
          // Diagnosis: ?bounces=N brackets how much of the indirect light the later bounces carry.
          bounces: Number(params.get("bounces") ?? 5),
          // The Surface Cache is on: a ray reads the map where it lands (PRD-639). Diagnosis: ?giMaps=0 returns the
          // flat colour factor, ?giLights=0 leaves the lamps out of what a ray returns (the direct frame keeps them).
          surfaceCache:
            params.get("giMaps") !== "0" && {
              images: (material, slot) => this.#images.get(material.name ?? "")?.[slot],
            },
          lights: lights.map((l) => ({
            position: l.position,
            color: l.color,
            // Diagnosis: ?giLights=0 keeps the lamp's place but lights nothing. An empty list would stop the bake
            // in a scene with no sun and no sky.
            intensity: params.get("giLights") === "0" ? 0 : l.intensity,
            distance: l.distance,
          })),
        });
        skipped.forEach((m, i) => (m.material as unknown as { color: Color }).color.copy(kept[i] as Color));
        if (gi === undefined)
          unsupported.push({ actor: NAME, property: "GI", reason: "the GI cache did not bake" });
        // Diagnosis: ?direct=0 switches the lights off after the bake, so the frame holds the indirect
        // light alone (Unreal's L7-Epic-indirect, r.Lumen.Visualize.IndirectDiffuse 1, is its pair).
        if (params.get("direct") === "0") for (const l of lights) l.intensity = 0;
      }
      // Unreal's default lighting for a translucent surface is its translucency volume, the same in every direction
      // (Volumetric NonDirectional): the lamps at a quarter of what a facing surface receives and, from L7, the room's mean
      // bounce light. Another mode is not recreated (PRD-643). A mapped surface keeps the lit material.
      for (const m of DATA.meshes as { name: string; material: { alphaMode?: string; translucencyLightingMode?: string } }[]) {
        const mode = m.material.translucencyLightingMode;
        if (m.material.alphaMode === "BLEND" && mode !== undefined && mode !== "tlm_volumetric_non_directional")
          unsupported.push({ actor: m.name, property: "translucencyLightingMode", reason: `${mode} is not recreated` });
      }
      const bounce = giCache.meanRadiance;
      const direct = (position: Node<"vec3">) => pointLightMean(lights, position);
      for (const mesh of meshes) {
        const source = mesh.material as MeshStandardMaterial;
        if (source.transparent !== true || source.map != null) continue;
        mesh.material = translucentTwin(source, (position) =>
          bounce === undefined ? direct(position) : bounce(position).add(direct(position)),
        );
        // Cost measurement: ?translucent=off draws the same frame without its translucent surfaces.
        if (params.get("translucent") === "off") mesh.visible = false;
      }
      // The fog Unreal draws from layer L3 (r.Fog, r.VolumetricFog), as VQ-07's medium: Unreal's exponential height fog in
      // the room, its extinction and albedo, the lamps as unshadowed point lights. One medium per chain build.
      const fogData = level >= 3 ? DATA.fog : undefined;
      const makeFog = () => {
        if (fogData === undefined || fogData === null) return undefined;
        if (!fogData.volumetric) {
          unsupported.push({ actor: "Fog", property: "volumetric", reason: "only volumetric fog is recreated" });
          return undefined;
        }
        const extinction = fogData.density * 0.1 * fogData.volumetricExtinctionScale;
        const [ar = 1, ag = 1, ab = 1] = fogData.volumetricAlbedo;
        // The fog fills the scene and ends at its opaque surfaces: the model's bounds, past the walls.
        const bounds = new Box3().setFromObject(model).expandByScalar(1);
        const shadowed = lights.filter((l) => !(l instanceof PointLight) || l.castShadow);
        for (const l of shadowed)
          unsupported.push({ actor: l.name, property: "castShadows", reason: "the fog takes unshadowed point lights only" });
        for (const [key, zero] of [
          ["startDistanceM", 0],
          ["maxOpacity", 1],
        ] as const)
          if (fogData[key] !== zero)
            unsupported.push({ actor: "Fog", property: key, reason: "not carried by the fog medium" });
        if (fogData.inscatteringLuminance.some((c: number) => c > 0))
          unsupported.push({ actor: "Fog", property: "inscatteringLuminance", reason: "the analytic fog colour is not drawn" });
        return createVolumetricFog(scene, camera, {
          enabled: true,
          renderer: ctx.renderer.kind,
          steps: Number(params.get("fogSteps") ?? 48),
          resolutionScale: params.get("fogScale") === "1" ? 1 : 0.5,
          // Unreal: FogDensity / 1000 per centimetre, FogHeightFalloff / 1000 per centimetre in base 2
          // (UE 5.8.3: Renderer/Private/SceneCore.cpp, FExponentialHeightFogSceneInfo).
          volumes: [
            {
              bounds,
              density: extinction,
              baseHeight: fogData.position[1],
              heightFalloff: ((fogData.heightFalloff / 1000) * 100) * Math.LN2,
            },
          ],
          albedo: new Color().setRGB(ar, ag, ab, SRGBColorSpace),
          ambient: new Color(0, 0, 0),
          // From L7 the air also scatters the room's bounce light: the cache's mean radiance, the same in every direction
          // (Unreal adds the Lumen translucency volume to every fog sample).
          ...(giCache.meanRadiance === undefined ? {} : { ambientNode: giCache.meanRadiance }),
          anisotropy: fogData.volumetricScatteringDistribution,
          points: lights.filter((l): l is PointLight => l instanceof PointLight && !l.castShadow),
          environment: { aerialPerspective: false, godRays: false },
        });
      };
      // The template's `high` chain with the L9-only stages off, as Reference.ts runs below L9.
      // Exposure is the scene's fixed EV100: Unreal's manual exposure, 0.18 / 2^EV100.
      const build = (method: FinalGatherMethod) => {
        this.#dispose?.();
        const medium = makeFog();
        const world = new WorldEnvironment({
          ...qualityPreset("high"),
          autoExposureEnabled: false,
          bloomEnabled: false,
          // Diagnosis: ?gtao=0 takes the contact occlusion out, to tell its darkening from the shadow's.
          gtaoEnabled: level >= 6 && params.get("gtao") !== "0",
          finalGatherMethod: method,
          // Diagnosis: ?ssgi=0|1 and ?ssgiIntensity=N bracket the screen-space gather over the cache.
          ...(params.get("ssgi") === null ? {} : { ssgiEnabled: params.get("ssgi") === "1" }),
          ...(params.get("ssgiIntensity") === null ? {} : { ssgiIntensity: Number(params.get("ssgiIntensity")) }),
          // Unreal's L7 is its Epic tier (render/quality.ts).
          ...EPIC_SSGI,
          // Diagnosis: ?ssgiQuality=<tier> and ?ssgiScale=N gather another way (PRD-640 cost gate).
          ...(params.get("ssgiQuality") === null ? {} : { ssgiQuality: params.get("ssgiQuality") as "epic" }),
          ...(params.get("ssgiScale") === null ? {} : { ssgiResolutionScale: Number(params.get("ssgiScale")) }),
          ...(params.get("ssgiDenoise") === null ? {} : { ssgiDenoiseRadius: Number(params.get("ssgiDenoise")) }),
          // Diagnosis: ?probes=1 gathers with screen probes (PRD-640).
          // 16 x 16 rays per probe: the engine's probes carry no radiance cache, so they trace twice Unreal's real-time 8 x 8
          // (PRD-640 round 2026-10-21: sunlit-room dP50 0.129 against 0.140 for the per-pixel Epic gather). ?probeRays=N overrides.
          ...(params.get("probes") === "1"
            ? {
                ssgiScreenProbes: true,
                ssgiProbeRays: Number(params.get("probeRays") ?? 16),
                ssgiDenoiseRadius: Number(params.get("ssgiDenoise") ?? 16),
              }
            : {}),
          ...(params.get("probeJitter") === null ? {} : { ssgiProbeJitter: Number(params.get("probeJitter")) }),
          ...(params.get("probeDebug") === null ? {} : { ssgiProbeDebug: Number(params.get("probeDebug")) }),
          vignetteAmount: 0,
          exposure: EXPOSURE,
        });
        const applied = world.apply(
          ctx.renderer,
          scene,
          camera,
          medium === undefined ? {} : { baseColour: (scenePass) => medium.compose(scenePass) },
        );
        this.#dispose = () => {
          applied.dispose();
          medium?.dispose();
        };
      };
      build(GI_METHOD);
      // The tier's method moves with the measured GI time when the URL asks for giAuto=1 (PRD-644).
      if (GI_METHOD !== "none")
        this.#gi = watchGi(ctx, { tier: TIER, method: GI_METHOD, rebuild: build });
    }
    for (const u of unsupported)
      console.info(`TN_CALIBRATION_SCENE unsupported ${u.actor}.${u.property}: ${u.reason}`);

    const target = new Vector3();
    const reference = {
      layer: LAYER,
      tier: TIER,
      finalGatherMethod: GI_METHOD,
      shadowQuality: SHADOW.shadowQuality,
      // The GI and shadow watchers' newest windows, for the perf run (PRD-644 AC-2, PRD-652).
      giBudget: () => this.#gi?.lastReport(),
      shadowBudget: () => this.#shadow?.lastReport(),
      setShadowTier: (tier: string) => setShadowTier(resolveQualityTier({ tier })),
      scene: NAME,
      unsupported,
      // The live scene, renderer and GI cache, for in-page diagnosis.
      world: scene,
      gi: giCache,
      renderer: ctx.renderer.raw,
      disposePost: () => this.#dispose?.(),
      // Diagnosis: a lamp filter with other tap counts, for in-page paired cost runs (PRD-650).
      lampFilter: (blockers: number, samples: number) =>
        sourceRadiusShadowFilter({
          sourceRadius: DATA.lights[0]?.sourceRadiusM ?? 0,
          blockerSamples: blockers,
          filterSamples: samples,
        }),
      // What the frame was drawn with, for the capture report: a wrong unit shows here first.
      probe: () => {
        const r = ctx.renderer.raw as unknown as { toneMapping: number; toneMappingExposure: number };
        const lights: unknown[] = [];
        scene.traverse((o) => {
          const l = o as PointLight;
          if (l.isLight) lights.push({ type: l.type, intensity: l.intensity, distance: l.distance, decay: l.decay, visible: l.visible });
        });
        const m = meshes[0]?.material as { type?: string; color?: Color; roughness?: number } | undefined;
        return {
          toneMapping: r.toneMapping,
          toneMappingExposure: r.toneMappingExposure,
          lights,
          material: { type: m?.type, color: m?.color?.toArray(), roughness: m?.roughness },
        };
      },
      engine:
        "engine" in (ctx.renderer.raw as unknown as { info: object }).info ? "threenative" : "threejs",
      pose(pose: Pose): void {
        const aspect = innerWidth / innerHeight;
        const half = (pose.hfovDeg * Math.PI) / 360;
        camera.fov = (2 * Math.atan(Math.tan(half) / aspect) * 180) / Math.PI;
        camera.aspect = aspect;
        camera.near = 0.1;
        camera.far = 2000;
        camera.position.fromArray(pose.position);
        camera.lookAt(target.fromArray(pose.target));
        camera.updateProjectionMatrix();
      },
    };
    (window as unknown as { __tnRef: unknown }).__tnRef = reference;
    // Start at the capture's first pose (or ?pose=<name>), not at the framework camera's origin.
    const poses = (DATA.poses ?? []) as (Pose & { name: string })[];
    const start = poses.find((pose) => pose.name === params.get("pose")) ?? poses[0];
    if (start !== undefined) reference.pose(start);
    return () => undefined;
  }

  override exit(ctx: GameCtx): void {
    this.#dispose?.();
    this.#dispose = undefined;
    super.exit(ctx);
  }
}
