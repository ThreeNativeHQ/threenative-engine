{
  "name": "midway-flight-bench",
  "schemaVersion": 1,
  "target": "web",
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "warmupFrames": 30,
  "steps": [
    {
      "kind": "click",
      "label": "take-the-deck",
      "at": {
        "element": {
          "id": "start-deck"
        }
      },
      "release": true
    },
    {
      "kind": "input",
      "label": "accelerate-on-deck",
      "press": "KeyW",
      "holdTicks": 900,
      "release": true
    },
    {
      "kind": "input",
      "label": "brief-pull-back",
      "press": "ArrowDown",
      "holdTicks": 45,
      "release": true
    },
    {
      "kind": "wait",
      "label": "released-stick-climb",
      "waitTicks": 900,
      "release": true,
      "screenshot": "takeoff.png"
    },
    {
      "kind": "input",
      "label": "cockpit",
      "press": "KeyC",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "wait",
      "label": "canopy-and-instruments",
      "waitTicks": 30,
      "release": true,
      "screenshot": "cockpit.png"
    },
    {
      "kind": "input",
      "label": "rear-gunner",
      "press": "KeyY",
      "holdTicks": 1,
      "release": true
    },
    {
      "kind": "wait",
      "label": "gun-view",
      "waitTicks": 60,
      "release": true,
      "screenshot": "reargun.png"
    }
  ],
  "assert": {
    "diagnostics": {
      "noConsoleErrors": true,
      "noNetworkErrors": true,
      "runtimeReady": true
    },
    "hud": [
      {
        "id": "briefing",
        "visible": false
      }
    ],
    "resources": [
      {
        "id": "state",
        "path": "airborne",
        "atSteps": [
          {
            "label": "released-stick-climb",
            "equals": true
          }
        ]
      },
      {
        "id": "state",
        "path": "altitude",
        "gte": 40,
        "changed": true
      }
    ]
  }
}
