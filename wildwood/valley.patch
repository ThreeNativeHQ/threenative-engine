 /**
+ * Every logical path the detail tier reads, in the order it starts. Built from the same constants
+ * the loaders use, so a species added to a niche is prefetched without a second list to update.
+ */
+function detailAssetPaths(): readonly string[] {
+  const paths = new Set<string>();
+  for (const niche of Object.values(FLORA)) {
+    for (const name of niche) paths.add(`${FAB}/${name}.glb`);
+  }
+  for (const name of LANDMARK_STONE.boughs) paths.add(`${FAB}/${name}.glb`);
+  for (const name of LANDMARK_STONE.stumps) paths.add(`${FAB}/${name}.glb`);
+  for (const file of [
+    "cliffrocks_diffuse.jpg",
+    "cliffrocks_normal.jpg",
+    "dead_tree_trunk_diffuse.jpg",
+    "dead_tree_trunk_normal.jpg",
+  ]) {
+    paths.add(`landscape/${file}`);
+  }
+  for (const model of WILDWOOD_ANIMAL_MODELS) {
+    paths.add(`fab/${ANIMAL_LISTING}/ue/Models/${model}`);
+  }
+  // The environment is a manifest texture read by RGBELoader, not `ctx.assets`; prefetching it
+  // lets the cache bridge serve it, so the deferred tier asks the network for nothing.
+  paths.add("hdri/kloofendal_48d_2k.hdr");
+  return [...paths];
+}
