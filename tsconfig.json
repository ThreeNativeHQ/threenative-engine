{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "types": ["node"],
    "allowJs": false,
    "paths": {
      "@threenative/core": ["./packages/core/src/index.ts"],
      "@threenative/core/playtest": ["./packages/core/src/playtest.ts"],
      "@threenative/physics": ["./packages/physics/src/index.ts"],
      "@threenative/playtest": ["./packages/playtest/src/index.ts"],
      "@threenative/ui": ["./packages/ui/src/index.ts"],
      "tn-native-transport": ["./packages/three-native/perry/src/index.ts"]
    }
  },
  "include": [
    "scripts/**/*.ts",
    "test-support/**/*.ts",
    "hosting/**/*.ts",
    "packages/**/__tests__/**/*.ts",
    "examples/**/__tests__/**/*.ts",
    "vitest.config.ts",
    "playwright.config.ts"
  ],
  "exclude": [
    "node_modules",
    "**/dist/**",
    "packages/runtime-native/scripts/**",
    "packages/three-native/__tests__/fixtures",
    "scripts/performance-regression/labs"
  ]
}
