{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "ignore": [
      "**/dist/**",
      "**/dist-native/**",
      "**/.threenative/**",
      "**/mcp/engine-server.mjs",
      "**/mcp/blender-server.mjs",
      "packages/metahuman/wasm/**",
      "artifacts/**",
      "examples/strata-terrain-preview/src/world/*.json",
      "examples/strata-terrain-preview/local-assets/**",
      "build/**",
      "release-native/**",
      ".linchpin/**",
      ".runtime/**",
      ".worktrees/**",
      ".claude/worktrees/**",
      ".opencode/**",
      ".leanpi/**",
      ".linchpin/**",
      ".tnshots/**",
      ".mcp.json",
      "**/.cursor/mcp.json",
      "**/.vscode/mcp.json",
      "**/.gemini/settings.json",
      "**/.zed/settings.json",
      "**/opencode.json",
      "packages/runtime-native/.runtime/**",
      "packages/runtime-native/build/**",
      "packages/runtime-native/**/build/**",
      "packages/runtime-native/third_party/**",
      "packages/runtime-native/native/css-ui/vendor/**",
      "examples/native-css-hud/corpus/out/**",
      "examples/native-css-hud/corpus/out-interaction/**",
      "packages/assets/vendor/basis-encoder/basis_encoder.js",
      "packages/runtime-native/**/*.json",
      "packages/terrain/starter/*/recipe.json",
      "test-results/**",
      "examples/abyss-vanilla/index.html",
      "examples/abyss-vanilla/src/main.js",
      "examples/abyss-vanilla/src/style.css",
      "examples/abyss-vanilla/vite.config.js",
      "examples/auto-lod/public/**",
      "examples/abyss-framework/public/**",
      "examples/prd493-terrain-splat/public/**",
      "examples/abyss-framework/vq-assets/.generated/**",
      "examples/csg-doorway/public/**",
      "docs/benchmark/sweeps/**",
      "docs/benchmark/rounds/**",
      "docs/benchmark/prd345/shooter-causes1/**",
      "docs/verification/prd-357-c4-duplicate-inventory.json",
      "docs/verification/prd-357-c4-duplicate-inventory-before.json",
      "docs/verification/vq04/**",
      "docs/verification/visuals/**",
      "benchmark/engine-load-test/godot-lights-meshes/benchmark_box_1000.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "lineWidth": 100
  },
  "organizeImports": {
    "enabled": true
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "complexity": {
        "noExcessiveCognitiveComplexity": {
          "level": "warn",
          "options": { "maxAllowedComplexity": 15 }
        }
      },
      "style": {
        "useNamingConvention": {
          "level": "error",
          "options": {
            "conventions": [{ "selector": { "kind": "interface" }, "match": "I(.*)" }],
            "strictCase": false,
            "requireAscii": false
          }
        }
      }
    }
  },
  "overrides": [
    {
      "include": ["**/*.ts", "**/*.tsx"],
      "linter": { "rules": { "style": { "useNamingConvention": "off" } } }
    },
    {
      "include": ["packages/runtime-native/**/*.js", "packages/runtime-native/**/*.mjs"],
      "formatter": { "enabled": false },
      "organizeImports": { "enabled": false },
      "linter": {
        "rules": {
          "style": {
            "useNamingConvention": {
              "level": "error",
              "options": {
                "conventions": [
                  { "selector": { "kind": "importNamespace" }, "match": ".*" },
                  { "selector": { "kind": "objectLiteralProperty" }, "match": ".*" }
                ],
                "strictCase": false,
                "requireAscii": false
              }
            },
            "useDefaultParameterLast": "warn",
            "useTemplate": "warn",
            "noUnusedTemplateLiteral": "warn"
          },
          "performance": { "noDelete": "warn" }
        }
      }
    },
    {
      "include": [
        "packages/core/src/**",
        "packages/physics/src/**",
        "packages/ui/src/**",
        "packages/create-threenative/src/**",
        "packages/playtest/src/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "useNamingConvention": {
              "level": "error",
              "options": {
                "conventions": [{ "selector": { "kind": "interface" }, "match": "I(.*)" }],
                "strictCase": false,
                "requireAscii": false
              }
            }
          }
        }
      }
    },
    {
      "include": ["packages/core/src/react-glyphs.ts"],
      "linter": { "rules": { "style": { "useNamingConvention": "off" } } }
    },
    {
      "include": ["packages/playtest/**"],
      "formatter": { "enabled": false },
      "organizeImports": { "enabled": false },
      "linter": {
        "rules": {
          "recommended": true,
          "complexity": {
            "noExcessiveCognitiveComplexity": {
              "level": "warn",
              "options": { "maxAllowedComplexity": 15 }
            },
            "noForEach": "warn"
          },
          "style": {
            "noNonNullAssertion": "warn",
            "noParameterAssign": "warn",
            "useNamingConvention": "warn",
            "useImportType": "warn",
            "useTemplate": "warn"
          },
          "suspicious": { "noConfusingVoidType": "warn" },
          "performance": { "noDelete": "warn" }
        }
      }
    },
    {
      "include": ["packages/playtest/src/**"],
      "linter": {
        "rules": {
          "style": {
            "useNamingConvention": {
              "level": "error",
              "options": {
                "conventions": [
                  { "selector": { "kind": "interface" }, "match": "I(.*)" },
                  { "match": ".*" }
                ],
                "strictCase": false,
                "requireAscii": false
              }
            }
          }
        }
      }
    },
    {
      "include": [
        "docs/verification/prd339-exposure-proof/camera-cuts-2bc1d57f.json",
        "docs/verification/prd339-exposure-proof/cold-boots-08b039c.json",
        "docs/verification/prd339-exposure-proof/cold-boots-d1500603.json",
        "docs/verification/prd339-exposure-proof/completion-388e8a.json",
        "docs/verification/prd339-exposure-proof/completion-current-55b5313.json",
        "docs/verification/prd339-exposure-proof/controlled-cuts-9a84ee0e.json",
        "docs/verification/prd339-exposure-proof/dark-adapted-bb34aff.json",
        "docs/verification/prd339-exposure-proof/live-clock-5c3b176.json",
        "docs/verification/prd339-exposure-proof/qualified-cuts-2a33c9a0.json",
        "docs/verification/prd339-exposure-proof/reverse-cuts-ad0498e6.json",
        "docs/verification/prd339-exposure-proof/rgb-correction-c7091c7.json",
        "docs/verification/prd339-exposure-proof/sunlight-failed-eaa583b.json"
      ],
      "formatter": {
        "enabled": false
      }
    }
  ]
}
