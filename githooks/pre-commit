#!/usr/bin/env bash
# Keep the agent-facing capability inventory synchronized with staged public engine changes.
# This intentionally does nothing for docs, examples, tests, and ordinary game/template edits.
set -euo pipefail

# The committing checkout, not the hook's: an absolute core.hooksPath runs one checkout's hook for every worktree.
cd "$(git rev-parse --show-toplevel)"

if [[ "${TN_SKIP_CAPABILITY_SYNC:-}" == "1" ]]; then
  echo "pre-commit: capability sync skipped (TN_SKIP_CAPABILITY_SYNC=1)"
  exit 0
fi

staged=$(git diff --cached --name-only --diff-filter=ACMR)

# A PRD or the Unreal feature map changed: refresh the port status the README and the map show.
if grep -Eq '^(docs/PRDs/.*PRD-[^/]*\.md|docs/PRDs/Unreal/research/unreal-visuals-and-performance-feature-map\.html|docs/PRDs/Unreal/research/internals/[^/]+\.json|scripts/unreal-port-status\.ts)$' <<<"$staged"; then
  if [[ -x node_modules/.bin/tsx ]]; then
    pnpm --silent unreal:status
  else
    echo "pre-commit: no node_modules here, Unreal port status not refreshed (pnpm check:docs will flag it)"
  fi
  git add -- README.md docs/PRDs/Unreal/research/unreal-visuals-and-performance-feature-map.html \
    docs/PRDs/Unreal/research/unreal-port-status.svg docs/PRDs/Unreal/research/unreal-port-progress.svg \
    docs/PRDs/Unreal/research/port-history.json
fi
if ! grep -Eq '^(packages/[^/]+/(src/.*|package\.json)|scripts/(build-capability-manifest|check-capability-docs|realism-effects-coverage|render-chain-capabilities)\.ts|pnpm-workspace\.yaml)$' <<<"$staged"; then
  exit 0
fi

echo "pre-commit: syncing engine capabilities"
pnpm capabilities:sync
# The public surface is written by the same trigger, and refuses to re-record while a removal is
# unannounced — so the break fails here, naming the symbol, rather than reaching `develop`.
pnpm api:surface:sync

# Stage only deterministic capability artifacts. Never sweep unrelated work into the commit.
git add -- \
  packages/create-threenative/capabilities.json \
  packages/core/capabilities.json \
  packages/create-threenative/agent-docs/references/capability-reference.md \
  packages/create-threenative/agent-files/.agents/skills/threenative-context/SKILL.md \
  scripts/api-surface.json