{
  "note": "PRD-638 GI calibration scenes. Each scene folder holds scene.py (authored in Unreal), and the exported scene.glb and scene.json. A variant is one Movie Render Queue run per pose. GI quality follows BaseScalability.ini on 5.8.3: @0 Lumen GI off, @1 irradiance field gather, @3 screen probe gather. expect is read back from the editor log for every job. A variant with motion: true is what a motion run (--motion <run>) captures by default, and one with motionOnly: true is captured by a motion run only; L7-Epic-motion and L7-Medium-motion are L7-Epic and L7-Medium with the backbuffer dither at 16 bits, so a still camera shows the GI flicker and not the tonemapper dither (L7-Medium-motion is captured on request: --variants).",
  "resolution": [1280, 720],
  "scenes": [
    {
      "name": "cornell",
      "owner": "PRD-638",
      "poses": ["cornell", "corner"]
    },
    {
      "name": "sunlit-room",
      "owner": "PRD-638",
      "poses": ["window", "leak", "door"]
    },
    {
      "name": "neon-corridor",
      "owner": "PRD-639",
      "poses": ["neon", "textured"]
    }
  ],
  "variants": [
    {
      "name": "L1",
      "layer": "L1",
      "cvars": {},
      "expect": {
        "r.DynamicGlobalIlluminationMethod": 0
      },
      "kinds": ["png", "exr"]
    },
    {
      "name": "L7-Low",
      "layer": "L7",
      "cvars": {
        "sg.GlobalIlluminationQuality": 0
      },
      "expect": {
        "r.Lumen.DiffuseIndirect.Allow": 0
      },
      "kinds": ["png", "exr"]
    },
    {
      "name": "L7-Medium",
      "layer": "L7",
      "cvars": {
        "sg.GlobalIlluminationQuality": 1
      },
      "expect": {
        "r.Lumen.DiffuseIndirect.Allow": 1,
        "r.Lumen.FinalGatherMethod": 0
      },
      "kinds": ["png", "exr"]
    },
    {
      "name": "L7-Epic",
      "layer": "L7",
      "cvars": {
        "sg.GlobalIlluminationQuality": 3
      },
      "expect": {
        "r.Lumen.DiffuseIndirect.Allow": 1,
        "r.Lumen.FinalGatherMethod": 1
      },
      "kinds": ["png", "exr"]
    },
    {
      "name": "L7-Epic-indirect",
      "layer": "L7",
      "cvars": {
        "sg.GlobalIlluminationQuality": 3,
        "r.Lumen.Visualize.IndirectDiffuse": 1
      },
      "expect": {
        "r.Lumen.DiffuseIndirect.Allow": 1,
        "r.Lumen.Visualize.IndirectDiffuse": 1
      },
      "kinds": ["png", "exr"]
    },
    {
      "name": "L7-Epic-scene",
      "layer": "L7",
      "cvars": {
        "sg.GlobalIlluminationQuality": 3,
        "r.Lumen.Visualize": 3
      },
      "expect": {
        "r.Lumen.DiffuseIndirect.Allow": 1,
        "r.Lumen.Visualize": 3
      },
      "kinds": ["png"]
    },
    {
      "name": "L9-Epic",
      "layer": "L9",
      "cvars": {
        "sg.GlobalIlluminationQuality": 3
      },
      "expect": {
        "r.Lumen.DiffuseIndirect.Allow": 1,
        "r.Lumen.FinalGatherMethod": 1
      },
      "kinds": ["png", "exr"]
    },
    {
      "name": "L7-Epic-motion",
      "layer": "L7",
      "motion": true,
      "motionOnly": true,
      "cvars": {
        "sg.GlobalIlluminationQuality": 3,
        "r.BackbufferQuantizationDitheringOverride": 16
      },
      "expect": {
        "r.Lumen.DiffuseIndirect.Allow": 1,
        "r.Lumen.FinalGatherMethod": 1,
        "r.BackbufferQuantizationDitheringOverride": 16
      },
      "kinds": ["png"]
    },
    {
      "name": "L7-Medium-motion",
      "layer": "L7",
      "motionOnly": true,
      "cvars": {
        "sg.GlobalIlluminationQuality": 1,
        "r.BackbufferQuantizationDitheringOverride": 16
      },
      "expect": {
        "r.Lumen.DiffuseIndirect.Allow": 1,
        "r.Lumen.FinalGatherMethod": 0,
        "r.BackbufferQuantizationDitheringOverride": 16
      },
      "kinds": ["png"]
    },
    {
      "name": "ID",
      "layer": "L0",
      "level": "id",
      "motion": true,
      "cvars": {},
      "expect": {},
      "kinds": ["png"]
    }
  ]
